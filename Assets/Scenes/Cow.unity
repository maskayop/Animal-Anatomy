  allChildrenBodyParts: []
  groupName: "\u0428\u0435\u0439\u043D\u044B\u0439 \u043E\u0442\u0434\u0435\u043B
    (\u0448\u0435\u0439\u043D\u044B\u0435 \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u0438)"
  groupScientificName: "vert\u0435brae cervicales"
  description: "\u0421\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442 \u043A\u043E\u0441\u0442\u043D\u0443\u044E
    \u043E\u0441\u043D\u043E\u0432\u0443 \u0448\u0435\u0438, \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u044E\u0449\u0435\u0439
    \u0440\u043E\u043B\u044C \u043C\u043E\u0449\u043D\u043E\u0433\u043E \u043E\u0434\u043D\u043E\u043F\u043B\u0435\u0447\u0435\u0433\u043E
    \u0440\u044B\u0447\u0430\u0433\u0430, \u043D\u0430 \u043F\u0435\u0440\u0435\u0434\u043D\u0435\u043C
    \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
    \u043A\u0440\u0435\u043F\u0438\u0442\u0441\u044F \u0433\u043E\u043B\u043E\u0432\u0430.
    \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u0440\u0430\u0437\u043B\u0438\u0447\u0438\u044F \u0432 \u0434\u043B\u0438\u043D\u0435
    \u0448\u0435\u0438, \u0443 \u0432\u0441\u0435\u0445 \u0434\u043E\u043C\u0430\u0448\u043D\u0438\u0445
    \u043C\u043B\u0435\u043A\u043E\u043F\u0438\u0442\u0430\u044E\u0449\u0438\u0445
    \u0438\u043C\u0435\u0435\u0442\u0441\u044F 7 \u0448\u0435\u0439\u043D\u044B\u0445
    \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u043E\u0432"
