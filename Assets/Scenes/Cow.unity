--- !u!114 &750859371
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 750859369}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f37a37e4c3126744d977577d18ea895a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.BodyPartGroup
  cameraDistanceLimitsMultiplier: 1
  bodyPartsGroups: []
  bodyParts: []
  allChildrenBodyParts: []
  groupName: "\u0425\u0432\u043E\u0441\u0442\u043E\u0432\u043E\u0439 \u043E\u0442\u0434\u0435\u043B
    (\u0445\u0432\u043E\u0441\u0442\u043E\u0432\u044B\u0435 \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u0438)"
  groupScientificName: vertebrae caudales
  description: "\u0412 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0435
    18 \u2013 20 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442 \u043E\u0441\u043D\u043E\u0432\u0443
    \u0445\u0432\u043E\u0441\u0442\u043E\u0432\u043E\u0433\u043E \u043E\u0442\u0434\u0435\u043B\u0430,
    \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u044E\u0449\u0435\u0433\u043E \u0437\u0430\u0449\u0438\u0442\u043D\u0443\u044E
    \u0444\u0443\u043D\u043A\u0446\u0438\u044E \u0438 \u0440\u043E\u043B\u044C \u0441\u0432\u043E\u0435\u043E\u0431\u0440\u0430\u0437\u043D\u043E\u0433\u043E
    \u0440\u0443\u043B\u044F \u043F\u0440\u0438 \u0431\u044B\u0441\u0442\u0440\u044B\u0445
    \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F\u0445.
    \u0423 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445 \u0432\u0438\u0434\u043E\u0432
    \u0434\u043E\u043C\u0430\u0448\u043D\u0438\u0445 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445
    \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0435 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B
    \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u0430 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442\u0441\u044F
    \u043B\u0438\u0448\u044C \u0443 \u043F\u0435\u0440\u0432\u044B\u0445 5 \u2013
    8, \u0432 \u0442\u043E \u0432\u0440\u0435\u043C\u044F \u043A\u0430\u043A \u0443
    \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445 \u043E\u043D\u0438 \u043F\u043E\u0434\u0432\u0435\u0440\u0433\u043B\u0438\u0441\u044C
    \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u0440\u0435\u0434\u0443\u043A\u0446\u0438\u0438.
    \u0421\u043E\u0445\u0440\u0430\u043D\u0438\u0432\u0448\u0438\u0435\u0441\u044F
    \u0442\u0435\u043B\u0430 \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u043E\u0432
    \u0438\u043C\u0435\u044E\u0442 \u0432\u0438\u0434 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0445
    \u0438 \u0442\u043E\u043D\u043A\u0438\u0445 \u0441\u0442\u043E\u043B\u0431\u0438\u043A\u043E\u0432\u0438\u0434\u043D\u043E\u0439
    \u0444\u043E\u0440\u043C\u044B \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0439.\n\u0423
    \u043A\u0440\u0443\u043F\u043D\u043E\u0433\u043E \u0440\u043E\u0433\u0430\u0442\u043E\u0433\u043E
    \u0441\u043A\u043E\u0442\u0430 \u0445\u0432\u043E\u0441\u0442 \u0434\u043B\u0438\u043D\u043D\u044B\u0439
    \u0437\u0430 \u0441\u0447\u0451\u0442 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u0434\u043B\u0438\u043D\u044B \u0442\u0435\u043B \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u043E\u0432.
    \u0420\u0443\u0434\u0438\u043C\u0435\u043D\u0442\u044B \u043F\u043E\u0437\u0432\u043E\u043D\u043E\u0447\u043D\u044B\u0445
    \u0434\u0443\u0433 \u0445\u043E\u0440\u043E\u0448\u043E \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u044B
    \u043D\u0430 \u043F\u0435\u0440\u0432\u044B\u0445 \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u0430\u0445.
    \u0418\u0437 \u0441\u0443\u0441\u0442\u0430\u0432\u043D\u044B\u0445 \u043E\u0442\u0440\u043E\u0441\u0442\u043A\u043E\u0432
    \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0441\u044C \u043B\u0438\u0448\u044C
    \u043A\u0440\u0430\u043D\u0438\u0430\u043B\u044C\u043D\u044B\u0435, \u0430 \u043F\u043E\u043F\u0435\u0440\u0435\u0447\u043D\u044B\u0435
    \u043F\u0440\u0438\u043D\u044F\u043B\u0438 \u0444\u043E\u0440\u043C\u0443 \u0448\u0438\u0440\u043E\u043A\u0438\u0445
    \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u043E\u043A, \u0437\u0430\u0433\u043D\u0443\u0442\u044B\u0445
    \u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E. \u041D\u0430 \u043A\u0440\u0430\u043D\u0438\u0430\u043B\u044C\u043D\u044B\u0445
    \u043A\u043E\u043D\u0446\u0430\u0445 \u043F\u0435\u0440\u0432\u044B\u0445 8 \u2013
    10 \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u043E\u0432 \u0441 \u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u0438\u043C\u0435\u044E\u0442\u0441\u044F
    \u0433\u0435\u043C\u0430\u043B\u044C\u043D\u044B\u0435 \u043E\u0442\u0440\u043E\u0441\u0442\u043A\u0438
    (processus hemales), \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E
    \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u044B \u043D\u0430 \u043F\u0435\u0440\u0432\u044B\u0445
    3 \u2013 5 \u0438 \u0438\u043D\u043E\u0433\u0434\u0430 \u043C\u043E\u0433\u0443\u0442
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u044B\u0432\u0430\u0442\u044C \u0433\u0435\u043C\u0430\u043B\u044C\u043D\u044B\u0435
    \u0434\u0443\u0433\u0438 (arcus hemales)"
  partGroupListButton: {fileID: 0}
  parentBodyPartGroup: {fileID: 0}
