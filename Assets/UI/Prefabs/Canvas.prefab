  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041B\u041A\u041C - \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435
    \u043A\u0430\u043C\u0435\u0440\u044B\n\u041F\u041A\u041C - \u0432\u044B\u0434\u0435\u043B\u0435\u043D\u0438\u0435
    \u0447\u0430\u0441\u0442\u0438 \u0442\u0435\u043B\u0430\nQ (\u0419) - \u0438\u0437\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
    \u0440\u0435\u0436\u0438\u043C\nF (\u0410) - \u0446\u0435\u043D\u0442\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0447\u0430\u0441\u0442\u044C \u0442\u0435\u043B\u0430\nEsc - \u0441\u043D\u044F\u0442\u044C
    \u0432\u044B\u0434\u0435\u043B\u0435\u043D\u0438\u0435 / \u0432\u044B\u0439\u0442\u0438
    \u0438\u0437 \u0438\u0437\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
    \u0440\u0435\u0436\u0438\u043C\u0430\nC (\u0421) + \u043C\u044B\u0448\u044C -
    \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435 \u0441\u0432\u0435\u0442\u0430\n~
    (\u0401), 1, 2, 3, 4, 5, 6, 7, 8, 9, 0 - \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0441\u0438\u0441\u0442\u0435\u043C\u0443\nShift + ~ (\u0401), 1, 2, 3, 4, 5,
    6, 7, 8, 9, 0 - \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u044B\u0431\u0440\u0430\u043D\u043D\u0443\u044E
    \u0441\u0438\u0441\u0442\u0435\u043C\u0443"
