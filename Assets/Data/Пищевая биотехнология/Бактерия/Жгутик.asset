  m_Name: "\u0416\u0433\u0443\u0442\u0438\u043A"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0416\u0433\u0443\u0442\u0438\u043A"
  scientificName: flagellum
  nameClip: {fileID: 0}
  description: "\u041D\u0438\u0442\u0435\u0432\u0438\u0434\u043D\u044B\u0435 \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u044B,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441\u043B\u0443\u0436\u0430\u0442
    \u043E\u0440\u0433\u0430\u043D\u0430\u043C\u0438 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
    \u0443 \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u0439. \u041E\u043D\u0438 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442
    \u0441\u043E\u0431\u043E\u0439 \u0442\u043E\u043D\u043A\u0438\u0435 \u043D\u0438\u0442\u0438,
    \u0431\u0435\u0440\u0443\u0449\u0438\u0435 \u043D\u0430\u0447\u0430\u043B\u043E
    \u043E\u0442 \u0446\u0438\u0442\u043E\u043F\u043B\u0430\u0437\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043C\u0435\u043C\u0431\u0440\u0430\u043D\u044B.\n\u0416\u0433\u0443\u0442\u0438\u043A
    \u0441\u043E\u0441\u0442\u043E\u0438\u0442 \u0438\u0437 \u0442\u0440\u0451\u0445
    \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0445 \u0447\u0430\u0441\u0442\u0435\u0439:\n-
    \u0411\u0430\u0437\u0430\u043B\u044C\u043D\u043E\u0435 \u0442\u0435\u043B\u044C\u0446\u0435
    (\u0431\u0430\u0437\u0430\u043B\u044C\u043D\u043E\u0435 \u0442\u0435\u043B\u043E).
    \u041E\u043F\u043E\u0440\u043D\u0430\u044F \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0430,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0437\u0430\u043A\u0440\u0435\u043F\u043B\u044F\u0435\u0442\u0441\u044F
    \u0432 \u043A\u043B\u0435\u0442\u043E\u0447\u043D\u043E\u0439 \u0441\u0442\u0435\u043D\u043A\u0435
    \u0438 \u0446\u0438\u0442\u043E\u043F\u043B\u0430\u0437\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043C\u0435\u043C\u0431\u0440\u0430\u043D\u0435. \u0412\u043A\u043B\u044E\u0447\u0430\u0435\u0442
    \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0439 \u0441\u0442\u0435\u0440\u0436\u0435\u043D\u044C
    \u0438 \u0441\u0438\u0441\u0442\u0435\u043C\u0443 \u0434\u0438\u0441\u043A\u043E\u0432
    (\u043A\u043E\u043B\u0435\u0446). \u0423 \u0433\u0440\u0430\u043C\u043F\u043E\u043B\u043E\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u0439 \u043E\u0431\u044B\u0447\u043D\u043E
    \u043E\u0434\u043D\u0430 \u043F\u0430\u0440\u0430 \u0434\u0438\u0441\u043A\u043E\u0432,
    \u0443 \u0433\u0440\u0430\u043C\u043E\u0442\u0440\u0438\u0446\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u2014 \u0434\u0432\u0435 \u043F\u0430\u0440\u044B. \u0414\u0438\u0441\u043A\u0438
    \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u044B \u0441 \u043A\u043B\u0435\u0442\u043E\u0447\u043D\u043E\u0439
    \u0441\u0442\u0435\u043D\u043A\u043E\u0439 \u0438 \u0446\u0438\u0442\u043E\u043F\u043B\u0430\u0437\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043C\u0435\u043C\u0431\u0440\u0430\u043D\u043E\u0439. \u0411\u0430\u0437\u0430\u043B\u044C\u043D\u043E\u0435
    \u0442\u0435\u043B\u044C\u0446\u0435 \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u0442
    \u0440\u043E\u043B\u044C \u043C\u0438\u043D\u0438\u0430\u0442\u044E\u0440\u043D\u043E\u0433\u043E
    \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043C\u043E\u0442\u043E\u0440\u0430,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432\u0440\u0430\u0449\u0430\u0435\u0442
    \u0436\u0433\u0443\u0442\u0438\u043A.\n- \u041A\u0440\u044E\u0447\u043E\u043A
    (\u043A\u043E\u043B\u0435\u043D\u043E). \u0413\u0438\u0431\u043A\u0430\u044F
    \u0431\u0435\u043B\u043A\u043E\u0432\u0430\u044F \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0430,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0435\u0442
    \u0431\u0430\u0437\u0430\u043B\u044C\u043D\u043E\u0435 \u0442\u0435\u043B\u043E
    \u0441 \u0436\u0433\u0443\u0442\u0438\u043A\u043E\u0432\u043E\u0439 \u043D\u0438\u0442\u044C\u044E.
    \u0414\u043B\u0438\u043D\u0430 \u043A\u0440\u044E\u0447\u043A\u0430 \u2014 30\u201345
    \u043D\u043C.\n- \u0421\u043F\u0438\u0440\u0430\u043B\u0435\u0432\u0438\u0434\u043D\u0430\u044F
    \u043D\u0438\u0442\u044C (\u0444\u0438\u043B\u0430\u043C\u0435\u043D\u0442, \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E
    \u0436\u0433\u0443\u0442\u0438\u043A). \u0416\u0451\u0441\u0442\u043A\u0430\u044F
    \u043D\u0438\u0442\u0435\u0432\u0438\u0434\u043D\u0430\u044F \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0430
    \u0434\u043B\u0438\u043D\u043E\u0439 \u0434\u043E 15 \u043C\u043A\u043C \u0438
    \u0434\u0438\u0430\u043C\u0435\u0442\u0440\u043E\u043C \u043E\u043A\u043E\u043B\u043E
    20 \u043D\u043C. \u0421\u043E\u0441\u0442\u043E\u0438\u0442 \u0438\u0437 \u0431\u0435\u043B\u043A\u0430
    \u0444\u043B\u0430\u0433\u0435\u043B\u043B\u0438\u043D\u0430 (\u043E\u0442 \u043B\u0430\u0442.
    flagellum \u2014 \u0436\u0433\u0443\u0442\u0438\u043A). \u0421\u0443\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0446\u044B
    \u0444\u043B\u0430\u0433\u0435\u043B\u043B\u0438\u043D\u0430 \u0437\u0430\u043A\u0440\u0443\u0447\u0435\u043D\u044B
    \u0432 \u0432\u0438\u0434\u0435 \u0441\u043F\u0438\u0440\u0430\u043B\u0438, \u043E\u0431\u0440\u0430\u0437\u0443\u044F
    \u0446\u0438\u043B\u0438\u043D\u0434\u0440\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0443. \u0412\u043D\u0443\u0442\u0440\u0438
    \u043D\u0438\u0442\u0438 \u0435\u0441\u0442\u044C \u043A\u0430\u043D\u0430\u043B,
    \u043F\u043E \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443 \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u0438\u0440\u0443\u044E\u0442\u0441\u044F
    \u043C\u043E\u043B\u0435\u043A\u0443\u043B\u044B \u043C\u043E\u043D\u043E\u043C\u0435\u0440\u043D\u043E\u0433\u043E
    \u0444\u043B\u0430\u0433\u0435\u043B\u043B\u0438\u043D\u0430.\n\u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u0438:\n-
    \u0422\u043E\u043B\u0449\u0438\u043D\u0430 \u0436\u0433\u0443\u0442\u0438\u043A\u043E\u0432
    \u2014 12\u201320 \u043D\u043C.\n- \u0414\u043B\u0438\u043D\u0430 \u2014 \u043E\u0442
    3 \u0434\u043E 15 \u043C\u043A\u043C \u0438 \u0431\u043E\u043B\u0435\u0435.\n-
    \u0418\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u044D\u043D\u0435\u0440\u0433\u0438\u0438
    \u0434\u043B\u044F \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u2014 \u0442\u0440\u0430\u043D\u0441\u043C\u0435\u043C\u0431\u0440\u0430\u043D\u043D\u044B\u0439
    \u0433\u0440\u0430\u0434\u0438\u0435\u043D\u0442 \u0438\u043E\u043D\u043E\u0432
    \u0432\u043E\u0434\u043E\u0440\u043E\u0434\u0430 \u0438\u043B\u0438 \u043D\u0430\u0442\u0440\u0438\u044F
    (\u043F\u0440\u043E\u0442\u043E\u043D-\u0434\u0432\u0438\u0436\u0443\u0449\u0430\u044F
    \u0441\u0438\u043B\u0430).\n- \u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C
    \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F \u043C\u043E\u0436\u0435\u0442
    \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0442\u044C 100 \u043E\u0431/\u0441.\n-
    \u041D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F
    \u043C\u043E\u0436\u0435\u0442 \u043C\u0435\u043D\u044F\u0442\u044C\u0441\u044F
    \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0431\u0438\u043D\u0430\u0440\u043D\u043E\u043C\u0443
    \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0442\u0435\u043B\u044E,
    \u0447\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u044F\u043C
    \u0438\u0437\u043C\u0435\u043D\u044F\u0442\u044C \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
    \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u0432 \u043E\u0442\u0432\u0435\u0442
    \u043D\u0430 \u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0441\u0438\u0433\u043D\u0430\u043B\u044B
    \u0438\u0437 \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0435\u0439 \u0441\u0440\u0435\u0434\u044B.\n-
    \u0415\u0441\u043B\u0438 \u0443 \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u0438
    \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0436\u0433\u0443\u0442\u0438\u043A\u043E\u0432,
    \u043E\u043D\u0438 \u043C\u043E\u0433\u0443\u0442 \u0441\u0438\u043D\u0445\u0440\u043E\u043D\u043D\u043E
    \u0432\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F, \u0441\u043F\u043B\u0435\u0442\u0430\u044F\u0441\u044C
    \u0432 \u0435\u0434\u0438\u043D\u044B\u0439 \u043F\u0443\u0447\u043E\u043A, \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0449\u0438\u0439
    \u043F\u0440\u043E\u043F\u0435\u043B\u043B\u0435\u0440.\n\u041A\u043B\u0430\u0441\u0441\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u044F
    \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u0439 \u043F\u043E \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u044E
    \u0438 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0443 \u0436\u0433\u0443\u0442\u0438\u043A\u043E\u0432:\n-
    \u041C\u043E\u043D\u043E\u0442\u0440\u0438\u0445\u0438 \u2014 \u0438\u043C\u0435\u044E\u0442
    \u043E\u0434\u0438\u043D \u0436\u0433\u0443\u0442\u0438\u043A (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u0445\u043E\u043B\u0435\u0440\u043D\u044B\u0439 \u0432\u0438\u0431\u0440\u0438\u043E\u043D).\n-
    \u041B\u043E\u0444\u043E\u0442\u0440\u0438\u0445\u0438 \u2014 \u043F\u0443\u0447\u043E\u043A
    \u0436\u0433\u0443\u0442\u0438\u043A\u043E\u0432 \u043D\u0430 \u043E\u0434\u043D\u043E\u043C
    \u043A\u043E\u043D\u0446\u0435 \u043A\u043B\u0435\u0442\u043A\u0438 (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u043A\u0430\u043C\u043F\u0438\u043B\u043E\u0431\u0430\u043A\u0442\u0435\u0440\u0438\u0438).\n-
    \u0410\u043C\u0444\u0438\u0442\u0440\u0438\u0445\u0438 \u2014 \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443
    \u0436\u0433\u0443\u0442\u0438\u043A\u0443 \u0438\u043B\u0438 \u043F\u0443\u0447\u043A\u0443
    \u0436\u0433\u0443\u0442\u0438\u043A\u043E\u0432 \u043D\u0430 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u043E\u043B\u043E\u0436\u043D\u044B\u0445
    \u043A\u043E\u043D\u0446\u0430\u0445 \u043A\u043B\u0435\u0442\u043A\u0438 (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u0441\u043F\u0438\u0440\u0438\u043B\u043B\u044B).\n- \u041F\u0435\u0440\u0438\u0442\u0440\u0438\u0445\u0438
    \u2014 \u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u0436\u0433\u0443\u0442\u0438\u043A\u043E\u0432, \u043F\u043E\u043A\u0440\u044B\u0432\u0430\u044E\u0449\u0438\u0445
    \u0432\u0441\u044E \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C
    \u043A\u043B\u0435\u0442\u043A\u0438 (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u043A\u0438\u0448\u0435\u0447\u043D\u0430\u044F \u043F\u0430\u043B\u043E\u0447\u043A\u0430).\n\u0416\u0433\u0443\u0442\u0438\u043A\u0438
    \u043C\u043E\u0436\u043D\u043E \u0432\u044B\u044F\u0432\u0438\u0442\u044C \u043F\u0440\u0438
    \u0441\u0432\u0435\u0442\u043E\u0432\u043E\u0439 \u043C\u0438\u043A\u0440\u043E\u0441\u043A\u043E\u043F\u0438\u0438
    \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0441\u043B\u0435 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043E\u043A\u0440\u0430\u0448\u0438\u0432\u0430\u043D\u0438\u044F (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u0441\u0435\u0440\u0435\u0431\u0440\u0435\u043D\u0438\u0435\u043C \u043F\u043E
    \u041C\u043E\u0440\u043E\u0437\u043E\u0432\u0443 \u0438\u043B\u0438 \u043E\u043A\u0440\u0430\u0441\u043A\u043E\u0439
    \u043F\u043E \u0413\u0440\u0435\u044E), \u0430 \u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435
    \u0447\u0451\u0442\u043A\u043E \u2014 \u043F\u0440\u0438 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u043E\u0439
    \u043C\u0438\u043A\u0440\u043E\u0441\u043A\u043E\u043F\u0438\u0438 \u0441 \u043D\u0430\u043F\u044B\u043B\u0435\u043D\u0438\u0435\u043C
    \u0442\u044F\u0436\u0451\u043B\u044B\u043C\u0438 \u043C\u0435\u0442\u0430\u043B\u043B\u0430\u043C\u0438"
  clip: {fileID: 0}
