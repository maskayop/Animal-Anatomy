  description: "\u041D\u0435\u043C\u0435\u043C\u0431\u0440\u0430\u043D\u043D\u044B\u0435
    \u043E\u0440\u0433\u0430\u043D\u0435\u043B\u043B\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u044E\u0442 \u0431\u0438\u043E\u0441\u0438\u043D\u0442\u0435\u0437
    \u0431\u0435\u043B\u043A\u0430 \u043D\u0430 \u044D\u0442\u0430\u043F\u0435 \u0442\u0440\u0430\u043D\u0441\u043B\u044F\u0446\u0438\u0438.
    \u041E\u043D\u0438 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442
    \u0441\u043E\u0431\u043E\u0439 \u0441\u043B\u043E\u0436\u043D\u044B\u0435 \u0440\u0438\u0431\u043E\u043D\u0443\u043A\u043B\u0435\u043E\u043F\u0440\u043E\u0442\u0435\u0438\u043D\u043E\u0432\u044B\u0435
    \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441\u044B, \u0441\u043E\u0441\u0442\u043E\u044F\u0449\u0438\u0435
    \u0438\u0437 \u0440\u0438\u0431\u043E\u0441\u043E\u043C\u0430\u043B\u044C\u043D\u043E\u0439
    \u0420\u041D\u041A (\u0440\u0420\u041D\u041A) \u0438 \u0440\u0438\u0431\u043E\u0441\u043E\u043C\u043D\u044B\u0445
    \u0431\u0435\u043B\u043A\u043E\u0432.\n\u0411\u0430\u043A\u0442\u0435\u0440\u0438\u0430\u043B\u044C\u043D\u044B\u0435
    \u0440\u0438\u0431\u043E\u0441\u043E\u043C\u044B \u0438\u043C\u0435\u044E\u0442
    \u0440\u0430\u0437\u043C\u0435\u0440 \u043E\u043A\u043E\u043B\u043E 15\u201320
    \u043D\u043C. \u041E\u043D\u0438 \u0441\u043E\u0441\u0442\u043E\u044F\u0442 \u0438\u0437
    \u0434\u0432\u0443\u0445 \u043D\u0435\u0440\u0430\u0432\u043D\u044B\u0445 \u0441\u0443\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0446:
    \u043C\u0430\u043B\u043E\u0439 (30S) \u0438 \u0431\u043E\u043B\u044C\u0448\u043E\u0439
    (50S). \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0430 \u0441\u0435\u0434\u0438\u043C\u0435\u043D\u0442\u0430\u0446\u0438\u0438
    (S) \u0434\u043B\u044F \u043F\u0440\u043E\u043A\u0430\u0440\u0438\u043E\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0440\u0438\u0431\u043E\u0441\u043E\u043C \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    70S.\n\u0421\u043E\u0441\u0442\u0430\u0432 \u0441\u0443\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0446:\n-
    \u041C\u0430\u043B\u0430\u044F \u0441\u0443\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0446\u0430
    \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442 \u043E\u0434\u043D\u0443 \u043C\u043E\u043B\u0435\u043A\u0443\u043B\u0443
    \u0440\u0420\u041D\u041A (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, 16S
    \u0440\u0420\u041D\u041A) \u0438 \u043E\u043A\u043E\u043B\u043E 20 \u0440\u0438\u0431\u043E\u0441\u043E\u043C\u043D\u044B\u0445
    \u0431\u0435\u043B\u043A\u043E\u0432. \u0415\u0451 \u043E\u0441\u043D\u043E\u0432\u043D\u0430\u044F
    \u0440\u043E\u043B\u044C \u2014 \u0434\u0435\u043A\u043E\u0434\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
    \u0442\u0440\u0438\u043F\u043B\u0435\u0442\u043D\u043E\u0433\u043E \u043A\u043E\u0434\u0430
    \u043C\u0420\u041D\u041A.\n- \u0411\u043E\u043B\u044C\u0448\u0430\u044F \u0441\u0443\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0446\u0430
    \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442 \u0434\u0432\u0435 \u043C\u043E\u043B\u0435\u043A\u0443\u043B\u044B
    \u0440\u0420\u041D\u041A (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, 23S
    \u0438 5S) \u0438 \u0431\u043E\u043B\u0435\u0435 30 \u0440\u0438\u0431\u043E\u0441\u043E\u043C\u043D\u044B\u0445
    \u0431\u0435\u043B\u043A\u043E\u0432. \u0415\u0451 \u043E\u0441\u043D\u043E\u0432\u043D\u0430\u044F
    \u0444\u0443\u043D\u043A\u0446\u0438\u044F \u2014 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u0435
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F \u043F\u0435\u043F\u0442\u0438\u0434\u043D\u043E\u0439
    \u0441\u0432\u044F\u0437\u0438 \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0441\u0438\u043D\u0442\u0435\u0437\u0430
    \u0431\u0435\u043B\u043A\u0430.\r\n\u0412 \u0441\u043E\u0441\u0442\u0430\u0432
    \u0440\u0438\u0431\u043E\u0441\u043E\u043C \u0432\u0445\u043E\u0434\u044F\u0442
    \u0438\u043E\u043D\u044B \u043C\u0430\u0433\u043D\u0438\u044F, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0442 \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0443
    \u0440\u0420\u041D\u041A. \u0418\u043D\u043E\u0433\u0434\u0430 \u0432\u044B\u0434\u0435\u043B\u044F\u044E\u0442
    \u0443\u0447\u0430\u0441\u0442\u043A\u0438 (\u0441\u0430\u0439\u0442\u044B) \u0432
    \u0440\u0438\u0431\u043E\u0441\u043E\u043C\u0435, \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0435
    \u0441 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0430\u043C\u0438 \u0442\u0440\u0430\u043D\u0441\u043B\u044F\u0446\u0438\u0438:\n-
    A-\u0443\u0447\u0430\u0441\u0442\u043E\u043A (\u0430\u043C\u0438\u043D\u043E\u0430\u0446\u0438\u043B\u044C\u043D\u044B\u0439)
    \u2014 \u043A\u0443\u0434\u0430 \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442
    \u043D\u043E\u0432\u044B\u0435 \u0430\u043C\u0438\u043D\u043E\u0430\u0446\u0438\u043B-\u0442\u0420\u041D\u041A;\n-
    P-\u0443\u0447\u0430\u0441\u0442\u043E\u043A (\u043F\u0435\u043F\u0442\u0438\u0434\u0438\u043B\u044C\u043D\u044B\u0439)
    \u2014 \u0433\u0434\u0435 \u0432 \u043C\u043E\u043C\u0435\u043D\u0442 \u043F\u0440\u0438\u0445\u043E\u0434\u0430
    \u043D\u043E\u0432\u043E\u0439 \u0430\u043C\u0438\u043D\u043E\u0430\u0446\u0438\u043B-\u0442\u0420\u041D\u041A
    \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0440\u0430\u0441\u0442\u0443\u0449\u0438\u0439
    \u043F\u0435\u043F\u0442\u0438\u0434;\n- E-\u0443\u0447\u0430\u0441\u0442\u043E\u043A
    \u2014 \u0447\u0435\u0440\u0435\u0437 \u043D\u0435\u0433\u043E \u043E\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u0432\u0448\u0430\u044F\u0441\u044F
    \u043E\u0442 \u0441\u0438\u043D\u0442\u0435\u0437\u0438\u0440\u0443\u0435\u043C\u043E\u0433\u043E
    \u043F\u043E\u043B\u0438\u043F\u0435\u043F\u0442\u0438\u0434\u0430 \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u043D\u0430\u044F
    \u0420\u041D\u041A \u043F\u043E\u043A\u0438\u0434\u0430\u0435\u0442 \u0440\u0438\u0431\u043E\u0441\u043E\u043C\u0443.\n\u0421\u0443\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0446\u044B
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B \u0440\u0430\u0437\u0434\u0435\u043B\u044F\u0442\u044C\u0441\u044F
    \u0438 \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u044F\u0442\u044C\u0441\u044F.
    \u0412 \u0446\u0438\u0442\u043E\u043F\u043B\u0430\u0437\u043C\u0435 \u043E\u043D\u0438
    \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044E\u0442 \u043A\u0430\u043A
    \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E, \u0442\u0430\u043A \u0438 \u0432\u043C\u0435\u0441\u0442\u0435.
    \u0414\u043B\u044F \u043D\u0430\u0447\u0430\u043B\u0430 \u0441\u0438\u043D\u0442\u0435\u0437\u0430
    \u0431\u0435\u043B\u043A\u0430 \u0441\u0443\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0446\u044B
    \u0434\u043E\u043B\u0436\u043D\u044B \u0431\u044B\u0442\u044C \u0440\u0430\u0437\u044A\u0435\u0434\u0438\u043D\u0435\u043D\u044B.
    \u041E\u0442\u0434\u0435\u043B\u044C\u043D\u0430\u044F \u043C\u0430\u043B\u0430\u044F
    \u0441\u0443\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0446\u0430 \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u0435\u0442
    \u043C\u0420\u041D\u041A \u0438 \u043D\u0430\u0445\u043E\u0434\u0438\u0442 \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u044B\u0439
    \u043A\u043E\u0434\u043E\u043D, \u0437\u0430\u0442\u0435\u043C \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0435\u0442\u0441\u044F
    \u0431\u043E\u043B\u044C\u0448\u0430\u044F \u0441\u0443\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0446\u0430,
    \u0438 \u0443\u0436\u0435 \u043F\u043E\u043B\u043D\u0430\u044F \u0440\u0438\u0431\u043E\u0441\u043E\u043C\u0430
    \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442 \u0431\u0438\u043E\u0441\u0438\u043D\u0442\u0435\u0437
    \u0431\u0435\u043B\u043A\u0430.\n\u0421\u043E\u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u0435
    \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u043E\u0432: \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E
    60% \u0420\u041D\u041A \u0438 40% \u0431\u0435\u043B\u043A\u0430.\n\u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u0432 \u043A\u043B\u0435\u0442\u043A\u0435: \u043E\u0442 1000 \u0434\u043E 100
    000 \u0440\u0438\u0431\u043E\u0441\u043E\u043C, \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438
    \u043E\u0442 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438 \u0440\u043E\u0441\u0442\u0430
    \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u0438.\n\u0420\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435:
    \u0431\u043E\u043B\u044C\u0448\u0430\u044F \u0447\u0430\u0441\u0442\u044C \u0440\u0438\u0431\u043E\u0441\u043E\u043C
    \u043F\u0440\u0438\u043B\u0435\u0433\u0430\u0435\u0442 \u043A \u0446\u0438\u0442\u043E\u043F\u043B\u0430\u0437\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043C\u0435\u043C\u0431\u0440\u0430\u043D\u0435, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
    \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u044B
    \u0432 \u0446\u0438\u0442\u043E\u043F\u043B\u0430\u0437\u043C\u0435.\n\u041F\u043E\u043B\u0438\u0441\u043E\u043C\u044B
    (\u043F\u043E\u043B\u0438\u0440\u0438\u0431\u043E\u0441\u043E\u043C\u044B) \u2014
    \u0430\u0433\u0440\u0435\u0433\u0430\u0442\u044B, \u0441\u043E\u0441\u0442\u043E\u044F\u0449\u0438\u0435
    \u0438\u0437 \u0438\u0420\u041D\u041A, \u0442\u0420\u041D\u041A \u0438 \u0440\u0438\u0431\u043E\u0441\u043E\u043C.
    \u041E\u043D\u0438 \u043C\u043E\u0433\u0443\u0442 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C\u0441\u044F
    \u0432 \u0446\u0438\u0442\u043E\u043F\u043B\u0430\u0437\u043C\u0435 \u0438\u043B\u0438
    \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u0442\u044C\u0441\u044F \u0441 \u043C\u0435\u043C\u0431\u0440\u0430\u043D\u043D\u044B\u043C\u0438
    \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0430\u043C\u0438.\n\u0424\u0443\u043D\u043A\u0446\u0438\u0438
    \u0440\u0438\u0431\u043E\u0441\u043E\u043C:\n- \u0434\u0435\u043A\u043E\u0434\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
    \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438 \u0441 \u043C\u0420\u041D\u041A;\n-
    \u043A\u0430\u0442\u0430\u043B\u0438\u0437 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F
    \u043F\u0435\u043F\u0442\u0438\u0434\u043D\u044B\u0445 \u0441\u0432\u044F\u0437\u0435\u0439
    \u043C\u0435\u0436\u0434\u0443 \u0430\u043C\u0438\u043D\u043E\u043A\u0438\u0441\u043B\u043E\u0442\u0430\u043C\u0438;\n-
    \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u0435 \u0442\u043E\u0447\u043D\u043E\u0433\u043E
    \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044F \u043C\u0435\u0436\u0434\u0443
    \u043A\u043E\u0434\u043E\u043D\u0430\u043C\u0438 \u043C\u0420\u041D\u041A \u0438
    \u0430\u043C\u0438\u043D\u043E\u043A\u0438\u0441\u043B\u043E\u0442\u0430\u043C\u0438.\n\u0418\u0437\u0443\u0447\u0435\u043D\u0438\u0435
    \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u044B \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u0430\u043B\u044C\u043D\u044B\u0445
    \u0440\u0438\u0431\u043E\u0441\u043E\u043C \u0438\u043C\u0435\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u043E\u0435
    \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u0434\u043B\u044F \u0431\u0438\u043E\u043B\u043E\u0433\u0438\u0438,
    \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u044B \u0438 \u0431\u0438\u043E\u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0438,
    \u0442\u0430\u043A \u043A\u0430\u043A \u0440\u0438\u0431\u043E\u0441\u043E\u043C\u044B
