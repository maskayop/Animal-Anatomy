  description: "\u0418\u043B\u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F:
    \u0444\u0438\u043C\u0431\u0440\u0438\u0438, \u0432\u043E\u0440\u0441\u0438\u043D\u043A\u0438.
    \u042D\u0442\u043E \u043D\u0438\u0442\u0435\u0432\u0438\u0434\u043D\u044B\u0435
    \u0431\u0435\u043B\u043A\u043E\u0432\u044B\u0435 \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u044B,
    \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0435
    \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
    \u043A\u043B\u0435\u0442\u043E\u043A \u043C\u043D\u043E\u0433\u0438\u0445 \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u0439.
    \u041E\u043D\u0438 \u0438\u0433\u0440\u0430\u044E\u0442 \u0432\u0430\u0436\u043D\u0443\u044E
    \u0440\u043E\u043B\u044C \u0432 \u0436\u0438\u0437\u043D\u0435\u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u0439, \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u044F
    \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0445
    \u0444\u0443\u043D\u043A\u0446\u0438\u0439.\n\u041F\u0438\u043B\u0438 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442
    \u0441\u043E\u0431\u043E\u0439 \u0442\u043E\u043D\u043A\u0438\u0435 \u043F\u043E\u043B\u044B\u0435
    \u043D\u0438\u0442\u0438 \u0431\u0435\u043B\u043A\u043E\u0432\u043E\u0439 \u043F\u0440\u0438\u0440\u043E\u0434\u044B.
    \u041E\u043D\u0438 \u0441\u043E\u0441\u0442\u043E\u044F\u0442 \u0438\u0437 \u043E\u0434\u043D\u043E\u0433\u043E
    \u0438\u043B\u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
    \u0442\u0438\u043F\u043E\u0432 \u0441\u043F\u0438\u0440\u0430\u043B\u044C\u043D\u043E
    \u0443\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0445 \u0431\u0435\u043B\u043A\u043E\u0432\u044B\u0445
    \u043C\u043E\u043B\u0435\u043A\u0443\u043B \u2014 \u043F\u0438\u043B\u0438\u043D\u043E\u0432
    \u0438\u043B\u0438 \u0444\u0438\u043C\u0431\u0440\u0438\u043D. \u0420\u0430\u0437\u043C\u0435\u0440
    \u043F\u0438\u043B\u0435\u0439 \u0432\u0430\u0440\u044C\u0438\u0440\u0443\u0435\u0442:
    \u0434\u043B\u0438\u043D\u0430 \u2014 \u043E\u0442 \u0434\u043E\u043B\u0435\u0439
    \u043C\u043A\u043C \u0434\u043E \u0431\u043E\u043B\u0435\u0435 \u0447\u0435\u043C
    20 \u043C\u043A\u043C, \u0434\u0438\u0430\u043C\u0435\u0442\u0440 \u2014 2\u201311
    \u043D\u043C.\n\u0427\u0430\u0441\u0442\u043E \u043D\u0430 \u043A\u043E\u043D\u0446\u0430\u0445
    \u043F\u0438\u043B\u0435\u0439 \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044E\u0442
    \u043E\u0441\u043E\u0431\u044B\u0435 \u043F\u0440\u0438\u043A\u0440\u0435\u043F\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u0441\u0443\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0446\u044B (\u0430\u0434\u0433\u0435\u0437\u0438\u043D\u044B),
    \u043D\u043E \u0438\u043D\u043E\u0433\u0434\u0430 \u0432\u0435\u0441\u044C \u043F\u0438\u043B\u044C
    \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u0430\u0434\u0433\u0435\u0437\u0438\u0432\u043D\u044B\u043C\u0438
    \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430\u043C\u0438. \u041E\u0447\u0435\u043D\u044C
    \u0442\u043E\u043D\u043A\u0438\u0435 \u043F\u0438\u043B\u0438 (\u0434\u0438\u0430\u043C\u0435\u0442\u0440\u043E\u043C
    \u043C\u0435\u043D\u0435\u0435 2 \u043D\u043C) \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442
    \xAB\u043A\u0443\u0434\u0440\u044F\u0448\u043A\u0430\u043C\u0438\xBB \u2014 \u043E\u043D\u0438
    \u0441\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u0432 \u043F\u0443\u0448\u0438\u0441\u0442\u0443\u044E
    \u043B\u0438\u043F\u043A\u0443\u044E \u043C\u0430\u0441\u0441\u0443 \u043D\u0430
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u043A\u043B\u0435\u0442\u043E\u043A,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442
    \u0438\u0445 \u0430\u0433\u0440\u0435\u0433\u0430\u0446\u0438\u044E.\n\u041F\u0438\u043B\u0438
    \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C \u043E\u0442 \u0442\u043E\u043D\u043A\u0438\u0445
    \u043D\u0438\u0442\u0435\u0432\u0438\u0434\u043D\u044B\u0445 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0439
    \u0434\u043E \u0442\u043E\u043B\u0441\u0442\u044B\u0445 \u043F\u0430\u043B\u043E\u0447\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0445
    \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440 \u0441 \u043E\u0441\u0435\u0432\u044B\u043C\u0438
    \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u044F\u043C\u0438. \u0427\u0430\u0441\u0442\u043E
    \u043E\u043D\u0438 \u0440\u0430\u0437\u0431\u0440\u043E\u0441\u0430\u043D\u044B
    \u043F\u043E \u0432\u0441\u0435\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
    \u043A\u043B\u0435\u0442\u043A\u0438, \u043D\u043E \u0438\u043D\u043E\u0433\u0434\u0430
    \u043B\u043E\u043A\u0430\u043B\u0438\u0437\u0443\u044E\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E
    \u043D\u0430 \u043E\u0434\u043D\u043E\u043C \u0435\u0451 \u043A\u043E\u043D\u0446\u0435.\n\u0424\u0443\u043D\u043A\u0446\u0438\u0438:\n-
    \u041F\u0440\u0438\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435 \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u0439
    \u043A \u0441\u0443\u0431\u0441\u0442\u0440\u0430\u0442\u0430\u043C \u0438 \u0434\u0440\u0443\u0433\u0438\u043C
    \u043A\u043B\u0435\u0442\u043A\u0430\u043C. \u041F\u0438\u043B\u0438 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0442
    \u0430\u0434\u0433\u0435\u0437\u0438\u044E \u2014 \u043F\u0440\u0438\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435
    \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u0439 \u043A \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044F\u043C
    (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u043A \u043A\u043B\u0435\u0442\u043A\u0430\u043C
    \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u0430-\u0445\u043E\u0437\u044F\u0438\u043D\u0430
    \u0438\u043B\u0438 \u0434\u0440\u0443\u0433\u0438\u043C \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u044F\u043C),
    \u0447\u0442\u043E \u0432\u0430\u0436\u043D\u043E \u0434\u043B\u044F \u043A\u043E\u043B\u043E\u043D\u0438\u0437\u0430\u0446\u0438\u0438,
    \u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F \u0431\u0438\u043E\u043F\u043B\u0451\u043D\u043E\u043A
    \u0438 \u043F\u0440\u043E\u043D\u0438\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u044F
    \u043F\u0430\u0442\u043E\u0433\u0435\u043D\u043D\u044B\u0445 \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u0439
    \u0432 \u043A\u043B\u0435\u0442\u043A\u0438 \u0445\u043E\u0437\u044F\u0438\u043D\u0430.\n-
    \u041F\u0435\u0440\u0435\u0434\u0430\u0447\u0430 \u0433\u0435\u043D\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430 \u043C\u0435\u0436\u0434\u0443
    \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u044F\u043C\u0438 (\u043A\u043E\u043D\u044A\u044E\u0433\u0430\u0446\u0438\u044F).
    \u041F\u043E\u043B\u043E\u0432\u044B\u0435 (\u043A\u043E\u043D\u044A\u044E\u0433\u0430\u0442\u0438\u0432\u043D\u044B\u0435)
    \u043F\u0438\u043B\u0438 \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u044E\u0442
    \u0432 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0435 \u0447\u0430\u0441\u0442\u0438
    \u0433\u0435\u043D\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430 \u043E\u0442 \u0434\u043E\u043D\u043E\u0440\u0441\u043A\u043E\u0439
    \u043A\u043B\u0435\u0442\u043A\u0438 \u043A \u0440\u0435\u0446\u0438\u043F\u0438\u0435\u043D\u0442\u043D\u043E\u0439.
    \u042D\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u044F\u043C
    \u0431\u044B\u0441\u0442\u0440\u043E \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u0442\u0430\u0442\u044C
    \u043D\u043E\u0432\u044B\u0435 \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430,
    \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440 \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0441\u0442\u044C
    \u043A \u0430\u043D\u0442\u0438\u0431\u0438\u043E\u0442\u0438\u043A\u0430\u043C.\n-
    \u0410\u0434\u0430\u043F\u0442\u0430\u0446\u0438\u044F \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u043E\u0432.
    \u041F\u0438\u043B\u0438 \u0441\u043B\u0443\u0436\u0430\u0442 \u043C\u0435\u0441\u0442\u0430\u043C\u0438
    \u043F\u0440\u0438\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u044F \u043C\u043D\u043E\u0433\u0438\u0445
    \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u043E\u0444\u0430\u0433\u043E\u0432.\n-
    \u0423\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435 \u043F\u043B\u043E\u0449\u0430\u0434\u0438
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u043A\u043B\u0435\u0442\u043A\u0438,
    \u0447\u0442\u043E \u0434\u0430\u0451\u0442 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0430 \u0432
    \u0443\u0442\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u0438 \u043F\u0438\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432 \u0438\u0437 \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0435\u0439
    \u0441\u0440\u0435\u0434\u044B.\n\u041F\u043E \u0444\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u043C\u0443
    \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044E \u043F\u0438\u043B\u0438
    \u043F\u043E\u0434\u0440\u0430\u0437\u0434\u0435\u043B\u044F\u044E\u0442 \u043D\u0430
    \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0442\u0438\u043F\u043E\u0432:\n-
    \u041F\u0438\u043B\u0438 1-\u0433\u043E \u0442\u0438\u043F\u0430 (\u043E\u0431\u0449\u0435\u0433\u043E
    \u0442\u0438\u043F\u0430, common pili). \u041E\u0442\u0432\u0435\u0447\u0430\u044E\u0442
    \u0437\u0430 \u0430\u0434\u0433\u0435\u0437\u0438\u044E \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u0439
    \u043A \u043F\u043E\u0440\u0430\u0436\u0430\u0435\u043C\u043E\u0439 \u043A\u043B\u0435\u0442\u043A\u0435.
    \u041D\u0430\u0447\u0438\u043D\u0430\u044E\u0442\u0441\u044F \u043D\u0430 \u0446\u0438\u0442\u043E\u043F\u043B\u0430\u0437\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043C\u0435\u043C\u0431\u0440\u0430\u043D\u0435 \u0438 \u043F\u0440\u043E\u043D\u0438\u0437\u044B\u0432\u0430\u044E\u0442
    \u043A\u043B\u0435\u0442\u043E\u0447\u043D\u0443\u044E \u0441\u0442\u0435\u043D\u043A\u0443.
    \u0418\u0445 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0432\u0435\u043B\u0438\u043A\u043E
    \u2014 \u043E\u0442 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
    \u0441\u043E\u0442\u0435\u043D \u0434\u043E \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
    \u0442\u044B\u0441\u044F\u0447 \u043D\u0430 \u043E\u0434\u043D\u0443 \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u0430\u043B\u044C\u043D\u0443\u044E
    \u043A\u043B\u0435\u0442\u043A\u0443.\n- \u041F\u0438\u043B\u0438 2-\u0433\u043E
    \u0442\u0438\u043F\u0430 (\u043F\u043E\u043B\u043E\u0432\u044B\u0435, F-\u043F\u0438\u043B\u0438,
    \u043A\u043E\u043D\u044A\u044E\u0433\u0430\u0442\u0438\u0432\u043D\u044B\u0435,
    sex pili). \u0423\u0447\u0430\u0441\u0442\u0432\u0443\u044E\u0442 \u0432 \u043A\u043E\u043D\u044A\u044E\u0433\u0430\u0446\u0438\u0438
    \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u0439. \u0418\u043C\u0435\u044E\u0442
    \u0442\u043E\u043B\u044C\u043A\u043E \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u0438-\u0434\u043E\u043D\u043E\u0440\u044B
    \u0432 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u043E\u043C
    \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0435 (1\u20134 \u043D\u0430
    \u043A\u043B\u0435\u0442\u043A\u0443), \u0431\u043E\u043B\u0435\u0435 \u0434\u043B\u0438\u043D\u043D\u044B\u0435
    (0,5\u201310 \u043C\u043A\u043C). \u041E\u0442\u043B\u0438\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
    \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u044C \u2014  \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435
    \u0441 \u043E\u0441\u043E\u0431\u044B\u043C\u0438 \xAB\u043C\u0443\u0436\u0441\u043A\u0438\u043C\u0438\xBB
    \u0441\u0444\u0435\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u043E\u0444\u0430\u0433\u0430\u043C\u0438,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0430\u0434\u0441\u043E\u0440\u0431\u0438\u0440\u0443\u044E\u0442\u0441\u044F
    \u043D\u0430 \u043F\u043E\u043B\u043E\u0432\u044B\u0445 \u043F\u0438\u043B\u044F\u0445.\n\u0422\u0430\u043A\u0436\u0435
    \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u043A\u043B\u0430\u0441\u0441\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u044F
    \u043F\u043E \u0434\u0440\u0443\u0433\u0438\u043C \u043A\u0440\u0438\u0442\u0435\u0440\u0438\u044F\u043C,
    \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u043D\u0430 \u043F\u0438\u043B\u0438
    \u0433\u043B\u0430\u0432\u043D\u043E\u0433\u043E \u0442\u0438\u043F\u0430 \u0438
    \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u043D\u043E\u0433\u043E
