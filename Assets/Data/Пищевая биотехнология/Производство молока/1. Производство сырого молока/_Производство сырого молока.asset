  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u041F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u043E
    \u0441\u044B\u0440\u043E\u0433\u043E \u043C\u043E\u043B\u043E\u043A\u0430"
  scientificName: 
  nameClip: {fileID: 0}
  description: "\u0417\u0434\u0435\u0441\u044C \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0442\u0441\u044F
    \u0434\u043E\u0439\u043D\u044B\u0435 \u043A\u043E\u0440\u043E\u0432\u044B, \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
    \u0434\u043E\u0435\u043D\u0438\u0435 \u0438 \u043F\u0435\u0440\u0432\u0438\u0447\u043D\u0430\u044F
    \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0430 \u043C\u043E\u043B\u043E\u043A\u0430.
    \u041A\u0430\u0447\u0435\u0441\u0442\u0432\u043E \u0441\u044B\u0440\u043E\u0433\u043E
    \u043C\u043E\u043B\u043E\u043A\u0430 \u0437\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u0438\u043C\u0435\u043D\u043D\u043E \u043D\u0430 \u044D\u0442\u043E\u043C \u044D\u0442\u0430\u043F\u0435:
    \u043E\u0442 \u043A\u043E\u0440\u043C\u043B\u0435\u043D\u0438\u044F, \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F
    \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445 \u0438 \u0433\u0438\u0433\u0438\u0435\u043D\u044B
    \u0434\u043E\u0435\u043D\u0438\u044F. \u0421 \u0444\u0435\u0440\u043C\u044B \u043C\u043E\u043B\u043E\u043A\u043E
    \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043D\u0430
    \u0437\u0430\u0432\u043E\u0434 \u0432 \u043E\u0445\u043B\u0430\u0436\u0434\u0451\u043D\u043D\u043E\u043C
    \u0432\u0438\u0434\u0435 (4\u20136\xB0C) \u0432 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445
    \u0446\u0438\u0441\u0442\u0435\u0440\u043D\u0430\u0445"
  clip: {fileID: 0}
