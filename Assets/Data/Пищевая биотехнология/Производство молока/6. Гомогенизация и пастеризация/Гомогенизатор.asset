  m_Name: "\u0413\u043E\u043C\u043E\u0433\u0435\u043D\u0438\u0437\u0430\u0442\u043E\u0440"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0413\u043E\u043C\u043E\u0433\u0435\u043D\u0438\u0437\u0430\u0442\u043E\u0440"
  scientificName: 
  nameClip: {fileID: 0}
  description: "\u041F\u043B\u0443\u043D\u0436\u0435\u0440\u043D\u044B\u0439 \u043D\u0430\u0441\u043E\u0441
    \u0432\u044B\u0441\u043E\u043A\u043E\u0433\u043E \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F
    (10\u201315 \u041C\u041F\u0430), \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u0440\u043E\u0434\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
    \u043C\u043E\u043B\u043E\u043A\u043E \u0447\u0435\u0440\u0435\u0437 \u0443\u0437\u043A\u0443\u044E
    \u0449\u0435\u043B\u044C (\u043A\u043B\u0430\u043F\u0430\u043D). \u041D\u0430
    \u0432\u044B\u0445\u043E\u0434\u0435 \u0436\u0438\u0440\u043E\u0432\u044B\u0435
    \u0448\u0430\u0440\u0438\u043A\u0438 \u0440\u0430\u0437\u0431\u0438\u0432\u0430\u044E\u0442\u0441\u044F
    \u0441 3\u20134 \u043C\u0438\u043A\u0440\u043E\u043D \u0434\u043E 0,5\u20131
    \u043C\u0438\u043A\u0440\u043E\u043D\u0430. \u0412 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435
    \u043C\u043E\u043B\u043E\u043A\u043E \u043D\u0435 \u0440\u0430\u0441\u0441\u043B\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
    \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0431\u043E\u043B\u0435\u0435
    \u0431\u0435\u043B\u044B\u043C \u0438 \u043E\u0434\u043D\u043E\u0440\u043E\u0434\u043D\u044B\u043C,
    \u0443\u043B\u0443\u0447\u0448\u0430\u0435\u0442\u0441\u044F \u0435\u0433\u043E
    \u0432\u043A\u0443\u0441 \u0438 \u0443\u0441\u0432\u043E\u044F\u0435\u043C\u043E\u0441\u0442\u044C.
    \u0411\u0435\u0437 \u0433\u043E\u043C\u043E\u0433\u0435\u043D\u0438\u0437\u0430\u0446\u0438\u0438
    \u0441\u043B\u0438\u0432\u043A\u0438 \u0431\u044B\u0441\u0442\u0440\u043E \u0432\u0441\u043F\u043B\u044B\u0432\u0430\u043B\u0438
    \u0431\u044B \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C"
  clip: {fileID: 0}
