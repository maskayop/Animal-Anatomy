  m_Name: "_\u0421\u043A\u0435\u043B\u0435\u0442 \u043F\u0440\u0435\u0434\u043F\u043B\u0435\u0447\u044C\u044F"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0421\u043A\u0435\u043B\u0435\u0442 \u043F\u0440\u0435\u0434\u043F\u043B\u0435\u0447\u044C\u044F"
  scientificName: skeleton antebrachii
  description: "\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D
    \u043B\u0443\u0447\u0435\u0432\u043E\u0439 \u0438 \u043B\u043E\u043A\u0442\u0435\u0432\u043E\u0439
    \u043A\u043E\u0441\u0442\u044F\u043C\u0438, \u0438\u0437 \u043A\u043E\u0442\u043E\u0440\u044B\u0445
    \u043F\u0435\u0440\u0432\u0430\u044F \u0443 \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u0430
    \u043C\u043B\u0435\u043A\u043E\u043F\u0438\u0442\u0430\u044E\u0449\u0438\u0445
    \u0431\u043E\u043B\u0435\u0435 \u043C\u0430\u0441\u0441\u0438\u0432\u043D\u0430,
    \u043D\u043E \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u043A\u043E\u0440\u043E\u0447\u0435 \u0432\u0442\u043E\u0440\u043E\u0439. \u0423
    \u043A\u043E\u0440\u043E\u0432\u044B \u043B\u0443\u0447\u0435\u0432\u0430\u044F
    \u0438 \u043B\u043E\u043A\u0442\u0435\u0432\u0430\u044F \u043A\u043E\u0441\u0442\u0438
    \u043F\u0440\u0435\u0434\u043F\u043B\u0435\u0447\u044C\u044F \u0441\u0440\u043E\u0441\u0448\u0438\u0435\u0441\u044F.
    \u041C\u0435\u0436\u0434\u0443 \u043D\u0438\u043C\u0438 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
    \u043A\u043E\u0441\u0442\u043D\u0430\u044F \u0442\u043A\u0430\u043D\u044C, \u0437\u0430
    \u0441\u0447\u0451\u0442 \u0447\u0435\u0433\u043E \u043A\u043E\u0441\u0442\u0438
    \u043F\u043B\u043E\u0442\u043D\u043E \u0441\u0432\u044F\u0437\u0430\u043D\u044B
    \u0434\u0440\u0443\u0433 \u0441 \u0434\u0440\u0443\u0433\u043E\u043C. \u0421\u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442\u0441\u044F
    \u0442\u043E\u043B\u044C\u043A\u043E \u0449\u0435\u043B\u0438 \u043C\u0435\u0436\u0434\u0443
    \u0438\u0445 \u0442\u0435\u043B\u0430\u043C\u0438, \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044B\u0435
    \u0434\u043B\u044F \u0441\u043E\u0441\u0443\u0434\u043E\u0432 \u0438 \u043D\u0435\u0440\u0432\u043E\u0432
    \u2014 \u043C\u0435\u0436\u043A\u043E\u0441\u0442\u043D\u043E\u0435 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E"
