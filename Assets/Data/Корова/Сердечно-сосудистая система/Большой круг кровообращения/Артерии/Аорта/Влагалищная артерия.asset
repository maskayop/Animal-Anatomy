  m_Name: "\u0412\u043B\u0430\u0433\u0430\u043B\u0438\u0449\u043D\u0430\u044F \u0430\u0440\u0442\u0435\u0440\u0438\u044F"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0412\u043B\u0430\u0433\u0430\u043B\u0438\u0449\u043D\u0430\u044F
    \u0430\u0440\u0442\u0435\u0440\u0438\u044F"
  scientificName: arteria vaginalis
  description: "\u041A\u0440\u043E\u0432\u043E\u0441\u043D\u0430\u0431\u0436\u0430\u0435\u0442
    \u0432\u043B\u0430\u0433\u0430\u043B\u0438\u0449\u0435, \u0442\u0435\u043B\u043E
    \u0438 \u0448\u0435\u0439\u043A\u0443 \u043C\u0430\u0442\u043A\u0438 (\u043C\u0430\u0442\u043E\u0447\u043D\u0430\u044F
    \u0432\u0435\u0442\u0432\u044C - ramus uterinus); \u043E\u0442\u0434\u0430\u0451\u0442
    \u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u0443\u044E \u043F\u0443\u0437\u044B\u0440\u043D\u0443\u044E
    \u0430\u0440\u0442\u0435\u0440\u0438\u044E - a. vesicalis caudalis - \u0434\u043B\u044F
    \u0448\u0435\u0439\u043A\u0438 \u043C\u043E\u0447\u0435\u0432\u043E\u0433\u043E
    \u043F\u0443\u0437\u044B\u0440\u044F \u0438 \u0441\u0440\u0435\u0434\u043D\u044E\u044E
    \u0430\u0440\u0442\u0435\u0440\u0438\u044E \u043F\u0440\u044F\u043C\u043E\u0439
    \u043A\u0438\u0448\u043A\u0438 - a. rectalis media - \u0440\u0430\u0437\u0432\u0435\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0432 \u0441\u0442\u0435\u043D\u043A\u0435 \u043F\u0440\u044F\u043C\u043E\u0439
    \u043A\u0438\u0448\u043A\u0438"
  clip: {fileID: 0}
