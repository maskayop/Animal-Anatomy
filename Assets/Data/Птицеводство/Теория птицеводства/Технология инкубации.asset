  m_Script: {fileID: 11500000, guid: 3f00395bd4580c04eb5d722a11c9666a, type: 3}
  m_Name: "\u0422\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u044F \u0438\u043D\u043A\u0443\u0431\u0430\u0446\u0438\u0438"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0422\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u044F \u0438\u043D\u043A\u0443\u0431\u0430\u0446\u0438\u0438"
  scientificName: 
  nameClip: {fileID: 0}
  description: "\u041F\u0440\u043E\u0446\u0435\u0441\u0441 \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u044F \u0441\u0443\u0442\u043E\u0447\u043D\u043E\u0433\u043E \u043C\u043E\u043B\u043E\u0434\u043D\u044F\u043A\u0430 \u0438\u0437 \u0438\u043D\u043A\u0443\u0431\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0433\u043E \u044F\u0439\u0446\u0430 \u0432 \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445. \u0418\u043D\u043A\u0443\u0431\u0430\u0442\u043E\u0440\u0438\u0439 \u2014 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435 \u043F\u043E\u0434\u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u0435, \u0433\u0434\u0435 \u0438\u043D\u043A\u0443\u0431\u0438\u0440\u0443\u044E\u0442 \u044F\u0439\u0446\u0430; \u0432 \u0435\u0433\u043E \u0441\u043E\u0441\u0442\u0430\u0432 \u0432\u0445\u043E\u0434\u044F\u0442 \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0438\u0435 \u0438\u043D\u043A\u0443\u0431\u0430\u0442\u043E\u0440\u043E\u0432, \u0432\u044B\u0432\u043E\u0434\u043D\u044B\u0435 \u0448\u043A\u0430\u0444\u044B, \u043C\u043E\u0435\u0447\u043D\u0430\u044F, \u0441\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u043E\u0447\u043D\u0430\u044F \u0438 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0435 \u0434\u043B\u044F \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u044F\u0438\u0446.\n\u041A\u043B\u044E\u0447\u0435\u0432\u044B\u0435 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B \u0440\u0435\u0436\u0438\u043C\u0430 \u0438\u043D\u043A\u0443\u0431\u0430\u0446\u0438\u0438:\n- \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u2014 \u043E\u043F\u0442\u0438\u043C\u0430\u043B\u044C\u043D\u043E 37,5\u201337,7 \xB0C (\u044D\u043C\u0431\u0440\u0438\u043E\u043D \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0442\u044C\u0441\u044F \u043F\u0440\u0438 27\u201343 \xB0C);\n- \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u0432\u043B\u0430\u0436\u043D\u043E\u0441\u0442\u044C \u2014 50\u201360% \u0432 \u0438\u043D\u043A\u0443\u0431\u0430\u0446\u0438\u0438, 68\u201372% \u0432 \u043F\u0435\u0440\u0438\u043E\u0434 \u0432\u044B\u0432\u043E\u0434\u0430;\n- \u0432\u0435\u043D\u0442\u0438\u043B\u044F\u0446\u0438\u044F \u2014 \u043F\u0440\u0438\u0442\u043E\u043A \u043A\u0438\u0441\u043B\u043E\u0440\u043E\u0434\u0430 \u0438 \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u0435 \u0443\u0433\u043B\u0435\u043A\u0438\u0441\u043B\u043E\u0433\u043E \u0433\u0430\u0437\u0430 (\u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u043A \u043A\u0438\u0441\u043B\u043E\u0440\u043E\u0434\u0430 \u0432\u044B\u0437\u044B\u0432\u0430\u0435\u0442 \u0443\u0440\u043E\u0434\u0441\u0442\u0432\u0430 \u0438 \u0433\u0438\u0431\u0435\u043B\u044C \u0437\u0430\u0440\u043E\u0434\u044B\u0448\u0435\u0439);\n- \u043F\u043E\u0432\u043E\u0440\u043E\u0442 \u044F\u0438\u0446 \u2014 \u043A\u0430\u0436\u0434\u044B\u0435 1\u20132 \u0447\u0430\u0441\u0430 \u0434\u043E \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0430 \u043D\u0430 \u0432\u044B\u0432\u043E\u0434.\n\u0421\u0440\u043E\u043A\u0438 \u0432\u044B\u0432\u043E\u0434\u0430: \u043A\u0443\u0440 \u044F\u0438\u0447\u043D\u044B\u0445 \u043F\u043E\u0440\u043E\u0434 \u2014 \u043A \u043A\u043E\u043D\u0446\u0443 21 \u0441\u0443\u0442\u043E\u043A, \u043C\u044F\u0441\u043D\u044B\u0445 \u2014 21,5 \u0441\u0443\u0442\u043E\u043A.\n\u0422\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0440\u043E\u0446\u0435\u0441\u0441 \u0438\u0434\u0451\u0442 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E \u043D\u0435\u043F\u0435\u0440\u0435\u0441\u0435\u043A\u0430\u044E\u0449\u0438\u0445\u0441\u044F \u043F\u043E\u0442\u043E\u043A\u043E\u0432: \u043F\u0440\u0438\u0451\u043C \u0438 \u0441\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u043A\u0430 \u044F\u0438\u0446, \u043E\u0432\u043E\u0441\u043A\u043E\u043F\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435, \u0434\u0435\u0437\u0438\u043D\u0444\u0435\u043A\u0446\u0438\u044F, \u0437\u0430\u043A\u043B\u0430\u0434\u043A\u0430 \u0432 \u0438\u043D\u043A\u0443\u0431\u0430\u0442\u043E\u0440\u044B, \u043F\u0435\u0440\u0435\u043D\u043E\u0441 \u043D\u0430 \u0432\u044B\u0432\u043E\u0434 \u043D\u0430 19\u201320-\u0435 \u0441\u0443\u0442\u043A\u0438, \u0432\u044B\u0431\u043E\u0440\u043A\u0430 \u0438 \u0441\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u043A\u0430 \u0446\u044B\u043F\u043B\u044F\u0442"
  clip: {fileID: 0}
