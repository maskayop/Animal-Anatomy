  m_Name: "\u041A\u043E\u0440\u043C\u043B\u0435\u043D\u0438\u0435 \u0446\u044B\u043F\u043B\u044F\u0442-\u0431\u0440\u043E\u0439\u043B\u0435\u0440\u043E\u0432"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u041A\u043E\u0440\u043C\u043B\u0435\u043D\u0438\u0435 \u0446\u044B\u043F\u043B\u044F\u0442-\u0431\u0440\u043E\u0439\u043B\u0435\u0440\u043E\u0432"
  scientificName: 
  nameClip: {fileID: 0}
  description: "\u041E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u044F \u043F\u0438\u0442\u0430\u043D\u0438\u044F \u043C\u044F\u0441\u043D\u043E\u0439 \u043F\u0442\u0438\u0446\u044B, \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u0430\u044F \u043D\u0430 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E \u0431\u044B\u0441\u0442\u0440\u044B\u0439 \u043F\u0440\u0438\u0440\u043E\u0441\u0442 \u0436\u0438\u0432\u043E\u0439 \u043C\u0430\u0441\u0441\u044B \u043F\u0440\u0438 \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0445 \u0437\u0430\u0442\u0440\u0430\u0442\u0430\u0445 \u043A\u043E\u0440\u043C\u0430. \u0426\u044B\u043F\u043B\u044F\u0442\u0430-\u0431\u0440\u043E\u0439\u043B\u0435\u0440\u044B \u043E\u0431\u043B\u0430\u0434\u0430\u044E\u0442 \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E\u0441\u0442\u044C\u044E \u0440\u043E\u0441\u0442\u0430, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0438\u0445 \u0441 \u043F\u0435\u0440\u0432\u044B\u0445 \u0434\u043D\u0435\u0439 \u0436\u0438\u0437\u043D\u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u043A\u043E\u0440\u043C\u0438\u0442\u044C \u043F\u043E\u043B\u043D\u043E\u0440\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u043C\u0438 \u043A\u043E\u043C\u0431\u0438\u043A\u043E\u0440\u043C\u0430\u043C\u0438, \u0441\u0431\u0430\u043B\u0430\u043D\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C\u0438 \u043F\u043E \u0432\u0441\u0435\u043C \u043F\u0438\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430\u043C.\n\u041F\u0435\u0440\u0438\u043E\u0434\u044B \u043A\u043E\u0440\u043C\u043B\u0435\u043D\u0438\u044F:\n- \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u044B\u0439 \u2014 \u0434\u043E 10 \u0441\u0443\u0442\u043E\u043A;\n- \u0440\u043E\u0441\u0442\u043E\u0432\u043E\u0439 \u2014 11\u201322 \u0441\u0443\u0442\u043E\u043A;\n- \u0444\u0438\u043D\u0438\u0448\u043D\u044B\u0439 \u2014 \u043F\u0435\u0440\u0432\u044B\u0439 (23\u201339 \u0441\u0443\u0442\u043E\u043A) \u0438 \u0432\u0442\u043E\u0440\u043E\u0439 (\u0441 40 \u0441\u0443\u0442\u043E\u043A \u0438 \u0441\u0442\u0430\u0440\u0448\u0435).\n\u0421\u0442\u0430\u0440\u0442\u043E\u0432\u044B\u0439 \u043F\u0435\u0440\u0438\u043E\u0434. \u0412 \u043A\u043E\u043C\u0431\u0438\u043A\u043E\u0440\u043C\u0430 \u0432\u043A\u043B\u044E\u0447\u0430\u044E\u0442 \u043B\u0435\u0433\u043A\u043E\u043F\u0435\u0440\u0435\u0432\u0430\u0440\u0438\u043C\u044B\u0435 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u044B: \u043A\u0443\u043A\u0443\u0440\u0443\u0437\u0443, \u043F\u0448\u0435\u043D\u0438\u0446\u0443, \u0441\u043E\u0435\u0432\u044B\u0439 \u0448\u0440\u043E\u0442, \u043F\u043E\u043B\u0443\u043E\u0431\u0435\u0437\u0436\u0438\u0440\u0435\u043D\u043D\u0443\u044E \u0441\u043E\u0435\u0432\u0443\u044E \u043C\u0443\u043A\u0443, \u0431\u0435\u043B\u044B\u0439 \u043B\u044E\u043F\u0438\u043D \u0438 \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0430\u0442\u044B \u043D\u0430 \u0435\u0433\u043E \u043E\u0441\u043D\u043E\u0432\u0435, \u0440\u044B\u0431\u043D\u0443\u044E \u043C\u0443\u043A\u0443, \u043A\u0443\u043A\u0443\u0440\u0443\u0437\u043D\u044B\u0439 \u0433\u043B\u044E\u0442\u0435\u043D. \u0421\u0443\u0442\u043E\u0447\u043D\u044B\u0445 \u0446\u044B\u043F\u043B\u044F\u0442 \u043A\u043E\u0440\u043C\u044F\u0442 \u0441\u0440\u0430\u0437\u0443 \u043F\u043E\u0441\u043B\u0435 \u043F\u043E\u0441\u0430\u0434\u043A\u0438 \u0432 \u043F\u0442\u0438\u0447\u043D\u0438\u043A, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043A\u043E\u0440\u043C \u0438 \u0441\u0432\u0435\u0436\u0443\u044E \u0432\u043E\u0434\u0443 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u043E\u0439 20\u201322 \xB0C \u0433\u043E\u0442\u043E\u0432\u044F\u0442 \u0437\u0430\u0440\u0430\u043D\u0435\u0435.\n\u041F\u043E\u0435\u0434\u0430\u0435\u043C\u043E\u0441\u0442\u044C. \u0421\u0442\u0430\u0440\u0442\u043E\u0432\u043E\u0433\u043E \u043A\u043E\u0440\u043C\u0430 \u0437\u0430 \u0434\u0435\u0441\u044F\u0442\u044C \u0434\u043D\u0435\u0439 \u043F\u0442\u0438\u0446\u0430 \u0434\u043E\u043B\u0436\u043D\u0430 \u0441\u044A\u0435\u0441\u0442\u044C \u043D\u0435 \u043C\u0435\u043D\u0435\u0435 250 \u0433. \u0420\u043E\u0441\u0442\u043E\u0432\u043E\u0433\u043E \u043A\u043E\u0440\u043C\u0430 \u0432 \u043F\u0435\u0440\u0438\u043E\u0434 \u0441 11 \u043F\u043E 22 \u0434\u0435\u043D\u044C \u2014 \u043D\u0435 \u043C\u0435\u043D\u0435\u0435 1000 \u0433. \u041F\u0440\u0438\u0440\u043E\u0441\u0442 \u0436\u0438\u0432\u043E\u0439 \u043C\u0430\u0441\u0441\u044B \u0431\u0440\u043E\u0439\u043B\u0435\u0440\u043E\u0432 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0432 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u043C \u0437\u0430 \u0441\u0447\u0451\u0442 \u0431\u0435\u043B\u043A\u0430, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B \u0440\u0430\u0446\u0438\u043E\u043D\u044B \u0441 \u0432\u044B\u0441\u043E\u043A\u0438\u043C \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435\u043C \u0431\u0438\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438 \u043F\u043E\u043B\u043D\u043E\u0446\u0435\u043D\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0442\u0435\u0438\u043D\u0430. \u0418\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430\u043C\u0438 \u043F\u0440\u043E\u0442\u0435\u0438\u043D\u0430 \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435 \u043A\u043E\u0440\u043C\u0430 \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0433\u043E \u0438 \u0440\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F.\n\u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044C. \u0421\u043B\u0435\u0434\u044F\u0442 \u0437\u0430 \u043F\u043E\u0435\u0434\u0430\u0435\u043C\u043E\u0441\u0442\u044C\u044E \u043A\u043E\u0440\u043C\u0430 \u0438 \u043F\u0440\u0438\u0440\u043E\u0441\u0442\u043E\u043C \u043C\u0430\u0441\u0441\u044B: \u043F\u0440\u0438 \u043E\u0442\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u044F\u0445 \u043A\u043E\u0440\u0440\u0435\u043A\u0442\u0438\u0440\u0443\u044E\u0442 \u0440\u0430\u0446\u0438\u043E\u043D \u0438\u043B\u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u044F \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u044F. \u041F\u0435\u0440\u0435\u043A\u043E\u0440\u043C \u0432\u0435\u0434\u0451\u0442 \u043A \u043E\u0436\u0438\u0440\u0435\u043D\u0438\u044E \u0438 \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u044E \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430 \u0442\u0443\u0448\u043A\u0438, \u043D\u0435\u0434\u043E\u043A\u043E\u0440\u043C \u2014 \u043A \u043F\u0430\u0434\u0435\u043D\u0438\u044E \u043F\u0440\u0438\u0440\u043E\u0441\u0442\u0430"
