  m_Name: "\u041F\u043E\u0440\u043E\u0434\u044B \u043A\u0443\u0440"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u041F\u043E\u0440\u043E\u0434\u044B \u043A\u0443\u0440"
  scientificName: 
  nameClip: {fileID: 0}
  description: "\u041F\u043E\u0440\u043E\u0434\u0430 \u2014 \u044D\u0442\u043E \u0433\u0440\u0443\u043F\u043F\u0430 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E \u043E\u0442 \u043E\u0445\u0440\u0430\u043D\u043E\u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u0433\u0435\u043D\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u043E\u0431\u0443\u0441\u043B\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u043C\u0438 \u0431\u0438\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u0438 \u043C\u043E\u0440\u0444\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438 \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430\u043C\u0438 \u0438 \u043F\u0440\u0438\u0437\u043D\u0430\u043A\u0430\u043C\u0438, \u043F\u0440\u0438\u0447\u0451\u043C \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0438\u0437 \u043D\u0438\u0445 \u0441\u043F\u0435\u0446\u0438\u0444\u0438\u0447\u043D\u044B \u0434\u043B\u044F \u0434\u0430\u043D\u043D\u043E\u0439 \u0433\u0440\u0443\u043F\u043F\u044B \u0438 \u043E\u0442\u043B\u0438\u0447\u0430\u044E\u0442 \u0435\u0451 \u043E\u0442 \u0434\u0440\u0443\u0433\u0438\u0445 \u0433\u0440\u0443\u043F\u043F.\n\u041E\u0441\u043D\u043E\u0432\u043D\u044B\u0435 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u0438 \u043F\u043E\u0440\u043E\u0434\u044B: \u043E\u0431\u0449\u043D\u043E\u0441\u0442\u044C \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F, \u0441\u0445\u043E\u0434\u0441\u0442\u0432\u043E \u043C\u0435\u0436\u0434\u0443 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u043C\u0438, \u0447\u0438\u0441\u043B\u0435\u043D\u043D\u043E\u0441\u0442\u044C \u043F\u043E\u0433\u043E\u043B\u043E\u0432\u044C\u044F, \u0430\u0440\u0435\u0430\u043B, \u043A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u043D\u043E\u0441\u0442\u044C \u0438 \u0438\u0437\u043C\u0435\u043D\u0447\u0438\u0432\u043E\u0441\u0442\u044C, \u043F\u043E\u043B\u0435\u0437\u043D\u043E\u0441\u0442\u044C \u0434\u043B\u044F \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430.\n\u041A\u043B\u0430\u0441\u0441\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u044F \u043F\u043E\u0440\u043E\u0434 \u043A\u0443\u0440 \u043F\u043E \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044E \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438:\n- \u042F\u0438\u0447\u043D\u044B\u0435 \u2014 \u0440\u0443\u0441\u0441\u043A\u0430\u044F \u0431\u0435\u043B\u0430\u044F, \u043B\u0435\u0433\u0433\u043E\u0440\u043D, \u043C\u0438\u043D\u043E\u0440\u043A\u0430, \u0443\u043A\u0440\u0430\u0438\u043D\u0441\u043A\u0430\u044F \u0443\u0448\u0430\u043D\u043A\u0430, \u043E\u0440\u043B\u043E\u0432\u0441\u043A\u0430\u044F \u0441\u0438\u0442\u0446\u0435\u0432\u0430\u044F. \u0425\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0437\u0443\u044E\u0442\u0441\u044F \u043B\u0451\u0433\u043A\u0438\u043C \u043A\u043E\u0441\u0442\u044F\u043A\u043E\u043C, \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0436\u0438\u0432\u043E\u0439 \u043C\u0430\u0441\u0441\u043E\u0439, \u0440\u0430\u043D\u043D\u0435\u0439 \u0441\u043A\u043E\u0440\u043E\u0441\u043F\u0435\u043B\u043E\u0441\u0442\u044C\u044E.\n- \u041C\u044F\u0441\u043D\u044B\u0435 \u2014 \u043B\u0430\u043D\u0433\u0430\u0448, \u043A\u043E\u0440\u043D\u0438\u0448, \u0431\u0440\u0430\u043C\u0430, \u0444\u0430\u0432\u0435\u0440\u043E\u043B\u044C, \u0434\u043E\u0440\u043A\u0438\u043D\u0433, \u043A\u043E\u0445\u0438\u043D\u0445\u0438\u043D. \u041A\u0440\u0443\u043F\u043D\u044B\u0435, \u0441 \u0445\u043E\u0440\u043E\u0448\u043E \u0440\u0430\u0437\u0432\u0438\u0442\u043E\u0439 \u043C\u0443\u0441\u043A\u0443\u043B\u0430\u0442\u0443\u0440\u043E\u0439, \u043C\u0435\u043D\u0435\u0435 \u0441\u043A\u043E\u0440\u043E\u0441\u043F\u0435\u043B\u044B\u0435.\n- \u041C\u044F\u0441\u043E-\u044F\u0438\u0447\u043D\u044B\u0435 \u2014 \u043C\u043E\u0441\u043A\u043E\u0432\u0441\u043A\u0430\u044F, \u0440\u043E\u0434-\u0430\u0439\u043B\u0430\u043D\u0434, \u043D\u044C\u044E-\u0433\u0435\u043C\u043F\u0448\u0438\u0440, \u043A\u0430\u043B\u0438\u0444\u043E\u0440\u043D\u0438\u0439\u0441\u043A\u0430\u044F \u0441\u0435\u0440\u0430\u044F, \u0433\u043E\u043B\u043E\u0448\u0435\u0439\u043D\u0430\u044F, \u044E\u0440\u043B\u043E\u0432\u0441\u043A\u0430\u044F \u0433\u043E\u043B\u043E\u0441\u0438\u0441\u0442\u0430\u044F, \u043B\u0438\u0432\u0435\u043D\u0441\u043A\u0430\u044F, \u043A\u0443\u0447\u0438\u043D\u0441\u043A\u0430\u044F \u044E\u0431\u0438\u043B\u0435\u0439\u043D\u0430\u044F, \u0437\u0430\u0433\u043E\u0440\u0441\u043A\u0430\u044F, \u043F\u0430\u043D\u0446\u0438\u0440\u0435\u0432\u0441\u043A\u0430\u044F, \u043F\u0435\u0440\u0432\u043E\u043C\u0430\u0439\u0441\u043A\u0430\u044F, \u043F\u043E\u043B\u0442\u0430\u0432\u0441\u043A\u0430\u044F, \u0435\u0440\u0435\u0432\u0430\u043D\u0441\u043A\u0430\u044F, \u043E\u0440\u043F\u0438\u043D\u0433\u0442\u043E\u043D\u044B, \u043F\u043B\u0438\u043C\u0443\u0442\u0440\u043E\u043A\u0438, \u0432\u0438\u0430\u043D\u0434\u043E\u0442\u044B, \u0441\u0443\u0441\u0441\u0435\u043A\u0441\u044B. \u0421\u043E\u0447\u0435\u0442\u0430\u044E\u0442 \u0445\u043E\u0440\u043E\u0448\u0438\u0435 \u043C\u044F\u0441\u043D\u044B\u0435 \u0438 \u044F\u0438\u0447\u043D\u044B\u0435 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430.\n\n\u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440:\n- \u041F\u043E\u0440\u043E\u0434\u0430 \u041B\u0435\u0433\u0433\u043E\u0440\u043D. \u041D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438 \u2014 \u044F\u0438\u0447\u043D\u043E\u0435. \u0421\u0440\u0435\u0434\u043D\u044F\u044F \u044F\u0439\u0446\u0435\u043D\u043E\u0441\u043A\u043E\u0441\u0442\u044C \u2014 220\u2013300 \u044F\u0438\u0446 \u0432 \u0433\u043E\u0434, \u043C\u0430\u0441\u0441\u0430 \u044F\u0439\u0446\u0430 \u2014 58\u201365 \u0433, \u0436\u0438\u0432\u0430\u044F \u043C\u0430\u0441\u0441\u0430: \u043A\u0443\u0440\u0438\u0446\u0430 \u2014 1,8\u20132,5 \u043A\u0433, \u043F\u0435\u0442\u0443\u0445 \u2014 2,5\u20133,4 \u043A\u0433. \u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u0438: \u0432\u044B\u0441\u043E\u043A\u0430\u044F \u044F\u0439\u0446\u0435\u043D\u043E\u0441\u043A\u043E\u0441\u0442\u044C \u0438 \u0441\u043A\u043E\u0440\u043E\u0441\u043F\u0435\u043B\u043E\u0441\u0442\u044C (\u043D\u0430\u0447\u0430\u043B\u043E \u044F\u0439\u0446\u0435\u043A\u043B\u0430\u0434\u043A\u0438 \u0432 4,5\u20135 \u043C\u0435\u0441.), \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0438\u043D\u0441\u0442\u0438\u043D\u043A\u0442 \u043D\u0430\u0441\u0438\u0436\u0438\u0432\u0430\u043D\u0438\u044F, \u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0435 \u0438 \u043F\u0443\u0433\u043B\u0438\u0432\u044B\u0435, \u0445\u043E\u0440\u043E\u0448\u043E \u0430\u0434\u0430\u043F\u0442\u0438\u0440\u0443\u044E\u0442\u0441\u044F \u043A \u0440\u0430\u0437\u043D\u044B\u043C \u043A\u043B\u0438\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u043C.\n- \u041F\u043E\u0440\u043E\u0434\u0430 \u0411\u0440\u0430\u043C\u0430. \u041D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438 \u2014 \u043C\u044F\u0441\u043D\u043E\u0435 \u0438 \u0434\u0435\u043A\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u043E\u0435. \u0421\u0440\u0435\u0434\u043D\u044F\u044F \u044F\u0439\u0446\u0435\u043D\u043E\u0441\u043A\u043E\u0441\u0442\u044C \u2014 120\u2013160 \u044F\u0438\u0446 \u0432 \u0433\u043E\u0434, \u043C\u0430\u0441\u0441\u0430 \u044F\u0439\u0446\u0430 \u2014 55\u201360 \u0433, \u0441\u043A\u043E\u0440\u043B\u0443\u043F\u0430 \u043A\u0440\u0435\u043C\u043E\u0432\u043E-\u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u0430\u044F, \u0436\u0438\u0432\u0430\u044F \u043C\u0430\u0441\u0441\u0430: \u043A\u0443\u0440\u0438\u0446\u0430 \u2014 3,5\u20134,5 \u043A\u0433, \u043F\u0435\u0442\u0443\u0445 \u2014 4,5\u20135,5 \u043A\u0433. \u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u0438: \u0447\u0440\u0435\u0437\u0432\u044B\u0447\u0430\u0439\u043D\u043E \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u044B \u043A \u0445\u043E\u043B\u043E\u0434\u0443 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0433\u0443\u0441\u0442\u043E\u043C\u0443 \u043E\u043F\u0435\u0440\u0435\u043D\u0438\u044E \u0438 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u043C\u0443 \u0433\u0440\u0435\u0431\u043D\u044E, \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0439 \u0438 \u0434\u0440\u0443\u0436\u0435\u043B\u044E\u0431\u043D\u044B\u0439 \u043D\u0440\u0430\u0432, \u0445\u043E\u0440\u043E\u0448\u043E \u0440\u0430\u0437\u0432\u0438\u0442 \u0438\u043D\u0441\u0442\u0438\u043D\u043A\u0442 \u043D\u0430\u0441\u0438\u0436\u0438\u0432\u0430\u043D\u0438\u044F, \u043F\u043E\u0437\u0434\u043D\u0435\u0435 \u0441\u043E\u0437\u0440\u0435\u0432\u0430\u043D\u0438\u0435 (\u043D\u0430\u0447\u0430\u043B\u043E \u044F\u0439\u0446\u0435\u043A\u043B\u0430\u0434\u043A\u0438 \u0432 8\u20139 \u043C\u0435\u0441\u044F\u0446\u0435\u0432).\n- \u041F\u043E\u0440\u043E\u0434\u0430 \u041D\u044C\u044E-\u0433\u0435\u043C\u043F\u0448\u0438\u0440. \u041D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438 \u2014 \u043C\u044F\u0441\u043E-\u044F\u0438\u0447\u043D\u043E\u0435. \u0421\u0440\u0435\u0434\u043D\u044F\u044F \u044F\u0439\u0446\u0435\u043D\u043E\u0441\u043A\u043E\u0441\u0442\u044C \u2014 200\u2013220 \u044F\u0438\u0446 \u0432 \u0433\u043E\u0434, \u043C\u0430\u0441\u0441\u0430 \u044F\u0439\u0446\u0430 \u2014 56\u201360 \u0433, \u0436\u0438\u0432\u0430\u044F \u043C\u0430\u0441\u0441\u0430: \u043A\u0443\u0440\u0438\u0446\u0430 \u2014 2,5\u20132,9 \u043A\u0433, \u043F\u0435\u0442\u0443\u0445 \u2014 3,5\u20133,9 \u043A\u0433. \u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u0438: \u0431\u044B\u0441\u0442\u0440\u043E\u0435 \u043E\u043F\u0435\u0440\u0435\u043D\u0438\u0435 \u0438 \u0441\u043A\u043E\u0440\u043E\u0441\u043F\u0435\u043B\u043E\u0441\u0442\u044C, \u043E\u0442\u043B\u0438\u0447\u043D\u0430\u044F \u0430\u0434\u0430\u043F\u0442\u0430\u0446\u0438\u044F \u043A \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u043C \u043A\u043B\u0438\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u043C, \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0439 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440, \u0438\u043D\u0441\u0442\u0438\u043D\u043A\u0442 \u043D\u0430\u0441\u0438\u0436\u0438\u0432\u0430\u043D\u0438\u044F \u043E\u0441\u043B\u0430\u0431\u043B\u0435\u043D (\u043B\u0443\u0447\u0448\u0435 \u0432\u044B\u0432\u043E\u0434\u0438\u0442\u044C \u0432 \u0438\u043D\u043A\u0443\u0431\u0430\u0442\u043E\u0440\u0435), \u0433\u0440\u0435\u0431\u0435\u043D\u044C \u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u0435\u043D \u043A \u0441\u0438\u043B\u044C\u043D\u044B\u043C \u043C\u043E\u0440\u043E\u0437\u0430\u043C.\n- \u041F\u043E\u0440\u043E\u0434\u0430 \u041F\u043B\u0438\u043C\u0443\u0442\u0440\u043E\u043A. \u041D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438 \u2014 \u043C\u044F\u0441\u043E-\u044F\u0438\u0447\u043D\u043E\u0435. \u0421\u0440\u0435\u0434\u043D\u044F\u044F \u044F\u0439\u0446\u0435\u043D\u043E\u0441\u043A\u043E\u0441\u0442\u044C \u2014 160\u2013220 \u044F\u0438\u0446 \u0432 \u0433\u043E\u0434, \u043C\u0430\u0441\u0441\u0430 \u044F\u0439\u0446\u0430 \u2014 55\u201362 \u0433, \u0441\u043A\u043E\u0440\u043B\u0443\u043F\u0430 \u0441\u0432\u0435\u0442\u043B\u043E-\u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u0430\u044F \u0438\u043B\u0438 \u043A\u0440\u0435\u043C\u043E\u0432\u0430\u044F, \u0436\u0438\u0432\u0430\u044F \u043C\u0430\u0441\u0441\u0430: \u043A\u0443\u0440\u0438\u0446\u0430 \u2014 2,7\u20133,5 \u043A\u0433, \u043F\u0435\u0442\u0443\u0445 \u2014 3,6\u20134,5 \u043A\u0433. \u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u0438: \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0439 \u043D\u0440\u0430\u0432 \u0438 \u0432\u044B\u0441\u043E\u043A\u0430\u044F \u0430\u0434\u0430\u043F\u0442\u0430\u0446\u0438\u044F \u043A \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u043E\u043C\u0443 \u043A\u043B\u0438\u043C\u0430\u0442\u0443, \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u0435 \u043C\u044F\u0441\u043D\u044B\u0435 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u043A\u0430\u043A \u043C\u0430\u0442\u0435\u0440\u0438\u043D\u0441\u043A\u0430\u044F \u0444\u043E\u0440\u043C\u0430 \u043F\u0440\u0438 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0438 \u0431\u0440\u043E\u0439\u043B\u0435\u0440\u043E\u0432"
