  m_Name: "5. \u0425\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u0438\u043D\u043A\u0443\u0431\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0445 \u044F\u0438\u0446"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0425\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u0438\u043D\u043A\u0443\u0431\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0445 \u044F\u0438\u0446"
  scientificName: 
  nameClip: {fileID: 0}
  description: "\u041A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u0432\u0430\u0436\u043D\u044B\u0439 \u044D\u0442\u0430\u043F \u0432 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0438 \u0438\u043D\u043A\u0443\u0431\u0430\u0446\u0438\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E \u0432\u043B\u0438\u044F\u0435\u0442 \u043D\u0430 \u0432\u044B\u0432\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u044C \u0438 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043E \u043C\u043E\u043B\u043E\u0434\u043D\u044F\u043A\u0430. \u0412 \u044D\u0442\u043E\u0442 \u043F\u0435\u0440\u0438\u043E\u0434 \u0432 \u044F\u0439\u0446\u0435 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u044F\u0442 \u0431\u0438\u043E\u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F: \u043E\u043D\u043E \u0442\u0435\u0440\u044F\u0435\u0442 \u0432\u043B\u0430\u0433\u0443, \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442\u0441\u044F \u043C\u0430\u0441\u0441\u0430 \u0431\u0435\u043B\u043A\u0430, \u043D\u0430\u0440\u0443\u0448\u0430\u0435\u0442\u0441\u044F \u0435\u0433\u043E \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0430, \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u043A\u0438\u0441\u043B\u043E\u0442\u043D\u043E\u0441\u0442\u044C \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0433\u043E.\n\u041E\u0441\u043D\u043E\u0432\u043D\u044B\u0435 \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u044B \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F:\n1. \u041F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E\u0435 \u043E\u0445\u043B\u0430\u0436\u0434\u0435\u043D\u0438\u0435 \u043F\u043E\u0441\u043B\u0435 \u0441\u043D\u0435\u0441\u0435\u043D\u0438\u044F. \u042F\u0439\u0446\u0430 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u043E\u0445\u043B\u0430\u0434\u0438\u0442\u044C \u0434\u043E \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u044B \u043D\u0438\u0436\u0435 \u043F\u043E\u0440\u043E\u0433\u0430 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F \u044D\u043C\u0431\u0440\u0438\u043E\u043D\u0430 (\u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E 18\u201325 \xB0C) \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 6\u20138 \u0447\u0430\u0441\u043E\u0432. \u041D\u0435 \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u043F\u043E\u043C\u0435\u0449\u0430\u0442\u044C \u044F\u0439\u0446\u0430 \u0432 \u044F\u0439\u0446\u0435\u0441\u043A\u043B\u0430\u0434 \u0441\u0440\u0430\u0437\u0443 \u043F\u043E\u0441\u043B\u0435 \u0441\u043D\u0435\u0441\u0435\u043D\u0438\u044F \u2014 \u0438\u043C \u043D\u0443\u0436\u043D\u043E \u0434\u0430\u0442\u044C \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E \u043E\u0441\u0442\u044B\u0442\u044C, \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u0435\u0441\u043B\u0438 \u043E\u043D\u0438 \u0443\u0436\u0435 \u0443\u043B\u043E\u0436\u0435\u043D\u044B \u0432 \u043B\u043E\u0442\u043A\u0438.\n2. \u041C\u0438\u043D\u0438\u043C\u0438\u0437\u0430\u0446\u0438\u044F \u0441\u0440\u043E\u043A\u043E\u0432 \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F. \u041E\u043F\u0442\u0438\u043C\u0430\u043B\u044C\u043D\u043E \u0437\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0442\u044C \u044F\u0439\u0446\u0430 \u0432 \u0438\u043D\u043A\u0443\u0431\u0430\u0442\u043E\u0440 \u0447\u0435\u0440\u0435\u0437 1\u20132 \u0434\u043D\u044F \u043F\u043E\u0441\u043B\u0435 \u0441\u043D\u0435\u0441\u0435\u043D\u0438\u044F. \u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u043C\u0430\u044F \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u0434\u043B\u044F \u043A\u0443\u0440\u0438\u043D\u044B\u0445 \u044F\u0438\u0446 \u2014 \u0434\u043E 5 \u0441\u0443\u0442\u043E\u043A, \u0434\u043B\u044F \u0438\u043D\u0434\u044E\u0448\u0438\u043D\u044B\u0445 \u2014 \u0434\u043E 6, \u0443\u0442\u0438\u043D\u044B\u0445 \u2014 \u0434\u043E 8, \u043F\u0435\u0440\u0435\u043F\u0435\u043B\u0438\u043D\u044B\u0445 \u2014 \u0434\u043E 7, \u0433\u0443\u0441\u0438\u043D\u044B\u0445 \u2014 \u0434\u043E 10 \u0441\u0443\u0442\u043E\u043A. \u041A\u0430\u0436\u0434\u044B\u0439 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u0434\u0435\u043D\u044C \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u0441\u043D\u0438\u0436\u0430\u0435\u0442 \u0432\u044B\u0432\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u044C: \u0432 \u0441\u0440\u0435\u0434\u043D\u0435\u043C \u043D\u0430 0,2% \u0434\u043E 7-\u0433\u043E \u0434\u043D\u044F \u0438 \u043D\u0430 0,5% \u2014 \u043F\u043E\u0441\u043B\u0435 \u043D\u0435\u0433\u043E.\n3. \u0421\u0442\u0440\u043E\u0433\u043E\u0435 \u0441\u043E\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435 \u043C\u0438\u043A\u0440\u043E\u043A\u043B\u0438\u043C\u0430\u0442\u0430. \u041F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0435 \u0434\u043B\u044F \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F (\u044F\u0439\u0446\u0435\u0441\u043A\u043B\u0430\u0434) \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u0442\u044C \u0447\u0438\u0441\u0442\u044B\u043C, \u0441\u0443\u0445\u0438\u043C, \u0445\u043E\u0440\u043E\u0448\u043E \u0432\u0435\u043D\u0442\u0438\u043B\u0438\u0440\u0443\u0435\u043C\u044B\u043C, \u0431\u0435\u0437 \u043F\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u0445 \u0437\u0430\u043F\u0430\u0445\u043E\u0432.\n4. \u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044C \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u044B \u0438 \u0432\u043B\u0430\u0436\u043D\u043E\u0441\u0442\u0438. \u0422\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u043D\u044B\u0439 \u0440\u0435\u0436\u0438\u043C \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u0441\u0440\u043E\u043A\u0430 \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F:\n- \u0434\u043E 3 \u0441\u0443\u0442\u043E\u043A: 20\u201321 \xB0C;\n- 4\u20137 \u0441\u0443\u0442\u043E\u043A: 14\u201315 \xB0C;\n- \u0441\u0432\u044B\u0448\u0435 7 \u0441\u0443\u0442\u043E\u043A: 12\u201313 \xB0C.\n5. \u041E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u0432\u043B\u0430\u0436\u043D\u043E\u0441\u0442\u044C \u0432\u043E\u0437\u0434\u0443\u0445\u0430 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u043D\u0430 \u0443\u0440\u043E\u0432\u043D\u0435 50\u201380% \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442 \u0432\u0438\u0434\u0430 \u043F\u0442\u0438\u0446\u044B \u0438 \u0441\u0440\u043E\u043A\u0430 \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F.\n6. \u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0435 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u044F\u0438\u0446 \u0432 \u043B\u043E\u0442\u043A\u0430\u0445. \u041A\u0443\u0440\u0438\u043D\u044B\u0435 \u0438 \u0438\u043D\u0434\u044E\u0448\u0438\u043D\u044B\u0435 \u044F\u0439\u0446\u0430 \u0445\u0440\u0430\u043D\u044F\u0442 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u043E \u0442\u0443\u043F\u044B\u043C \u043A\u043E\u043D\u0446\u043E\u043C \u0432\u0432\u0435\u0440\u0445; \u0443\u0442\u0438\u043D\u044B\u0435 \u043C\u0435\u043B\u043A\u0438\u0435 \u0438 \u0441\u0440\u0435\u0434\u043D\u0438\u0435 \u2014 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u043E, \u0430 \u043A\u0440\u0443\u043F\u043D\u044B\u0435 \u2014 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u044C\u043D\u043E; \u0433\u0443\u0441\u0438\u043D\u044B\u0435 \u2014 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u044C\u043D\u043E; \u043F\u0435\u0440\u0435\u043F\u0435\u043B\u0438\u043D\u044B\u0435 \u2014 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u043E \u043E\u0441\u0442\u0440\u044B\u043C \u043A\u043E\u043D\u0446\u043E\u043C \u0432\u0432\u0435\u0440\u0445.\n7. \u0420\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u043E\u0435 \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u043D\u0438\u0435. \u042F\u0439\u0446\u0430 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0442\u044C 3\u20134 \u0440\u0430\u0437\u0430 \u0432 \u0441\u0443\u0442\u043A\u0438 \u043D\u0430 90\xB0 \u043F\u043E\u0441\u043B\u0435 \u043F\u0435\u0440\u0432\u044B\u0445 5 \u0441\u0443\u0442\u043E\u043A \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F.\n8. \u0413\u0435\u0440\u043C\u0435\u0442\u0438\u0447\u043D\u0430\u044F \u0443\u043F\u0430\u043A\u043E\u0432\u043A\u0430. \u0414\u043B\u044F \u043F\u0440\u043E\u0434\u043B\u0435\u043D\u0438\u044F \u0441\u0440\u043E\u043A\u0430 \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u044F\u0439\u0446\u0430 \u0443\u043F\u0430\u043A\u043E\u0432\u044B\u0432\u0430\u044E\u0442 \u0432 \u043F\u043E\u043B\u0438\u044D\u0442\u0438\u043B\u0435\u043D\u043E\u0432\u044B\u0435 \u043F\u0430\u043A\u0435\u0442\u044B \u0441 \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u0435\u043C \u0432\u043E\u0437\u0434\u0443\u0445\u0430 \u0438\u043B\u0438 \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u044E\u0442 \u043F\u0430\u043A\u0435\u0442\u044B \u0430\u0437\u043E\u0442\u043E\u043C.\n\u042F\u0439\u0446\u0430 \u0434\u0435\u0437\u0438\u043D\u0444\u0438\u0446\u0438\u0440\u0443\u044E\u0442 \u0441\u0440\u0430\u0437\u0443 \u043F\u043E\u0441\u043B\u0435 \u0441\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u043A\u0438 \u0438 \u0443\u043A\u043B\u0430\u0434\u043A\u0438 \u0432 \u043B\u043E\u0442\u043A\u0438. \u0415\u0441\u043B\u0438 \u043F\u043B\u0430\u043D\u0438\u0440\u0443\u0435\u0442\u0441\u044F \u0434\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435 \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435 (\u0441\u0432\u044B\u0448\u0435 5\u20137 \u0441\u0443\u0442\u043E\u043A), \u044F\u0439\u0446\u0430 \u043F\u0435\u0440\u0438\u043E\u0434\u0438\u0447\u0435\u0441\u043A\u0438 \u043F\u0440\u043E\u0433\u0440\u0435\u0432\u0430\u044E\u0442 \u0432 \u0438\u043D\u043A\u0443\u0431\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u043C \u0448\u043A\u0430\u0444\u0443 \u043F\u0440\u0438 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0435 37,8\u201338,0 \xB0C \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 4\u20135 \u0447\u0430\u0441\u043E\u0432, \u0430 \u0437\u0430\u0442\u0435\u043C \u043E\u0445\u043B\u0430\u0436\u0434\u0430\u044E\u0442 \u0434\u043E \u043A\u043E\u043C\u043D\u0430\u0442\u043D\u043E\u0439 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u044B \u043F\u0435\u0440\u0435\u0434 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435\u043C \u0432 \u044F\u0439\u0446\u0435\u0441\u043A\u043B\u0430\u0434. \u041F\u0440\u043E\u0433\u0440\u0435\u0432 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u044E\u0442 \u0447\u0435\u0440\u0435\u0437 \u043A\u0430\u0436\u0434\u044B\u0435 5 \u0441\u0443\u0442\u043E\u043A \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F.\n\u0412 \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u0447\u0430\u0441\u0442\u0438 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F \u0434\u043B\u044F \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u044E\u0442 \u043E\u0437\u043E\u043D\u0430\u0442\u043E\u0440\u044B. \u041E\u0437\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435 \u043F\u0440\u043E\u0432\u043E\u0434\u044F\u0442 \u043F\u0435\u0440\u0438\u043E\u0434\u0438\u0447\u0435\u0441\u043A\u0438 (1 \u0440\u0430\u0437 \u0432 3\u20135 \u0434\u043D\u0435\u0439 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E 8\u201312 \u0447\u0430\u0441\u043E\u0432) \u0438\u043B\u0438 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E, \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u044F \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0430\u0446\u0438\u044E \u043E\u0437\u043E\u043D\u0430"
  clip: {fileID: 0}
