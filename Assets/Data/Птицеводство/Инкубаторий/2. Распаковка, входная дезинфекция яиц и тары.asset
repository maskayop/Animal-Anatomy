  m_Name: "2. \u0420\u0430\u0441\u043F\u0430\u043A\u043E\u0432\u043A\u0430, \u0432\u0445\u043E\u0434\u043D\u0430\u044F
    \u0434\u0435\u0437\u0438\u043D\u0444\u0435\u043A\u0446\u0438\u044F \u044F\u0438\u0446
    \u0438 \u0442\u0430\u0440\u044B"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0420\u0430\u0441\u043F\u0430\u043A\u043E\u0432\u043A\u0430, \u0432\u0445\u043E\u0434\u043D\u0430\u044F
    \u0434\u0435\u0437\u0438\u043D\u0444\u0435\u043A\u0446\u0438\u044F \u044F\u0438\u0446
    \u0438 \u0442\u0430\u0440\u044B"
  scientificName: 
  nameClip: {fileID: 0}
  description: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u044D\u0442\u0430\u043F \u0432 \u0438\u043D\u043A\u0443\u0431\u0430\u0442\u043E\u0440\u0438\u0438,
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439 \u043D\u0430
    \u043F\u0440\u0435\u0434\u043E\u0442\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435
    \u0437\u0430\u043D\u043E\u0441\u0430 \u0438 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0435\u043D\u0438\u044F
    \u043F\u0430\u0442\u043E\u0433\u0435\u043D\u043D\u043E\u0439 \u043C\u0438\u043A\u0440\u043E\u0444\u043B\u043E\u0440\u044B,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438
    \u043A \u0433\u0438\u0431\u0435\u043B\u0438 \u044D\u043C\u0431\u0440\u0438\u043E\u043D\u043E\u0432
    \u0438 \u0438\u043D\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044E
    \u0432\u0441\u0435\u0433\u043E \u0441\u0442\u0430\u0434\u0430.\n\u042D\u0442\u043E\u0442
    \u044D\u0442\u0430\u043F \u043E\u0431\u044B\u0447\u043D\u043E \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u044E\u0442
    \u0432 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u043C \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0438,
    \u0438\u0437\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u043C
    \u043E\u0442 \u0434\u0440\u0443\u0433\u0438\u0445 \u0437\u043E\u043D. \u0415\u0433\u043E
    \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u043A\u0430 \u0434\u043E\u043B\u0436\u043D\u0430
    \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0442\u044C \u043E\u0434\u043D\u043E\u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439
    \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043F\u043E\u0442\u043E\u043A: \u0438\u0441\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F
    \u0432\u0441\u0442\u0440\u0435\u0447\u043D\u043E\u0435 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435
    \u044F\u0438\u0446, \u0432\u044B\u0432\u0435\u0434\u0435\u043D\u043D\u043E\u0433\u043E
    \u043C\u043E\u043B\u043E\u0434\u043D\u044F\u043A\u0430 \u0438 \u043E\u0442\u0445\u043E\u0434\u043E\u0432
    \u0438\u043D\u043A\u0443\u0431\u0430\u0446\u0438\u0438.\n\u041A\u043B\u044E\u0447\u0435\u0432\u044B\u0435
    \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F \u043A \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044E:\n-
    \u041F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u0434\u043E\u043B\u0436\u043D\u044B
    \u0431\u044B\u0442\u044C \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u044B
    \u043A \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044E \u043C\u043E\u044E\u0449\u0438\u0445
    \u0438 \u0434\u0435\u0437\u0438\u043D\u0444\u0438\u0446\u0438\u0440\u0443\u044E\u0449\u0438\u0445
    \u0441\u0440\u0435\u0434\u0441\u0442\u0432.\n- \u041F\u043E\u043B\u044B \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u044E\u0442
    \u0441 \u0443\u043A\u043B\u043E\u043D\u043E\u043C \u0434\u043B\u044F \u0441\u0442\u043E\u043A\u0430
    \u0436\u0438\u0434\u043A\u043E\u0441\u0442\u0435\u0439.\n- \u041E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u043D\u0430\u043B\u0438\u0447\u0438\u0435 \u0434\u0435\u0437\u0432\u0430\u043D\u043D\u044B
    \u043F\u0440\u0438 \u0432\u0445\u043E\u0434\u0435.\n- \u0412 \u0440\u0430\u0437\u043D\u044B\u0445
    \u0437\u043E\u043D\u0430\u0445 \u0438\u043D\u043A\u0443\u0431\u0430\u0442\u043E\u0440\u0438\u044F
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u0443\u044E
    \u043E\u0434\u0435\u0436\u0434\u0443 \u0438 \u043E\u0431\u0443\u0432\u044C \u0440\u0430\u0437\u043D\u043E\u0433\u043E
    \u0446\u0432\u0435\u0442\u0430, \u043F\u0435\u0440\u0435\u0445\u043E\u0434 \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u0430
    \u043C\u0435\u0436\u0434\u0443 \u0437\u043E\u043D\u0430\u043C\u0438 \u0431\u0435\u0437
    \u043F\u0435\u0440\u0435\u043E\u0434\u0435\u0432\u0430\u043D\u0438\u044F \u0437\u0430\u043F\u0440\u0435\u0449\u0451\u043D.\n\u041F\u043E\u0441\u043B\u0435
    \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0438 \u044F\u0438\u0446 \u0432 \u0438\u043D\u043A\u0443\u0431\u0430\u0442\u043E\u0440\u0438\u0439
    \u0438\u0445 \u0440\u0430\u0441\u043F\u0430\u043A\u043E\u0432\u044B\u0432\u0430\u044E\u0442
    \u0432 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u043E\u0442\u0432\u0435\u0434\u0451\u043D\u043D\u043E\u043C
    \u043C\u0435\u0441\u0442\u0435. \u0414\u0430\u043B\u0435\u0435 \u044F\u0439\u0446\u0430
    \u043F\u043E\u0434\u0432\u0435\u0440\u0433\u0430\u044E\u0442 \u043F\u0435\u0440\u0432\u0438\u0447\u043D\u043E\u0439
    \u0434\u0435\u0437\u0438\u043D\u0444\u0435\u043A\u0446\u0438\u0438. \u0415\u0451
    \u043F\u0440\u043E\u0432\u043E\u0434\u044F\u0442 \u043A\u0430\u043A \u043C\u043E\u0436\u043D\u043E
    \u0440\u0430\u043D\u044C\u0448\u0435 \u2014 \u0436\u0435\u043B\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u043D\u0435 \u043F\u043E\u0437\u0434\u043D\u0435\u0435 1,5\u20132 \u0447\u0430\u0441\u043E\u0432
    \u043F\u043E\u0441\u043B\u0435 \u0441\u043D\u0435\u0441\u0435\u043D\u0438\u044F,
    \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u0435\u0434\u043E\u0442\u0432\u0440\u0430\u0442\u0438\u0442\u044C
    \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0435 \u043F\u0440\u043E\u043D\u0438\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0435
    \u043C\u0438\u043A\u0440\u043E\u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u043E\u0432
    \u0432 \u043F\u043E\u0440\u044B \u0441\u043A\u043E\u0440\u043B\u0443\u043F\u044B.\n\u041C\u0435\u0442\u043E\u0434\u044B
    \u0434\u0435\u0437\u0438\u043D\u0444\u0435\u043A\u0446\u0438\u0438 \u044F\u0438\u0446:\n-
    \u041E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0430 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0430\u043C\u0438
    \u0434\u0435\u0437\u0438\u043D\u0444\u0435\u043A\u0442\u0430\u043D\u0442\u043E\u0432
    (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u043D\u0430\u0434\u0443\u043A\u0441\u0443\u0441\u043D\u0430\u044F
    \u043A\u0438\u0441\u043B\u043E\u0442\u0430, \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u0438\u0447\u043D\u044B\u0435
    \u0430\u043C\u043C\u043E\u043D\u0438\u0435\u0432\u044B\u0435 \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F).\n-
    \u041E\u0437\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435 (\u043E\u0437\u043E\u043D
    \u043A\u0430\u043A \u0441\u0438\u043B\u044C\u043D\u044B\u0439 \u043E\u043A\u0438\u0441\u043B\u0438\u0442\u0435\u043B\u044C
    \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E \u0441\u043D\u0438\u0436\u0430\u0435\u0442
    \u043C\u0438\u043A\u0440\u043E\u0431\u043D\u0443\u044E \u043E\u0431\u0441\u0435\u043C\u0435\u043D\u0451\u043D\u043D\u043E\u0441\u0442\u044C
    \u0441\u043A\u043E\u0440\u043B\u0443\u043F\u044B).\n- \u0410\u044D\u0440\u043E\u0437\u043E\u043B\u044C\u043D\u0430\u044F
    \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0430.\n\u0421\u0438\u043B\u044C\u043D\u043E
    \u0437\u0430\u0433\u0440\u044F\u0437\u043D\u0451\u043D\u043D\u044B\u0435 \u044F\u0439\u0446\u0430
    (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u043E\u0442 \u0432\u043E\u0434\u043E\u043F\u043B\u0430\u0432\u0430\u044E\u0449\u0435\u0439
    \u043F\u0442\u0438\u0446\u044B) \u043F\u0435\u0440\u0435\u0434 \u0434\u0435\u0437\u0438\u043D\u0444\u0435\u043A\u0446\u0438\u0435\u0439
    \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u043C\u043E\u044E\u0442
    \u0432 \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0445 \u0432\u0430\u043D\u043D\u0430\u0445
    \u0438\u043B\u0438 \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u044F\u0439\u0446\u0435\u043C\u043E\u0435\u0447\u043D\u044B\u0445
    \u043C\u0430\u0448\u0438\u043D.\n\u041E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
    \u0441 \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u043E\u0439 \u044F\u0438\u0446
    \u0434\u0435\u0437\u0438\u043D\u0444\u0438\u0446\u0438\u0440\u0443\u044E\u0442
    \u0438 \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442\u043D\u0443\u044E
    \u0442\u0430\u0440\u0443 (\u044F\u0449\u0438\u043A\u0438, \u043F\u0440\u043E\u043A\u043B\u0430\u0434\u043A\u0438).
    \u0414\u043B\u044F \u044D\u0442\u043E\u0433\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442
    \u0442\u0435 \u0436\u0435 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u044B, \u0447\u0442\u043E
    \u0438 \u0434\u043B\u044F \u044F\u0438\u0446, \u043B\u0438\u0431\u043E \u0434\u0440\u0443\u0433\u0438\u0435
    \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430.
    \u041C\u043D\u043E\u0433\u043E\u0440\u0430\u0437\u043E\u0432\u044B\u0435 \u043F\u043B\u0430\u0441\u0442\u0438\u043A\u043E\u0432\u044B\u0435
    \u0438\u043B\u0438 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0435
    \u044F\u0449\u0438\u043A\u0438 \u043F\u043E\u0441\u043B\u0435 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
    \u0442\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u043C\u043E\u044E\u0442,
    \u0434\u0435\u0437\u0438\u043D\u0444\u0438\u0446\u0438\u0440\u0443\u044E\u0442
    \u0438 \u043F\u0440\u043E\u0441\u0443\u0448\u0438\u0432\u0430\u044E\u0442.\n\u041F\u0440\u0438\u0451\u043C
    \u044F\u0438\u0446 \u043F\u0440\u043E\u0432\u043E\u0434\u044F\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
    \u043F\u0440\u0438 \u043D\u0430\u043B\u0438\u0447\u0438\u0438 \u0432\u0435\u0442\u0435\u0440\u0438\u043D\u0430\u0440\u043D\u043E\u0433\u043E
    \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
    \u043E \u0431\u043B\u0430\u0433\u043E\u043F\u043E\u043B\u0443\u0447\u0438\u0438
    \u0445\u043E\u0437\u044F\u0439\u0441\u0442\u0432\u0430 \u043F\u043E \u0438\u043D\u0444\u0435\u043A\u0446\u0438\u043E\u043D\u043D\u044B\u043C
    \u0437\u0430\u0431\u043E\u043B\u0435\u0432\u0430\u043D\u0438\u044F\u043C \u043F\u0442\u0438\u0446"
