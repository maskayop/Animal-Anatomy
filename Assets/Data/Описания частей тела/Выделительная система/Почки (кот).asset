  m_Script: {fileID: 11500000, guid: 3f00395bd4580c04eb5d722a11c9666a, type: 3}
  m_Name: "\u041F\u043E\u0447\u043A\u0438 (\u043A\u043E\u0442)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u041F\u043E\u0447\u043A\u0438"
  scientificName: renes (nephros)
  description: "\u041F\u0430\u0440\u043D\u044B\u0439 \u043E\u0432\u0430\u043B\u044C\u043D\u044B\u0439
    \u043E\u0440\u0433\u0430\u043D, \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0439
    \u0432 \u0431\u0440\u044E\u0448\u043D\u043E\u0439 \u043F\u043E\u043B\u043E\u0441\u0442\u0438,
    \u043F\u043E \u0446\u0435\u043D\u0442\u0440\u0443 \u0441\u043F\u0438\u043D\u044B
    (\u043D\u0430 \u0443\u0440\u043E\u0432\u043D\u0435 7\u20138 \u0440\u0435\u0431\u0440\u0430),
    \u0441 \u043E\u0431\u0435\u0438\u0445 \u0441\u0442\u043E\u0440\u043E\u043D \u043E\u0442
    \u043F\u043E\u0437\u0432\u043E\u043D\u043E\u0447\u043D\u0438\u043A\u0430. \u041B\u0435\u0432\u0430\u044F
    \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F
    \u043E\u0442 \u043F\u0440\u0430\u0432\u043E\u0439 \u0442\u0435\u043C, \u0447\u0442\u043E
    \u043E\u043D\u0430 \u0431\u043E\u043B\u0435\u0435 \u043F\u043E\u0434\u0432\u0438\u0436\u043D\u0430\u044F.\r\n\u041F\u043E\u0447\u043A\u0438
    \u0441\u043E\u0441\u0442\u043E\u044F\u0442 \u0438\u0437 \u0432\u043D\u0435\u0448\u043D\u0435\u0433\u043E
    \u043A\u043E\u0440\u043A\u043E\u0432\u043E\u0433\u043E \u0438 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0433\u043E
    \u043C\u043E\u0437\u0433\u043E\u0432\u043E\u0433\u043E \u0441\u043B\u043E\u0451\u0432,
    \u0430 \u0442\u0430\u043A\u0436\u0435 \u043F\u043E\u0447\u0435\u0447\u043D\u043E\u0439
    \u043B\u043E\u0445\u0430\u043D\u043A\u0438 (\u0432\u043E\u0440\u043E\u043D\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u043E\u0439
    \u043F\u043E\u043B\u043E\u0441\u0442\u0438, \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044F\u0449\u0435\u0439
    \u0432 \u043C\u043E\u0447\u0435\u0442\u043E\u0447\u043D\u0438\u043A) \u0438 \u043D\u0435\u0444\u0440\u043E\u043D\u043E\u0432.
    \u041A\u0430\u0436\u0434\u044B\u0439 \u043D\u0435\u0444\u0440\u043E\u043D \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442
    \u043A\u043B\u0443\u0431\u043E\u0447\u043A\u0438 (\u0441\u043A\u043E\u043F\u043B\u0435\u043D\u0438\u044F
    \u043A\u0430\u043F\u0438\u043B\u043B\u044F\u0440\u043E\u0432) \u0438 \u0441\u0438\u0441\u0442\u0435\u043C\u044B
    \u043A\u0430\u043D\u0430\u043B\u044C\u0446\u0435\u0432. \u041E\u0442 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0439
    \u043D\u0435\u0444\u0440\u043E\u043D\u044B \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u0442
    \u0432\u043D\u0435\u0448\u043D\u044F\u044F \u043A\u0430\u043F\u0441\u0443\u043B\u0430.u\r\n\u0421\u0430\u043C\u0443
    \u043F\u043E\u0447\u043A\u0443 \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u0442
    \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u0444\u0438\u0431\u0440\u043E\u0437\u043D\u0430\u044F \u043A\u0430\u043F\u0441\u0443\u043B\u0430,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F, \u0432 \u0441\u0432\u043E\u044E \u043E\u0447\u0435\u0440\u0435\u0434\u044C,
    \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0432 \u0436\u0438\u0440\u043E\u0432\u043E\u0439
    \u043A\u0430\u043F\u0441\u0443\u043B\u0435.\r\n\u0424\u0443\u043D\u043A\u0446\u0438\u0438:\r\n\u2014
    \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u0435 \u0442\u043E\u043A\u0441\u0438\u043D\u043E\u0432
    \u0438\u0437 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u0430 \u0438 \u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
    \u043C\u043E\u0447\u0443;\r\n\u2014 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435
    \u0432\u043E\u0434\u043D\u043E\u0433\u043E, \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043B\u0438\u0442\u043D\u043E\u0433\u043E
    \u0438 \u043A\u0438\u0441\u043B\u043E\u0442\u043D\u043E-\u0449\u0435\u043B\u043E\u0447\u043D\u043E\u0433\u043E
    \u0431\u0430\u043B\u0430\u043D\u0441\u043E\u0432;\r\n\u2014 \u0440\u0435\u0433\u0443\u043B\u044F\u0446\u0438\u044F
    \u0430\u0440\u0442\u0435\u0440\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u044F;\r\n\u2014 \u0432\u044B\u0432\u043E\u0434
    \u043B\u0438\u0448\u043D\u0435\u0433\u043E \u043A\u0430\u043B\u044C\u0446\u0438\u044F;\r\n\u2014
    \u0432\u044B\u0440\u0430\u0431\u043E\u0442\u043A\u0430 \u0430\u0434\u0440\u0435\u043D\u0430\u043B\u0438\u043D\u0430;\r\n\u2014
    \u0441\u0438\u043D\u0442\u0435\u0437 \u0433\u043E\u0440\u043C\u043E\u043D\u0430
    \u044D\u0440\u0438\u0442\u0440\u043E\u043F\u043E\u044D\u0442\u0438\u043D\u0430,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442
    \u0437\u0430 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435 \u044D\u0440\u0438\u0442\u0440\u043E\u0446\u0438\u0442\u043E\u0432
    \u0432 \u043A\u043E\u0441\u0442\u043D\u043E\u043C \u043C\u043E\u0437\u0433\u0443"
  clip: {fileID: 0}
