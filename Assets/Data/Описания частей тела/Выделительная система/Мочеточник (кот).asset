  m_Name: "\u041C\u043E\u0447\u0435\u0442\u043E\u0447\u043D\u0438\u043A (\u043A\u043E\u0442)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u041C\u043E\u0447\u0435\u0442\u043E\u0447\u043D\u0438\u043A"
  scientificName: ureter
  nameClip: {fileID: 8300000, guid: 899682b3caa52f745bcc28d73a106412, type: 3}
  description: "\u041F\u0430\u0440\u043D\u044B\u0439 \u043E\u0440\u0433\u0430\u043D,
    \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u0439
    \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u043C\u043E\u0447\u0438
    \u0438\u0437 \u043F\u043E\u0447\u0435\u0447\u043D\u043E\u0439 \u043B\u043E\u0445\u0430\u043D\u043A\u0438
    \u0432 \u043C\u043E\u0447\u0435\u0432\u043E\u0439 \u043F\u0443\u0437\u044B\u0440\u044C.
    \u0414\u043B\u0438\u043D\u0430 \u043C\u043E\u0447\u0435\u0442\u043E\u0447\u043D\u0438\u043A\u043E\u0432
    \u0443 \u043A\u043E\u0442\u043E\u0432 \u2014 9\u201312 \u0441\u043C. \u041C\u043E\u0447\u0435\u0442\u043E\u0447\u043D\u0438\u043A
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u043E\u0431\u043E\u0439
    \u043A\u043E\u0436\u043D\u043E-\u043C\u044B\u0448\u0435\u0447\u043D\u0443\u044E
    \u0442\u0440\u0443\u0431\u043A\u0443 \u0438 \u0441\u043E\u0441\u0442\u043E\u0438\u0442
    \u0438\u0437 \u0430\u0434\u0432\u0435\u043D\u0442\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0439,
    \u043C\u044B\u0448\u0435\u0447\u043D\u043E\u0439 \u0438 \u0441\u043B\u0438\u0437\u0438\u0441\u0442\u043E\u0439
    \u043E\u0431\u043E\u043B\u043E\u0447\u0435\u043A.\r\n\u0421\u043D\u0430\u0440\u0443\u0436\u0438
    \u043C\u043E\u0447\u0435\u0442\u043E\u0447\u043D\u0438\u043A \u0438\u043C\u0435\u0435\u0442
    \u0445\u043E\u0440\u043E\u0448\u043E \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u043D\u044B\u0439
    \u0430\u0434\u0432\u0435\u043D\u0442\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439
    \u0441\u043B\u043E\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u043E\u0447\u0442\u0438
    \u0441\u0440\u0430\u0437\u0443 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
    \u0432 \u043E\u043A\u043E\u043B\u043E\u043F\u043E\u0447\u0435\u0447\u043D\u0443\u044E
    \u0436\u0438\u0440\u043E\u0432\u0443\u044E \u043A\u0430\u043F\u0441\u0443\u043B\u0443.
    \u041A\u043E\u043D\u0442\u0443\u0440\u044B \u0430\u0434\u0432\u0435\u043D\u0442\u0438\u0446\u0438\u0438
    \u043D\u0430 \u043F\u043E\u043F\u0435\u0440\u0435\u0447\u043D\u043E\u043C \u0441\u0440\u0435\u0437\u0435
    \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0442 \u0432\u043E\u043B\u043D\u044B,
    \u0432 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0438 \u043A\u043E\u0442\u043E\u0440\u044B\u0445
    \u043F\u0440\u043E\u0445\u043E\u0434\u044F\u0442 \u0441\u043E\u0441\u0443\u0434\u0438\u0441\u0442\u043E-\u043D\u0435\u0440\u0432\u043D\u044B\u0435
    \u043F\u0443\u0447\u043A\u0438.\r\n\u041C\u044B\u0448\u0435\u0447\u043D\u044B\u0445
    \u0441\u043B\u043E\u0451\u0432 \u0434\u0432\u0430:\r\n\u2014 \u043D\u0430\u0440\u0443\u0436\u043D\u044B\u0439
    \u2014 \u0446\u0438\u0440\u043A\u0443\u043B\u044F\u0440\u043D\u044B\u0439, \u043C\u044B\u0448\u0435\u0447\u043D\u044B\u0435
    \u0432\u043E\u043B\u043E\u043A\u043D\u0430 \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u044E\u0442\u0441\u044F
    \u043F\u043E\u043F\u0435\u0440\u0451\u043A \u043E\u0441\u0438 \u043C\u043E\u0447\u0435\u0442\u043E\u0447\u043D\u0438\u043A\u0430;\r\n\u2014
    \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439 \u2014 \u043F\u0440\u043E\u0434\u043E\u043B\u044C\u043D\u044B\u0439.\r\n\u042D\u043F\u0438\u0442\u0435\u043B\u0438\u0430\u043B\u044C\u043D\u044B\u0439
    \u0441\u043B\u043E\u0439 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D
    \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u043D\u044B\u043C \u044D\u043F\u0438\u0442\u0435\u043B\u0438\u0435\u043C,
    \u043A\u043B\u0435\u0442\u043A\u0438 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
    \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u044E\u0442\u0441\u044F
    \u0432 3\u20135 \u0441\u043B\u043E\u0451\u0432, \u043E\u0431\u0440\u0430\u0437\u0443\u044F
    \u0441\u043A\u043B\u0430\u0434\u043A\u0438.\r\n\u0421\u043B\u0438\u0437\u0438\u0441\u0442\u0430\u044F
    \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0430 \u043F\u0440\u0438 \u0441\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u0438\u0438
    \u043C\u044B\u0448\u0446 \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442 \u0441\u043A\u043B\u0430\u0434\u043A\u0438,
    \u0447\u0442\u043E \u0441\u043F\u043E\u0441\u043E\u0431\u0441\u0442\u0432\u0443\u0435\u0442
    \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0432\u0430\u043D\u0438\u044E \u043F\u0440\u043E\u0441\u0432\u0435\u0442\u0430
    \u043C\u043E\u0447\u0435\u0442\u043E\u0447\u043D\u0438\u043A\u0430 \u043D\u0430
    \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u044B\u0445 \u0443\u0447\u0430\u0441\u0442\u043A\u0430\u0445.
    \u0412 \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u043B\u0435\u043D\u043D\u043E\u043C
    \u043C\u043E\u0447\u0435\u0442\u043E\u0447\u043D\u0438\u043A\u0435 \u043F\u0440\u043E\u0441\u0432\u0435\u0442
    \u043F\u043E\u0434 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C \u0432\u043E\u043B\u043D\u044B
    \u043C\u043E\u0447\u0438 \u043C\u043E\u0436\u0435\u0442 \u0432\u0435\u0440\u0435\u0442\u0435\u043D\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u043E
    \u0440\u0430\u0441\u0448\u0438\u0440\u044F\u0442\u044C\u0441\u044F.\r\n\u0412
    \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0439 \u0447\u0430\u0441\u0442\u0438
    \u043C\u043E\u0447\u0435\u0442\u043E\u0447\u043D\u0438\u043A \u044D\u043B\u0430\u0441\u0442\u0438\u0447\u043D\u043E
    \u0441\u0432\u044F\u0437\u0430\u043D \u0441 \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0435\u0439
    \u0442\u043A\u0430\u043D\u044C\u044E \u043D\u0435\u043F\u0440\u043E\u0447\u043D\u043E
    \u043F\u0440\u0438\u043A\u0440\u0435\u043F\u043B\u044F\u044E\u0449\u0435\u0439\u0441\u044F
    \u0430\u0434\u0432\u0435\u043D\u0442\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0439
    \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u043E\u0439, \u0447\u0442\u043E \u0432\u0430\u0436\u043D\u043E
    \u0434\u043B\u044F \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u043C\u043E\u0447\u0435\u0442\u043E\u0447\u043D\u0438\u043A\u0430
    \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0435\u0433\u043E \u0441\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u0438\u0439.\r\n\u041D\u0430
    \u0443\u0440\u043E\u0432\u043D\u0435 \u043C\u043E\u0447\u0435\u043F\u0443\u0437\u044B\u0440\u043D\u043E\u0433\u043E
    \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A\u0430 \u043C\u043E\u0447\u0435\u0442\u043E\u0447\u043D\u0438\u043A
    \u043D\u0430 \u043F\u043E\u043F\u0435\u0440\u0435\u0447\u043D\u044B\u0445 \u0441\u0440\u0435\u0437\u0430\u0445
    \u043D\u0435 \u0438\u043C\u0435\u0435\u0442 \u0447\u0451\u0442\u043A\u0438\u0445
    \u0432\u043D\u0435\u0448\u043D\u0438\u0445 \u0433\u0440\u0430\u043D\u0438\u0446,
    \u0442\u0430\u043A \u043A\u0430\u043A \u043C\u044B\u0448\u0446\u044B \u0438\u0434\u0443\u0442
    \u0432 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F\u0445,
    \u043E\u0431\u0440\u0430\u0437\u0443\u044F \u0435\u0434\u0438\u043D\u044B\u0439
    \u043C\u044B\u0448\u0435\u0447\u043D\u044B\u0439 \u043C\u0430\u0441\u0441\u0438\u0432
    \u0441 \u043C\u044B\u0448\u0446\u0430\u043C\u0438 \u043C\u043E\u0447\u0435\u0432\u043E\u0433\u043E
    \u043F\u0443\u0437\u044B\u0440\u044F.\r\n\u041C\u043E\u0447\u0435\u0442\u043E\u0447\u043D\u0438\u043A\u0438
    \u0438\u0434\u0443\u0442 \u0432\u0434\u043E\u043B\u044C \u043F\u043E\u0437\u0432\u043E\u043D\u043E\u0447\u043D\u043E\u0433\u043E
    \u0441\u0442\u043E\u043B\u0431\u0430 \u0432 \u043A\u0430\u0443\u0434\u043E\u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u043E\u043C
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438 \u0434\u043E
    \u0441\u0442\u0435\u043D\u043A\u0438 \u043C\u043E\u0447\u0435\u0432\u043E\u0433\u043E
    \u043F\u0443\u0437\u044B\u0440\u044F. \u0411\u0440\u044E\u0448\u043D\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C \u043C\u043E\u0447\u0435\u0442\u043E\u0447\u043D\u0438\u043A\u0430
    \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u043F\u043E\u0434 \u043F\u043E\u044F\u0441\u043D\u0438\u0447\u043D\u044B\u043C\u0438
    \u043C\u044B\u0448\u0446\u0430\u043C\u0438 \u0432 \u0437\u0430\u0431\u0440\u044E\u0448\u0438\u043D\u043D\u043E\u0439
    \u043E\u0431\u043B\u0430\u0441\u0442\u0438 \u043F\u043E\u0447\u0442\u0438 \u043F\u0430\u0440\u0430\u043B\u043B\u0435\u043B\u044C\u043D\u043E
    \u0441\u0440\u0435\u0434\u0438\u043D\u043D\u043E\u0439 \u043B\u0438\u043D\u0438\u0438.
    \u0422\u0430\u0437\u043E\u0432\u0430\u044F \u0447\u0430\u0441\u0442\u044C \u0438\u0437\u0433\u0438\u0431\u0430\u0435\u0442\u0441\u044F
    \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0432 \u043C\u043E\u0447\u0435\u043F\u043E\u043B\u043E\u0432\u043E\u0439
    \u0441\u043A\u043B\u0430\u0434\u043A\u0435 \u0431\u0440\u044E\u0448\u0438\u043D\u044B:
    \u0443 \u0441\u0430\u043C\u043A\u0438 \u2014 \u0432 \u0431\u0440\u044B\u0436\u0435\u0439\u043A\u0443
    \u043C\u0430\u0442\u043A\u0438, \u0443 \u0441\u0430\u043C\u0446\u0430 \u2014
    \u0432 \u0441\u043A\u043B\u0430\u0434\u043A\u0443 \u0441\u0435\u043C\u044F\u043F\u0440\u043E\u0432\u043E\u0434\u0430.\r\n\u041A\u043E\u043D\u0435\u0447\u043D\u044B\u0439
    \u0443\u0447\u0430\u0441\u0442\u043E\u043A \u043C\u043E\u0447\u0435\u0442\u043E\u0447\u043D\u0438\u043A\u0430
    \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0441 \u0434\u043E\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0439
    \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u043A \u0448\u0435\u0439\u043A\u0435
    \u043C\u043E\u0447\u0435\u0432\u043E\u0433\u043E \u043F\u0443\u0437\u044B\u0440\u044F
    \u0438 \u043F\u0440\u043E\u0431\u043E\u0434\u0430\u0435\u0442 \u0435\u0433\u043E
    \u0441\u0435\u0440\u043E\u0437\u043D\u0443\u044E \u0438 \u043C\u044B\u0448\u0435\u0447\u043D\u0443\u044E
    \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0438. \u0414\u0430\u043B\u0435\u0435
    \u043E\u043D \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439
    \u0443\u0447\u0430\u0441\u0442\u043E\u043A \u043C\u0435\u0436\u0434\u0443 \u043C\u044B\u0448\u0435\u0447\u043D\u043E\u0439
