  m_Name: "\u0421\u0440\u0435\u0434\u0438\u043D\u043D\u0430\u044F \u0430\u0440\u0442\u0435\u0440\u0438\u044F"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0421\u0440\u0435\u0434\u0438\u043D\u043D\u0430\u044F \u0430\u0440\u0442\u0435\u0440\u0438\u044F"
  scientificName: arteria mediana
  description: "\u041B\u0435\u0436\u0438\u0442 \u043D\u0430 \u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u043E\u0439
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u043F\u0440\u0435\u0434\u043F\u043B\u0435\u0447\u044C\u044F
    \u0432 \u0441\u0440\u0435\u0434\u0438\u043D\u043D\u043E\u043C \u0436\u0435\u043B\u043E\u0431\u0435
    \u043C\u0435\u0436\u0434\u0443 \u043B\u0443\u0447\u0435\u0432\u044B\u043C \u0441\u0433\u0438\u0431\u0430\u0442\u0435\u043B\u0435\u043C
    \u0438 \u043B\u0443\u0447\u0435\u0432\u043E\u0439 \u043A\u043E\u0441\u0442\u044C\u044E.
    \u041E\u0442 \u0441\u0440\u0435\u0434\u0438\u043D\u043D\u043E\u0439 \u0430\u0440\u0442\u0435\u0440\u0438\u0438
    \u043E\u0442\u0445\u043E\u0434\u044F\u0442:\n\u0430) \u0433\u043B\u0443\u0431\u043E\u043A\u0430\u044F
    \u0430\u0440\u0442\u0435\u0440\u0438\u044F \u043F\u0440\u0435\u0434\u043F\u043B\u0435\u0447\u044C\u044F
    - a. profunda antebrachii;\n\u0431) \u043F\u0440\u043E\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F
    \u043B\u0443\u0447\u0435\u0432\u0430\u044F \u0430\u0440\u0442\u0435\u0440\u0438\u044F
    - a. radialis proximalis;\n\u0432) \u043B\u0443\u0447\u0435\u0432\u0430\u044F
    \u0430\u0440\u0442\u0435\u0440\u0438\u044F - a. radialis;\n\u0433) \u043F\u0430\u043B\u044C\u043C\u0430\u0440\u043D\u0430\u044F
    \u0432\u0435\u0442\u0432\u044C \u0441\u0440\u0435\u0434\u0438\u043D\u043D\u043E\u0439
    \u0430\u0440\u0442\u0435\u0440\u0438\u0438 - \u0433 palmaris a. medianae"
