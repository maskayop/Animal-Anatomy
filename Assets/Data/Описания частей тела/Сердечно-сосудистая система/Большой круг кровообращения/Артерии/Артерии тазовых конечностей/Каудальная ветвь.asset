  m_Name: "\u041A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u0430\u044F \u0432\u0435\u0442\u0432\u044C"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u041A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u0430\u044F \u0432\u0435\u0442\u0432\u044C"
  scientificName: ramus caudalis
  description: "\u0418\u0434\u0451\u0442 \u043F\u043E \u043C\u0435\u0434\u0438\u043E\u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u043E\u0439
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u0433\u043E\u043B\u0435\u043D\u0438.
    \u041D\u0430 \u043F\u043B\u0430\u043D\u0442\u0430\u0440\u043D\u043E\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
    \u0437\u0430\u043F\u043B\u044E\u0441\u043D\u0435\u0432\u043E\u0433\u043E \u0441\u0443\u0441\u0442\u0430\u0432\u0430
    \u0434\u0435\u043B\u0438\u0442\u0441\u044F \u043D\u0430 \u043B\u0430\u0442\u0435\u0440\u0430\u043B\u044C\u043D\u0443\u044E
    \u0438 \u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u0443\u044E \u043F\u043B\u0430\u043D\u0442\u0430\u0440\u043D\u044B\u0435
    \u0430\u0440\u0442\u0435\u0440\u0438\u0438 - \u0430\u0430. plantares lateralis
    et medialis, - \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0438\u0434\u0443\u0442
    \u043F\u043E \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u043C
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044F\u043C \u0437\u0430\u043F\u043B\u044E\u0441\u043D\u0435\u0432\u043E\u0433\u043E
    \u0441\u0443\u0441\u0442\u0430\u0432\u0430 \u0438 \u043D\u0438\u0436\u0435 \u0435\u0433\u043E
    \u0444\u043E\u0440\u043C\u0438\u0440\u0443\u044E\u0442 \u0433\u043B\u0443\u0431\u043E\u043A\u0443\u044E
    \u043F\u043B\u0430\u043D\u0442\u0430\u0440\u043D\u0443\u044E \u0434\u0443\u0433\u0443
    - arcus plantaris profundus"
