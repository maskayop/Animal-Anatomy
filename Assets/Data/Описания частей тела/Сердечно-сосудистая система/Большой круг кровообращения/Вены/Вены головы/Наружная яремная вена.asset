  m_Name: "\u041D\u0430\u0440\u0443\u0436\u043D\u0430\u044F \u044F\u0440\u0435\u043C\u043D\u0430\u044F
    \u0432\u0435\u043D\u0430"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u041D\u0430\u0440\u0443\u0436\u043D\u0430\u044F \u044F\u0440\u0435\u043C\u043D\u0430\u044F
    \u0432\u0435\u043D\u0430"
  scientificName: vena jugularis externa
  description: "\u041B\u0435\u0436\u0438\u0442 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u043D\u043E
    \u0432 \u044F\u0440\u0435\u043C\u043D\u043E\u043C \u0436\u0435\u043B\u043E\u0431\u0435,
    \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442\u0441\u044F \u0441\u043B\u0438\u044F\u043D\u0438\u0435\u043C
    \u044F\u0437\u044B\u0447\u043D\u043E\u043B\u0438\u0446\u0435\u0432\u043E\u0439
    \u0438 \u0432\u0435\u0440\u0445\u043D\u0435\u0447\u0435\u043B\u044E\u0441\u0442\u043D\u043E\u0439
    \u0432\u0435\u043D, \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0449\u0438\u0445
    \u043A\u0440\u043E\u0432\u044C \u0441 \u043E\u0431\u043B\u0430\u0441\u0442\u0438
    \u0433\u043E\u043B\u043E\u0432\u044B.\n\u0412 \u043D\u0430\u0440\u0443\u0436\u043D\u0443\u044E
    \u044F\u0440\u0435\u043C\u043D\u0443\u044E \u0432\u0435\u043D\u0443 \u0432\u043F\u0430\u0434\u0430\u044E\u0442:\n1.
    \u0412\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u044F\u044F \u044F\u0440\u0435\u043C\u043D\u0430\u044F
    \u0432\u0435\u043D\u0430 - v. jugularis interna - \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
    \u043D\u0435\u0431\u043D\u044B\u043C \u0441\u043F\u043B\u0435\u0442\u0435\u043D\u0438\u0435\u043C
    \u0432 \u0441\u043B\u0438\u0437\u0438\u0441\u0442\u043E\u0439 \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0435
    \u0442\u0432\u0435\u0440\u0434\u043E\u0433\u043E \u043D\u0435\u0431\u0430, \u0441\u043B\u0435\u0434\u0443\u0435\u0442
    \u0432\u0434\u043E\u043B\u044C \u0432\u0435\u043D\u0442\u0440\u043E\u043B\u0430\u0442\u0435\u0440\u0430\u043B\u044C\u043D\u043E\u0439
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u0442\u0440\u0430\u0445\u0435\u0438,
    \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442 \u0432\u0435\u0442\u0432\u0438
    \u043E\u0442 \u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u043E\u0439 \u0436\u0435\u043B\u0435\u0437\u044B
    \u0438 \u0433\u043E\u0440\u0442\u0430\u043D\u0438;\n2. \u0413\u043E\u043B\u043E\u0432\u043D\u0430\u044F
    \u0432\u0435\u043D\u0430 - v. cephalica - \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u043D\u0430\u044F
    \u0432\u0435\u043D\u0430 \u0433\u0440\u0443\u0434\u043D\u043E\u0439 \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u0438;\n3.
    \u041F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u043D\u0430\u044F
    \u0448\u0435\u0439\u043D\u0430\u044F \u0432\u0435\u043D\u0430 - v. cervicalis
    superficialis"
