  m_Script: {fileID: 11500000, guid: 3f00395bd4580c04eb5d722a11c9666a, type: 3}
  m_Name: "\u0421\u0435\u0440\u0434\u0446\u0435 (\u043A\u0443\u0440\u0438\u0446\u0430)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0421\u0435\u0440\u0434\u0446\u0435"
  scientificName: cor (kardia)
  nameClip: {fileID: 8300000, guid: e682a37bf77569b4489198bad0b200bc, type: 3}
  description: "\u041F\u043E\u043B\u044B\u0439 \u043C\u044B\u0448\u0435\u0447\u043D\u044B\u0439
    \u043E\u0440\u0433\u0430\u043D, \u043A\u043E\u043D\u0443\u0441\u043E\u0432\u0438\u0434\u043D\u043E\u0439
    \u0444\u043E\u0440\u043C\u044B, \u043B\u0435\u0436\u0430\u0449\u0438\u0439 \u0432
    \u043A\u0440\u0430\u043D\u0438\u0430\u043B\u044C\u043D\u043E\u0439 \u0447\u0430\u0441\u0442\u0438
    \u043F\u043E\u043B\u043E\u0441\u0442\u0438 \u0442\u0435\u043B\u0430, \u043C\u0435\u0436\u0434\u0443
    \u0434\u043E\u043B\u044F\u043C\u0438 \u043F\u0435\u0447\u0435\u043D\u0438. \u0410\u043D\u0430\u0442\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0447\u0430\u0441\u0442\u0438 \u0441\u0435\u0440\u0434\u0446\u0430:\r\n1. \u041E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0435
    - basis cordis - \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043E
    \u043A\u0440\u0430\u043D\u0438\u043E\u0434\u043E\u0440\u0441\u0430\u043B\u044C\u043D\u043E;\r\n2.
    \u0412\u0435\u0440\u0445\u0443\u0448\u043A\u0430 - apex cordis - \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0430
    \u043A\u0430\u0443\u0434\u043E\u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E;\r\n3.
    \u041F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438:\r\n\u0430)
    \u0433\u0440\u0443\u0434\u0438\u043D\u043D\u0430\u044F - facies sternalis - \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0430
    \u043A \u0433\u0440\u0443\u0434\u0438\u043D\u0435;\r\n\u0431) \u043F\u0435\u0447\u0451\u043D\u043E\u0447\u043D\u0430\u044F
    - facies hepatica - \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0430 \u043A \u043F\u0435\u0447\u0435\u043D\u0438.\r\n5.
    \u0416\u0435\u043B\u043E\u0431\u0430:\r\n\u0430) \u0432\u0435\u043D\u0435\u0447\u043D\u044B\u0439
    (\u043A\u043E\u0440\u043E\u043D\u0430\u0440\u043D\u044B\u0439) - sulcus coronarius
    - \u043E\u043F\u043E\u044F\u0441\u044B\u0432\u0430\u0435\u0442 \u0441\u0435\u0440\u0434\u0446\u0435,
    \u0440\u0430\u0437\u0433\u0440\u0430\u043D\u0438\u0447\u0438\u0432\u0430\u044F
    \u0441\u043D\u0430\u0440\u0443\u0436\u0438 \u043F\u0440\u0435\u0434\u0441\u0435\u0440\u0434\u0438\u044F
    \u0443 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F \u0438 \u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043A\u0438,
    \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0435
    \u0431\u043B\u0438\u0436\u0435 \u043A \u0432\u0435\u0440\u0445\u0443\u0448\u043A\u0435.\r\n\u0421\u043D\u0430\u0440\u0443\u0436\u0438
    \u043E\u043D \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u0433\u0440\u0430\u043D\u0438\u0446\u0443
    \u043C\u0435\u0436\u0434\u0443 \u043F\u0440\u0435\u0434\u0441\u0435\u0440\u0434\u0438\u044F\u043C\u0438
    \u0438 \u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043A\u0430\u043C\u0438;\r\n\u0431)
    \u043C\u0435\u0436\u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043A\u043E\u0432\u044B\u0439
    \u0441\u0443\u0431\u0441\u0438\u043D\u0443\u043E\u0437\u043D\u044B\u0439 - sulcus
    interventricularis subsinuosus - \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
    \u043E\u0442 \u0441\u0438\u043D\u0443\u0441\u0430 \u043F\u043E\u043B\u044B\u0445
    \u0432\u0435\u043D \u043A \u0432\u0435\u0440\u0445\u0443\u0448\u043A\u0435 \u0441\u0435\u0440\u0434\u0446\u0430;\r\n\u0432)
    \u043C\u0435\u0436\u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043A\u043E\u0432\u044B\u0439
    \u043F\u0430\u0440\u0430\u043A\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439
    - sulcus interventricularis paraconalis - \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
    \u043E\u0442 \u0443\u0441\u0442\u044C\u044F \u0441\u0442\u0432\u043E\u043B\u0430
    \u043B\u0451\u0433\u043E\u0447\u043D\u044B\u0445 \u0430\u0440\u0442\u0435\u0440\u0438\u0439
    \u043A \u0432\u0435\u0440\u0445\u0443\u0448\u043A\u0435 \u0441\u0435\u0440\u0434\u0446\u0430.\r\n\u041C\u0435\u0436\u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043A\u043E\u0432\u044B\u0435
    \u0436\u0435\u043B\u043E\u0431\u0430 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0442
    \u043C\u0435\u0436\u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043A\u043E\u0432\u043E\u0439
    \u043F\u0435\u0440\u0435\u0433\u043E\u0440\u043E\u0434\u043A\u0435 \u0438 \u0441\u043D\u0430\u0440\u0443\u0436\u0438
    \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0430\u044E\u0442 \u0433\u0440\u0430\u043D\u0438\u0446\u0443
    \u043C\u0435\u0436\u0434\u0443 \u043B\u0435\u0432\u044B\u043C \u0438 \u043F\u0440\u0430\u0432\u044B\u043C
    \u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043A\u0430\u043C\u0438. \u0423 \u043A\u0443\u0440\u0438\u0446\u044B
    \u043E\u043D\u0438 \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u044B \u0441\u043B\u0430\u0431\u043E
    \u0438 \u043D\u0435 \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u044E\u0442 \u0432\u0435\u0440\u0445\u0443\u0448\u043A\u0438,
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u043D\u043E\u0439 \u043B\u0435\u0432\u044B\u043C
    \u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043A\u043E\u043C.\r\n\u0421\u0435\u0440\u0434\u0446\u0435
    \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442 4 \u043F\u043E\u043B\u043E\u0441\u0442\u0438,
    \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u043C\u044B\u0435 \u043A\u0430\u043C\u0435\u0440\u0430\u043C\u0438
    \u0441\u0435\u0440\u0434\u0446\u0430.\r\nI. \u041F\u0440\u0435\u0434\u0441\u0435\u0440\u0434\u0438\u044F
    - atria - \u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u044B \u043C\u0435\u0436\u0434\u0443
    \u0441\u043E\u0431\u043E\u0439 \u043C\u0435\u0436\u043F\u0440\u0435\u0434\u0441\u0435\u0440\u0434\u043D\u043E\u0439
    \u043F\u0435\u0440\u0435\u0433\u043E\u0440\u043E\u0434\u043A\u043E\u0439. \u0415\u0451
    \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u044D\u043C\u0431\u0440\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0435
    \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u044F \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F
    \u043F\u043E\u0441\u043B\u0435 \u0432\u044B\u043B\u0443\u043F\u043B\u0435\u043D\u0438\u044F.
    \u0420\u0430\u0437\u043B\u0438\u0447\u0430\u044E\u0442 \u0434\u0432\u0430 \u043F\u0440\u0435\u0434\u0441\u0435\u0440\u0434\u0438\u044F:\r\n1)
    \u043F\u0440\u0430\u0432\u043E\u0435 - atrium dextrum - \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
    \u0432\u0435\u043D\u043E\u0437\u043D\u0443\u044E \u043A\u0440\u043E\u0432\u044C
    \u0438\u0437 \u0434\u0432\u0443\u0445 \u043A\u0440\u0430\u043D\u0438\u0430\u043B\u044C\u043D\u044B\u0445
    \u0438 \u043E\u0434\u043D\u043E\u0439 \u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u043E\u0439
    \u043F\u043E\u043B\u044B\u0445 \u0432\u0435\u043D; \u0441\u044E\u0434\u0430 \u0442\u0430\u043A\u0436\u0435
    \u043E\u0442\u0442\u0435\u043A\u0430\u0435\u0442 \u043A\u0440\u043E\u0432\u044C
    \u043F\u043E \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u044B\u043C \u0432\u0435\u043D\u0430\u043C;\r\n2)
    \u043B\u0435\u0432\u043E\u0435 - atrium sinistrum - \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
    \u043A\u0440\u043E\u0432\u044C \u0438\u0437 \u043F\u0440\u0430\u0432\u043E\u0439
    \u0438 \u043B\u0435\u0432\u043E\u0439 \u043B\u0451\u0433\u043E\u0447\u043D\u044B\u0445
    \u0432\u0435\u043D.\r\nII. \u0416\u0435\u043B\u0443\u0434\u043E\u0447\u043A\u0438
    - ventriculi - \u0441\u043E\u043E\u0431\u0449\u0430\u044E\u0442\u0441\u044F \u0441
    \u043F\u0440\u0435\u0434\u0441\u0435\u0440\u0434\u0438\u044F\u043C\u0438 \u0447\u0435\u0440\u0435\u0437
    \u043F\u0440\u0430\u0432\u043E\u0435 \u0438 \u043B\u0435\u0432\u043E\u0435 \u043F\u0440\u0435\u0434\u0441\u0435\u0440\u0434\u043D\u043E-\u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043A\u043E\u0432\u044B\u0435
    \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u044F (ostium atrioventriculare
    dextrum et sinistrum). \u041C\u0435\u0436\u0434\u0443 \u0441\u043E\u0431\u043E\u0439
    \u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043A\u0438 \u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u044B
    \u043C\u0435\u0436\u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043A\u043E\u0432\u043E\u0439
    \u043F\u0435\u0440\u0435\u0433\u043E\u0440\u043E\u0434\u043A\u043E\u0439. \u041F\u0440\u0430\u0432\u044B\u0439
    \u043F\u0440\u0435\u0434\u0441\u0435\u0440\u0434\u043D\u043E-\u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043A\u043E\u0432\u044B\u0439
    \u043A\u043B\u0430\u043F\u0430\u043D \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    \u0441\u043E\u0431\u043E\u0439 \u043C\u044B\u0448\u0435\u0447\u043D\u0443\u044E
    \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u043A\u0443 \u0431\u0435\u0437 \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u044C\u043D\u044B\u0445
    \u0445\u043E\u0440\u0434; \u043B\u0435\u0432\u044B\u0439 \u0438\u043C\u0435\u0435\u0442
    \u0442\u0440\u0438 \u0441\u0442\u0432\u043E\u0440\u043A\u0438, \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0435
    \u0445\u043E\u0440\u0434\u0430\u043C\u0438 \u0441 \u0441\u043E\u0441\u043E\u0447\u043A\u043E\u0432\u044B\u043C\u0438
    \u043C\u044B\u0448\u0446\u0430\u043C\u0438.\r\n\u0420\u0430\u0437\u043B\u0438\u0447\u0430\u044E\u0442
    \u0434\u0432\u0430 \u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043A\u0430:\r\n1)
    \u043F\u0440\u0430\u0432\u044B\u0439 - ventriculus dexter - \u0438\u0437 \u043D\u0435\u0433\u043E
    \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0441\u0442\u0432\u043E\u043B \u043B\u0451\u0433\u043E\u0447\u043D\u044B\u0445
    \u0430\u0440\u0442\u0435\u0440\u0438\u0439;\r\n2) \u043B\u0435\u0432\u044B\u0439
    - ventriculus sinister - \u0438\u0437 \u043D\u0435\u0433\u043E \u0432\u044B\u0445\u043E\u0434\u0438\u0442
    \u0430\u043E\u0440\u0442\u0430 - \u0441\u0430\u043C\u0430\u044F \u043A\u0440\u0443\u043F\u043D\u0430\u044F
    \u0430\u0440\u0442\u0435\u0440\u0438\u044F \u0432 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u0435.\r\n\u041F\u0440\u0430\u0432\u043E\u0435
    \u043F\u0440\u0435\u0434\u0441\u0435\u0440\u0434\u0438\u0435 \u0438 \u0436\u0435\u043B\u0443\u0434\u043E\u0447\u0435\u043A
    \u043F\u0440\u043E\u043A\u0430\u0447\u0438\u0432\u0430\u044E\u0442 \u0432\u0435\u043D\u043E\u0437\u043D\u0443\u044E
    \u043A\u0440\u043E\u0432\u044C, \u0430 \u043B\u0435\u0432\u043E\u0435 \u043F\u0440\u0435\u0434\u0441\u0435\u0440\u0434\u0438\u0435
    \u0438 \u043B\u0435\u0432\u044B\u0439 \u0436\u0435\u043B\u0443\u0434\u043E\u0447\u0435\u043A
    - \u0430\u0440\u0442\u0435\u0440\u0438\u0430\u043B\u044C\u043D\u0443\u044E"
  clip: {fileID: 8300000, guid: 255e2c681a3d2d84baf2eaa1eb303699, type: 3}
