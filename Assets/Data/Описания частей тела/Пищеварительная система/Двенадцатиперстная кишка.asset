  m_Name: "\u0414\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u0438\u043F\u0435\u0440\u0441\u0442\u043D\u0430\u044F
    \u043A\u0438\u0448\u043A\u0430"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0414\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u0438\u043F\u0435\u0440\u0441\u0442\u043D\u0430\u044F
    \u043A\u0438\u0448\u043A\u0430"
  scientificName: intestinum duodenum
  description: "\u0427\u0430\u0441\u0442\u044C \u0442\u043E\u043D\u043A\u043E\u0433\u043E
    \u043E\u0442\u0434\u0435\u043B\u0430 \u043A\u0438\u0448\u0435\u0447\u043D\u0438\u043A\u0430,
    \u0433\u0434\u0435 \u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435 \u0438\u043D\u0442\u0435\u043D\u0441\u0438\u0432\u043D\u043E
    \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442 \u043F\u0435\u0440\u0435\u0432\u0430\u0440\u0438\u0432\u0430\u043D\u0438\u0435
    \u0438 \u0432\u0441\u0430\u0441\u044B\u0432\u0430\u043D\u0438\u0435 \u043F\u0438\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432.\n\u041A\u0438\u0448\u043A\u0430 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
    \u0432 \u043F\u0440\u0430\u0432\u043E\u043C \u043F\u043E\u0434\u0440\u0435\u0431\u0435\u0440\u044C\u0435
    \u0438 \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E \u0437\u0430\u0445\u043E\u0434\u0438\u0442
    \u0432 \u043F\u043E\u044F\u0441\u043D\u0438\u0447\u043D\u0443\u044E \u043E\u0431\u043B\u0430\u0441\u0442\u044C.\n\u0423
    \u043A\u0440\u0443\u043F\u043D\u043E\u0433\u043E \u0440\u043E\u0433\u0430\u0442\u043E\u0433\u043E
    \u0441\u043A\u043E\u0442\u0430 \u0434\u043B\u0438\u043D\u0430 90\u2013120 \u0441\u043C,
    \u0434\u0438\u0430\u043C\u0435\u0442\u0440 \u0434\u043E 5\u20137 \u0441\u043C.\n\u041F\u043E\u0434\u0432\u0435\u0448\u0435\u043D\u0430
    \u043D\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0439 \u0431\u0440\u044B\u0436\u0435\u0439\u043A\u0435,
    \u043C\u0430\u043B\u043E\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u0430. \u041D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
    \u043E\u0442 \u043F\u0438\u043B\u043E\u0440\u0443\u0441\u0430 \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438
    \u0441\u0442\u0435\u0440\u043D\u0430\u043B\u044C\u043D\u044B\u0445 \u043A\u043E\u043D\u0446\u043E\u0432
    9\u201311-\u0433\u043E \u0440\u0435\u0431\u0440\u0430 \u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043A \u0432\u043E\u0440\u043E\u0442\u0430\u043C \u043F\u0435\u0447\u0435\u043D\u0438,
    \u0433\u0434\u0435 \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442 S-\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0439
    \u0438\u0437\u0433\u0438\u0431. \u0417\u0430\u0442\u0435\u043C \u043A\u0438\u0448\u043A\u0430
    \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F \u043F\u043E
    \u043F\u0435\u0447\u0435\u043D\u0438 \u0434\u043E\u0440\u0441\u043E\u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u043E
    \u043A \u043F\u0440\u0430\u0432\u043E\u0439 \u043F\u043E\u0447\u043A\u0435, \u043D\u0430
    \u0443\u0440\u043E\u0432\u043D\u0435 4\u20135-\u0433\u043E \u043F\u043E\u044F\u0441\u043D\u0438\u0447\u043D\u044B\u0445
    \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u043E\u0432 \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
    \u0441\u043F\u0440\u0430\u0432\u0430 \u043D\u0430\u043B\u0435\u0432\u043E, \u043E\u0431\u0440\u0430\u0437\u0443\u044F
    \u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u0443\u044E \u0438\u0437\u0432\u0438\u043B\u0438\u043D\u0443.
    \u041F\u043E\u0441\u043B\u0435 \u0447\u0435\u0433\u043E \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043A\u0440\u0430\u043D\u0438\u0430\u043B\u044C\u043D\u043E \u0438 \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438
    \u043F\u0435\u0447\u0435\u043D\u0438 \u0431\u0435\u0437 \u0440\u0435\u0437\u043A\u0438\u0445
    \u0433\u0440\u0430\u043D\u0438\u0446 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
    \u0432 \u0442\u043E\u0449\u0443\u044E \u043A\u0438\u0448\u043A\u0443.\n\u0412
    \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u0438\u043F\u0435\u0440\u0441\u0442\u043D\u0443\u044E
    \u043A\u0438\u0448\u043A\u0443 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F
    \u043F\u0440\u043E\u0442\u043E\u043A\u0438 \u043F\u0435\u0447\u0435\u043D\u0438
    \u0438 \u043F\u043E\u0434\u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043D\u043E\u0439
    \u0436\u0435\u043B\u0435\u0437\u044B. \u0423 \u043A\u0440\u0443\u043F\u043D\u043E\u0433\u043E
    \u0440\u043E\u0433\u0430\u0442\u043E\u0433\u043E \u0441\u043A\u043E\u0442\u0430
    \u0436\u0435\u043B\u0447\u043D\u044B\u0439 \u043F\u0440\u043E\u0442\u043E\u043A
    \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043D\u0430
    \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438 50\u201370 \u0441\u043C
    \u043E\u0442 \u043D\u0430\u0447\u0430\u043B\u0430 \u043A\u0438\u0448\u043A\u0438,
    \u043F\u0440\u043E\u0442\u043E\u043A \u043F\u043E\u0434\u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043D\u043E\u0439
    \u0436\u0435\u043B\u0435\u0437\u044B \u2014 \u043D\u0430 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438
    30\u201340 \u0441\u043C.\n\u0424\u043D\u0443\u043A\u0446\u0438\u0438:\n- \u043F\u0435\u0440\u0435\u0432\u0430\u0440\u0438\u0432\u0430\u043D\u0438\u0435
    \u043F\u0438\u0449\u0438, \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u0432\u0448\u0435\u0439
    \u0438\u0437 \u0436\u0435\u043B\u0443\u0434\u043A\u0430. \u0424\u0435\u0440\u043C\u0435\u043D\u0442\u044B,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0432\u044B\u0434\u0435\u043B\u044F\u0435\u0442
    \u043F\u043E\u0434\u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043D\u0430\u044F
    \u0436\u0435\u043B\u0435\u0437\u0430 \u0438 \u0441\u0442\u0435\u043D\u043A\u0438
    \u043A\u0438\u0448\u043A\u0438, \u043F\u0435\u0440\u0435\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E\u0442
    \u0443\u0433\u043B\u0435\u0432\u043E\u0434\u044B, \u0436\u0438\u0440\u044B \u0438
    \u043F\u0440\u043E\u0442\u0435\u0438\u043D;\n- \u0432\u0441\u0430\u0441\u044B\u0432\u0430\u043D\u0438\u0435
    \u043F\u0438\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u0432\u0435\u0449\u0435\u0441\u0442\u0432;
    \u0441\u043B\u0438\u0437\u0438\u0441\u0442\u0430\u044F \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0430
    \u043A\u0438\u0448\u043A\u0438 \u043F\u043E\u043A\u0440\u044B\u0442\u0430 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u043C\u0438
    \u0432\u043E\u0440\u0441\u0438\u043D\u043A\u0430\u043C\u0438, \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
    \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043F\u043B\u043E\u0449\u0430\u0434\u044C \u0438 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C
    \u0432\u0441\u0430\u0441\u044B\u0432\u0430\u043D\u0438\u044F;\n- \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430
    \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u043E\u0432 \u043F\u0438\u0449\u0435\u0432\u0430\u0440\u0435\u043D\u0438\u044F
    \u043A \u0432\u0441\u0430\u0441\u044B\u0432\u0430\u043D\u0438\u044E \u2014 \u0436\u0435\u043B\u0447\u044C,
    \u043F\u043E\u043F\u0430\u0434\u0430\u044E\u0449\u0430\u044F \u0432 \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u0438\u043F\u0435\u0440\u0441\u0442\u043D\u0443\u044E
    \u043A\u0438\u0448\u043A\u0443 \u0447\u0435\u0440\u0435\u0437 \u0436\u0435\u043B\u0447\u043D\u044B\u0439
    \u043F\u0440\u043E\u0442\u043E\u043A, \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442
    \u0443\u0441\u0432\u043E\u0435\u043D\u0438\u044E \u0436\u0438\u0440\u043E\u0432"
  clip: {fileID: 0}
