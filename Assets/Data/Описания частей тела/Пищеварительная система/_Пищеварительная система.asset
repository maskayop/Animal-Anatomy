  m_Name: "_\u041F\u0438\u0449\u0435\u0432\u0430\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
    \u0441\u0438\u0441\u0442\u0435\u043C\u0430"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u041F\u0438\u0449\u0435\u0432\u0430\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
    \u0441\u0438\u0441\u0442\u0435\u043C\u0430"
  scientificName: systema digestorium
  description: "\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    \u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0441 \u043E\u0440\u0433\u0430\u043D\u043E\u0432,
    \u043E\u0442\u043D\u043E\u0441\u044F\u0449\u0438\u0445\u0441\u044F \u043A \u0431\u043E\u043B\u0435\u0435
    \u0440\u0430\u043D\u043D\u0438\u043C \u043F\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044E
    \u0438 \u0438\u043C\u0435\u044E\u0449\u0438\u0445, \u043F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E
    \u0441 \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u0430\u043F\u043F\u0430\u0440\u0430\u0442\u0430\u043C\u0438
    \u043D\u0430\u0438\u0431\u043E\u043B\u044C\u0448\u0443\u044E \u043C\u0430\u0441\u0441\u0443
    \u0438 \u043E\u0431\u044A\u0451\u043C. \u041E\u0440\u0433\u0430\u043D\u0430\u043C\u0438
    \u0430\u043F\u043F\u0430\u0440\u0430\u0442\u0430 \u043F\u0438\u0449\u0435\u0432\u0430\u0440\u0435\u043D\u0438\u044F
    \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F:
    \u0437\u0430\u0445\u0432\u0430\u0442 \u043F\u0438\u0449\u0438 \u0438 \u0432\u043E\u0434\u044B,
    \u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435 \u043F\u0438\u0449\u0435\u0432\u043E\u0433\u043E
    \u043A\u043E\u043C\u043A\u0430, \u0440\u0430\u0441\u0449\u0435\u043F\u043B\u0435\u043D\u0438\u0435
    \u043F\u0438\u0449\u0438 \u0438 \u0432\u0441\u0430\u0441\u044B\u0432\u0430\u043D\u0438\u0435
    \u043F\u0438\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u0432\u0435\u0449\u0435\u0441\u0442\u0432
    \u0432 \u043A\u0440\u043E\u0432\u044C \u0438\u043B\u0438 \u043B\u0438\u043C\u0444\u0443"
  clip: {fileID: 8300000, guid: e3b7f5bb41c77e144833a466291afe37, type: 3}
