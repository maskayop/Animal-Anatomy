    \u0432 \u0441\u0442\u0435\u043D\u043A\u0435 \u043A\u0438\u0448\u0435\u0447\u043D\u043E\u0439
    \u0442\u0440\u0443\u0431\u043A\u0438.\r\n\u0421\u043B\u0438\u0437\u0438\u0441\u0442\u0430\u044F
    \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0430 \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442
    \u043C\u043D\u043E\u0433\u043E\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u044B\u0435
    \u043F\u0440\u0438\u0441\u043F\u043E\u0441\u043E\u0431\u043B\u0435\u043D\u0438\u044F,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044E\u0442
    \u0432\u0441\u0430\u0441\u044B\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u0443\u044E
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C: \u0446\u0438\u0440\u043A\u0443\u043B\u044F\u0440\u043D\u044B\u0435
    \u0441\u043A\u043B\u0430\u0434\u043A\u0438 \u0438 \u0432\u043E\u0440\u0441\u0438\u043D\u044B.\r\n\u041C\u0435\u0436\u0434\u0443
    \u0432\u043E\u0440\u0441\u0438\u043D\u043A\u0430\u043C\u0438 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
    \u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u0442\u0443\u0431\u0443\u043B\u043E\u0430\u043B\u044C\u0432\u0435\u043E\u043B\u044F\u0440\u043D\u044B\u0445
    \u0436\u0435\u043B\u0451\u0437, \u0432\u044B\u0434\u0435\u043B\u044F\u044E\u0449\u0438\u0445
    \u0441\u043B\u0438\u0437\u044C \u0438 \u0437\u0430\u0449\u0438\u0449\u0430\u044E\u0449\u0438\u0445
    \u0441\u043B\u0438\u0437\u0438\u0441\u0442\u0443\u044E \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0443
    \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u0438\u043F\u0435\u0440\u0441\u0442\u043D\u043E\u0439
    \u043A\u0438\u0448\u043A\u0438 \u043E\u0442 \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
    \u0441\u043E\u043B\u044F\u043D\u043E\u0439 \u043A\u0438\u0441\u043B\u043E\u0442\u044B.\r\n\u0422\u043E\u043B\u0441\u0442\u044B\u0439
    \u043E\u0442\u0434\u0435\u043B \u0441\u043E\u0441\u0442\u043E\u0438\u0442 \u0438\u0437
    \u0441\u043B\u0435\u043F\u043E\u0439, \u043E\u0431\u043E\u0434\u043E\u0447\u043D\u043E\u0439
    \u0438 \u043F\u0440\u044F\u043C\u043E\u0439 \u043A\u0438\u0448\u043E\u043A.\r\n\u0424\u0443\u043D\u043A\u0446\u0438\u0438:\r\n-
    \u0412\u0441\u0430\u0441\u044B\u0432\u0430\u043D\u0438\u0435 \u0432\u043E\u0434\u044B,
    \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0432\u0438\u0442\u0430\u043C\u0438\u043D\u043E\u0432
    \u0438 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043B\u0438\u0442\u043E\u0432.\r\n-
    \u0417\u0430\u0432\u0435\u0440\u0448\u0430\u0435\u0442\u0441\u044F \u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
    \u043A\u0430\u043B\u043E\u0432\u044B\u0445 \u043C\u0430\u0441\u0441.\r\n- \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
    \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u043E\u0439 \u043F\u0435\u0440\u0438\u0441\u0442\u0430\u043B\u044C\u0442\u0438\u043A\u0435
    \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442 \u043F\u0440\u043E\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435
    \u0445\u0438\u043C\u0443\u0441\u0430 \u043F\u043E \u043A\u0438\u0448\u0435\u0447\u043D\u0438\u043A\u0443
    \u0441 \u043F\u043E\u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u044D\u0432\u0430\u043A\u0443\u0430\u0446\u0438\u0435\u0439
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u0432\u0448\u0435\u0433\u043E\u0441\u044F
    \u043A\u0430\u043B\u0430 \u0438\u0437 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u0430.\r\n\u0412
    \u0441\u043B\u0438\u0437\u0438\u0441\u0442\u043E\u0439 \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0435
