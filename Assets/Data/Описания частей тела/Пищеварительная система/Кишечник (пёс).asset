  description: "\u041C\u044B\u0448\u0435\u0447\u043D\u0430\u044F \u0442\u0440\u0443\u0431\u043A\u0430,
    \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u0430\u044F
    \u0434\u043B\u044F \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u044D\u0442\u0430\u043F\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u0440\u0438\u0432\u0430\u043D\u0438\u044F
    \u0438 \u0432\u0441\u0430\u0441\u044B\u0432\u0430\u043D\u0438\u044F \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0445
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432 \u0432 \u043A\u0440\u043E\u0432\u0435\u043D\u043E\u0441\u043D\u0443\u044E
    \u0441\u0435\u0442\u044C. \u0421\u043E\u0441\u0442\u043E\u0438\u0442 \u0438\u0437
    \u0442\u043E\u043D\u043A\u043E\u0433\u043E \u0438 \u0442\u043E\u043B\u0441\u0442\u043E\u0433\u043E
    \u043E\u0442\u0434\u0435\u043B\u043E\u0432.\r\n\u0414\u043B\u0438\u043D\u0430
    \u043A\u0438\u0448\u0435\u0447\u043D\u0438\u043A\u0430 \u043C\u043E\u0436\u0435\u0442
    \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0442\u044C 2,5\u20137,5 \u043C \u0432
    \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442
    \u0440\u0430\u0437\u043C\u0435\u0440\u0430 \u0441\u043E\u0431\u0430\u043A\u0438.\r\n\u0422\u043E\u043D\u043A\u0438\u0439
    \u043E\u0442\u0434\u0435\u043B \u0441\u043E\u0441\u0442\u043E\u0438\u0442 \u0438\u0437
    \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u0438\u043F\u0435\u0440\u0441\u0442\u043D\u043E\u0439,
    \u0442\u043E\u0449\u0435\u0439 \u0438 \u043F\u043E\u0434\u0432\u0437\u0434\u043E\u0448\u043D\u043E\u0439
    \u043A\u0438\u0448\u043A\u0438.\r\n\u0424\u0443\u043D\u043A\u0446\u0438\u0438:\r\n-
    \u0417\u0430\u0432\u0435\u0440\u0448\u0430\u0435\u0442\u0441\u044F \u043F\u0435\u0440\u0435\u0432\u0430\u0440\u0438\u0432\u0430\u043D\u0438\u0435
    \u043F\u0438\u0449\u0438 \u043F\u043E\u0434 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\u043C
    \u0444\u0435\u0440\u043C\u0435\u043D\u0442\u043E\u0432, \u0432\u044B\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u043C\u044B\u0445
    \u043F\u0435\u0447\u0435\u043D\u044C\u044E \u0438 \u043F\u043E\u0434\u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043D\u043E\u0439
    \u0436\u0435\u043B\u0435\u0437\u043E\u0439.\n- \u041E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0432\u0441\u0430\u0441\u044B\u0432\u0430\u043D\u0438\u0435 \u0432 \u043A\u0440\u043E\u0432\u044C
    \u0438 \u043B\u0438\u043C\u0444\u0443 \u043F\u0435\u0440\u0435\u0432\u0430\u0440\u0435\u043D\u043D\u044B\u0445
