  m_Script: {fileID: 11500000, guid: 3f00395bd4580c04eb5d722a11c9666a, type: 3}
  m_Name: "\u0416\u0435\u043B\u0443\u0434\u043E\u043A (\u0441\u0432\u0438\u043D\u044C\u044F)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0416\u0435\u043B\u0443\u0434\u043E\u043A"
  scientificName: ventriculus
  description: "\u041E\u0434\u043D\u043E\u043A\u0430\u043C\u0435\u0440\u043D\u044B\u0439
    \u043E\u0440\u0433\u0430\u043D \u043F\u0438\u0449\u0435\u0432\u043E\u0434\u043D\u043E-\u043A\u0438\u0448\u0435\u0447\u043D\u043E\u0433\u043E
    \u0442\u0438\u043F\u0430. \u0418\u043C\u0435\u0435\u0442 \u0447\u0430\u0448\u0435\u043E\u0431\u0440\u0430\u0437\u043D\u0443\u044E
    \u0444\u043E\u0440\u043C\u0443, \u043E\u0431\u044A\u0451\u043C \u2014 6,5\u20139
    \u043B.\n\u041E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u0438 \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F:\n-
    \u0414\u0432\u0435 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438:
    \u0434\u0438\u0430\u0444\u0440\u0430\u0433\u043C\u0430\u043B\u044C\u043D\u0430\u044F
    (\u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0430 \u043A \u0434\u0438\u0430\u0444\u0440\u0430\u0433\u043C\u0435)
    \u0438 \u0432\u0438\u0441\u0446\u0435\u0440\u0430\u043B\u044C\u043D\u0430\u044F
    (\u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0430 \u043A \u043A\u0438\u0448\u0435\u0447\u043D\u0438\u043A\u0443).\n-
    \u0411\u043E\u043B\u044C\u0448\u0430\u044F \u043A\u0440\u0438\u0432\u0438\u0437\u043D\u0430
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0430 \u043D\u0430\u043B\u0435\u0432\u043E,
    \u0432\u043D\u0438\u0437 \u0438 \u043D\u0430\u0437\u0430\u0434, \u043C\u0430\u043B\u0430\u044F
    \u2014 \u043D\u0430\u043F\u0440\u0430\u0432\u043E \u0438 \u0432\u0432\u0435\u0440\u0445.\r\n-
    \u0412\u0445\u043E\u0434 \u043F\u0438\u0449\u0435\u0432\u043E\u0434\u0430 \u0432
    \u0436\u0435\u043B\u0443\u0434\u043E\u043A \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442
    \u043A\u0430\u0440\u0434\u0438\u0430\u043B\u044C\u043D\u043E\u0435 \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435,
    \u043E\u043D\u043E \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043E
    \u0441\u043B\u0435\u0432\u0430.\r\n- \u0412\u044B\u0445\u043E\u0434 \u0438\u0437
    \u0436\u0435\u043B\u0443\u0434\u043A\u0430 \u0432 \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u0438\u043F\u0435\u0440\u0441\u0442\u043D\u0443\u044E
    \u043A\u0438\u0448\u043A\u0443 \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442
    \u043F\u0438\u043B\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435.\r\n-
    \u0412\u043E\u043A\u0440\u0443\u0433 \u043A\u0430\u0440\u0434\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u044F \u0432\u043E\u0440\u043E\u043D\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u043E\u0439
    \u0444\u043E\u0440\u043C\u044B \u0432\u044B\u0434\u0435\u043B\u044F\u044E\u0442
    \u043B\u0435\u0432\u0443\u044E \u043A\u0430\u0440\u0434\u0438\u0430\u043B\u044C\u043D\u0443\u044E
    \u0447\u0430\u0441\u0442\u044C, \u0430 \u0432\u043E\u043A\u0440\u0443\u0433 \u043F\u0438\u043B\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u044F, \u0441\u043F\u0440\u0430\u0432\u0430,
    \u2014 \u043F\u0438\u043B\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u0447\u0430\u0441\u0442\u044C.\r\n- \u041C\u0435\u0436\u0434\u0443 \u044D\u0442\u0438\u043C\u0438
    \u0434\u0432\u0443\u043C\u044F \u0447\u0430\u0441\u0442\u044F\u043C\u0438, \u0432
    \u0441\u0440\u0435\u0434\u043D\u0435\u0439 \u0447\u0430\u0441\u0442\u0438, \u043F\u043E
    \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043A\u0440\u0438\u0432\u0438\u0437\u043D\u0435,
    \u0432\u044B\u0434\u0435\u043B\u044F\u044E\u0442 \u0434\u043E\u043D\u043D\u0443\u044E
    \u0447\u0430\u0441\u0442\u044C \u0436\u0435\u043B\u0443\u0434\u043A\u0430.\n\u041C\u044B\u0448\u0435\u0447\u043D\u0430\u044F
    \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0430 \u0441\u043E\u0441\u0442\u043E\u0438\u0442
    \u0438\u0437 \u043F\u0440\u043E\u0434\u043E\u043B\u044C\u043D\u043E\u0433\u043E
    \u0438 \u043A\u043E\u0441\u043E\u0433\u043E \u0441\u043B\u043E\u0451\u0432 \u0433\u043B\u0430\u0434\u043A\u043E\u0439
    \u043C\u044B\u0448\u0435\u0447\u043D\u043E\u0439 \u0442\u043A\u0430\u043D\u0438.\r\n\u0416\u0435\u043B\u0443\u0434\u043E\u043A
    \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D \u043F\u043E\u043F\u0435\u0440\u0451\u043A
    \u0431\u0440\u044E\u0448\u043D\u043E\u0439 \u043F\u043E\u043B\u043E\u0441\u0442\u0438,
    \u043A\u0430\u0440\u0434\u0438\u0430\u043B\u044C\u043D\u0430\u044F \u0447\u0430\u0441\u0442\u044C
    \u2014 \u0432 \u043B\u0435\u0432\u043E\u043C \u043F\u043E\u0434\u0440\u0435\u0431\u0435\u0440\u044C\u0435,
    \u043F\u0438\u043B\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0447\u0430\u0441\u0442\u044C
    \u0437\u0430\u0445\u043E\u0434\u0438\u0442 \u0432 \u043F\u0440\u0430\u0432\u043E\u0435
    \u043F\u043E\u0434\u0440\u0435\u0431\u0435\u0440\u044C\u0435.\n\u0412 \u0441\u043B\u0438\u0437\u0438\u0441\u0442\u043E\u0439
    \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0435 \u0436\u0435\u043B\u0443\u0434\u043A\u0430
    \u0437\u0430\u043B\u043E\u0436\u0435\u043D\u044B \u043F\u0438\u0449\u0435\u0432\u0430\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u0436\u0435\u043B\u0435\u0437\u044B, \u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435
    \u0432\u0430\u0436\u043D\u044B\u0435 \u0438\u0437 \u043A\u043E\u0442\u043E\u0440\u044B\u0445
    \u043D\u0430\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438
    \u0434\u043D\u0430 \u0436\u0435\u043B\u0443\u0434\u043A\u0430"
  clip: {fileID: 0}
