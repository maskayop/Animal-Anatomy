  m_Script: {fileID: 11500000, guid: 3f00395bd4580c04eb5d722a11c9666a, type: 3}
  m_Name: "\u041F\u0435\u0447\u0435\u043D\u044C"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u041F\u0435\u0447\u0435\u043D\u044C"
  scientificName: hepar
  description: "\u042F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0441\u0430\u043C\u043E\u0439
    \u043A\u0440\u0443\u043F\u043D\u043E\u0439 \u043C\u043D\u043E\u0433\u043E\u0444\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0439
    \u0436\u0435\u043B\u0435\u0437\u043E\u0439 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u0430.
    \u0423\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0442 \u0432 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0438
    \u0436\u0435\u043B\u0447\u0438.\n\u041F\u0435\u0447\u0435\u043D\u044C \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043F\u0430\u0440\u0435\u043D\u0445\u0438\u043C\u0430\u0442\u043E\u0437\u043D\u044B\u043C
    \u043E\u0440\u0433\u0430\u043D\u043E\u043C \u0438 \u0441\u043E\u0441\u0442\u043E\u0438\u0442
    \u0438\u0437 \u0441\u0442\u0440\u043E\u043C\u044B \u0438 \u043F\u0430\u0440\u0435\u043D\u0445\u0438\u043C\u044B.\n\u0421\u043D\u0430\u0440\u0443\u0436\u0438
    \u043F\u0435\u0447\u0435\u043D\u044C \u043F\u043E\u043A\u0440\u044B\u0442\u0430
    \u0441\u0435\u0440\u043E\u0437\u043D\u043E\u0439 \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u043E\u0439
    \u0431\u0440\u044E\u0448\u043D\u043E\u0439 \u043F\u043E\u043B\u043E\u0441\u0442\u0438
    \u2013 \u0431\u0440\u044E\u0448\u0438\u043D\u043E\u0439. \u041F\u043B\u043E\u0442\u043D\u0430\u044F
    \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
    \u0442\u043A\u0430\u043D\u044C \u043F\u043E \u043F\u0435\u0440\u0438\u0444\u0435\u0440\u0438\u0438
    \u043E\u0440\u0433\u0430\u043D\u0430 \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442
    \u0442\u043E\u043D\u043A\u0443\u044E \u0432\u043E\u043B\u043E\u043A\u043D\u0438\u0441\u0442\u0443\u044E
    \u043A\u0430\u043F\u0441\u0443\u043B\u0443. \u041D\u0430\u0438\u0431\u043E\u043B\u0435\u0435
    \u0441\u0438\u043B\u044C\u043D\u043E \u043A\u0430\u043F\u0441\u0443\u043B\u0430
    \u0440\u0430\u0437\u0432\u0438\u0442\u0430 \u0443 \u0432\u043E\u0440\u043E\u0442
    \u043F\u0435\u0447\u0435\u043D\u0438. \u041E\u0442 \u043A\u0430\u043F\u0441\u0443\u043B\u044B
    \u043E\u0442\u0445\u043E\u0434\u044F\u0442 \u0432\u043D\u0443\u0442\u0440\u044C
    \u043E\u0440\u0433\u0430\u043D\u0430 \u043C\u043D\u043E\u0433\u043E\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u044B\u0435
    \u0442\u0440\u0430\u0431\u0435\u043A\u0443\u043B\u044B \u0438 \u0434\u0435\u043B\u044F\u0442
    \u043F\u0430\u0440\u0435\u043D\u0445\u0438\u043C\u0443 \u043F\u0435\u0447\u0435\u043D\u0438
    \u043D\u0430 \u0434\u043E\u043B\u044C\u043A\u0438, \u043A\u0430\u0436\u0434\u0430\u044F
    \u0438\u0437 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0441\u043E\u0441\u0442\u043E\u0438\u0442
    \u0438\u0437 \u0433\u0435\u043F\u0430\u0442\u043E\u0446\u0438\u0442\u043E\u0432
    (\u043F\u0435\u0447\u0435\u043D\u043E\u0447\u043D\u0430\u044F \u043A\u043B\u0435\u0442\u043A\u0430,
    \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u043D\u043E-\u0444\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u0430\u044F
    \u0435\u0434\u0438\u043D\u0438\u0446\u0430 \u043F\u0435\u0447\u0435\u043D\u0438).\n\u0412
    \u0442\u043A\u0430\u043D\u044F\u0445 \u043F\u0435\u0447\u0451\u043D\u043E\u0447\u043D\u044B\u0445
    \u0434\u043E\u043B\u0435\u0439 \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u044E\u0442\u0441\u044F
    \u0442\u0440\u0438\u0430\u0434\u044B - trias hepatis: \u043C\u0435\u0436\u0434\u043E\u043B\u044C\u043A\u043E\u0432\u0430\u044F
    \u0430\u0440\u0442\u0435\u0440\u0438\u044F, \u0432\u0435\u043D\u0430, \u0436\u0435\u043B\u0447\u043D\u044B\u0439
    \u043F\u0440\u043E\u0442\u043E\u043A. \u041E\u043D\u0438 \u043E\u0431\u0440\u0430\u0437\u0443\u044E\u0442
    \u043C\u0435\u0436\u0434\u043E\u043B\u044C\u043A\u043E\u0432\u044B\u0435 \u0432\u0435\u043D\u044B,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044F\u0442
    \u0432 \u043A\u0430\u043F\u0438\u043B\u043B\u044F\u0440\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044F\u0442 \u0432 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u0443\u044E
    \u0432\u0435\u043D\u0443 \u0434\u043E\u043B\u044C\u043A\u0438 - v.centralis,
    \u0430 \u043E\u043D\u0438 \u043E\u0431\u0440\u0430\u0437\u0443\u044E\u0442 \u043F\u043E\u0434\u0434\u043E\u043B\u044C\u043A\u043E\u0432\u044B\u0435
    \u0432\u0435\u043D\u044B - v.sublobulares. \u041F\u043E\u0434\u0434\u043E\u043B\u044C\u043A\u043E\u0432\u044B\u0435
    \u0432\u0435\u043D\u044B \u043E\u0431\u0440\u0430\u0437\u0443\u044E\u0442 \u043F\u0435\u0447\u0451\u043D\u043E\u0447\u043D\u044B\u0435
    \u0432\u0435\u043D\u044B, \u0430 \u043F\u0435\u0447\u0435\u043D\u043E\u0447\u043D\u044B\u0435
    \u0432\u0435\u043D\u044B \u0432\u043F\u0430\u0434\u0430\u044E\u0442 \u0432 \u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u0443\u044E
    \u043F\u043E\u043B\u0443\u044E \u0432\u0435\u043D\u0443.\n\u0427\u0430\u0441\u0442\u0438
    \u043F\u0435\u0447\u0435\u043D\u0438:\n1. \u0414\u0438\u0430\u0444\u0440\u0430\u0433\u043C\u0430\u043B\u044C\u043D\u0430\u044F
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C (\u0432\u044B\u043F\u0443\u043A\u043B\u0430\u044F,
    \u043F\u0440\u0438\u043B\u0435\u0436\u0438\u0442 \u043A \u0434\u0438\u0430\u0444\u0440\u0430\u0433\u043C\u0435)
    - facies diaphragmalis.\n2. \u0412\u0438\u0441\u0446\u0435\u0440\u0430\u043B\u044C\u043D\u0430\u044F
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C\u0442\u044C
    (\u0432\u043E\u0433\u043D\u0443\u0442\u0430\u044F, \u043F\u0440\u0438\u043B\u0435\u0436\u0438\u0442
    \u043A \u043A\u0438\u0448\u0435\u0447\u043D\u0438\u043A\u0443, \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u043C
    \u043E\u0440\u0433\u0430\u043D\u0430\u043C) - facies visceralis.\n3. \u0414\u043E\u0440\u0441\u0430\u043B\u044C\u043D\u044B\u0439
    \u043A\u0440\u0430\u0439 (\u0442\u0443\u043F\u043E\u0439) - margo dorsalis (obtusus).\n4.
    \u0412\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0439 \u043A\u0440\u0430\u0439
    (\u043E\u0441\u0442\u0440\u044B\u0439) - margo ventralis (acutus).\n5. \u0412\u043E\u0440\u043E\u0442\u0430
    \u043F\u0435\u0447\u0435\u043D\u0438 (\u0432 \u0441\u0440\u0435\u0434\u043D\u0435\u0439
    \u0434\u043E\u043B\u0435 \u043F\u0435\u0447\u0435\u043D\u0438) - porta hepatis.\n6.
    \u0414\u043E\u043B\u0438: \u043F\u0440\u0430\u0432\u0430\u044F \u043B\u0430\u0442\u0435\u0440\u0430\u043B\u044C\u043D\u0430\u044F
    \u0438 \u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u0430\u044F - lobus hepatis
    dexter lateralis et mediales,\n\u043B\u0435\u0432\u0430\u044F \u043B\u0430\u0442\u0435\u0440\u0430\u043B\u044C\u043D\u0430\u044F
    \u0438 \u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u0430\u044F - lobus hepatis
    sinister lateralis et mediales,\n\u0441\u0440\u0435\u0434\u043D\u044F\u044F \u043D\u0438\u0436\u043D\u044F\u044F
    \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u0430\u044F \u0438 \u0432\u0435\u0440\u0445\u043D\u044F\u044F
    \u0445\u0432\u043E\u0441\u0442\u0430\u0442\u0430\u044F - lobus hepatis medius
    quadratus et caudatus.\n\u0425\u0432\u043E\u0441\u0442\u0430\u0442\u0430\u044F
    \u0434\u043E\u043B\u044F \u0438\u043C\u0435\u0435\u0442 \u0441\u043E\u0441\u0446\u0435\u0432\u0438\u0434\u043D\u044B\u0439
    \u0438 \u0445\u0432\u043E\u0441\u0442\u0430\u0442\u044B\u0439 \u043E\u0442\u0440\u043E\u0441\u0442\u043E\u043A
    - processus papillaris et caudatus. \u041D\u0430 \u0445\u0432\u043E\u0441\u0442\u0430\u0442\u043E\u043C
    \u043E\u0442\u0440\u043E\u0441\u0442\u043A\u0435 \u0438\u043C\u0435\u0435\u0442\u0441\u044F
    \u043F\u043E\u0447\u0435\u0447\u043D\u043E\u0435 \u0432\u0434\u0430\u0432\u043B\u0438\u0432\u0430\u043D\u0438\u0435
    \u2013 impression renalis.\n\u0414\u043E\u043B\u0438 \u043F\u0435\u0447\u0435\u043D\u0438
    \u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u044B \u043C\u0435\u0436\u0434\u043E\u043B\u044C\u043A\u043E\u0432\u044B\u043C\u0438
    \u0432\u044B\u0440\u0435\u0437\u043A\u0430\u043C\u0438.\n\u0421\u0432\u044F\u0437\u043A\u0438
    \u043F\u0435\u0447\u0435\u043D\u0438:\n1. \u041F\u0440\u0430\u0432\u0430\u044F
    \u0438 \u043B\u0435\u0432\u0430\u044F \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0430\u044F
    \u0441\u0432\u044F\u0437\u043A\u0430 - lig. triangulare dexter et sibister.\n2.
    \u0421\u0435\u0440\u043F\u043E\u0432\u0438\u0434\u043D\u0430\u044F \u0441\u0432\u044F\u0437\u043A\u0430
    - lig. falciforme hepatis.\n3. \u041A\u0440\u0443\u0433\u043B\u0430\u044F \u0441\u0432\u044F\u0437\u043A\u0430
    (\u043E\u0441\u0442\u0430\u0442\u043E\u043A \u043E\u0442 \u043F\u0443\u043F\u043E\u0447\u043D\u043E\u0439
    \u0432\u0435\u043D\u044B) - lig. teres.\n4. \u041F\u043E\u0447\u0435\u0447\u043D\u043E-\u043F\u0435\u0447\u0451\u043D\u043E\u0447\u043D\u0430\u044F
    - lig. renohepaticum.\n5. \u0416\u0435\u043B\u0443\u0434\u043E\u0447\u043D\u043E-\u043F\u0435\u0447\u0451\u043D\u043E\u0447\u043D\u0430\u044F
    - lig. gastrohepaticum.\n6. \u041F\u0435\u0447\u0451\u043D\u043E\u0447\u043D\u043E-\u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u0438\u043F\u0435\u0440\u0441\u0442\u043D\u0430\u044F
    \u2013 lig. hepatoduodenale.\n7. \u041A\u043E\u0440\u043E\u0442\u043A\u0430\u044F
    \u0432\u0435\u043D\u0435\u0447\u043D\u0430\u044F \u0441\u0432\u044F\u0437\u043A\u0430
    - lig. coranarium"
  clip: {fileID: 0}
