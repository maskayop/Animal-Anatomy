  m_Name: "\u0422\u043E\u043D\u043A\u0430\u044F \u043A\u0438\u0448\u043A\u0430 (\u0441\u0432\u0438\u043D\u044C\u044F)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0422\u043E\u043D\u043A\u0430\u044F \u043A\u0438\u0448\u043A\u0430"
  scientificName: intestinum tenue
  nameClip: {fileID: 8300000, guid: 5837b9579cf066a4a8459d2be759b28a, type: 3}
  description: "\u041A\u0438\u0448\u0435\u0447\u043D\u0438\u043A \u0441\u0432\u0438\u043D\u044C\u0438
    \u2014 \u043F\u043E\u043B\u0430\u044F \u0442\u0440\u0443\u0431\u043A\u0430, \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u044E\u0449\u0430\u044F\u0441\u044F
    \u0432 \u0432\u0438\u0434\u0435 \u043C\u043D\u043E\u0433\u043E\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u044B\u0445
    \u0438\u0437\u0432\u0438\u0442\u044B\u0445 \u043F\u0435\u0442\u0435\u043B\u044C.
    \u041F\u043E\u0434\u0440\u0430\u0437\u0434\u0435\u043B\u044F\u0435\u0442\u0441\u044F
    \u043D\u0430 \u0442\u043E\u043D\u043A\u0438\u0439 \u0438 \u0442\u043E\u043B\u0441\u0442\u044B\u0439
    \u043E\u0442\u0434\u0435\u043B\u044B. \u0412\u0435\u0441\u044C \u043A\u0438\u0448\u0435\u0447\u043D\u0438\u043A
    \u0443 \u0441\u0432\u0438\u043D\u044C\u0438 \u0432 10 \u0440\u0430\u0437 \u0434\u043B\u0438\u043D\u043D\u0435\u0435
    \u0435\u0451 \u0442\u0435\u043B\u0430.\n\u0421\u0442\u0435\u043D\u043A\u0430
    \u043A\u0438\u0448\u0435\u0447\u043D\u0438\u043A\u0430 \u0441\u043E\u0441\u0442\u043E\u0438\u0442
    \u0438\u0437 \u0442\u0440\u0451\u0445 \u043E\u0431\u043E\u043B\u043E\u0447\u0435\u043A:
    \u0441\u043B\u0438\u0437\u0438\u0441\u0442\u043E\u0439, \u043C\u044B\u0448\u0435\u0447\u043D\u043E\u0439
    \u0438 \u0441\u0435\u0440\u043E\u0437\u043D\u043E\u0439.\r\n\u0421\u043B\u0438\u0437\u0438\u0441\u0442\u0430\u044F
    \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0430 \u043F\u043E\u043A\u0440\u044B\u0442\u0430
    \u0446\u0438\u043B\u0438\u043D\u0434\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u043C
    \u043A\u0430\u0451\u043C\u0447\u0430\u0442\u044B\u043C \u044D\u043F\u0438\u0442\u0435\u043B\u0438\u0435\u043C,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442
    \u0432\u0441\u0430\u0441\u044B\u0432\u0430\u043D\u0438\u0435 \u043F\u0438\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432 \u0432 \u043A\u0440\u043E\u0432\u044C.\r\n\u0412
    \u0442\u043E\u043B\u0449\u0435 \u0441\u043B\u0438\u0437\u0438\u0441\u0442\u043E\u0439
    \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0438 \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u044B
    \u043E\u0431\u0449\u0435\u043A\u0438\u0448\u0435\u0447\u043D\u044B\u0435 \u0436\u0435\u043B\u0435\u0437\u044B,
    \u0432\u044B\u0434\u0435\u043B\u044F\u044E\u0449\u0438\u0435 \u0432 \u043F\u0440\u043E\u0441\u0432\u0435\u0442
    \u043A\u0438\u0448\u043A\u0438 \u043A\u0438\u0448\u0435\u0447\u043D\u044B\u0439
    \u0441\u043E\u043A.\r\n\u041F\u043E \u0432\u0441\u0435\u043C\u0443 \u043A\u0438\u0448\u0435\u0447\u043D\u0438\u043A\u0443
    \u043D\u0430 \u0441\u043B\u0438\u0437\u0438\u0441\u0442\u043E\u0439 \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0435
    \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u044B \u043B\u0438\u043C\u0444\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0444\u043E\u043B\u043B\u0438\u043A\u0443\u043B\u044B \u0438 \u043A\u0438\u0448\u0435\u0447\u043D\u044B\u0435
    \u0431\u043B\u044F\u0448\u043A\u0438 (\u043F\u0435\u0439\u0435\u0440\u043E\u0432\u044B
    \u0431\u043B\u044F\u0448\u043A\u0438), \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u044E\u0442 \u0437\u0430\u0449\u0438\u0442\u043D\u0443\u044E
    \u0444\u0443\u043D\u043A\u0446\u0438\u044E.\r\n\u0422\u043E\u043D\u043A\u0438\u0439
    \u043E\u0442\u0434\u0435\u043B \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
    \u043E\u0442 \u0436\u0435\u043B\u0443\u0434\u043A\u0430 \u0438 \u0434\u0435\u043B\u0438\u0442\u0441\u044F
    \u043D\u0430 \u0442\u0440\u0438 \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0435
    \u0447\u0430\u0441\u0442\u0438:\r\n- \u0414\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u0438\u043F\u0435\u0440\u0441\u0442\u043D\u0430\u044F
    \u043A\u0438\u0448\u043A\u0430 \u2014 \u043F\u0435\u0440\u0432\u0430\u044F \u0438
    \u0441\u0430\u043C\u0430\u044F \u043A\u043E\u0440\u043E\u0442\u043A\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C, \u0434\u043B\u0438\u043D\u043E\u0439 40\u201390
    \u0441\u043C, \u0432 \u043D\u0435\u0451 \u0432\u044B\u0445\u043E\u0434\u044F\u0442
    \u0436\u0451\u043B\u0447\u043D\u044B\u0435 \u043F\u0440\u043E\u0442\u043E\u043A\u0438
    \u0438 \u043F\u0440\u043E\u0442\u043E\u043A\u0438 \u043F\u043E\u0434\u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043D\u043E\u0439
    \u0436\u0435\u043B\u0435\u0437\u044B.\r\n- \u0422\u043E\u0449\u0430\u044F \u043A\u0438\u0448\u043A\u0430
    \u2014 \u0441\u0430\u043C\u0430\u044F \u0434\u043B\u0438\u043D\u043D\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C, \u0434\u043B\u0438\u043D\u043E\u0439 \u0434\u043E
    14 \u043C, \u043F\u043E\u0434\u0432\u0435\u0448\u0435\u043D\u0430 \u0432 \u0432\u0438\u0434\u0435
    \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u0430 \u043F\u0435\u0442\u0435\u043B\u044C
    \u043D\u0430 \u043E\u0431\u0448\u0438\u0440\u043D\u043E\u0439 \u0431\u0440\u044B\u0436\u0435\u0439\u043A\u0435.\r\n-
    \u041F\u043E\u0434\u0432\u0437\u0434\u043E\u0448\u043D\u0430\u044F \u043A\u0438\u0448\u043A\u0430
    \u2014 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u0435 \u0442\u043E\u0449\u0435\u0439
    \u043A\u0438\u0448\u043A\u0438 \u0434\u043B\u0438\u043D\u043E\u0439 \u043E\u043A\u043E\u043B\u043E
    4 \u043C.\r\n\u0412 \u0442\u043E\u043D\u043A\u043E\u043C \u043E\u0442\u0434\u0435\u043B\u0435
    \u043A\u0438\u0448\u0435\u0447\u043D\u0438\u043A\u0430 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435
    \u0436\u0435\u043B\u0443\u0434\u043A\u0430 \u043F\u043E\u0434\u0432\u0435\u0440\u0433\u0430\u0435\u0442\u0441\u044F
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044E \u0436\u0435\u043B\u0447\u0438,
    \u043A\u0438\u0448\u0435\u0447\u043D\u043E\u0433\u043E \u0438 \u043F\u043E\u0434\u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043D\u043E\u0433\u043E
    \u0441\u043E\u043A\u043E\u0432, \u0447\u0442\u043E \u0441\u043F\u043E\u0441\u043E\u0431\u0441\u0442\u0432\u0443\u0435\u0442
    \u0440\u0430\u0441\u0449\u0435\u043F\u043B\u0435\u043D\u0438\u044E \u043F\u0438\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432 \u043D\u0430 \u043F\u0440\u043E\u0441\u0442\u044B\u0435
    \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0449\u0438\u0435 \u0438
    \u0438\u0445 \u0432\u0441\u0430\u0441\u044B\u0432\u0430\u043D\u0438\u044E \u0432
    \u043A\u0440\u043E\u0432\u044C \u0438 \u043B\u0438\u043C\u0444\u0443"
