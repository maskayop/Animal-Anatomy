  m_Name: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430 \u043D\u0435\u0440\u0432\u043E\u0432"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0421\u0438\u0441\u0442\u0435\u043C\u0430 \u043D\u0435\u0440\u0432\u043E\u0432"
  scientificName: systema nervosum
  nameClip: {fileID: 8300000, guid: 149175a002b75c04fb19d8d4cb3cc5ab, type: 3}
  description: "\u0421\u043E\u0432\u043E\u043A\u0443\u043F\u043D\u043E\u0441\u0442\u044C
    \u0430\u043D\u0430\u0442\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0438 \u0438
    \u0444\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E
    \u0432\u0437\u0430\u0438\u043C\u043E\u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0445
    \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0438\u0440\u0443\u044E\u0442 \u0438
    \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u044E\u0442 \u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
    \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445 \u0441\u0438\u0441\u0442\u0435\u043C
    \u0438 \u0430\u043F\u043F\u0430\u0440\u0430\u0442\u043E\u0432 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u0430.
    \u0422\u0430\u043A\u0436\u0435 \u0432 \u0430\u043D\u0430\u0442\u043E\u043C\u0438\u0438
    \u043D\u0435\u0440\u0432\u043D\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u044B
    \u0438\u0437\u0443\u0447\u0430\u044E\u0442 \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
    \u043D\u0435\u0439\u0440\u043E\u043D\u0430 \u2014 \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u043D\u043E-\u0444\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0439
    \u0435\u0434\u0438\u043D\u0438\u0446\u044B \u043D\u0435\u0440\u0432\u043D\u043E\u0439
    \u0441\u0438\u0441\u0442\u0435\u043C\u044B, \u0438 \u0441\u0438\u043D\u0430\u043F\u0441\u0430
    \u2014 \u043C\u0435\u0441\u0442\u0430 \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0438
    \u043D\u0435\u0440\u0432\u043D\u044B\u0445 \u0438\u043C\u043F\u0443\u043B\u044C\u0441\u043E\u0432"
  clip: {fileID: 8300000, guid: a3d552f4e1bb2bb429ddfa3d54e58d9a, type: 3}
