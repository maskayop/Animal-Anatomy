  m_Script: {fileID: 11500000, guid: 3f00395bd4580c04eb5d722a11c9666a, type: 3}
  m_Name: "\u0420\u0451\u0431\u0435\u0440\u043D\u0430\u044F \u043A\u043E\u0441\u0442\u044C
    \u0432\u0435\u0440\u0442\u0435\u0431\u0440\u0430\u043B\u044C\u043D\u0430\u044F
    1-2 (\u043B\u043E\u0436\u043D\u0430\u044F) (\u043A\u0443\u0440\u0438\u0446\u0430)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0420\u0451\u0431\u0435\u0440\u043D\u0430\u044F \u043A\u043E\u0441\u0442\u044C
    \u0432\u0435\u0440\u0442\u0435\u0431\u0440\u0430\u043B\u044C\u043D\u0430\u044F
    (\u043B\u043E\u0436\u043D\u0430\u044F)"
  scientificName: pars vertebralis costae (costae spuriae)
  nameClip: {fileID: 8300000, guid: dd01c1cf9e3436049bdb8bbc8de5b714, type: 3}
  description: "\u0418\u043B\u0438 \u0430\u0441\u0442\u0435\u0440\u043D\u0430\u043B\u044C\u043D\u0430\u044F
    - asternales - \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0442 \u0432
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0438 \u0431\u043E\u043A\u043E\u0432\u043E\u0439
    \u0441\u0442\u0435\u043D\u043A\u0438 \u0433\u0440\u0443\u0434\u043D\u043E\u0439
    \u043A\u043B\u0435\u0442\u043A\u0438 \u0438 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F
    \u043A \u0434\u043B\u0438\u043D\u043D\u044B\u043C \u0438\u0437\u043E\u0433\u043D\u0443\u0442\u044B\u043C
    \u043F\u043B\u043E\u0441\u043A\u0438\u043C \u043A\u043E\u0441\u0442\u044F\u043C.\n\u0412\u0435\u0440\u0442\u0435\u0431\u0440\u0430\u043B\u044C\u043D\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C \u0438\u0441\u0442\u0438\u043D\u043D\u043E\u0433\u043E
    \u0440\u0435\u0431\u0440\u0430 \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0435\u0442\u0441\u044F
    \u0441 \u0433\u0440\u0443\u0434\u043D\u044B\u043C \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u043E\u043C.
    \u042D\u0442\u043E \u0431\u043E\u043B\u0435\u0435 \u043C\u0430\u0441\u0441\u0438\u0432\u043D\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043D\u0435\u0441\u0451\u0442
    \u043A\u0440\u044E\u0447\u043A\u043E\u0432\u0438\u0434\u043D\u044B\u0439 \u043E\u0442\u0440\u043E\u0441\u0442\u043E\u043A
    (processus uncinatus), \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439
    \u043D\u0430\u0437\u0430\u0434 \u0438 \u0432\u043D\u0438\u0437. \u042D\u0442\u043E\u0442
    \u043E\u0442\u0440\u043E\u0441\u0442\u043E\u043A \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0435 \u0440\u0435\u0431\u0440\u043E
    \u0438 \u043F\u0440\u0438\u0434\u0430\u0451\u0442 \u0433\u0440\u0443\u0434\u043D\u043E\u0439
    \u043A\u043B\u0435\u0442\u043A\u0435 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E
    \u0436\u0451\u0441\u0442\u043A\u043E\u0441\u0442\u044C, \u0447\u0442\u043E \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438
    \u0432\u0430\u0436\u043D\u043E \u0434\u043B\u044F \u043F\u0440\u0438\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u044F
    \u043B\u0435\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445 \u043C\u044B\u0448\u0446.\n\u0412
    \u043E\u0442\u043B\u0438\u0447\u0438\u0435 \u043E\u0442 \u0438\u0441\u0442\u0438\u043D\u043D\u044B\u0445
    \u0440\u0451\u0431\u0435\u0440, \u0443 \u043B\u043E\u0436\u043D\u044B\u0445 \u0440\u0451\u0431\u0435\u0440
    \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0441\u0442\u0435\u0440\u043D\u0430\u043B\u044C\u043D\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043E\u043D\u0438
    \u043D\u0435 \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u044E\u0442 \u0433\u0440\u0443\u0434\u0438\u043D\u044B
    \u0438 \u043E\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F
    \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E \u0432 \u0442\u043E\u043B\u0449\u0435
    \u043C\u044B\u0448\u0446 \u0431\u0440\u044E\u0448\u043D\u043E\u0439 \u0441\u0442\u0435\u043D\u043A\u0438"
  clip: {fileID: 0}
