  m_Script: {fileID: 11500000, guid: 3f00395bd4580c04eb5d722a11c9666a, type: 3}
  m_Name: "_\u0421\u043A\u0435\u043B\u0435\u0442 \u0433\u0440\u0443\u0434\u043D\u043E\u0439
    \u043A\u043B\u0435\u0442\u043A\u0438 (\u043A\u043E\u043F\u044B\u0442\u043D\u044B\u0435)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0421\u043A\u0435\u043B\u0435\u0442 \u0433\u0440\u0443\u0434\u043D\u043E\u0439
    \u043A\u043B\u0435\u0442\u043A\u0438"
  scientificName: skeleton thoracis
  nameClip: {fileID: 8300000, guid: 53aad222c0abe634d86c4f2084f13e00, type: 3}
  description: "\u0421\u043B\u0443\u0436\u0438\u0442 \u043E\u0441\u043D\u043E\u0432\u043E\u0439
    \u0441\u0442\u0435\u043D\u043E\u043A \u0433\u0440\u0443\u0434\u043D\u043E\u0439
    \u043F\u043E\u043B\u043E\u0441\u0442\u0438 (cavum thoracis). \u0412 \u0435\u0433\u043E
    \u0441\u043E\u0441\u0442\u0430\u0432 \u0432\u0445\u043E\u0434\u044F\u0442 \u0433\u0440\u0443\u0434\u043D\u044B\u0435
    \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u0438, \u0440\u0451\u0431\u0440\u0430
    \u0438 \u0433\u0440\u0443\u0434\u0438\u043D\u0430. \u0412 \u0446\u0435\u043B\u043E\u043C
    \u0441\u043A\u0435\u043B\u0435\u0442 \u0433\u0440\u0443\u0434\u043D\u043E\u0439
    \u043A\u043B\u0435\u0442\u043A\u0438 \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442
    \u043A\u043E\u043D\u0443\u0441 \u0441 \u0443\u0441\u0435\u0447\u0451\u043D\u043D\u043E\u0439
    \u0432\u0435\u0440\u0448\u0438\u043D\u043E\u0439, \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u0439
    \u043A\u0440\u0430\u043D\u0438\u0430\u043B\u044C\u043D\u043E.\n\u0423 \u0434\u043E\u043C\u0430\u0448\u043D\u0438\u0445
    \u043C\u043B\u0435\u043A\u043E\u043F\u0438\u0442\u0430\u044E\u0449\u0438\u0445
    \u0433\u0440\u0443\u0434\u043D\u0430\u044F \u043A\u043B\u0435\u0442\u043A\u0430
    \u0438\u043C\u0435\u0435\u0442 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u044B\u0435
    \u0432\u0438\u0434\u043E\u0432\u044B\u0435 \u043E\u0442\u043B\u0438\u0447\u0438\u044F
    \u043A\u0430\u043A \u043F\u043E \u0441\u0432\u043E\u0435\u0439 \u0444\u043E\u0440\u043C\u0435,
    \u0442\u0430\u043A \u0438 \u043F\u043E \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044E
    \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0445 \u0435\u0451 \u043A\u043E\u0441\u0442\u043D\u044B\u0445
    \u0441\u0435\u0433\u043C\u0435\u043D\u0442\u043E\u0432. \u041A\u0440\u0430\u043D\u0438\u0430\u043B\u044C\u043D\u043E\u0435
    \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435 \u0433\u0440\u0443\u0434\u043D\u043E\u0439
    \u043A\u043B\u0435\u0442\u043A\u0438 (apertura thoracis cranialis) \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442\u0441\u044F
    \u043C\u0435\u0436\u0434\u0443 \u043F\u0435\u0440\u0432\u044B\u043C\u0438 \u0440\u0451\u0431\u0440\u0430\u043C\u0438,
    \u043F\u0435\u0440\u0432\u044B\u043C \u0433\u0440\u0443\u0434\u043D\u044B\u043C
    \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u043E\u043C \u0438 \u0440\u0443\u043A\u043E\u044F\u0442\u043A\u043E\u0439
    \u0433\u0440\u0443\u0434\u0438\u043D\u044B.\n\u041A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u043E\u0435
    \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435 \u0433\u0440\u0443\u0434\u043D\u043E\u0439
    \u043A\u043B\u0435\u0442\u043A\u0438 (apertura thoracis caudalis) \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u043E
    \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C\u0438 \u0440\u0451\u0431\u0440\u0430\u043C\u0438,
    \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C \u0433\u0440\u0443\u0434\u043D\u044B\u043C
    \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u043E\u043C, \u043C\u0435\u0447\u0435\u0432\u0438\u0434\u043D\u044B\u043C
    \u043E\u0442\u0440\u043E\u0441\u0442\u043A\u043E\u043C \u0438 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    \u0441\u043E\u0431\u043E\u0439 \u0441\u043E\u0433\u043D\u0443\u0442\u044B\u0439
    \u043F\u043E\u0434 \u0442\u0443\u043F\u044B\u043C \u0443\u0433\u043B\u043E\u043C
    \u043E\u0432\u0430\u043B. \u0411\u043E\u043A\u043E\u0432\u044B\u0435 \u0441\u0442\u0435\u043D\u043A\u0438
    \u0433\u0440\u0443\u0434\u043D\u043E\u0439 \u043A\u043B\u0435\u0442\u043A\u0438
    \u0432 \u043A\u0440\u0430\u043D\u0438\u0430\u043B\u044C\u043D\u043E\u0439 \u0447\u0430\u0441\u0442\u0438
    \u0443 \u043A\u043E\u043F\u044B\u0442\u043D\u044B\u0445 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445
    \u0441\u0436\u0430\u0442\u044B \u0441 \u0431\u043E\u043A\u043E\u0432, \u0430
    \u0432 \u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u043E\u043C \u043E\u0442\u0434\u0435\u043B\u0435
    \u0431\u043E\u043B\u0435\u0435 \u043E\u043A\u0440\u0443\u0433\u043B\u044B\u0435"
  clip: {fileID: 8300000, guid: af1a8021f3862a1448df01a3c1adbf1b, type: 3}
