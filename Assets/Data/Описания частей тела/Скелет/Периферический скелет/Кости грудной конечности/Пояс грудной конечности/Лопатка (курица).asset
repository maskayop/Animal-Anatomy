  m_Script: {fileID: 11500000, guid: 3f00395bd4580c04eb5d722a11c9666a, type: 3}
  m_Name: "\u041B\u043E\u043F\u0430\u0442\u043A\u0430 (\u043A\u0443\u0440\u0438\u0446\u0430)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u041B\u043E\u043F\u0430\u0442\u043A\u0430"
  scientificName: scapula
  nameClip: {fileID: 8300000, guid: 111b0e581cfff6940aca6bb5005eff2f, type: 3}
  description: "\u0414\u043B\u0438\u043D\u043D\u0430\u044F, \u0443\u0437\u043A\u0430\u044F
    \u0438 \u0441\u0430\u0431\u043B\u0435\u0432\u0438\u0434\u043D\u043E \u0438\u0437\u043E\u0433\u043D\u0443\u0442\u0430\u044F
    \u043A\u043E\u0441\u0442\u044C, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0432\u0445\u043E\u0434\u0438\u0442
    \u0432 \u0441\u043E\u0441\u0442\u0430\u0432 \u043F\u043B\u0435\u0447\u0435\u0432\u043E\u0433\u043E
    \u043F\u043E\u044F\u0441\u0430 \u0438 \u0441\u043B\u0443\u0436\u0438\u0442 \u0434\u043B\u044F
    \u043F\u043E\u0434\u0432\u0438\u0436\u043D\u043E\u0433\u043E \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F
    \u043A\u0440\u044B\u043B\u0430 \u0441\u043E \u0441\u043A\u0435\u043B\u0435\u0442\u043E\u043C.\n\u041B\u043E\u043F\u0430\u0442\u043A\u0430
    \u043B\u0435\u0436\u0438\u0442 \u043F\u0430\u0440\u0430\u043B\u043B\u0435\u043B\u044C\u043D\u043E
    \u043F\u043E\u0437\u0432\u043E\u043D\u043E\u0447\u043D\u043E\u043C\u0443 \u0441\u0442\u043E\u043B\u0431\u0443
    \u043D\u0430 \u0434\u043E\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0439 (\u0441\u043F\u0438\u043D\u043D\u043E\u0439)
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u0433\u0440\u0443\u0434\u043D\u043E\u0439
    \u0441\u0442\u0435\u043D\u043A\u0438, \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u044F\u0441\u044C
    \u043D\u0430\u0434 \u0432\u0435\u0440\u0442\u0435\u0431\u0440\u0430\u043B\u044C\u043D\u044B\u043C\u0438
    (\u043F\u043E\u0437\u0432\u043E\u043D\u043E\u0447\u043D\u044B\u043C\u0438) \u043A\u043E\u043D\u0446\u0430\u043C\u0438
    \u0440\u0451\u0431\u0435\u0440. \u0415\u0451 \u0444\u043E\u0440\u043C\u0430 \u2014
    \u0441\u0430\u0431\u043B\u0435\u0432\u0438\u0434\u043D\u0430\u044F, \u0447\u0442\u043E
    \u0441\u0432\u044F\u0437\u0430\u043D\u043E \u0441 \u043F\u0435\u0440\u0435\u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u0435\u043C
    \u043D\u0430\u0433\u0440\u0443\u0437\u043E\u043A: \u043F\u043E\u0441\u043A\u043E\u043B\u044C\u043A\u0443
    \u043E\u0441\u043D\u043E\u0432\u043D\u0430\u044F \u043E\u043F\u043E\u0440\u0430
    \u043A\u0440\u044B\u043B\u0430 \u043F\u0435\u0440\u0435\u0448\u043B\u0430 \u043D\u0430
    \u0433\u0440\u0443\u0434\u0438\u043D\u0443, \u043B\u043E\u043F\u0430\u0442\u043A\u0430
    \u0441\u043C\u0435\u0441\u0442\u0438\u043B\u0430\u0441\u044C \u043D\u0430 \u0441\u043F\u0438\u043D\u043D\u0443\u044E
    \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0433\u0440\u0443\u0434\u043D\u043E\u0439
    \u043A\u043B\u0435\u0442\u043A\u0438 \u0438 \u0432\u044B\u0442\u044F\u043D\u0443\u043B\u0430\u0441\u044C,
    \u0447\u0442\u043E\u0431\u044B \u0441\u043B\u0443\u0436\u0438\u0442\u044C \u043F\u0440\u043E\u0447\u043D\u043E\u0439
    \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u043E\u0439 \u0434\u043B\u044F \u043F\u0440\u0438\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u044F
    \u043C\u043E\u0449\u043D\u044B\u0445 \u043C\u044B\u0448\u0446, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u0445
    \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u043A\u0440\u044B\u043B\u0430.\n\u0421\u0443\u0441\u0442\u0430\u0432\u043D\u043E\u0439
    \u0443\u0433\u043E\u043B \u043B\u043E\u043F\u0430\u0442\u043A\u0438 \u0438\u043C\u0435\u0435\u0442
    \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0435 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
    \u0434\u043B\u044F \u0441\u043E\u0447\u043B\u0435\u043D\u0435\u043D\u0438\u044F
    \u0441 \u0442\u0440\u0435\u043C\u044F \u043A\u043E\u0441\u0442\u044F\u043C\u0438:
    \u043A\u043E\u0440\u0430\u043A\u043E\u0438\u0434\u043D\u043E\u0439 (\u0432\u043E\u0440\u043E\u043D\u044C\u0435\u0439
    \u043A\u043E\u0441\u0442\u044C\u044E), \u043A\u043B\u044E\u0447\u0438\u0446\u0435\u0439
    (\u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0443 \u043F\u0442\u0438\u0446 \u043F\u0430\u0440\u043D\u0430\u044F
    \u0438 \u0441\u0440\u0430\u0441\u0442\u0430\u0435\u0442\u0441\u044F, \u043E\u0431\u0440\u0430\u0437\u0443\u044F
    \u0432\u0438\u043B\u043E\u0447\u043A\u0443) \u0438 \u043F\u043B\u0435\u0447\u0435\u0432\u043E\u0439
    \u043A\u043E\u0441\u0442\u044C\u044E.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F:\n\u0413\u043B\u0430\u0432\u043D\u0430\u044F
    \u0437\u0430\u0434\u0430\u0447\u0430 \u043B\u043E\u043F\u0430\u0442\u043A\u0438
    \u2014 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0442\u044C \u043F\u0440\u043E\u0447\u043D\u0443\u044E
    \u0438 \u043F\u043E\u0434\u0432\u0438\u0436\u043D\u0443\u044E \u043E\u043F\u043E\u0440\u0443
    \u0434\u043B\u044F \u043C\u044B\u0448\u0446 \u043A\u0440\u044B\u043B\u0430. \u041A
    \u043D\u0435\u0439 \u043F\u0440\u0438\u043A\u0440\u0435\u043F\u043B\u044F\u0435\u0442\u0441\u044F
    \u043C\u043D\u043E\u0436\u0435\u0441\u0442\u0432\u043E \u043C\u044B\u0448\u0435\u0447\u043D\u044B\u0445
    \u0432\u043E\u043B\u043E\u043A\u043E\u043D, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0441\u043E\u0437\u0434\u0430\u044E\u0442 \u0441\u0438\u043B\u0443 \u0442\u044F\u0433\u0438
    \u043F\u0440\u0438 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0438 \u043A\u0440\u044B\u043B\u0430.
    \u0422\u0430\u043A\u0438\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u043C, \u044D\u0442\u0430
    \u043A\u043E\u0441\u0442\u044C \u0438\u0433\u0440\u0430\u0435\u0442 \u043A\u043B\u044E\u0447\u0435\u0432\u0443\u044E
    \u0440\u043E\u043B\u044C \u0432 \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0435
    \u043F\u043E\u043B\u0451\u0442\u0430, \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
    \u043D\u0430 \u0442\u043E \u0447\u0442\u043E \u043A\u0443\u0440\u044B \u043B\u0435\u0442\u0430\u044E\u0442
    \u043F\u043B\u043E\u0445\u043E"
  clip: {fileID: 0}
