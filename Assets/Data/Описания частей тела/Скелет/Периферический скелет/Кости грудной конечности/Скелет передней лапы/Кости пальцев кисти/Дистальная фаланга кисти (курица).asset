  nameClip: {fileID: 8300000, guid: 749f91290b2680643b5bbe5a83c3b52b, type: 3}
  description: "\u041A\u043E\u043D\u0446\u0435\u0432\u0430\u044F, \u0438\u043B\u0438
    \u043A\u043E\u0433\u0442\u0435\u0432\u0430\u044F, \u0444\u0430\u043B\u0430\u043D\u0433\u0430;
    \u0435\u0451 \u043F\u043E\u0440\u044F\u0434\u043A\u043E\u0432\u044B\u0439 \u043D\u043E\u043C\u0435\u0440
    \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u043F\u0430\u043B\u044C\u0446\u0430.\r\n\u041C\u0435\u043B\u043A\u0438\u0435
    \u0444\u0430\u043B\u0430\u043D\u0433\u0438 \u0442\u0440\u0451\u0445 \u043F\u0430\u043B\u044C\u0446\u0435\u0432
    \u043A\u0440\u044B\u043B\u0430 \u0440\u0430\u0437\u043B\u0438\u0447\u0430\u044E\u0442\u0441\u044F
    \u043F\u043E \u0444\u043E\u0440\u043C\u0435 \u0438 \u0447\u0438\u0441\u043B\u0443.
    \u0423 \u0431\u043E\u043B\u044C\u0448\u043E\u0433\u043E \u043F\u0430\u043B\u044C\u0446\u0430
    \u043A\u0440\u044B\u043B\u0430 \u0434\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u0430\u044F
    \u0444\u0430\u043B\u0430\u043D\u0433\u0430 \u0441\u043E\u0447\u043B\u0435\u043D\u044F\u0435\u0442\u0441\u044F
    \u0441 \u043F\u0440\u043E\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0439"
