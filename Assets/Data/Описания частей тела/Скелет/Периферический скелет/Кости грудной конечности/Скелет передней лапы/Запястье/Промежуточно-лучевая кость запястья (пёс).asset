  russianName: "\u041F\u0440\u043E\u043C\u0435\u0436\u0443\u0442\u043E\u0447\u043D\u043E-\u043B\u0443\u0447\u0435\u0432\u0430\u044F
    \u043A\u043E\u0441\u0442\u044C \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u044F"
  scientificName: os carpi intermedioradiale, os scapholunatum
  description: "\u041F\u0440\u043E\u043C\u0435\u0436\u0443\u0442\u043E\u0447\u043D\u0430\u044F
    \u043A\u043E\u0441\u0442\u044C \u0438\u043B\u0438 \u043F\u043E\u043B\u0443\u043B\u0443\u043D\u043D\u0430\u044F
    (os lunatum)\u0438 \u043B\u0443\u0447\u0435\u0432\u0430\u044F \u043A\u043E\u0441\u0442\u044C
    \u0438\u043B\u0438 \u043B\u0430\u0434\u044C\u0435\u0432\u0438\u0434\u043D\u0430\u044F
    (os scaphoideum) \u0441\u0440\u0430\u0441\u0442\u0430\u044E\u0442\u0441\u044F
    \u0432 \u043E\u0434\u043D\u0443 \u043E\u0431\u0449\u0443\u044E \u043A\u043E\u0441\u0442\u044C.\n\u041A\u043E\u0441\u0442\u0438
    \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u044F \u0433\u0443\u0431\u0447\u0430\u0442\u044B\u0435,
    \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0435, \u0430\u0441\u0441\u0438\u043C\u0435\u0442\u0440\u0438\u0447\u043D\u044B\u0435,
    \u043E\u0431\u0440\u0430\u0437\u0443\u044E\u0442 \u0437\u0430\u043F\u044F\u0441\u0442\u043D\u044B\u0439
    \u0441\u0443\u0441\u0442\u0430\u0432"
  clip: {fileID: 0}
