  m_Script: {fileID: 11500000, guid: 3f00395bd4580c04eb5d722a11c9666a, type: 3}
  m_Name: "_\u0417\u0430\u043F\u044F\u0441\u0442\u044C\u0435 (\u043A\u043E\u0440\u043E\u0432\u0430)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0417\u0430\u043F\u044F\u0441\u0442\u044C\u0435"
  scientificName: carpus
  nameClip: {fileID: 8300000, guid: 46396f13a7faf414e871afe9050d1e2a, type: 3}
  description: "\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043E
    \u0434\u0432\u0443\u043C\u044F \u0440\u044F\u0434\u0430\u043C\u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0445
    \u043A\u043E\u0441\u0442\u0435\u0439 (ossa carpi), \u0441\u0447\u0451\u0442 \u043A\u043E\u0442\u043E\u0440\u044B\u0445
    \u0432\u0435\u0434\u0451\u0442\u0441\u044F \u0441 \u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043A\u0440\u0430\u044F.\n\u0412 \u043F\u0440\u043E\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u043C
    \u0440\u044F\u0434\u0443 \u0438\u043C\u0435\u0435\u0442\u0441\u044F \u0447\u0435\u0442\u044B\u0440\u0435
    \u043A\u043E\u0441\u0442\u0438: \u0437\u0430\u043F\u044F\u0441\u0442\u043D\u0430\u044F
    \u043B\u0443\u0447\u0435\u0432\u0430\u044F, \u0438\u043B\u0438 \u043B\u0430\u0434\u044C\u0435\u0432\u0438\u0434\u043D\u0430\u044F
    (os carpi radiale, os scaphoideum), \u0437\u0430\u043F\u044F\u0441\u0442\u043D\u0430\u044F
    \u043F\u0440\u043E\u043C\u0435\u0436\u0443\u0442\u043E\u0447\u043D\u0430\u044F,
    \u0438\u043B\u0438 \u043F\u043E\u043B\u0443\u043B\u0443\u043D\u043D\u0430\u044F
    (os carpi intermedium, os lunatum), \u0437\u0430\u043F\u044F\u0441\u0442\u043D\u0430\u044F
    \u043B\u043E\u043A\u0442\u0435\u0432\u0430\u044F, \u0438\u043B\u0438 \u0442\u0440\u0451\u0445\u0433\u0440\u0430\u043D\u043D\u0430\u044F
    (os carpi ulnare, os triquartum), \u0438 \u0437\u0430\u043F\u044F\u0441\u0442\u043D\u0430\u044F
    \u0434\u043E\u0431\u0430\u0432\u043E\u0447\u043D\u0430\u044F, \u0438\u043B\u0438
    \u0433\u043E\u0440\u043E\u0445\u043E\u0432\u0438\u0434\u043D\u0430\u044F (os
    carpi accessorium, os pisiforme).\n\u0423 \u0436\u0432\u0430\u0447\u043D\u044B\u0445
    \u043A\u043E\u0441\u0442\u0438 \u043F\u0440\u043E\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0440\u044F\u0434\u0430 \u0431\u0443\u0433\u0440\u0438\u0441\u0442\u044B\u0435;
    \u0437\u0430\u043F\u044F\u0441\u0442\u043D\u0430\u044F \u043B\u0443\u0447\u0435\u0432\u0430\u044F
    \u0432\u044B\u0442\u044F\u043D\u0443\u0442\u0430 \u043A\u0430\u0443\u0434\u043E\u043F\u0440\u043E\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E;
    \u043F\u0440\u043E\u043C\u0435\u0436\u0443\u0442\u043E\u0447\u043D\u0430\u044F
    \u0438\u043C\u0435\u0435\u0442 \u0434\u0432\u0435 \u043F\u0430\u043B\u044C\u043C\u0430\u0440\u043D\u044B\u0435
    \u0432\u0435\u0442\u0432\u0438; \u0437\u0430\u043F\u044F\u0441\u0442\u043D\u0430\u044F
    \u043B\u043E\u043A\u0442\u0435\u0432\u0430\u044F \u043E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F
    \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u043E\u0439 \u0441\u0443\u0441\u0442\u0430\u0432\u043D\u043E\u0439
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C\u044E \u0441\u0435\u0434\u043B\u043E\u0432\u0438\u0434\u043D\u043E\u0439
    \u0444\u043E\u0440\u043C\u044B \u0441 \u0438\u0437\u043E\u0433\u043D\u0443\u0442\u044B\u043C\u0438
    \u0432 \u043B\u0430\u0442\u0435\u0440\u043E\u0434\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u043C
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438 \u043A\u0440\u0430\u044F\u043C\u0438;
    \u0434\u043E\u0431\u0430\u0432\u043E\u0447\u043D\u0430\u044F \u043A\u043E\u0441\u0442\u044C
    \u0438\u043C\u0435\u0435\u0442 \u0446\u0438\u043B\u0438\u043D\u0434\u0440\u0438\u0447\u0435\u0441\u043A\u0443\u044E
    \u0444\u043E\u0440\u043C\u0443.\n\u041C\u0435\u0436\u0440\u044F\u0434\u043E\u0432\u044B\u0435
    \u0441\u0443\u0441\u0442\u0430\u0432\u043D\u044B\u0435 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
    \u0437\u0430\u043F\u044F\u0441\u0442\u043D\u044B\u0445 \u043A\u043E\u0441\u0442\u0435\u0439
    \u0432\u0434\u043E\u043B\u044C \u043F\u0435\u0440\u0435\u0434\u043D\u0435\u0433\u043E
    \u043A\u0440\u0430\u044F \u0438\u043C\u0435\u044E\u0442 \u0437\u0430\u0441\u0442\u0430\u0432\u043A\u0438.
    \u041F\u043E \u0437\u0430\u0434\u043D\u0435\u043C\u0443 \u043A\u0440\u0430\u044E
    \u043D\u0430 \u043A\u043E\u0441\u0442\u044F\u0445 \u0432\u0435\u0440\u0445\u043D\u0435\u0433\u043E
    \u0440\u044F\u0434\u0430 \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u044B \u0441\u0443\u0441\u0442\u0430\u0432\u043D\u044B\u0435
    \u0443\u0433\u043B\u0443\u0431\u043B\u0435\u043D\u0438\u044F, \u0442\u043E\u0433\u0434\u0430
    \u043A\u0430\u043A \u043D\u0430 \u043A\u043E\u0441\u0442\u044F\u0445 \u0434\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0440\u044F\u0434\u0430 \u0438\u043C \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043B\u0435\u0436\u0430\u0442
    \u0441\u0443\u0441\u0442\u0430\u0432\u043D\u044B\u0435 \u0432\u0430\u043B\u0438\u043A\u0438.\n\u0414\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u0430\u044F
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C \u043D\u0438\u0436\u043D\u0435\u0433\u043E
    \u0440\u044F\u0434\u0430 \u0437\u0430\u043F\u044F\u0441\u0442\u043D\u044B\u0445
    \u043A\u043E\u0441\u0442\u0435\u0439 \u0443 \u043A\u043E\u043F\u044B\u0442\u043D\u044B\u0445
    \u043F\u043B\u043E\u0441\u043A\u0430\u044F"
  clip: {fileID: 8300000, guid: 8539095a5ab24ff4ba7db6d2f63e51a3, type: 3}
