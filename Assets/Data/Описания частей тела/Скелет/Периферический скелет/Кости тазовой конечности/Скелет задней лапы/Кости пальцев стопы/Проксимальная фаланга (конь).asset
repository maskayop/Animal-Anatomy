  m_Script: {fileID: 11500000, guid: 3f00395bd4580c04eb5d722a11c9666a, type: 3}
  m_Name: "\u041F\u0440\u043E\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F
    \u0444\u0430\u043B\u0430\u043D\u0433\u0430 (\u043A\u043E\u043D\u044C)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u041F\u0440\u043E\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F
    \u0444\u0430\u043B\u0430\u043D\u0433\u0430"
  scientificName: phalanx proximalis
  description: "\u0418\u043B\u0438 \u043F\u0435\u0440\u0432\u0430\u044F \u0444\u0430\u043B\u0430\u043D\u0433\u0430
    - phalanx prima, \u0443 \u043B\u043E\u0448\u0430\u0434\u0438 \u043F\u0443\u0442\u043E\u0432\u0430\u044F
    \u043A\u043E\u0441\u0442\u044C \u2013 os compedale - \u0438\u043C\u0435\u044E\u0442
    \u0441\u0445\u043E\u0434\u043D\u0443\u044E \u0444\u043E\u0440\u043C\u0443 \u0438
    \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u043E\u0435 \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
    \u0441\u043E \u0441\u0440\u0435\u0434\u043D\u0435\u0439 \u0444\u0430\u043B\u0430\u043D\u0433\u043E\u0439,
    \u043D\u043E \u043E\u0442\u043B\u0438\u0447\u0430\u044E\u0442\u0441\u044F \u043F\u043E
    \u0440\u0430\u0437\u043C\u0435\u0440\u0430\u043C. \u0423 \u043D\u0438\u0445 \u0440\u0430\u0437\u043B\u0438\u0447\u0430\u044E\u0442
    \u0442\u0435\u043B\u043E (corpus phalangis), \u043F\u0440\u043E\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0439
    \u043A\u043E\u043D\u0435\u0446, \u0438\u043B\u0438 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0435
    \u0444\u0430\u043B\u0430\u043D\u0433\u0438 (basis phalangis) \u0441 \u0441\u0443\u0441\u0442\u0430\u0432\u043D\u043E\u0439
    \u044F\u043C\u043A\u043E\u0439 (caput phalangis) \u0438 \u0441\u0443\u0441\u0442\u0430\u0432\u043D\u044B\u043C
    \u0431\u043B\u043E\u043A\u043E\u043C. \u041D\u0430 \u0441\u0443\u0441\u0442\u0430\u0432\u043D\u043E\u0439
    \u044F\u043C\u043A\u0435 \u043F\u0440\u043E\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0439
    \u0444\u0430\u043B\u0430\u043D\u0433\u0438 \u0438\u043C\u0435\u0435\u0442\u0441\u044F
    \u0436\u0451\u043B\u043E\u0431"
  clip: {fileID: 8300000, guid: a6f3df059ffe9de4eb71bd214cdcfa75, type: 3}
