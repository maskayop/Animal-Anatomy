  m_Name: "\u0421\u0440\u0435\u0434\u043D\u044F\u044F \u0444\u0430\u043B\u0430\u043D\u0433\u0430
    \u0441\u0442\u043E\u043F\u044B (\u043A\u043E\u043D\u044C)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0421\u0440\u0435\u0434\u043D\u044F\u044F \u0444\u0430\u043B\u0430\u043D\u0433\u0430"
  scientificName: phalanx media pelvini
  nameClip: {fileID: 8300000, guid: 239f689e526d0344dbc33b0c61f1d213, type: 3}
  description: "\u0418\u043B\u0438 \u0432\u0442\u043E\u0440\u0430\u044F \u0444\u0430\u043B\u0430\u043D\u0433\u0430
    - phalanx secunda, \u0443 \u043B\u043E\u0448\u0430\u0434\u0438 \u0432\u0435\u043D\u0435\u0447\u043D\u0430\u044F
    \u043A\u043E\u0441\u0442\u044C \u2013 os coronale.\n\u041A\u043E\u0440\u043E\u0442\u043A\u0430\u044F
    \u043A\u043E\u0441\u0442\u044C \u043F\u0430\u043B\u044C\u0446\u0430, \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u0430\u044F
    \u043C\u0435\u0436\u0434\u0443 \u043F\u0443\u0442\u043E\u0432\u043E\u0439, \u043A\u043E\u043F\u044B\u0442\u043D\u043E\u0439
    \u0438 \u0447\u0435\u043B\u043D\u043E\u0447\u043D\u043E\u0439 \u043A\u043E\u0441\u0442\u044F\u043C\u0438.
    \u0418\u043C\u0435\u0435\u0442 \u0444\u043E\u0440\u043C\u0443 \u043A\u0443\u0431\u0430
    \u0441 \u0441\u0438\u043B\u044C\u043D\u043E \u0448\u0435\u0440\u043E\u0445\u043E\u0432\u0430\u0442\u044B\u043C\u0438
    \u0431\u043E\u043A\u043E\u0432\u044B\u043C\u0438 \u0438 \u043F\u0435\u0440\u0435\u0434\u043D\u0435\u0439
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044F\u043C\u0438
    \u0438 \u043F\u043E\u0447\u0442\u0438 \u0433\u043B\u0430\u0434\u043A\u043E\u0439
    \u0437\u0430\u0434\u043D\u0435\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C\u044E"
  clip: {fileID: 8300000, guid: 2a1b2c57f4c23124b9ec577fb3a39cea, type: 3}
