    \u0441\u043E\u0431\u0430\u043A\u0438 \u043F\u0440\u0438 \u043D\u0430\u043B\u0438\u0447\u0438\u0438
    \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u043F\u0430\u043B\u044C\u0446\u0430,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0447\u0430\u0449\u0435 \u043E\u0442\u0441\u0443\u0441\u0442\u0432\u0443\u0435\u0442,
    \u043F\u0435\u0440\u0432\u0430\u044F \u0444\u0430\u043B\u0430\u043D\u0433\u0430
    \u0441\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0441 \u0434\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C
