  scientificName: os tarsale quartum
  description: "\u0418\u043B\u0438 \u043A\u0443\u0431\u043E\u0432\u0438\u0434\u043D\u0430\u044F
    \u043A\u043E\u0441\u0442\u044C \u2013 os cuboideum, \u2013 \u043B\u0435\u0436\u0438\u0442
    \u043B\u0430\u0442\u0435\u0440\u0430\u043B\u044C\u043D\u043E \u043C\u0435\u0436\u0434\u0443
    \u043F\u044F\u0442\u043E\u0447\u043D\u043E\u0439 \u0438 \u043F\u043B\u044E\u0441\u043D\u0435\u0432\u044B\u043C\u0438
    \u043A\u043E\u0441\u0442\u044F\u043C\u0438, \u0443 \u043B\u043E\u0448\u0430\u0434\u0438
    \u043A\u0443\u0431\u043E\u0432\u0438\u0434\u043D\u043E\u0439 \u0444\u043E\u0440\u043C\u044B
    \u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0432\u044B\u0442\u044F\u043D\u0443\u0442\u0430
    \u0432 \u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u043E\u043C \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438"
  clip: {fileID: 0}
