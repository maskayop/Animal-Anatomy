  m_Script: {fileID: 11500000, guid: 3f00395bd4580c04eb5d722a11c9666a, type: 3}
  m_Name: "\u0422\u0430\u0440\u0430\u043D\u043D\u0430\u044F \u043A\u043E\u0441\u0442\u044C
    (\u043A\u043E\u0440\u043E\u0432\u0430)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0422\u0430\u0440\u0430\u043D\u043D\u0430\u044F \u043A\u043E\u0441\u0442\u044C"
  scientificName: talus
  nameClip: {fileID: 8300000, guid: 10929c108ed08cb40bb69617cd1d20f8, type: 3}
  description: "\u0418\u043B\u0438 \u0437\u0430\u043F\u043B\u044E\u0441\u043D\u0435\u0432\u0430\u044F
    \u0431\u043E\u043B\u044C\u0448\u0435\u0431\u0435\u0440\u0446\u043E\u0432\u0430\u044F
    \u043A\u043E\u0441\u0442\u044C \u2013 os tarsi tibiale, \u2013 \u0438\u043C\u0435\u0435\u0442
    \u0442\u0435\u043B\u043E (corpus tali), \u043F\u0440\u043E\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0439
    \u0431\u043B\u043E\u043A (trochlea tali proximalis), \u0448\u0435\u0439\u043A\u0443
    (collum tali) \u0438 \u0433\u043E\u043B\u043E\u0432\u043A\u0443 (caput tali).\n\u0423
    \u043A\u043E\u043F\u044B\u0442\u043D\u044B\u0445 \u0434\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0439
    \u043A\u043E\u043D\u0435\u0446 \u0442\u0435\u043B\u0430 \u0442\u0430\u0440\u0430\u043D\u043D\u043E\u0439
    \u043A\u043E\u0441\u0442\u0438 \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442
    \u0434\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0439 \u0431\u043B\u043E\u043A
    (trochlea tali distalis).\n\u041D\u0430 \u043F\u0440\u043E\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u043C
    \u0431\u043B\u043E\u043A\u0435 \u0432\u044B\u0434\u0435\u043B\u044F\u044E\u0442\u0441\u044F
    \u043B\u0430\u0442\u0435\u0440\u0430\u043B\u044C\u043D\u044B\u0439 \u0438 \u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u044B\u0439
    \u0433\u0440\u0435\u0431\u043D\u0438, \u043F\u0440\u043E\u0445\u043E\u0434\u044F\u0449\u0438\u0435
    \u0432 \u0441\u0430\u0433\u0438\u0442\u0442\u0430\u043B\u044C\u043D\u043E\u0439
    \u043F\u043B\u043E\u0441\u043A\u043E\u0441\u0442\u0438 \u0438 \u0440\u0430\u0437\u0434\u0435\u043B\u0451\u043D\u043D\u044B\u0435
    \u0448\u0438\u0440\u043E\u043A\u0438\u043C \u0436\u0451\u043B\u043E\u0431\u043E\u043C.\n\u0423
    \u0436\u0432\u0430\u0447\u043D\u044B\u0445 \u0433\u0440\u0435\u0431\u043D\u0438
    \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u044E\u0442 \u0448\u0435\u0439\u043A\u0438
    \u0442\u0430\u0440\u0430\u043D\u043D\u043E\u0439 \u043A\u043E\u0441\u0442\u0438
    \u0438 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F
    \u043D\u0430\u0434 \u0434\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C
    \u0431\u043B\u043E\u043A\u043E\u043C, \u0438\u043C\u0435\u044F \u0437\u0434\u0435\u0441\u044C
    \u043D\u0430\u0434\u0431\u043B\u043E\u043A\u043E\u0432\u0443\u044E \u044F\u043C\u043A\u0443,
    \u0432 \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043F\u0440\u0438 \u0441\u0433\u0438\u0431\u0430\u043D\u0438\u0438
    \u0441\u0443\u0441\u0442\u0430\u0432\u0430 \u0443\u043F\u0438\u0440\u0430\u0435\u0442\u0441\u044F
    \u0434\u043E\u0440\u0441\u0430\u043B\u044C\u043D\u044B\u0439 \u0432\u044B\u0441\u0442\u0443\u043F
    \u0434\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u043A\u043E\u043D\u0446\u0430
    \u0431\u043E\u043B\u044C\u0448\u0435\u0431\u0435\u0440\u0446\u043E\u0432\u043E\u0439
    \u043A\u043E\u0441\u0442\u0438.\n\u041D\u0430 \u0434\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u043C
    \u0431\u043B\u043E\u043A\u0435 \u0438\u043C\u0435\u0435\u0442\u0441\u044F \u0441\u0443\u0441\u0442\u0430\u0432\u043D\u0430\u044F
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C \u0434\u043B\u044F
    \u0441\u043E\u0447\u043B\u0435\u043D\u0435\u043D\u0438\u044F \u0441 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439
    (\u043B\u0430\u0434\u044C\u0435\u0432\u0438\u0434\u043D\u043E\u0439) \u043A\u043E\u0441\u0442\u044C\u044E
    (facies articularis navicularis).\n\u0423 \u0436\u0432\u0430\u0447\u043D\u044B\u0445
    \u0441\u0443\u0441\u0442\u0430\u0432\u043D\u0430\u044F \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C
    \u0434\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0431\u043B\u043E\u043A\u0430
    \u043F\u043E\u043B\u043E\u0433\u0438\u043C \u0441\u0430\u0433\u0438\u0442\u0442\u0430\u043B\u044C\u043D\u044B\u043C
    \u0436\u0451\u043B\u043E\u0431\u043E\u043C \u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0430
    \u043D\u0430 \u0434\u0432\u0435 \u0447\u0430\u0441\u0442\u0438, \u0438\u0437
    \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u0430\u044F
    \u0438\u043C\u0435\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u0440\u0430\u0437\u043C\u0435\u0440\u044B.\n\u041B\u0430\u0442\u0435\u0440\u043E\u043F\u043B\u0430\u043D\u0442\u0430\u0440\u043D\u0430\u044F
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C \u0442\u0435\u043B\u0430
    \u0442\u0430\u0440\u0430\u043D\u043D\u043E\u0439 \u043A\u043E\u0441\u0442\u0438
    \u0434\u043B\u044F \u0441\u043E\u0447\u043B\u0435\u043D\u0435\u043D\u0438\u044F
    \u0441 \u043F\u044F\u0442\u043E\u0447\u043D\u043E\u0439 \u043A\u043E\u0441\u0442\u044C\u044E
    \u0438\u043C\u0435\u0435\u0442 \u0434\u0432\u0435 \u0441\u0443\u0441\u0442\u0430\u0432\u043D\u044B\u0435
    \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0438 (facies articulares calcaneae),
    \u0440\u0430\u0437\u0434\u0435\u043B\u0451\u043D\u043D\u044B\u0435 \u0437\u0430\u043F\u043B\u044E\u0441\u043D\u0435\u0432\u044B\u043C
    \u0436\u0451\u043B\u043E\u0431\u043E\u043C (sulcus tali)"
  clip: {fileID: 8300000, guid: 37da3c52f4db49f449e927920c548e94, type: 3}
