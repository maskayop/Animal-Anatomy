  m_Script: {fileID: 11500000, guid: 3f00395bd4580c04eb5d722a11c9666a, type: 3}
  m_Name: "\u0421\u0440\u043E\u0441\u0448\u0438\u0435\u0441\u044F \u0432\u0442\u043E\u0440\u0430\u044F
    \u0438 \u0442\u0440\u0435\u0442\u044C\u044F \u0437\u0430\u043F\u043B\u044E\u0441\u043D\u0435\u0432\u044B\u0435
    \u043A\u043E\u0441\u0442\u0438 (\u043A\u043E\u0440\u043E\u0432\u0430)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0421\u0440\u043E\u0441\u0448\u0438\u0435\u0441\u044F \u0432\u0442\u043E\u0440\u0430\u044F
    \u0438 \u0442\u0440\u0435\u0442\u044C\u044F \u0437\u0430\u043F\u043B\u044E\u0441\u043D\u0435\u0432\u044B\u0435
    \u043A\u043E\u0441\u0442\u0438"
  scientificName: os tarsi secundum et tertium
  description: "\u0412\u0442\u043E\u0440\u0430\u044F \u0437\u0430\u043F\u043B\u044E\u0441\u043D\u0435\u0432\u0430\u044F
    \u043A\u043E\u0441\u0442\u044C \u2013 os tarsale secundum, \u0438\u043B\u0438
    \u043F\u0440\u043E\u043C\u0435\u0436\u0443\u0442\u043E\u0447\u043D\u0430\u044F
    \u043A\u043B\u0438\u043D\u043E\u0432\u0438\u0434\u043D\u0430\u044F \u043A\u043E\u0441\u0442\u044C
    \u2013 os cuneiforme intermedium.\n\u0422\u0440\u0435\u0442\u044C\u044F \u0437\u0430\u043F\u043B\u044E\u0441\u043D\u0435\u0432\u0430\u044F
    \u043A\u043E\u0441\u0442\u044C \u2013 os tarsale tertium, \u0438\u043B\u0438
    \u043B\u0430\u0442\u0435\u0440\u0430\u043B\u044C\u043D\u0430\u044F \u043A\u043B\u0438\u043D\u043E\u0432\u0438\u0434\u043D\u0430\u044F
    \u043A\u043E\u0441\u0442\u044C \u2013 os cuneiforme laterale, \u2013 \u0443 \u0436\u0432\u0430\u0447\u043D\u044B\u0445
    \u0441\u0440\u043E\u0441\u043B\u0430\u0441\u044C \u0441\u043E \u0432\u0442\u043E\u0440\u043E\u0439
    \u0437\u0430\u043F\u043B\u044E\u0441\u043D\u0435\u0432\u043E\u0439 \u0438 \u0438\u043C\u0435\u0435\u0442
    \u043F\u043B\u043E\u0441\u043A\u0443\u044E \u0447\u0435\u0442\u044B\u0440\u0451\u0445\u0443\u0433\u043E\u043B\u044C\u043D\u0443\u044E
    \u0444\u043E\u0440\u043C\u0443 \u0441 \u043E\u043A\u0440\u0443\u0433\u043B\u044B\u043C\u0438
    \u043A\u0440\u0430\u044F\u043C\u0438"
  clip: {fileID: 0}
