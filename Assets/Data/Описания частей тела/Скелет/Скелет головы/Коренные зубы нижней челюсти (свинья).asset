  m_Name: "\u041A\u043E\u0440\u0435\u043D\u043D\u044B\u0435 \u0437\u0443\u0431\u044B
    \u043D\u0438\u0436\u043D\u0435\u0439 \u0447\u0435\u043B\u044E\u0441\u0442\u0438
    (\u0441\u0432\u0438\u043D\u044C\u044F)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u041A\u043E\u0440\u0435\u043D\u043D\u044B\u0435 \u0437\u0443\u0431\u044B
    \u043D\u0438\u0436\u043D\u0435\u0439 \u0447\u0435\u043B\u044E\u0441\u0442\u0438"
  scientificName: dentes premolares, dentes molares
  description: "\u041F\u0440\u0435\u043C\u043E\u043B\u044F\u0440\u044B \u0443 \u0441\u0432\u0438\u043D\u044C\u0438
    \u2014 \u044D\u0442\u043E \u043B\u043E\u0436\u043D\u044B\u0435 \u043A\u043E\u0440\u0435\u043D\u043D\u044B\u0435
    \u0437\u0443\u0431\u044B, \u0438\u0445 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u2014 3\u20134 \u0441 \u043A\u0430\u0436\u0434\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B
    \u043E\u0431\u0435\u0438\u0445 \u0447\u0435\u043B\u044E\u0441\u0442\u0435\u0439.
    \u041F\u0440\u0435\u043C\u043E\u043B\u044F\u0440\u044B \u0448\u0438\u0440\u043E\u043A\u0438\u0435
    \u0438 \u043C\u043D\u043E\u0433\u043E\u0431\u0443\u0433\u043E\u0440\u0447\u0430\u0442\u044B\u0435,
    \u043F\u0440\u0438\u0441\u043F\u043E\u0441\u043E\u0431\u043B\u0435\u043D\u044B
    \u0434\u043B\u044F \u0440\u0430\u0437\u043C\u0430\u043B\u044B\u0432\u0430\u043D\u0438\u044F
    \u0438 \u043F\u0435\u0440\u0435\u0442\u0438\u0440\u0430\u043D\u0438\u044F \u043F\u0438\u0449\u0438.
    \u041C\u0435\u0436\u0434\u0443 \u043D\u0438\u043C\u0438 \u0438 \u0440\u0435\u0437\u0446\u0430\u043C\u0438
    \u043E\u0431\u044B\u0447\u043D\u043E \u0438\u043C\u0435\u0435\u0442\u0441\u044F
    \u0431\u0435\u0437\u0437\u0443\u0431\u043E\u0435 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E.
    \u0418\u043D\u043E\u0433\u0434\u0430 \u0432\u043F\u0435\u0440\u0435\u0434\u0438
    \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u043F\u0440\u0435\u043C\u043E\u043B\u044F\u0440\u0430
    \u0438\u043C\u0435\u0435\u0442\u0441\u044F \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
    \u2014 \u0432\u043E\u043B\u0447\u0438\u0439 \u0437\u0443\u0431.\n\u041C\u043E\u043B\u044F\u0440\u044B
    \u0443 \u0441\u0432\u0438\u043D\u044C\u0438 \u2014 \u044D\u0442\u043E \u0438\u0441\u0442\u0438\u043D\u043D\u044B\u0435
    \u043A\u043E\u0440\u0435\u043D\u043D\u044B\u0435 \u0437\u0443\u0431\u044B, \u0438\u0445
    \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u2014 \u043F\u043E
    3 \u0441 \u043A\u0430\u0436\u0434\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B
    \u043E\u0431\u0435\u0438\u0445 \u0447\u0435\u043B\u044E\u0441\u0442\u0435\u0439.
    \u041C\u043E\u043B\u044F\u0440\u044B \u0441\u0430\u043C\u044B\u0435 \u043A\u0440\u0443\u043F\u043D\u044B\u0435,
    \u043D\u0435 \u0438\u043C\u0435\u044E\u0442 \u043C\u043E\u043B\u043E\u0447\u043D\u044B\u0445
    \u043F\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A\u043E\u0432.
    \u0420\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u044B \u0432 \u0430\u0431\u043E\u0440\u0430\u043B\u044C\u043D\u043E\u0439
    \u0447\u0430\u0441\u0442\u0438 \u0447\u0435\u043B\u044E\u0441\u0442\u0435\u0439.
    \u0418\u043D\u043E\u0433\u0434\u0430 \u043F\u043E\u0437\u0430\u0434\u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E
    \u043C\u043E\u043B\u044F\u0440\u0430 \u0432\u044B\u0440\u0430\u0441\u0442\u0430\u0435\u0442
    \u0437\u0443\u0431 \u043C\u0443\u0434\u0440\u043E\u0441\u0442\u0438.\n\u0423
    \u0441\u0432\u0438\u043D\u044C\u0438 \u0432\u0441\u0435 \u0437\u0443\u0431\u044B
    \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u043A\u043E\u0440\u043E\u043D\u043A\u043E\u0432\u044B\u0435,
    \u0442\u0435\u043B\u043E \u0441\u0440\u0430\u0432\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0435, \u0430 \u043A\u043E\u0440\u043D\u0438
    \u0434\u043B\u0438\u043D\u043D\u044B\u0435, \u0445\u043E\u0440\u043E\u0448\u043E
    \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u043D\u044B\u0435. \u041F\u0440\u0435\u043C\u043E\u043B\u044F\u0440\u044B
    \u0432 2 \u0440\u0430\u0437\u0430 \u0442\u043E\u043D\u044C\u0448\u0435 \u043C\u043E\u043B\u044F\u0440\u043E\u0432"
