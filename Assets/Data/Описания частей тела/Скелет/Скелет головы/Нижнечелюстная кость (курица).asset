  m_Script: {fileID: 11500000, guid: 3f00395bd4580c04eb5d722a11c9666a, type: 3}
  m_Name: "\u041D\u0438\u0436\u043D\u0435\u0447\u0435\u043B\u044E\u0441\u0442\u043D\u0430\u044F
    \u043A\u043E\u0441\u0442\u044C (\u043A\u0443\u0440\u0438\u0446\u0430)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u041D\u0438\u0436\u043D\u0435\u0447\u0435\u043B\u044E\u0441\u0442\u043D\u0430\u044F
    \u043A\u043E\u0441\u0442\u044C"
  scientificName: mandibula
  nameClip: {fileID: 8300000, guid: 0685c06640f1c264ab0ae440c12dc8c0, type: 3}
  description: "\u0418\u043B\u0438 \u043D\u0438\u0436\u043D\u044F\u044F \u0447\u0435\u043B\u044E\u0441\u0442\u044C
    \u2013 \u043F\u0430\u0440\u043D\u0430\u044F, \u043F\u043E\u0434\u0432\u0438\u0436\u043D\u043E
    \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0435\u0442\u0441\u044F \u0441 \u0447\u0435\u0440\u0435\u043F\u043E\u043C
    \u0438 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E
    \u0447\u0430\u0441\u0442\u044C \u043A\u043E\u0441\u0442\u043D\u043E\u0439 \u043E\u0441\u043D\u043E\u0432\u044B
    \u0440\u043E\u0442\u043E\u0432\u043E\u0439 \u043F\u043E\u043B\u043E\u0441\u0442\u0438.
    \u041C\u0435\u0436\u0434\u0443 \u043D\u0438\u0436\u043D\u0438\u043C\u0438 \u0447\u0435\u043B\u044E\u0441\u0442\u044F\u043C\u0438,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0432 \u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u043E\u043C
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
    \u0440\u0430\u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u0432 \u0431\u043E\u043A\u043E\u0432\u044B\u0435
    \u0441\u0442\u043E\u0440\u043E\u043D\u044B, \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u043E
    \u043C\u0435\u0436\u0447\u0435\u043B\u044E\u0441\u0442\u043D\u043E\u0435 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E
    (spatium intermandibulare).\n\u0423 \u043A\u0443\u0440 \u043D\u0438\u0436\u043D\u0435\u0447\u0435\u043B\u044E\u0441\u0442\u043D\u0430\u044F
    \u043A\u043E\u0441\u0442\u044C \u043D\u0435 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043C\u043E\u043D\u043E\u043B\u0438\u0442\u043D\u043E\u0439 \u2014 \u043E\u043D\u0430
    \u0441\u043E\u0441\u0442\u043E\u0438\u0442 \u0438\u0437 \u0434\u0432\u0443\u0445
    \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0445 \u0447\u0430\u0441\u0442\u0435\u0439:\n-
    \u041A\u0440\u0430\u043D\u0438\u0430\u043B\u044C\u043D\u044B\u0439 (\u043F\u0435\u0440\u0435\u0434\u043D\u0438\u0439)
    \u043E\u0442\u0434\u0435\u043B \u2014 \u0437\u0443\u0431\u043D\u0430\u044F \u043A\u043E\u0441\u0442\u044C
    (os dentale);\n- \u041A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u044B\u0439
    (\u0437\u0430\u0434\u043D\u0438\u0439) \u043E\u0442\u0434\u0435\u043B \u2014
    \u0441\u043E\u0447\u043B\u0435\u043D\u0451\u043D\u043D\u0430\u044F \u043A\u043E\u0441\u0442\u044C
    (os articulare).\n\u042D\u0442\u0438 \u0434\u0432\u0435 \u043A\u043E\u0441\u0442\u0438
    \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u044E\u0442\u0441\u044F \u0441\u0438\u043C\u0444\u0438\u0437\u043E\u043C
    \u2014 \u0437\u043E\u043D\u043E\u0439 \u043F\u0440\u043E\u0447\u043D\u043E\u0433\u043E
    \u0445\u0440\u044F\u0449\u0435\u0432\u043E\u0433\u043E \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F.\n\u0412\u0430\u0436\u043D\u0435\u0439\u0448\u0430\u044F
    \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u044C \u2014 \u043F\u043E\u0434\u0432\u0438\u0436\u043D\u043E\u0435
    \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435 \u0441 \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u043E\u0439
    \u043A\u043E\u0441\u0442\u044C\u044E (os quadratum). \u042D\u0442\u043E \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435
    \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442 \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u043E\u043D\u0438\u0436\u043D\u0435\u0447\u0435\u043B\u044E\u0441\u0442\u043D\u043E\u0439
    \u0441\u0443\u0441\u0442\u0430\u0432. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
    \u044D\u0442\u043E\u043C\u0443 \u0441\u0443\u0441\u0442\u0430\u0432\u0443 \u043F\u0440\u0438
    \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u043D\u0438\u0438 \u043A\u043B\u044E\u0432\u0430
    \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F
    \u043F\u043E\u0434\u043A\u043B\u044E\u0432\u044C\u0435, \u043D\u043E \u0438 \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
    \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F \u043D\u0430\u0434\u043A\u043B\u044E\u0432\u044C\u0435
    (\u0432\u0435\u0440\u0445\u043D\u044F\u044F \u0447\u0430\u0441\u0442\u044C \u043A\u043B\u044E\u0432\u0430).
    \u0422\u0430\u043A\u0430\u044F \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F
    \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u043F\u0442\u0438\u0446\u0430\u043C
    \u0448\u0438\u0440\u043E\u043A\u0438\u0439 \u0434\u0438\u0430\u043F\u0430\u0437\u043E\u043D
    \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0439 \u0447\u0435\u043B\u044E\u0441\u0442\u0435\u0439,
    \u0447\u0442\u043E \u0432\u0430\u0436\u043D\u043E \u0434\u043B\u044F \u0434\u043E\u0431\u044B\u0432\u0430\u043D\u0438\u044F
    \u0438 \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0438 \u043F\u0438\u0449\u0438"
  clip: {fileID: 0}
