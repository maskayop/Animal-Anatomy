  russianName: "\u0413\u0440\u0443\u0434\u043D\u043E\u0439 \u043E\u0442\u0434\u0435\u043B
    (\u0433\u0440\u0443\u0434\u043D\u044B\u0435 \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u0438)"
  scientificName: vertebrae thoracicae
  nameClip: {fileID: 8300000, guid: 73fb33327e8b1bc4b9e662bf5aec9ee8, type: 3}
  description: "\u0423\u0447\u0430\u0441\u0442\u0432\u0443\u044E\u0442 \u0432 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0438
    \u0433\u0440\u0443\u0434\u043D\u043E\u0439 \u043A\u043B\u0435\u0442\u043A\u0438.\n\u0413\u0440\u0443\u0434\u043D\u043E\u0439
    \u043E\u0442\u0434\u0435\u043B \u0443 \u043A\u0443\u0440 \u0441\u043E\u0441\u0442\u043E\u0438\u0442
    \u0438\u0437 6\u20137 \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u043E\u0432
    \u0438 \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u0440\u0451\u0431\u0440\u0430\u043C\u0438
    \u0438 \u0433\u0440\u0443\u0434\u0438\u043D\u043E\u0439 \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442
    \u0433\u0440\u0443\u0434\u043D\u0443\u044E \u043A\u043B\u0435\u0442\u043A\u0443.
    \u0423 \u043A\u0443\u0440 \u043E\u043D\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u0430\u044F,
    \u043D\u043E \u0432\u044B\u0441\u043E\u043A\u0430\u044F \u0438 \u0448\u0438\u0440\u043E\u043A\u0430\u044F.\n\u0412\u0430\u0436\u043D\u0430\u044F
    \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0441\u0442\u044C: \u0443 \u043A\u0443\u0440\u0438\u043D\u044B\u0445
    2\u20135-\u0439 \u0433\u0440\u0443\u0434\u043D\u044B\u0435 \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u0438
    \u0441\u0440\u0430\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u043C\u0435\u0436\u0434\u0443
    \u0441\u043E\u0431\u043E\u0439, \u043E\u0431\u0440\u0430\u0437\u0443\u044F \u0435\u0434\u0438\u043D\u0443\u044E
    \u0441\u043F\u0438\u043D\u043D\u0443\u044E \u043A\u043E\u0441\u0442\u044C. \u042D\u0442\u043E
    \u0440\u0435\u0437\u043A\u043E \u0441\u043D\u0438\u0436\u0430\u0435\u0442 \u043F\u043E\u0434\u0432\u0438\u0436\u043D\u043E\u0441\u0442\u044C
    \u043E\u0442\u0434\u0435\u043B\u0430 \u0438 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442
    \u0435\u0433\u043E \u0432 \u043F\u0440\u043E\u0447\u043D\u0443\u044E \u043E\u043F\u043E\u0440\u0443
    \u0434\u043B\u044F \u043B\u0435\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u043C\u044B\u0448\u0446. 7-\u0439 \u043F\u043E\u0437\u0432\u043E\u043D\u043E\u043A
    \u0441\u0440\u0430\u0441\u0442\u0430\u0435\u0442\u0441\u044F \u0441 \u043F\u043E\u044F\u0441\u043D\u0438\u0447\u043D\u043E-\u043A\u0440\u0435\u0441\u0442\u0446\u043E\u0432\u044B\u043C
    \u043E\u0442\u0434\u0435\u043B\u043E\u043C.\r\n\u0423\u0442\u043E\u0447\u043D\u0435\u043D\u0438\u0435:\n\u041D\u0430
    \u0434\u0430\u043D\u043D\u043E\u0439 \u043C\u043E\u0434\u0435\u043B\u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u043E
    6 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0445 \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u043E\u0432.
    \u042D\u0442\u043E \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442
    \u0430\u043D\u0430\u0442\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u043D\u043E\u0440\u043C\u0435, \u043D\u043E \u0432 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u0447\u0430\u0441\u0442\u044C \u0438\u0437 \u043D\u0438\u0445 (2\u20135-\u0439)
    \u0441\u0440\u0430\u0441\u0442\u0430\u0435\u0442\u0441\u044F \u0432 \u0441\u043F\u0438\u043D\u043D\u0443\u044E
    \u043A\u043E\u0441\u0442\u044C. \u041D\u0430 \u043C\u043E\u0434\u0435\u043B\u0438
    \u043E\u043D\u0438 \u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u044B \u0434\u043B\u044F
    \u043D\u0430\u0433\u043B\u044F\u0434\u043D\u043E\u0441\u0442\u0438"
