    \u0441 \u0445\u043E\u0440\u043E\u0448\u043E \u0440\u0430\u0437\u0432\u0438\u0442\u044B\u043C\u0438
    \u043F\u043E\u043F\u0435\u0440\u0435\u0447\u043D\u044B\u043C\u0438 \u0438 \u043E\u0441\u0442\u0438\u0441\u0442\u044B\u043C
    \u043E\u0442\u0440\u043E\u0441\u0442\u043A\u0430\u043C\u0438.\r\n\u041C\u0435\u0436\u0434\u0443
    \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u043C\u0438 \u0445\u0432\u043E\u0441\u0442\u043E\u0432\u044B\u043C\u0438
    \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u0430\u043C\u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442\u0441\u044F
    \u043F\u043E\u0434\u0432\u0438\u0436\u043D\u044B\u0435 \u0445\u0440\u044F\u0449\u0435\u0432\u044B\u0435
    \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F. \u041A \u043E\u0442\u0440\u043E\u0441\u0442\u043A\u0430\u043C
    \u043F\u0440\u0438\u043A\u0440\u0435\u043F\u043B\u044F\u044E\u0442\u0441\u044F
    \u043C\u044B\u0448\u0446\u044B \u0438 \u0441\u0432\u044F\u0437\u043A\u0438, \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0449\u0438\u0435
