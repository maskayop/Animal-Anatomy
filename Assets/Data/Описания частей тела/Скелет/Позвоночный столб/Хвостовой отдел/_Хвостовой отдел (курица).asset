  m_Script: {fileID: 11500000, guid: 3f00395bd4580c04eb5d722a11c9666a, type: 3}
  m_Name: "_\u0425\u0432\u043E\u0441\u0442\u043E\u0432\u043E\u0439 \u043E\u0442\u0434\u0435\u043B
    (\u043A\u0443\u0440\u0438\u0446\u0430)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0425\u0432\u043E\u0441\u0442\u043E\u0432\u043E\u0439 \u043E\u0442\u0434\u0435\u043B
    (\u0445\u0432\u043E\u0441\u0442\u043E\u0432\u044B\u0435 \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u0438)"
  scientificName: vertebrae caudales
  nameClip: {fileID: 8300000, guid: f73f6958e1d0979438a75671351a016e, type: 3}
  description: "\u0425\u0432\u043E\u0441\u0442\u043E\u0432\u043E\u0439 \u043E\u0442\u0434\u0435\u043B
    \u0443 \u043A\u0443\u0440 \u0441\u043E\u0441\u0442\u043E\u0438\u0442 \u0438\u0437
    \u0434\u0432\u0443\u0445 \u0444\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0445
    \u0447\u0430\u0441\u0442\u0435\u0439: \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0445
    \u0445\u0432\u043E\u0441\u0442\u043E\u0432\u044B\u0445 \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u043E\u0432
    \u0438 \u0441\u0440\u043E\u0441\u0448\u0435\u0433\u043E\u0441\u044F \u043F\u0438\u0433\u043E\u0441\u0442\u0438\u043B\u044F.\r\n\u0423
    \u043A\u0443\u0440\u0438\u0446\u044B \u043E\u0431\u044B\u0447\u043D\u043E \u0438\u043C\u0435\u0435\u0442\u0441\u044F
    5-6 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0445 \u0445\u0432\u043E\u0441\u0442\u043E\u0432\u044B\u0445
    \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u043E\u0432; \u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u044B\u0435
    \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u0438, \u0432\u043E\u0448\u0435\u0434\u0448\u0438\u0435
    \u0432 \u0441\u043B\u043E\u0436\u043D\u044B\u0439 \u043A\u0440\u0435\u0441\u0442\u0435\u0446
    \u0438 \u043F\u0438\u0433\u043E\u0441\u0442\u0438\u043B\u044C, \u0432 \u044D\u0442\u043E
    \u0447\u0438\u0441\u043B\u043E \u043D\u0435 \u0432\u043A\u043B\u044E\u0447\u0430\u044E\u0442\u0441\u044F.\r\n\u042D\u0442\u043E
    \u0442\u0438\u043F\u0438\u0447\u043D\u044B\u0435 \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u0438
    \u0441 \u0440\u0430\u0437\u0432\u0438\u0442\u044B\u043C\u0438 \u043F\u043E\u043F\u0435\u0440\u0435\u0447\u043D\u044B\u043C\u0438
    \u043E\u0442\u0440\u043E\u0441\u0442\u043A\u0430\u043C\u0438. \u041E\u043D\u0438
    \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442 \u043F\u043E\u0434\u0432\u0438\u0436\u043D\u043E\u0441\u0442\u044C,
    \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044F \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435
    \u0445\u0432\u043E\u0441\u0442\u0430 (\u0440\u0443\u043B\u0435\u0432\u044B\u0445
    \u043F\u0435\u0440\u044C\u0435\u0432) \u0432\u0432\u0435\u0440\u0445-\u0432\u043D\u0438\u0437
    \u0438 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u044B.\r\n\u041F\u0438\u0433\u043E\u0441\u0442\u0438\u043B\u044C
    (Pygostylus) - \u044D\u0442\u043E \u0441\u0440\u043E\u0441\u0448\u0438\u0435\u0441\u044F
    \u0432 \u0435\u0434\u0438\u043D\u0443\u044E \u043A\u043E\u0441\u0442\u044C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
    \u0445\u0432\u043E\u0441\u0442\u043E\u0432\u044B\u0435 \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u0438
    (\u043A\u043E\u043F\u0447\u0438\u043A\u043E\u0432\u0443\u044E \u043A\u043E\u0441\u0442\u044C).\r\n\u041F\u0438\u0433\u043E\u0441\u0442\u0438\u043B\u044C
    \u0441\u043B\u0443\u0436\u0438\u0442 \u043E\u043F\u043E\u0440\u043E\u0439 \u0434\u043B\u044F
    \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F \u0440\u0443\u043B\u0435\u0432\u044B\u0445
    \u043F\u0435\u0440\u044C\u0435\u0432. \u0421\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0435
    \u0441 \u043D\u0438\u043C \u043C\u044B\u0448\u0446\u044B, \u0441\u0432\u044F\u0437\u043A\u0438
    \u0438 \u043C\u044F\u0433\u043A\u0438\u0435 \u0442\u043A\u0430\u043D\u0438 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0442
    \u0444\u043E\u043B\u043B\u0438\u043A\u0443\u043B\u044B \u0440\u0443\u043B\u0435\u0432\u044B\u0445
    \u043F\u0435\u0440\u044C\u0435\u0432, \u0430 \u0441\u0430\u043C \u043E\u043D
    \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u0438\u0445
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435"
  clip: {fileID: 0}
