  m_Name: "\u0421\u0435\u043B\u0435\u0437\u0451\u043D\u043A\u0430 (\u043F\u0451\u0441)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0421\u0435\u043B\u0435\u0437\u0451\u043D\u043A\u0430"
  scientificName: splen
  description: "\u041D\u0435\u043F\u0430\u0440\u043D\u044B\u0439 \u043F\u0430\u0440\u0435\u043D\u0445\u0438\u043C\u0430\u0442\u043E\u0437\u043D\u044B\u0439
    \u043E\u0440\u0433\u0430\u043D, \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0439
    \u0432 \u0431\u0440\u044E\u0448\u043D\u043E\u0439 \u043F\u043E\u043B\u043E\u0441\u0442\u0438.
    \u041F\u043E \u043A\u043E\u043D\u0441\u0438\u0441\u0442\u0435\u043D\u0446\u0438\u0438
    \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442 \u043F\u0435\u0447\u0435\u043D\u044C.\n\u0421\u0435\u043B\u0435\u0437\u0451\u043D\u043A\u0430
    \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0432 \u043B\u0435\u0432\u043E\u043C
    \u043F\u043E\u0434\u0440\u0435\u0431\u0435\u0440\u044C\u0435, \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E
    \u043F\u0440\u0438\u043B\u0435\u0433\u0430\u044F \u043A \u043B\u0435\u0432\u043E\u0439
    \u043F\u043E\u0447\u043A\u0435. \u041F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435
    \u043D\u0435\u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E\u0435 \u0438
    \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u043D\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u043E\u0441\u0442\u0438
    \u0436\u0435\u043B\u0443\u0434\u043A\u0430: \u043F\u0440\u0438 \u043F\u0443\u0441\u0442\u043E\u043C
    \u0436\u0435\u043B\u0443\u0434\u043A\u0435 \u043E\u0440\u0433\u0430\u043D \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442\u0441\u044F
    \u0432 \u043F\u043E\u0434\u0440\u0435\u0431\u0435\u0440\u044C\u0435, \u0430 \u043F\u043E
    \u043C\u0435\u0440\u0435 \u0435\u0433\u043E \u043D\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F
    \u0432\u044B\u0434\u0430\u0451\u0442\u0441\u044F \u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u043E
    \u0437\u0430 \u043F\u0440\u0435\u0434\u0435\u043B\u044B \u0440\u0451\u0431\u0435\u0440\u043D\u043E\u0439
    \u0434\u0443\u0433\u0438 \u0438\u043B\u0438 \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u0435\u0442\u0441\u044F
    \u0432 \u043F\u043E\u0434\u0432\u0437\u0434\u043E\u0448\u043D\u043E\u0439 \u043E\u0431\u043B\u0430\u0441\u0442\u0438.\n\u0414\u043B\u0438\u043D\u0430
    \u0441\u0435\u043B\u0435\u0437\u0451\u043D\u043A\u0438 \u0441\u043E\u0431\u0430\u043A\u0438
    \u0436\u0438\u0432\u043E\u0439 \u043C\u0430\u0441\u0441\u043E\u0439 \u043E\u0442
    10 \u043A\u0433 \u0438 \u0431\u043E\u043B\u0435\u0435 \u2014 \u043E\u0442 14,4
    \u0434\u043E 30,2 \u0441\u043C, \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0430\u044F
    \u0448\u0438\u0440\u0438\u043D\u0430 \u2014 4,8\u20137,3 \u0441\u043C, \u0442\u043E\u043B\u0449\u0438\u043D\u0430
    \u2014 0,6\u20131,8 \u0441\u043C. \u041C\u0430\u0441\u0441\u0430 - \u043E\u0442
    19 \u0434\u043E 105 \u0433.\n\u0424\u043E\u0440\u043C\u0430: \u043F\u043B\u043E\u0441\u043A\u0430\u044F,
    \u0432\u044B\u0442\u044F\u043D\u0443\u0442\u0430\u044F, \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442
    \u043B\u0435\u043D\u0442\u0443.\n\u0412\u043E\u0440\u043E\u0442\u0430 \u043D\u0430\u0445\u043E\u0434\u044F\u0442\u0441\u044F
    \u043D\u0430 \u0432\u0438\u0441\u0446\u0435\u0440\u0430\u043B\u044C\u043D\u043E\u0439
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438, \u0447\u0435\u0440\u0435\u0437
    \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
    \u0441\u0435\u043B\u0435\u0437\u0451\u043D\u043E\u0447\u043D\u0430\u044F \u0430\u0440\u0442\u0435\u0440\u0438\u044F.\r\n\u0421\u0435\u043B\u0435\u0437\u0451\u043D\u043A\u0430
    \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0430 \u0441 \u0431\u043E\u043B\u044C\u0448\u043E\u0439
    \u043A\u0440\u0438\u0432\u0438\u0437\u043D\u043E\u0439 \u0436\u0435\u043B\u0443\u0434\u043A\u0430
    \u043F\u0440\u0438 \u043F\u043E\u043C\u043E\u0449\u0438 \u0436\u0435\u043B\u0443\u0434\u043E\u0447\u043D\u043E-\u0441\u0435\u043B\u0435\u0437\u0451\u043D\u043E\u0447\u043D\u043E\u0439
    \u0441\u0432\u044F\u0437\u043A\u0438, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u0435\u0451
    \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0432 \u0431\u0440\u044E\u0448\u043D\u043E\u0439
    \u043F\u043E\u043B\u043E\u0441\u0442\u0438.\r\n\u0412 \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u0435
    \u0432\u044B\u0434\u0435\u043B\u044F\u044E\u0442\u0441\u044F \u0431\u0435\u043B\u0430\u044F
    \u0438 \u043A\u0440\u0430\u0441\u043D\u0430\u044F \u043F\u0443\u043B\u044C\u043F\u044B:
    \u0431\u0435\u043B\u0430\u044F \u043F\u0443\u043B\u044C\u043F\u0430 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430
    \u043B\u0438\u043C\u0444\u043E\u0438\u0434\u043D\u044B\u043C\u0438 \u0443\u0437\u0435\u043B\u043A\u0430\u043C\u0438,
    \u043A\u0440\u0430\u0441\u043D\u0430\u044F \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442
    \u0441\u043E\u0441\u0443\u0434\u044B \u043C\u0438\u043A\u0440\u043E\u0446\u0438\u0440\u043A\u0443\u043B\u044F\u0442\u043E\u0440\u043D\u043E\u0433\u043E
    \u0440\u0443\u0441\u043B\u0430. \u0423 \u0441\u043E\u0431\u0430\u043A \u043A\u0440\u0430\u0441\u043D\u0430\u044F
    \u043F\u0443\u043B\u044C\u043F\u0430 \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442
    \u0441\u0438\u043D\u0443\u0441\u044B.\n\u0424\u0443\u043D\u043A\u0446\u0438\u0438:\r\n-
    \u0414\u0435\u043F\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
    \u043A\u0440\u043E\u0432\u0438: \u0441\u0435\u043B\u0435\u0437\u0451\u043D\u043A\u0430
    \u043D\u0430\u043A\u0430\u043F\u043B\u0438\u0432\u0430\u0435\u0442 \u043A\u0440\u043E\u0432\u044C
    \u0432 \u0441\u0438\u043D\u0443\u0441\u043E\u0438\u0434\u043D\u044B\u0445 \u043A\u0430\u043F\u0438\u043B\u043B\u044F\u0440\u0430\u0445
    \u0438 \u0432\u0435\u043D\u043E\u0437\u043D\u044B\u0445 \u0441\u0438\u043D\u0443\u0441\u0430\u0445,
    \u043E\u0442\u043A\u0443\u0434\u0430 \u043E\u043D\u0430 \u043C\u043E\u0436\u0435\u0442
    \u0431\u044B\u0442\u044C \u0432\u044B\u0431\u0440\u043E\u0448\u0435\u043D\u0430
    \u0432 \u0441\u0438\u0441\u0442\u0435\u043C\u0443 \u043A\u0440\u043E\u0432\u043E\u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u044F
    \u043F\u0440\u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438.\r\n-
    \u0424\u0438\u043B\u044C\u0442\u0440\u0430\u0446\u0438\u044F \u043A\u0440\u043E\u0432\u0438:
    \u043E\u0440\u0433\u0430\u043D \u0443\u0434\u0430\u043B\u044F\u0435\u0442 \u0441\u0442\u0430\u0440\u044B\u0435
    \u0438\u043B\u0438 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0451\u043D\u043D\u044B\u0435
    \u043A\u043B\u0435\u0442\u043A\u0438 \u043A\u0440\u043E\u0432\u0438, \u0430 \u0442\u0430\u043A\u0436\u0435
    \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u0438 \u0438 \u0447\u0443\u0436\u0435\u0440\u043E\u0434\u043D\u044B\u0435
    \u0431\u0435\u043B\u043A\u0438 \u0438\u0437 \u043A\u0440\u043E\u0432\u043E\u0442\u043E\u043A\u0430.\r\n-
    \u0423\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \u0438\u043C\u043C\u0443\u043D\u043D\u044B\u0445
    \u0440\u0435\u0430\u043A\u0446\u0438\u044F\u0445: \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u0435 \u0434\u0435\u043F\u043E \u043C\u043E\u043D\u043E\u0446\u0438\u0442\u043E\u0432,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0432\u0441\u0442\u0443\u043F\u0430\u044E\u0442
    \u0432 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043F\u0440\u0438 \u0432\u043E\u0441\u043F\u0430\u043B\u0435\u043D\u0438\u044F\u0445.\r\n-
    \u041D\u0430\u043A\u043E\u043F\u043B\u0435\u043D\u0438\u0435 \u0442\u0440\u043E\u043C\u0431\u043E\u0446\u0438\u0442\u043E\u0432
    \u0438 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435 \u0438\u0445
    \u0443\u0440\u043E\u0432\u043D\u044F \u0432 \u043A\u0440\u043E\u0432\u0438.\n\u0421\u0435\u043B\u0435\u0437\u0451\u043D\u043A\u0430
    \u043D\u0435 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0436\u0438\u0437\u043D\u0435\u043D\u043D\u043E
    \u0432\u0430\u0436\u043D\u044B\u043C \u043E\u0440\u0433\u0430\u043D\u043E\u043C
    \u2014 \u0432 \u0441\u043B\u0443\u0447\u0430\u0435 \u0435\u0451 \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u044F
    \u0444\u0443\u043D\u043A\u0446\u0438\u0438 \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E
    \u0431\u0435\u0440\u0443\u0442 \u043D\u0430 \u0441\u0435\u0431\u044F \u0434\u0440\u0443\u0433\u0438\u0435
    \u043E\u0440\u0433\u0430\u043D\u044B"
