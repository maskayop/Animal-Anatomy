  m_Script: {fileID: 11500000, guid: 3f00395bd4580c04eb5d722a11c9666a, type: 3}
  m_Name: "\u0422\u0440\u0430\u0445\u0435\u044F (\u043A\u043E\u043D\u044C)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0422\u0440\u0430\u0445\u0435\u044F"
  scientificName: trachea
  nameClip: {fileID: 8300000, guid: 692096141bb56474186d6dc9cc09986a, type: 3}
  description: "\u0421\u043B\u0443\u0436\u0438\u0442 \u0434\u043B\u044F \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u044F
    \u0432\u043E\u0437\u0434\u0443\u0445\u0430 \u043E\u0442 \u0433\u043E\u0440\u0442\u0430\u043D\u0438
    \u043A \u043B\u0451\u0433\u043A\u0438\u043C \u0438 \u043E\u0431\u0440\u0430\u0442\u043D\u043E.
    \u0412\u0438\u0434 \u0442\u0440\u0443\u0431\u043A\u0438, \u043E\u0441\u043D\u043E\u0432\u0443
    \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442
    \u043D\u0435\u0437\u0430\u043C\u043A\u043D\u0443\u0442\u044B\u0435 \u043A\u043E\u043B\u044C\u0446\u0430
    \u0438\u0437 \u0433\u0438\u0430\u043B\u0438\u043D\u043E\u0432\u043E\u0433\u043E
    \u0445\u0440\u044F\u0449\u0430 (\u0443 \u043B\u043E\u0448\u0430\u0434\u0435\u0439
    \u043E\u043A\u043E\u043B\u043E 60 \u043A\u043E\u043B\u0435\u0446). \u0422\u0440\u0430\u0445\u0435\u044F
    \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u0436\u0430\u0442\u0430
    \u0432 \u0434\u043E\u0440\u0441\u043E\u0432\u0435\u043D\u0442\u0440\u0430\u044C\u043D\u043E\u043C
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438. \u0415\u0451
    \u043A\u043E\u043B\u044C\u0446\u0430 \u0438\u043C\u0435\u044E\u0442 \u043F\u043E\u043F\u0435\u0440\u0435\u0447\u043D\u043E-\u043E\u0432\u0430\u043B\u044C\u043D\u0443\u044E
    \u0444\u043E\u0440\u043C\u0443, \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u043C\u0438
    \u043A\u043E\u043D\u0446\u0430\u043C\u0438 \u043D\u0430\u043B\u0435\u0433\u0430\u044E\u0442
    \u0434\u0440\u0443\u0433 \u043D\u0430 \u0434\u0440\u0443\u0433\u0430 \u0438 \u043F\u0440\u043E\u0447\u043D\u043E
    \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u044B \u043A\u043E\u043B\u044C\u0446\u0435\u0432\u043E\u0439
    \u0441\u0432\u044F\u0437\u043A\u043E\u0439. \u0411\u0438\u0444\u0443\u0440\u043A\u0430\u0446\u0438\u044F
    \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043D\u0430 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
    5-6-\u0433\u043E \u0433\u0440\u0443\u0434\u043D\u044B\u0445 \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u043E\u0432.
    \u041C\u0435\u0441\u0442\u043E \u0434\u0435\u043B\u0435\u043D\u0438\u044F \u2013
    \u0431\u0438\u0444\u0443\u0440\u043A\u0430\u0446\u0438\u044F \u0442\u0440\u0430\u0445\u0435\u0438
    \u2013 bifurcatio trachea.\n\u0422\u0440\u0430\u0445\u0435\u0439\u043D\u044B\u0435
    \u0445\u0440\u044F\u0449\u0438 \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u044E\u0442\u0441\u044F
    \u0434\u0440\u0443\u0433 \u0441 \u0434\u0440\u0443\u0433\u043E\u043C \u043A\u043E\u043B\u044C\u0446\u0435\u0432\u0438\u0434\u043D\u044B\u043C\u0438
    \u0441\u0432\u044F\u0437\u043A\u0430\u043C\u0438, \u0430 \u0438\u0445 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0435
    \u043A\u043E\u043D\u0446\u044B \u0432\u0445\u043E\u0434\u044F\u0442 \u0441\u043E\u0441\u0442\u0430\u0432\u043D\u043E\u0439
    \u0447\u0430\u0441\u0442\u044C\u044E \u0432 \u0434\u043E\u0440\u0441\u0430\u043B\u044C\u043D\u0443\u044E
    \u043F\u0435\u0440\u0435\u043F\u043E\u043D\u0447\u0430\u0442\u0443\u044E \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C.
    \u0412 \u043F\u0435\u0440\u0435\u043F\u043E\u043D\u0447\u0430\u0442\u0443\u044E
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C, \u043A\u0440\u043E\u043C\u0435
    \u043A\u043E\u043B\u044C\u0446\u0435\u0432\u0438\u0434\u043D\u044B\u0445 \u0441\u0432\u044F\u0437\u043E\u043A,
    \u0432\u0445\u043E\u0434\u044F\u0442 \u0442\u0440\u0430\u0445\u0435\u0439\u043D\u044B\u0435
    \u043C\u044B\u0448\u0446\u044B, \u0437\u0430\u043B\u0435\u0433\u0430\u044E\u0449\u0438\u0435
    \u043F\u043E\u0434 \u0441\u043B\u0438\u0437\u0438\u0441\u0442\u043E\u0439 \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u043E\u0439
    \u0442\u0440\u0430\u0445\u0435\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043C\u043E\u0433\u0443\u0442 \u0441\u0443\u0436\u0438\u0432\u0430\u0442\u044C
    \u043F\u0440\u043E\u0441\u0432\u0435\u0442 \u0442\u0440\u0430\u0445\u0435\u0438.\n\u0421\u043B\u0438\u0437\u0438\u0441\u0442\u0430\u044F
    \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0430 - tunica mucosa - \u0432\u044B\u0441\u0442\u043B\u0430\u043D\u0430
    \u043E\u0434\u043D\u043E\u0441\u043B\u043E\u0439\u043D\u044B\u043C \u043C\u043D\u043E\u0433\u043E\u044F\u0434\u0435\u0440\u043D\u044B\u043C
    \u043F\u0440\u0438\u0437\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u043C
    \u043C\u0435\u0440\u0446\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C \u044D\u043F\u0438\u0442\u0435\u043B\u0438\u0435\u043C.\n\u041F\u043E\u0434\u0441\u043B\u0438\u0437\u0438\u0441\u0442\u0430\u044F
    \u043E\u0441\u043D\u043E\u0432\u0430 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442
    \u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u0442\u0440\u0430\u0445\u0435\u0430\u043B\u044C\u043D\u044B\u0445 \u0436\u0435\u043B\u0451\u0437
    \u2013 glandulae tracheales. \u0418\u0445 \u0432\u044B\u0432\u043E\u0434\u043D\u044B\u0435
    \u043F\u0440\u043E\u0442\u043E\u043A\u0438 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F
    \u0432 \u043F\u0440\u043E\u0441\u0432\u0435\u0442 \u0442\u0440\u0430\u0445\u0435\u0438.
    \u041F\u043E \u0442\u0438\u043F\u0443 \u0432\u044B\u0434\u0435\u043B\u044F\u0435\u043C\u043E\u0433\u043E
    \u0441\u0435\u043A\u0440\u0435\u0442\u0430 \u0436\u0435\u043B\u0435\u0437\u044B
    \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C \u0441\u043B\u0438\u0437\u0438\u0441\u0442\u044B\u043C\u0438,
    \u0441\u043C\u0435\u0448\u0430\u043D\u043D\u044B\u043C\u0438 \u0438 \u0441\u0435\u0440\u043E\u0437\u043D\u044B\u043C\u0438.\n\u0425\u043E\u043D\u0434\u0440\u043E\u0444\u0438\u0431\u0440\u043E\u0437\u043D\u0430\u044F
    \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0430 - tunica chondrofibrosa - \u0441\u043E\u0441\u0442\u043E\u0438\u0442
    \u0438\u0437 \u0433\u0438\u0430\u043B\u0438\u043D\u043E\u0432\u044B\u0445 \u0442\u0440\u0430\u0445\u0435\u0430\u043B\u044C\u043D\u044B\u0445
    \u0445\u0440\u044F\u0449\u0435\u0439 \u2013 cartilagines tracheales. \u041A\u043E\u043D\u0446\u044B
    \u0445\u0440\u044F\u0449\u0435\u0432\u044B\u0445 \u043A\u043E\u043B\u0435\u0446
    \u0441 \u0434\u043E\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B
    \u0442\u0440\u0430\u0445\u0435\u0438 \u0441\u0432\u044F\u0437\u0430\u043D\u044B
    \u0434\u0440\u0443\u0433 \u0441 \u0434\u0440\u0443\u0433\u043E\u043C \u0442\u0440\u0430\u0445\u0435\u0430\u043B\u044C\u043D\u044B\u043C\u0438
    \u0441\u0432\u044F\u0437\u043A\u0430\u043C\u0438 \u2013 ligamentum trachealia.\n\u041F\u0435\u0440\u0432\u044B\u0439
    \u0445\u0440\u044F\u0449 \u0442\u0440\u0430\u0445\u0435\u0438 \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0451\u043D
    \u043A \u043A\u043E\u043B\u044C\u0446\u0435\u0432\u0438\u0434\u043D\u043E\u043C\u0443
    \u0445\u0440\u044F\u0449\u0443 \u0433\u043E\u0440\u0442\u0430\u043D\u0438 \u043A\u043E\u043B\u044C\u0446\u0435\u0432\u0438\u0434\u043D\u043E-\u0442\u0440\u0430\u0445\u0435\u0439\u043D\u043E\u0439
    \u0441\u0432\u044F\u0437\u043A\u043E\u0439 \u2013 ligamentum circitracheale.
    \u041F\u043E\u0434 \u0441\u043B\u0438\u0437\u0438\u0437\u0441\u0442\u043E\u0439
    \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u043E\u0439 \u0432 \u0434\u043E\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0439
    \u0441\u0442\u0435\u043D\u043A\u0435 \u0442\u0440\u0430\u0445\u0435\u0438 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
    \u0442\u0440\u0430\u0445\u0435\u0430\u043B\u044C\u043D\u0430\u044F \u043C\u044B\u0448\u0446\u0430
    \u2013 musculus trachealis.\n\u0410\u0434\u0432\u0435\u043D\u0442\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u0430\u044F
    \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0430 - tunica adventitia - \u0441\u043E\u0441\u0442\u043E\u0438\u0442
    \u0438\u0437 \u0440\u044B\u0445\u043B\u043E\u0439 \u043D\u0435\u043E\u0444\u043E\u0440\u043C\u043B\u0435\u043D\u043D\u043E\u0439
    \u0442\u043A\u0430\u043D\u0438"
  clip: {fileID: 8300000, guid: 99d4f88c020efad44887ca05648b1ea6, type: 3}
