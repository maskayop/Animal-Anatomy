  m_Script: {fileID: 11500000, guid: 3f00395bd4580c04eb5d722a11c9666a, type: 3}
  m_Name: "\u041B\u0451\u0433\u043A\u0438\u0435 (\u0441\u0432\u0438\u043D\u044C\u044F)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u041B\u0451\u0433\u043A\u0438\u0435"
  scientificName: pulmones (pneumones)
  nameClip: {fileID: 8300000, guid: c4927dbbd1c0b9a4d90c0ce1a3db8e67, type: 3}
  description: "\u041F\u0430\u0440\u043D\u044B\u0435 \u043F\u0430\u0440\u0435\u043D\u0445\u0438\u043C\u0430\u0442\u043E\u0437\u043D\u044B\u0435
    \u043E\u0440\u0433\u0430\u043D\u044B, \u0441\u043B\u0443\u0436\u0430\u0449\u0438\u0435
    \u0434\u043B\u044F \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u0435\u043D\u0438\u044F
    \u0433\u0430\u0437\u043E\u043E\u0431\u043C\u0435\u043D\u0430 \u043C\u0435\u0436\u0434\u0443
    \u0432\u044B\u0434\u044B\u0445\u0430\u0435\u043C\u044B\u043C \u0432\u043E\u0437\u0434\u0443\u0445\u043E\u043C
    \u0438 \u043A\u0440\u043E\u0432\u044C\u044E. \u0412 \u0441\u0432\u043E\u0451\u043C
    \u0441\u043E\u0441\u0442\u0430\u0432\u0435 \u043B\u0451\u0433\u043A\u0438\u0435
    \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0442 \u0431\u0440\u043E\u043D\u0445\u0438\u0430\u043B\u044C\u043D\u043E\u0435
    \u0434\u0440\u0435\u0432\u043E (arbor bronchialis), \u0441\u043B\u0443\u0436\u0430\u0449\u0435\u0435
    \u0434\u043B\u044F \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F
    \u0432\u043E\u0437\u0434\u0443\u0445\u0430. \u0411\u0440\u043E\u043D\u0445\u0438\u0430\u043B\u044C\u043D\u043E\u0435
    \u0434\u0440\u0435\u0432\u043E \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u0430\u043B\u044C\u0432\u0435\u043E\u043B\u044F\u0440\u043D\u044B\u043C \u0434\u0440\u0435\u0432\u043E\u043C
    (arbor alveolaris), \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
    \u0433\u0430\u0437\u043E\u043E\u0431\u043C\u0435\u043D. \u0411\u0440\u043E\u043D\u0445\u0438\u0430\u043B\u044C\u043D\u043E\u0435
    \u0434\u0440\u0435\u0432\u043E \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442\u0441\u044F
    \u0432 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0435 \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
    \u0434\u0435\u043B\u0435\u043D\u0438\u044F \u043F\u0440\u0430\u0432\u043E\u0433\u043E
    \u0438 \u043B\u0435\u0432\u043E\u0433\u043E \u0433\u043B\u0430\u0432\u043D\u044B\u0445
    \u0431\u0440\u043E\u043D\u0445\u043E\u0432 (bronchi principales). \u0413\u043B\u0430\u0432\u043D\u044B\u0435
    \u0431\u0440\u043E\u043D\u0445\u0438 \u043F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E
    \u0434\u0435\u043B\u044F\u0442\u0441\u044F \u043D\u0430 \u0434\u043E\u043B\u0435\u0432\u044B\u0435
    \u0431\u0440\u043E\u043D\u0445\u0438 (bronchi lobares), \u0438\u0434\u0443\u0449\u0435\u0435
    \u0432 \u0434\u043E\u043B\u0438 \u043B\u0451\u0433\u043A\u0438\u0445. \u0422\u0430\u043C
    \u043E\u043D\u0438 \u0434\u0435\u043B\u044F\u0442\u0441\u044F \u043D\u0430 \u0441\u0435\u0433\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0435
    \u0431\u0440\u043E\u043D\u0445\u0438 (bronchi segmentales), \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0434\u0435\u043B\u044F\u0442 \u043B\u0451\u0433\u043A\u043E\u0435 \u043D\u0430
    \u0431\u0440\u043E\u043D\u0445\u043E\u043B\u0451\u0433\u043E\u0447\u043D\u044B\u0435
    \u0441\u0435\u0433\u043C\u0435\u043D\u0442\u044B. \u0412 \u0446\u0435\u043D\u0442\u0440\u0435
    \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0431\u0440\u043E\u043D\u0445\u043E\u043B\u0451\u0433\u043E\u0447\u043D\u043E\u0433\u043E
    \u0441\u0435\u0433\u043C\u0435\u043D\u0442\u0430 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
    \u0441\u0435\u0433\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0439
    \u0431\u0440\u043E\u043D\u0445 \u0438 \u0430\u0440\u0442\u0435\u0440\u0438\u044F.
    \u0412 \u0441\u0435\u0433\u043C\u0435\u043D\u0442\u0430\u0445 \u0441\u0435\u0433\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0435
    \u0431\u0440\u043E\u043D\u0445\u0438 \u0434\u0435\u043B\u044F\u0442\u0441\u044F
    \u043D\u0430 \u0441\u0443\u0431\u0441\u0435\u0433\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0435
    (bronchi subsegmentales). \u041E\u043D\u0438 \u0434\u0435\u043B\u044F\u0442\u0441\u044F
    \u043D\u0430 \u0434\u043E\u043B\u044C\u043A\u043E\u0432\u044B\u0435 \u0431\u0440\u043E\u043D\u0445\u0438
    (bronchi lobulares), \u0438\u0434\u0443\u0449\u0438\u0435 \u0432 \u0434\u043E\u043B\u044C\u043A\u0438
    \u043B\u0451\u0433\u043A\u0438\u0445. \u0414\u043E\u043B\u044C\u043A\u043E\u0432\u044B\u0435
    \u0434\u0435\u043B\u044F\u0442\u0441\u044F \u043D\u0430 \u0441\u0443\u0431\u043B\u043E\u0431\u0443\u043B\u044F\u0440\u043D\u044B\u0435
    \u0431\u0440\u043E\u043D\u0445\u0438 (bronchi sublobulares). \u041E\u043D\u0438
    \u0434\u0435\u043B\u044F\u0442\u0441\u044F \u043D\u0430 \u043F\u0440\u0435\u0442\u0435\u0440\u043C\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0435
    \u0431\u0440\u043E\u043D\u0445\u0438\u043E\u043B\u044B (bronchiole preterminales),
    \u0434\u0430\u044E\u0449\u0438\u0435 \u043D\u0430\u0447\u0430\u043B\u043E \u0442\u0435\u0440\u043C\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u043C
    \u0431\u0440\u043E\u043D\u0445\u0438\u043E\u043B\u0430\u043C (bronchioli terminales).
    \u0410 \u043E\u043D\u0438 \u0434\u0430\u044E\u0442 \u043D\u0430\u0447\u0430\u043B\u043E
    \u0430\u043B\u044C\u0432\u0435\u043E\u043B\u044F\u0440\u043D\u043E\u043C\u0443
    \u0434\u0440\u0435\u0432\u0443. \u041E\u043D\u043E \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442\u0441\u044F
    \u0432 \u043B\u0451\u0433\u043E\u0447\u043D\u043E\u043C \u0430\u0446\u0438\u043D\u0443\u0441\u0435
    (acinus pulmonalis). \u041A\u0430\u0436\u0434\u0430\u044F \u0442\u0435\u0440\u043C\u0438\u043D\u0430\u043B\u044C\u043D\u0430\u044F
    \u0431\u0440\u043E\u043D\u0445\u0438\u043E\u043B\u0430 \u0434\u0435\u043B\u0438\u0442\u0441\u044F
    \u043D\u0430 \u0440\u0435\u0441\u043F\u0438\u0440\u0430\u0442\u043E\u0440\u043D\u044B\u0435
    \u0431\u0440\u043E\u043D\u0445\u0438\u043E\u043B\u044B (bronchioli respiratorii),
    \u043E\u0442 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0438\u0434\u0443\u0442
    2 \u0440\u0435\u0441\u043F\u0438\u0440\u0430\u0442\u043E\u0440\u043D\u044B\u0445
    \u0445\u043E\u0434\u0430 (ductuli alveolaris). \u041E\u043D\u0438 \u043E\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F
    \u0430\u043B\u044C\u0432\u0435\u043E\u043B\u044F\u0440\u043D\u044B\u043C\u0438
    \u043C\u0435\u0448\u043E\u0447\u043A\u0430\u043C\u0438 (sacculi alveolaris).
    \u0412 \u043D\u0438\u0445 \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u044E\u0442\u0441\u044F
    \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u0435\u0441\u044F\u0442\u043A\u043E\u0432
    \u0430\u043B\u044C\u0432\u0435\u043E\u043B (alveoli pulmonis).\n\u0410\u043B\u044C\u0432\u0435\u043E\u043B\u044B
    \u2013 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0435 \u0442\u043E\u043D\u043A\u043E\u0441\u0442\u0435\u043D\u043D\u044B\u0435
    \u043F\u0443\u0437\u044B\u0440\u044C\u043A\u0438, \u0440\u0430\u0437\u0434\u0435\u043B\u0451\u043D\u043D\u044B\u0435
    \u0442\u043E\u043D\u043A\u0438\u043C\u0438 \u043F\u0440\u043E\u0441\u043B\u043E\u0439\u043A\u0430\u043C\u0438
    \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u0442\u043A\u0430\u043D\u0438. \u0412 \u0430\u043B\u044C\u0432\u0435\u043E\u043B\u0430\u0445
    \u0447\u0435\u0440\u0435\u0437 \u0430\u044D\u0440\u043E\u0433\u0435\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0431\u0430\u0440\u044C\u0435\u0440 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
    \u0433\u0430\u0437\u043E\u043E\u0431\u043C\u0435\u043D. \u041A\u0430\u0436\u0434\u044B\u0439
    \u0431\u0440\u043E\u043D\u0445 \u0441\u043E\u0441\u0442\u043E\u0438\u0442 \u0438\u0437
    \u0441\u043B\u0438\u0437\u0438\u0441\u0442\u043E\u0439, \u0444\u0438\u0431\u0440\u043E\u0437\u043D\u043E-\u0445\u0440\u044F\u0449\u0435\u0432\u043E\u0439,
    \u0430\u0434\u0432\u0435\u043D\u0442\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0439
    \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0438. \u0421\u043B\u0438\u0437\u0438\u0441\u0442\u0430\u044F
    \u0432\u044B\u0441\u0442\u043B\u0430\u043D\u0430 \u043C\u043D\u043E\u0433\u043E\u0440\u044F\u0434\u043D\u044B\u043C
    \u043C\u0435\u0440\u0446\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C \u044D\u043F\u0438\u0442\u0435\u043B\u0438\u0435\u043C.\n\u0424\u0438\u0431\u0440\u043E\u0437\u043D\u043E-\u0445\u0440\u044F\u0449\u0435\u0432\u0430\u044F
    \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442 \u0445\u0440\u044F\u0449\u0435\u0432\u043E\u0439
    \u0441\u043A\u0435\u043B\u0435\u0442 \u0431\u0440\u043E\u043D\u0445\u043E\u0432
    \u0438 \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u0430 \u0438\u0437 \u0433\u0438\u0430\u043B\u0438\u043D\u043E\u0432\u043E\u0433\u043E
    \u0445\u0440\u044F\u0449\u0430.\n\u0410\u0434\u0432\u0435\u043D\u0442\u0438\u0446\u0438\u044F
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430 \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u0442\u043A\u0430\u043D\u044C\u044E.\n\u0412\u0441\u0435 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B,
    \u0432\u0445\u043E\u0434\u044F\u0449\u0438\u0435 \u0432 \u0441\u043E\u0441\u0442\u0430\u0432
    \u0431\u0440\u043E\u043D\u0445\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0438 \u0430\u043B\u044C\u0432\u0435\u043E\u043B\u044F\u0440\u043D\u043E\u0433\u043E
    \u0434\u0440\u0435\u0432\u0430, \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u044F\u044E\u0442\u0441\u044F
    \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u0442\u043A\u0430\u043D\u044C\u044E \u0438 \u0432 \u0441\u043E\u0432\u043E\u043A\u0443\u043F\u043D\u043E\u0441\u0442\u0438
    \u043E\u0431\u0440\u0430\u0437\u0443\u044E\u0442 \u043F\u0440\u0430\u0432\u043E\u0435
    \u0438 \u043B\u0435\u0432\u043E\u0435 \u043B\u0451\u0433\u043A\u0438\u0435 (pulmo).
    \u041E\u043D\u0438 \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u044E\u0442\u0441\u044F
    \u0432 \u0433\u0440\u0443\u0434\u043D\u043E\u0439 \u043F\u043E\u043B\u043E\u0441\u0442\u0438
    \u0438 \u0441\u043D\u0430\u0440\u0443\u0436\u0438 \u043F\u043E\u043A\u0440\u044B\u0442\u044B
    \u043F\u043B\u0435\u0432\u0440\u043E\u0439. \u0420\u0430\u0437\u043B\u0438\u0447\u0430\u044E\u0442
    3 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438: \u0434\u0438\u0430\u0444\u0440\u0430\u0433\u043C\u0430\u043B\u044C\u043D\u0430\u044F
    (\u0432\u043E\u0433\u043D\u0443\u0442\u0430\u044F), \u0440\u0451\u0431\u0435\u0440\u043D\u0430\u044F
    (\u0432\u044B\u043F\u0443\u043A\u043B\u0430\u044F), \u0441\u0440\u0435\u0434\u043E\u0441\u0442\u0435\u043D\u043D\u0430\u044F.\n\u0421\u0440\u0435\u0434\u043E\u0441\u0442\u0435\u043D\u043D\u0430\u044F
    \u043D\u0435\u0441\u0451\u0442 \u043D\u0430 \u0441\u0435\u0431\u0435 \u0432\u043E\u0440\u043E\u0442\u0430
    \u043B\u0451\u0433\u043A\u0438\u0445, \u0447\u0435\u0440\u0435\u0437 \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0432 \u043D\u0435\u0433\u043E \u043F\u0440\u043E\u043D\u0438\u043A\u0430\u044E\u0442
    \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u0431\u0440\u043E\u043D\u0445, \u043B\u0451\u0433\u043E\u0447\u043D\u044B\u0435
    \u0430\u0440\u0442\u0435\u0440\u0438\u0438, \u043D\u0435\u0440\u0432\u044B \u0438
    \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u043B\u0451\u0433\u043E\u0447\u043D\u0430\u044F
    \u0432\u0435\u043D\u0430. \u0413\u043B\u0430\u0432\u043D\u044B\u0439 \u0431\u0440\u043E\u043D\u0445
    \u0432 \u0441\u043E\u0432\u043E\u043A\u0443\u043F\u043D\u043E\u0441\u0442\u0438
    \u0441 \u0441\u043E\u0441\u0443\u0434\u0430\u043C\u0438 \u0438 \u043D\u0435\u0440\u0432\u0430\u043C\u0438
    \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442 \u043A\u043E\u0440\u0435\u043D\u044C
    \u043B\u0451\u0433\u043A\u043E\u0433\u043E (radix pulmonis).\n\u0420\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442\u0441\u044F
    \u0430\u043E\u0440\u0442\u0430\u043B\u044C\u043D\u043E\u0435 \u0438 \u043F\u0438\u0449\u0435\u0432\u043E\u0434\u043D\u043E\u0435
    \u0432\u0434\u0430\u0432\u043B\u0438\u0432\u0430\u043D\u0438\u044F (impression
    aortica et esophagea) \u0438 \u0436\u0451\u043B\u043E\u0431 \u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u043E\u0439
    \u043F\u043E\u043B\u043E\u0439 \u0432\u0435\u043D\u044B (sulcus venae cavae caudalis).
    \u0412 \u043C\u0435\u0441\u0442\u0435 \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u044F
    \u0441\u0435\u0440\u0434\u0446\u0430 \u043B\u0451\u0433\u043A\u043E\u0435 \u043D\u0435\u0441\u0451\u0442
    \u043D\u0430 \u0441\u0435\u0431\u0435 \u043F\u0440\u0430\u0432\u0443\u044E \u0438
    \u043B\u0435\u0432\u0443\u044E \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u044B\u0435
    \u0432\u044B\u0440\u0435\u0437\u043A\u0438 (incisura cardiaca pulmonis).\n\u041D\u0430
    \u043A\u0430\u0436\u0434\u043E\u043C \u043B\u0451\u0433\u043A\u043E\u043C \u0435\u0441\u0442\u044C
    \u0442\u0443\u043F\u043E\u0439 (\u0434\u043E\u0440\u0441\u0430\u043B\u044C\u043D\u044B\u0439)
    \u043A\u0440\u0430\u0439 (margo obtusus) \u0438 \u043E\u0441\u0442\u0440\u044B\u0439
    (\u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0439) \u043A\u0440\u0430\u0439
    (margo acutus).\n\u041A\u0430\u0436\u0434\u043E\u0435 \u043B\u0451\u0433\u043A\u043E\u0435
    \u0441\u043E\u0441\u0442\u043E\u0438\u0442 \u0438\u0437 \u043A\u0440\u0430\u043D\u0438\u0430\u043B\u044C\u043D\u043E\u0439
    (\u0432\u0435\u0440\u0445\u0443\u0448\u0435\u0447\u043D\u043E\u0439) \u0434\u043E\u043B\u0438,
    \u0441\u0440\u0435\u0434\u043D\u0435\u0439 (\u0441\u0435\u0440\u0434\u0435\u0447\u043D\u043E\u0439)
    \u0438 \u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u043E\u0439 (\u0434\u0438\u0430\u0444\u0440\u0430\u0433\u043C\u0430\u043B\u044C\u043D\u043E\u0439).
    \u041D\u0430 \u043F\u0440\u0430\u0432\u043E\u043C \u043B\u0451\u0433\u043A\u043E\u043C
    \u0435\u0441\u0442\u044C \u0434\u043E\u0431\u0430\u0432\u043E\u0447\u043D\u0430\u044F
    \u0434\u043E\u043B\u044F.\n\u0423 \u0441\u0432\u0438\u043D\u044C\u0438 \u043B\u0451\u0433\u043A\u0438\u0435
    \u043E\u0442\u043B\u0438\u0447\u0430\u044E\u0442\u0441\u044F \u0442\u0435\u043C,
    \u0447\u0442\u043E \u043F\u0440\u0430\u0432\u043E\u0435 \u043A\u0440\u0430\u043D\u0438\u0430\u043B\u044C\u043D\u0430\u044F
    \u0434\u043E\u043B\u044F \u0445\u043E\u0442\u044F \u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0430
    \u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u043B\u0435\u0432\u043E\u0439, \u043D\u043E
    \u043D\u0430 \u0447\u0430\u0441\u0442\u0438 \u043D\u0435 \u0434\u0435\u043B\u0438\u0442\u0441\u044F.
    \u041F\u0440\u0430\u0432\u0430\u044F \u043A\u0440\u0430\u043D\u0438\u0430\u043B\u044C\u043D\u0430\u044F
    \u0434\u043E\u043B\u044F \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0439 \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u043E\u0439
    \u0432\u044B\u0440\u0435\u0437\u043A\u043E\u0439 \u043F\u043E\u0434\u0440\u0430\u0437\u0434\u0435\u043B\u044F\u0435\u0442\u0441\u044F
    \u043D\u0430 \u043A\u0440\u0430\u043D\u0438\u0430\u043B\u044C\u043D\u0443\u044E
    \u0438 \u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u0443\u044E \u0447\u0430\u0441\u0442\u0438"
