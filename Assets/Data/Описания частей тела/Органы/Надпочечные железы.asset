  m_Script: {fileID: 11500000, guid: 3f00395bd4580c04eb5d722a11c9666a, type: 3}
  m_Name: "\u041D\u0430\u0434\u043F\u043E\u0447\u0435\u0447\u043D\u044B\u0435 \u0436\u0435\u043B\u0435\u0437\u044B"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u041D\u0430\u0434\u043F\u043E\u0447\u0435\u0447\u043D\u044B\u0435
    \u0436\u0435\u043B\u0435\u0437\u044B (\u043D\u0430\u0434\u043F\u043E\u0447\u0435\u0447\u043D\u0438\u043A\u0438)"
  scientificName: glandulae suprarenales
  description: "\u041F\u0430\u0440\u043D\u044B\u0435 \u0436\u0435\u043B\u0435\u0437\u044B
    \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0439 \u0441\u0435\u043A\u0440\u0435\u0446\u0438\u0438,
    \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0435
    \u0432\u0431\u043B\u0438\u0437\u0438 \u043F\u043E\u0447\u0435\u043A.\n\u0416\u0435\u043B\u0435\u0437\u044B
    \u043B\u0435\u0436\u0430\u0442 \u0432 \u0431\u0440\u044E\u0448\u043D\u043E\u0439
    \u043F\u043E\u043B\u043E\u0441\u0442\u0438 \u0432\u043C\u0435\u0441\u0442\u0435
    \u0441 \u043F\u043E\u0447\u043A\u0430\u043C\u0438, \u0441\u0432\u044F\u0437\u0430\u043D\u044B
    \u0441 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C\u0438 \u0436\u0438\u0440\u043E\u0432\u043E\u0439
    \u043A\u0430\u043F\u0441\u0443\u043B\u043E\u0439 \u0438 \u0441\u043E\u0441\u0443\u0434\u0430\u043C\u0438.\n\u0423
    \u043A\u0440\u0443\u043F\u043D\u043E\u0433\u043E \u0440\u043E\u0433\u0430\u0442\u043E\u0433\u043E
    \u0441\u043A\u043E\u0442\u0430 \u043F\u0440\u0430\u0432\u0430\u044F \u0436\u0435\u043B\u0435\u0437\u0430
    \u0441\u0435\u0440\u0434\u0446\u0435\u0432\u0438\u0434\u043D\u043E\u0439 \u0444\u043E\u0440\u043C\u044B,
    \u043B\u0435\u0432\u0430\u044F \u2014 \u0431\u043E\u0431\u043E\u0432\u0438\u0434\u043D\u043E\u0439,
    \u0434\u043B\u0438\u043D\u0430 \u2014 3\u20134 \u0441\u043C.\n\u041D\u0430\u0434\u043F\u043E\u0447\u0435\u0447\u043D\u0438\u043A\u0438
    \u043A\u0440\u0430\u0441\u043D\u043E-\u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u043E\u0433\u043E
    \u0446\u0432\u0435\u0442\u0430. \u0421\u043D\u0430\u0440\u0443\u0436\u0438 \u043F\u043E\u043A\u0440\u044B\u0442\u044B
    \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0442\u043A\u0430\u043D\u043D\u043E\u0439
    \u043A\u0430\u043F\u0441\u0443\u043B\u043E\u0439.\n\u0412 \u043D\u0430\u0434\u043F\u043E\u0447\u0435\u0447\u043D\u0438\u043A\u0435
    \u0440\u0430\u0437\u043B\u0438\u0447\u0430\u044E\u0442 \u043A\u043E\u0440\u043A\u043E\u0432\u043E\u0435
    \u0438 \u043C\u043E\u0437\u0433\u043E\u0432\u043E\u0435 \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430.\n\u041A\u043E\u0440\u043A\u043E\u0432\u043E\u0435
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u043E \u0434\u0435\u043B\u0438\u0442\u0441\u044F
    \u043D\u0430 \u0442\u0440\u0438 \u0437\u043E\u043D\u044B: \u043A\u043B\u0443\u0431\u043E\u0447\u043A\u043E\u0432\u0443\u044E,
    \u043F\u0443\u0447\u043A\u043E\u0432\u0443\u044E \u0438 \u0441\u0435\u0442\u0447\u0430\u0442\u0443\u044E:\n-
    \u043A\u043B\u0443\u0431\u043E\u0447\u043A\u043E\u0432\u0430\u044F \u0437\u043E\u043D\u0430
    \u2014 \u043C\u0435\u043B\u043A\u0438\u0435 \u0441\u0435\u043A\u0440\u0435\u0442\u043E\u0440\u043D\u044B\u0435
    \u043A\u043B\u0435\u0442\u043A\u0438, \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E
    \u0446\u0438\u043B\u0438\u043D\u0434\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u0439
    \u0444\u043E\u0440\u043C\u044B, \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u044E\u0442\u0441\u044F
    \u0432 \u0432\u0438\u0434\u0435 \u043A\u043B\u0443\u0431\u043E\u0447\u043A\u043E\u0432;\n-
    \u043F\u0443\u0447\u043A\u043E\u0432\u0430\u044F \u0437\u043E\u043D\u0430 \u2014
    \u0431\u043E\u043B\u0435\u0435 \u043A\u0440\u0443\u043F\u043D\u044B\u0435 \u0441\u0435\u043A\u0440\u0435\u0442\u043E\u0440\u043D\u044B\u0435
    \u043A\u043B\u0435\u0442\u043A\u0438 \u043F\u043E\u043B\u0438\u0433\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0439
    \u0444\u043E\u0440\u043C\u044B, \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u044B
    \u0432 \u0432\u0438\u0434\u0435 \u0440\u0430\u0434\u0438\u0430\u043B\u044C\u043D\u043E
    \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0445
    \u0442\u044F\u0436\u0435\u0439;\n- \u0441\u0435\u0442\u0447\u0430\u0442\u0430\u044F
    \u0437\u043E\u043D\u0430 \u2014 \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u0430
    \u0438\u0437 \u043F\u0435\u0440\u0435\u043F\u043B\u0435\u0442\u0435\u043D\u0438\u044F
    \u043A\u043B\u0435\u0442\u043E\u0447\u043D\u044B\u0445 \u0442\u044F\u0436\u0435\u0439
    \u044D\u043F\u0438\u0442\u0435\u043B\u0438\u0430\u043B\u044C\u043D\u044B\u0445
    \u043A\u043B\u0435\u0442\u043E\u043A.\n\u041C\u043E\u0437\u0433\u043E\u0432\u043E\u0435
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u043E \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043E
    \u0432 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439 \u0447\u0430\u0441\u0442\u0438
    \u043E\u0440\u0433\u0430\u043D\u0430 \u0438 \u043E\u0442\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043E
    \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0439 \u043A\u0430\u043F\u0441\u0443\u043B\u043E\u0439.
    \u0412 \u0441\u043E\u0441\u0442\u0430\u0432 \u043C\u043E\u0437\u0433\u043E\u0432\u043E\u0433\u043E
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430 \u0432\u0445\u043E\u0434\u044F\u0442
    \u0445\u0440\u043E\u043C\u0430\u0444\u0438\u043D\u043D\u044B\u0435 \u043A\u043B\u0435\u0442\u043A\u0438,
    \u0441\u0438\u043C\u043F\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u043D\u0435\u0439\u0440\u043E\u043D\u044B, \u043C\u043D\u043E\u0433\u043E\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u044B\u0435
    \u043D\u0435\u0440\u0432\u043D\u044B\u0435 \u0432\u043E\u043B\u043E\u043A\u043D\u0430
    \u0438 \u0441\u0438\u043D\u0443\u0441\u043E\u0438\u0434\u043D\u044B\u0435 \u043A\u0430\u043F\u0438\u043B\u043B\u044F\u0440\u044B.\n\u041A\u043E\u0440\u043A\u043E\u0432\u043E\u0435
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u043E \u0432\u044B\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442
    \u0431\u043E\u043B\u0435\u0435 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u0438
    \u0433\u043E\u0440\u043C\u043E\u043D\u043E\u0432, \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u044E\u0449\u0438\u0445
    \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0430\u0446\u0438\u044E \u043D\u0430\u0442\u0440\u0438\u044F,
    \u043A\u0430\u043B\u0438\u044F \u0438 \u0445\u043B\u043E\u0440\u0430 \u0432 \u043A\u0440\u043E\u0432\u0438
    \u0438 \u0442\u043A\u0430\u043D\u044F\u0445, \u0443\u0433\u043B\u0435\u0432\u043E\u0434\u043D\u044B\u0439,
    \u0431\u0435\u043B\u043A\u043E\u0432\u044B\u0439 \u0438 \u0436\u0438\u0440\u043E\u0432\u043E\u0439
    \u043E\u0431\u043C\u0435\u043D\u044B, \u0430 \u0442\u0430\u043A\u0436\u0435 \u0432\u044B\u0440\u0430\u0431\u043E\u0442\u043A\u0443
    \u043F\u043E\u043B\u043E\u0432\u044B\u0445 \u0433\u043E\u0440\u043C\u043E\u043D\u043E\u0432.\n\u041C\u043E\u0437\u0433\u043E\u0432\u043E\u0435
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u043E \u0432\u044B\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442
    \u0430\u0434\u0440\u0435\u043D\u0430\u043B\u0438\u043D \u0438 \u043D\u043E\u0440\u0430\u0434\u0440\u0435\u043D\u0430\u043B\u0438\u043D"
  clip: {fileID: 8300000, guid: b6123df422a129647b77a24501d30173, type: 3}
