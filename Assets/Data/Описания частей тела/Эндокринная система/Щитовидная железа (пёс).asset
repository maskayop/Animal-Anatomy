  m_Script: {fileID: 11500000, guid: 3f00395bd4580c04eb5d722a11c9666a, type: 3}
  m_Name: "\u0429\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u0430\u044F \u0436\u0435\u043B\u0435\u0437\u0430
    (\u043F\u0451\u0441)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0429\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u0430\u044F \u0436\u0435\u043B\u0435\u0437\u0430"
  scientificName: glandula thyreoidea
  description: "\u042D\u043D\u0434\u043E\u043A\u0440\u0438\u043D\u043D\u0430\u044F
    \u0436\u0435\u043B\u0435\u0437\u0430 \u0443 \u043F\u043E\u0437\u0432\u043E\u043D\u043E\u0447\u043D\u044B\u0445,
    \u0445\u0440\u0430\u043D\u044F\u0449\u0430\u044F \u0439\u043E\u0434 \u0438 \u0432\u044B\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E\u0449\u0430\u044F
    \u0439\u043E\u0434\u043E\u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0449\u0438\u0435
    \u0433\u043E\u0440\u043C\u043E\u043D\u044B (\u0439\u043E\u0434\u0442\u0438\u0440\u043E\u043D\u0438\u043D\u044B).
    \u041E\u0440\u0433\u0430\u043D \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0439
    \u0441\u0435\u043A\u0440\u0435\u0446\u0438\u0438. \u0420\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D
    \u043F\u043E \u043F\u0440\u0430\u0432\u043E\u0439 \u0438 \u043B\u0435\u0432\u043E\u0439
    \u0441\u0442\u043E\u0440\u043E\u043D\u0435 \u0442\u0440\u0430\u0445\u0435\u0438,
    \u0438\u043C\u0435\u0435\u0442 \u0432\u0438\u0434 \u043C\u0438\u043D\u0434\u0430\u043B\u0438\u043D,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C
    \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u044B \u043F\u0435\u0440\u0435\u0448\u0435\u0439\u043A\u043E\u043C.\r\n\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430
    \u0434\u0432\u0443\u043C\u044F \u0430\u0441\u0441\u0438\u043C\u0435\u0442\u0440\u0438\u0447\u043D\u044B\u043C\u0438
    \u0434\u043E\u043B\u044F\u043C\u0438. \u0420\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u044B
    \u043D\u0430 \u0434\u043E\u0440\u0441\u043E-\u043B\u0430\u0442\u0435\u0440\u0430\u043B\u044C\u043D\u043E\u0439
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u0442\u0440\u0430\u0445\u0435\u0438
    \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438 2\u20136-\u0433\u043E \u0442\u0440\u0430\u0445\u0435\u0430\u043B\u044C\u043D\u044B\u0445
    \u043A\u043E\u043B\u0435\u0446. \u041F\u0435\u0440\u0435\u0448\u0435\u0435\u043A,
    \u043A\u0430\u043A \u043F\u0440\u0430\u0432\u0438\u043B\u043E, \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442.\r\n\u0421\u043D\u0430\u0440\u0443\u0436\u0438
    \u043F\u043E\u043A\u0440\u044B\u0442\u0430 \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u043E\u0439
    \u0438\u0437 \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u0442\u043A\u0430\u043D\u0438, \u043E\u0442 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
    \u0432\u0433\u043B\u0443\u0431\u044C \u043E\u0440\u0433\u0430\u043D\u0430 \u043E\u0442\u0445\u043E\u0434\u044F\u0442
    \u043F\u0435\u0440\u0435\u0433\u043E\u0440\u043E\u0434\u043A\u0438. \u0412 \u043D\u0438\u0445
    \u043F\u0440\u043E\u0445\u043E\u0434\u044F\u0442 \u043A\u0440\u043E\u0432\u0435\u043D\u043E\u0441\u043D\u044B\u0435,
    \u043B\u0438\u043C\u0444\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0441\u043E\u0441\u0443\u0434\u044B \u0438 \u043D\u0435\u0440\u0432\u044B.\n\u041A\u0430\u0436\u0434\u0430\u044F
    \u0434\u043E\u043B\u044C\u043A\u0430 \u0441\u043E\u0441\u0442\u043E\u0438\u0442
    \u0438\u0437 \u043C\u0438\u043A\u0440\u043E\u0441\u043A\u043E\u043F\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0444\u043E\u043B\u043B\u0438\u043A\u0443\u043B\u043E\u0432 \u2014 \u043F\u0443\u0437\u044B\u0440\u044C\u043A\u043E\u0432,
    \u0432\u043D\u0443\u0442\u0440\u0438 \u043A\u043E\u0442\u043E\u0440\u044B\u0445
    \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043A\u043E\u043B\u043B\u043E\u0438\u0434,
    \u0430 \u0441\u0442\u0435\u043D\u043A\u0438 \u0432\u044B\u0441\u0442\u043B\u0430\u043D\u044B
    \u0444\u043E\u043B\u043B\u0438\u043A\u0443\u043B\u044F\u0440\u043D\u044B\u043C\u0438
    \u043A\u043B\u0435\u0442\u043A\u0430\u043C\u0438.\r\n\u041F\u0435\u0440\u0435\u0433\u043E\u0440\u043E\u0434\u043A\u0438
    \u0434\u0435\u043B\u044F\u0442 \u043E\u0440\u0433\u0430\u043D \u043D\u0430 \u0434\u043E\u043B\u044C\u043A\u0438,
    \u0432\u043D\u0443\u0442\u0440\u0438 \u043A\u043E\u0442\u043E\u0440\u044B\u0445
    \u043D\u0430\u0445\u043E\u0434\u044F\u0442\u0441\u044F \xAB\u043C\u0435\u0448\u043E\u0447\u043A\u0438\xBB
    (\u0444\u043E\u043B\u043B\u0438\u043A\u0443\u043B\u044B), \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u044B\u0435
    \u043A\u043E\u043B\u043B\u043E\u0438\u0434\u043E\u043C, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0431\u043E\u0433\u0430\u0442 \u0439\u043E\u0434\u043E\u043C.\r\n\u0410\u043D\u0430\u0442\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0438
    \u043A \u043E\u0440\u0433\u0430\u043D\u0443 \u043F\u0440\u0438\u043B\u0435\u0436\u0430\u0442
    \u043F\u0430\u0440\u0430\u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u044B\u0435
    \u0436\u0435\u043B\u0435\u0437\u044B, \u043D\u0435\u0440\u0435\u0434\u043A\u043E
    \u0444\u043E\u0440\u043C\u0438\u0440\u0443\u044F \u0441 \u043D\u0438\u043C \u0435\u0434\u0438\u043D\u0443\u044E
    \u043A\u0430\u043F\u0441\u0443\u043B\u0443. \u0420\u0430\u0437\u043C\u0435\u0440
    \u0443 \u0441\u043E\u0431\u0430\u043A \u2014 2,5\u20133,0 \xD7 0,4\u20130,6 \u0441\u043C.\r\n\u0424\u0443\u043D\u043A\u0446\u0438\u0438:\r\n-
    \u0412 \u043D\u043E\u0440\u043C\u0435 \u0432\u044B\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442
    \u0442\u0438\u0440\u0435\u043E\u0438\u0434\u043D\u044B\u0435 \u0433\u043E\u0440\u043C\u043E\u043D\u044B:
    \u0442\u0440\u0438\u0439\u043E\u0434\u0442\u0438\u0440\u043E\u043D\u0438\u043D
    (\u04223) \u0438 \u0442\u0435\u0442\u0440\u0430\u0439\u043E\u0434\u0442\u0438\u0440\u043E\u043D\u0438\u043D
    (\u0442\u0438\u0440\u043E\u043A\u0441\u0438\u043D, \u04224).\n- \u0413\u043E\u0440\u043C\u043E\u043D\u044B
    \u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u043E\u0439 \u0436\u0435\u043B\u0435\u0437\u044B
    \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u044E\u0442 \u0432 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u0438
    \u043C\u0435\u0442\u0430\u0431\u043E\u043B\u0438\u0437\u043C\u0430 \u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B
    \u0434\u043B\u044F \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u0435\u043D\u0438\u044F
    \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0433\u043E \u043E\u0431\u043C\u0435\u043D\u0430.\n-
    \u0422\u0430\u043A\u0436\u0435 \u0433\u043E\u0440\u043C\u043E\u043D\u044B \u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u043E\u0439
    \u0436\u0435\u043B\u0435\u0437\u044B \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u044E\u0442
    \u0432 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0439
    \u0447\u0430\u0441\u0442\u043E\u0442\u044B \u0441\u0435\u0440\u0434\u0435\u0447\u043D\u044B\u0445
    \u0441\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u0438\u0439, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0442
    \u0434\u043E\u043B\u0436\u043D\u0443\u044E \u043D\u0435\u0440\u0432\u043D\u0443\u044E
    \u0432\u043E\u0437\u0431\u0443\u0434\u0438\u043C\u043E\u0441\u0442\u044C \u0438
    \u0442. \u0434."
