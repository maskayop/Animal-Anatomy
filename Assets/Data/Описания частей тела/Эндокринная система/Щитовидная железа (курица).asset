  m_Script: {fileID: 11500000, guid: 3f00395bd4580c04eb5d722a11c9666a, type: 3}
  m_Name: "\u0429\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u0430\u044F \u0436\u0435\u043B\u0435\u0437\u0430
    (\u043A\u0443\u0440\u0438\u0446\u0430)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0429\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u0430\u044F \u0436\u0435\u043B\u0435\u0437\u0430"
  scientificName: glandula thyreoidea
  nameClip: {fileID: 8300000, guid: 57670cb7ce8997f42b975eeafadfd90d, type: 3}
  description: "\u0423 \u043F\u0442\u0438\u0446 \u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u0430\u044F
    \u0436\u0435\u043B\u0435\u0437\u0430 \u043F\u0430\u0440\u043D\u0430\u044F. \u041E\u043D\u0430
    \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0430 \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438
    \u0432\u0445\u043E\u0434\u0430 \u0432 \u0433\u0440\u0443\u0434\u043D\u0443\u044E
    \u043F\u043E\u043B\u043E\u0441\u0442\u044C, \u043C\u0435\u0436\u0434\u0443 \u0441\u043E\u043D\u043D\u043E\u0439
    \u0430\u0440\u0442\u0435\u0440\u0438\u0435\u0439 \u0438 \u0442\u0440\u0430\u0445\u0435\u0435\u0439.
    \u0416\u0435\u043B\u0435\u0437\u044B \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0435,
    \u043E\u043A\u0440\u0443\u0433\u043B\u043E\u0439 \u0438\u043B\u0438 \u043E\u0432\u0430\u043B\u044C\u043D\u043E\u0439
    \u0444\u043E\u0440\u043C\u044B, \u0442\u0435\u043B\u0435\u0441\u043D\u043E\u0433\u043E
    \u0446\u0432\u0435\u0442\u0430, \u043E\u0431\u0438\u043B\u044C\u043D\u043E \u0441\u043D\u0430\u0431\u0436\u0435\u043D\u044B
    \u0441\u043E\u0441\u0443\u0434\u0430\u043C\u0438. \u0413\u0440\u0443\u0434\u043D\u0430\u044F
    \u043A\u043E\u0441\u0442\u044C \u0438 \u043C\u044B\u0448\u0446\u044B \u043D\u0430\u0434\u0451\u0436\u043D\u043E
    \u0441\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u0438\u0445, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
    \u043F\u0440\u0438 \u043E\u0431\u044B\u0447\u043D\u043E\u043C \u043E\u0441\u043C\u043E\u0442\u0440\u0435
    \u0437\u0430\u043C\u0435\u0442\u0438\u0442\u044C \u0438\u0445 \u0441\u043B\u043E\u0436\u043D\u043E.\n\u0421\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u043D\u043E-\u0444\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0439
    \u0435\u0434\u0438\u043D\u0438\u0446\u0435\u0439 \u0436\u0435\u043B\u0435\u0437\u044B
    \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u0444\u043E\u043B\u043B\u0438\u043A\u0443\u043B\u044B
    \u2014 \u0437\u0430\u043C\u043A\u043D\u0443\u0442\u044B\u0435 \u043F\u0443\u0437\u044B\u0440\u044C\u043A\u0438,
    \u0441\u0442\u0435\u043D\u043A\u0438 \u043A\u043E\u0442\u043E\u0440\u044B\u0445
    \u0441\u043E\u0441\u0442\u043E\u044F\u0442 \u0438\u0437 \u044D\u043F\u0438\u0442\u0435\u043B\u0438\u0430\u043B\u044C\u043D\u044B\u0445
    \u043A\u043B\u0435\u0442\u043E\u043A (\u0442\u0438\u0440\u043E\u0446\u0438\u0442\u043E\u0432).
    \u041F\u043E\u043B\u043E\u0441\u0442\u044C \u043A\u0430\u0436\u0434\u043E\u0433\u043E
    \u0444\u043E\u043B\u043B\u0438\u043A\u0443\u043B\u0430 \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u0430
    \u043A\u043E\u043B\u043B\u043E\u0438\u0434\u043E\u043C, \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0449\u0438\u043C
    \u0441\u043F\u0435\u0446\u0438\u0444\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0431\u0435\u043B\u043E\u043A \u2014 \u0442\u0438\u0440\u0435\u043E\u0433\u043B\u043E\u0431\u0443\u043B\u0438\u043D.\n\u0429\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u0430\u044F
    \u0436\u0435\u043B\u0435\u0437\u0430 \u043D\u0430\u043A\u0430\u043F\u043B\u0438\u0432\u0430\u0435\u0442
    \u0439\u043E\u0434 \u0438 \u0441\u0438\u043D\u0442\u0435\u0437\u0438\u0440\u0443\u0435\u0442
    \u0439\u043E\u0434\u0441\u043E\u0434\u0435\u0440\u0436\u0430\u0449\u0438\u0435
    \u0433\u043E\u0440\u043C\u043E\u043D\u044B: \u0422\u0438\u0440\u043E\u043A\u0441\u0438\u043D
    (T4), \u0422\u0440\u0438\u0439\u043E\u0434\u0442\u0438\u0440\u043E\u043D\u0438\u043D
    (T3). \u042D\u0442\u0438 \u0433\u043E\u0440\u043C\u043E\u043D\u044B \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u0443\u044E\u0442
    \u043E\u043A\u0438\u0441\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u044B \u0432 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u0435,
    \u0441\u0442\u0438\u043C\u0443\u043B\u0438\u0440\u0443\u044E\u0442 \u0432\u0441\u0435
    \u0432\u0438\u0434\u044B \u043E\u0431\u043C\u0435\u043D\u0430 \u0432\u0435\u0449\u0435\u0441\u0442\u0432,
    \u0432\u043B\u0438\u044F\u044E\u0442 \u043D\u0430 \u0440\u043E\u0441\u0442, \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435
    \u0438 \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043D\u0446\u0438\u0440\u043E\u0432\u043A\u0443
    \u0442\u043A\u0430\u043D\u0435\u0439. \u0422\u0430\u043A\u0436\u0435 \u0436\u0435\u043B\u0435\u0437\u0430
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442 \u043F\u0435\u043F\u0442\u0438\u0434\u043D\u044B\u0439
    \u0433\u043E\u0440\u043C\u043E\u043D \u043A\u0430\u043B\u044C\u0446\u0438\u0442\u043E\u043D\u0438\u043D,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0442
    \u0432 \u0440\u0435\u0433\u0443\u043B\u044F\u0446\u0438\u0438 \u043A\u0430\u043B\u044C\u0446\u0438\u0435\u0432\u043E-\u0444\u043E\u0441\u0444\u043E\u0440\u043D\u043E\u0433\u043E
    \u0433\u043E\u043C\u0435\u043E\u0441\u0442\u0430\u0437\u0430 \u0447\u0435\u0440\u0435\u0437
    \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043D\u0430
    \u043A\u043E\u0441\u0442\u043D\u0443\u044E \u0442\u043A\u0430\u043D\u044C.\n\u0413\u043E\u0440\u043C\u043E\u043D\u044B
    \u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u043E\u0439 \u0436\u0435\u043B\u0435\u0437\u044B
    \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u0432\u0430\u0436\u043D\u044B
    \u0434\u043B\u044F \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F \u0438 \u0436\u0438\u0437\u043D\u0435\u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u043F\u0442\u0438\u0446\u044B. \u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440:
    \u0443\u0434\u0430\u043B\u0435\u043D\u0438\u0435 \u0436\u0435\u043B\u0435\u0437\u044B
    \u0432 \u043F\u043E\u0441\u0442\u044D\u043C\u0431\u0440\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439
    \u043F\u0435\u0440\u0438\u043E\u0434 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442
    \u0440\u043E\u0441\u0442 \u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435
    \u0446\u044B\u043F\u043B\u044F\u0442. \u0412\u0432\u0435\u0434\u0435\u043D\u0438\u0435
    \u0433\u043E\u0440\u043C\u043E\u043D\u043E\u0432 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
    \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u044B\u0439 \u0440\u043E\u0441\u0442.\n\u0422\u0438\u0440\u043E\u043A\u0441\u0438\u043D
    \u0432 \u043E\u043F\u0442\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0445 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430\u0445
    \u0443\u0441\u043A\u043E\u0440\u044F\u0435\u0442 \u0441\u043E\u0437\u0440\u0435\u0432\u0430\u043D\u0438\u0435
    \u0444\u043E\u043B\u043B\u0438\u043A\u0443\u043B\u043E\u0432 \u0438 \u0441\u0442\u0438\u043C\u0443\u043B\u0438\u0440\u0443\u0435\u0442
    \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C \u044F\u0438\u0447\u043D\u0438\u043A\u043E\u0432.\r\n\u041F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0435
    \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435 \u0433\u043E\u0440\u043C\u043E\u043D\u0430
    \u0432 \u043A\u0440\u043E\u0432\u0438 \u0442\u043E\u0440\u043C\u043E\u0437\u0438\u0442
    \u0444\u0443\u043D\u043A\u0446\u0438\u044E \u043F\u043E\u043B\u043E\u0432\u044B\u0445
    \u0436\u0435\u043B\u0451\u0437, \u0441\u043D\u0438\u0436\u0430\u0435\u0442 \u044F\u0439\u0446\u0435\u043D\u043E\u0441\u043A\u043E\u0441\u0442\u044C
    \u0438 \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u043E\u0432\u043E\u0446\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u043B\u0438\u043D\u044C\u043A\u0443.\n\u0429\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u0430\u044F
    \u0436\u0435\u043B\u0435\u0437\u0430 \u2014 \u044D\u0442\u043E \u0433\u043B\u0430\u0432\u043D\u044B\u0439
    \u0440\u0435\u0433\u0443\u043B\u044F\u0442\u043E\u0440 \u043C\u0435\u0442\u0430\u0431\u043E\u043B\u0438\u0437\u043C\u0430
    \u0443 \u043A\u0443\u0440\u0438\u0446\u044B"
  clip: {fileID: 0}
