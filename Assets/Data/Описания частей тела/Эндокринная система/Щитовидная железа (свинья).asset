  m_Script: {fileID: 11500000, guid: 3f00395bd4580c04eb5d722a11c9666a, type: 3}
  m_Name: "\u0429\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u0430\u044F \u0436\u0435\u043B\u0435\u0437\u0430
    (\u0441\u0432\u0438\u043D\u044C\u044F)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0429\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u0430\u044F \u0436\u0435\u043B\u0435\u0437\u0430"
  scientificName: glandula thyreoidea
  description: "\u041D\u0435\u043F\u0430\u0440\u043D\u044B\u0439 \u043A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u044B\u0439
    \u043E\u0440\u0433\u0430\u043D, \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0439
    \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438 \u0442\u0440\u0430\u0445\u0435\u0438.
    \u0423 \u0432\u0437\u0440\u043E\u0441\u043B\u044B\u0445 \u0441\u0432\u0438\u043D\u0435\u0439
    \u0447\u0430\u0449\u0435 \u0432\u0441\u0435\u0433\u043E \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
    \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438 \u043F\u0435\u0440\u0432\u044B\u0445
    (2\u20133) \u043A\u043E\u043B\u0435\u0446 \u0442\u0440\u0430\u0445\u0435\u0438.\r\n\u0424\u043E\u0440\u043C\u0430
    \u043E\u0440\u0433\u0430\u043D\u0430 \u0440\u0430\u0437\u043D\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u0430
    \u0438 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0430:\n\u0432
    \u043D\u043E\u0432\u043E\u0440\u043E\u0436\u0434\u0451\u043D\u043D\u044B\u0439
    \u043F\u0435\u0440\u0438\u043E\u0434 \u2014 \u0441\u0435\u0440\u0434\u0446\u0435\u0432\u0438\u0434\u043D\u043E\u0439
    \u0444\u043E\u0440\u043C\u044B;\r\n\u0432 \u043F\u043E\u0434\u0441\u043E\u0441\u043D\u044B\u0439
    \u043F\u0435\u0440\u0438\u043E\u0434 \u2014 \u043E\u0432\u0430\u043B\u044C\u043D\u043E
    \u0432\u044B\u0442\u044F\u043D\u0443\u0442\u0430\u044F \u0438\u043B\u0438 \u043E\u043A\u0440\u0443\u0433\u043B\u0430\u044F,
    \u043D\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u043E\u0432\u0430\u043B\u044C\u043D\u0430\u044F,
    \u0441 \u0432\u043E\u0433\u043D\u0443\u0442\u043E\u0439 \u0434\u043E\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0439
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C\u044E \u0438
    \u0432\u044B\u043F\u0443\u043A\u043B\u043E\u0439 \u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439;\r\n\u0432
    \u043F\u0435\u0440\u0438\u043E\u0434 \u043E\u0442\u044A\u0451\u043C\u0430 \u2014
    \u0432 \u0432\u0438\u0434\u0435 \u0449\u0438\u0442\u0430, \u0442\u0440\u0451\u0445\u0433\u0440\u0430\u043D\u043D\u0438\u043A\u0430,
    \u043E\u0432\u0430\u043B\u0430;\r\n\u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435
    \u043F\u0435\u0440\u0438\u043E\u0434\u044B \u043F\u043E\u0441\u0442\u043D\u0430\u0442\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043E\u043D\u0442\u043E\u0433\u0435\u043D\u0435\u0437\u0430 \u2014 \u0440\u043E\u043C\u0431\u043E\u0432\u0438\u0434\u043D\u043E\u0439
    \u0444\u043E\u0440\u043C\u044B.\n\u0426\u0432\u0435\u0442 \u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u043E\u0439
    \u0436\u0435\u043B\u0435\u0437\u044B \u2014 \u043E\u0442 \u0432\u0438\u0448\u043D\u0451\u0432\u043E\u0433\u043E
    \u0434\u043E \u0442\u0451\u043C\u043D\u043E-\u0432\u0438\u0448\u043D\u0451\u0432\u043E\u0433\u043E,
    \u043A\u043E\u043D\u0441\u0438\u0441\u0442\u0435\u043D\u0446\u0438\u044F \u2014
    \u0443\u043F\u0440\u0443\u0433\u0430\u044F.\r\n\u041C\u0430\u0441\u0441\u0430
    \u0436\u0435\u043B\u0435\u0437\u044B \u0432\u0437\u0440\u043E\u0441\u043B\u044B\u0445
    \u0441\u0432\u0438\u043D\u0435\u0439 \u2014 15\u201324 \u0433.\r\n\u0424\u0438\u043A\u0441\u0438\u0440\u0443\u0435\u0442\u0441\u044F
    \u043D\u0430 \u0442\u0440\u0430\u0445\u0435\u0435 \u0437\u0430 \u0441\u0447\u0451\u0442
    \u0432\u043E\u0433\u043D\u0443\u0442\u043E\u0441\u0442\u0438 \u043D\u0430 \u0434\u043E\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0439
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u043E\u0440\u0433\u0430\u043D\u0430
    \u0438 \u0443\u043F\u043B\u043E\u0442\u043D\u0451\u043D\u043D\u044B\u0445 \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0442\u043A\u0430\u043D\u043D\u044B\u0445
    \u043F\u0443\u0447\u043A\u043E\u0432, \u043E\u0442\u0445\u043E\u0434\u044F\u0449\u0438\u0445
    \u043E\u0442 \u043D\u0430\u0440\u0443\u0436\u043D\u043E\u0439 \u043A\u0430\u043F\u0441\u0443\u043B\u044B
    (\u0444\u043E\u0440\u043C\u0438\u0440\u0443\u044E\u0442 \u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u044B\u0435
    \u0441\u0432\u044F\u0437\u043A\u0438).\n\u041F\u043E\u043A\u0440\u044B\u0442\u0430
    \u0434\u0432\u0443\u043C\u044F \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0442\u043A\u0430\u043D\u043D\u044B\u043C\u0438
    \u043A\u0430\u043F\u0441\u0443\u043B\u0430\u043C\u0438:\r\n\u0421\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F
    \u2014 \u043F\u043E\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C
    \u0436\u0435\u043B\u0435\u0437\u044B \u0438 \u043F\u043B\u043E\u0442\u043D\u043E
    \u0441\u0440\u0430\u0449\u0435\u043D\u0430 \u0441 \u0435\u0451 \u043F\u0430\u0440\u0435\u043D\u0445\u0438\u043C\u043E\u0439.
    \u041E\u0442 \u044D\u0442\u043E\u0439 \u043A\u0430\u043F\u0441\u0443\u043B\u044B
    \u0432\u043D\u0443\u0442\u0440\u044C \u043E\u0440\u0433\u0430\u043D\u0430 \u043E\u0442\u0445\u043E\u0434\u044F\u0442
    \u043C\u043D\u043E\u0433\u043E\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u044B\u0435
    \u0432\u044B\u0440\u043E\u0441\u0442\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442 \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0442\u043A\u0430\u043D\u043D\u044B\u0439
    \u043A\u0430\u0440\u043A\u0430\u0441.\n\u0414\u0440\u0443\u0433\u0430\u044F \u043A\u0430\u043F\u0441\u0443\u043B\u0430
    \u2014 \u043F\u0440\u0438\u043B\u0435\u0433\u0430\u0435\u0442 \u043A \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
    \u043A\u0430\u043F\u0441\u0443\u043B\u0435 \u0441\u043D\u0430\u0440\u0443\u0436\u0438.
    \u0423 4-\u043C\u0435\u0441\u044F\u0447\u043D\u044B\u0445 \u0441\u0432\u0438\u043D\u0435\u0439
    \u043C\u0435\u0436\u0434\u0443 \u043A\u0430\u043F\u0441\u0443\u043B\u0430\u043C\u0438
    \u0435\u0441\u0442\u044C \u043C\u0435\u0436\u043A\u0430\u043F\u0441\u0443\u043B\u044F\u0440\u043D\u043E\u0435
    \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E, \u0437\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u043E\u0435
    \u0440\u044B\u0445\u043B\u043E\u0439 \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u0442\u043A\u0430\u043D\u044C\u044E \u0438 \u0436\u0438\u0440\u043E\u0432\u043E\u0439
    \u043A\u043B\u0435\u0442\u0447\u0430\u0442\u043A\u043E\u0439.\r\n\u0421 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u043E\u043C
    \u043D\u0430\u0440\u0443\u0436\u043D\u0430\u044F \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C
    \u0436\u0435\u043B\u0435\u0437\u044B \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
    \u0431\u043E\u043B\u0435\u0435 \u0431\u0443\u0433\u0440\u0438\u0441\u0442\u043E\u0439
    \u0438\u0437-\u0437\u0430 \u043E\u0442\u043B\u043E\u0436\u0435\u043D\u0438\u044F
    \u0436\u0438\u0440\u043E\u0432\u043E\u0439 \u0442\u043A\u0430\u043D\u0438 \u0432
    \u043F\u043E\u0434\u043A\u0430\u043F\u0441\u0443\u043B\u044F\u0440\u043D\u043E\u0435
    \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E.\n\u0424\u0443\u043D\u043A\u0446\u0438\u0438:
    \u0432 \u0444\u043E\u043B\u043B\u0438\u043A\u0443\u043B\u0430\u0445 \u0449\u0438\u0442\u043E\u0432\u0438\u0434\u043D\u043E\u0439
    \u0436\u0435\u043B\u0435\u0437\u044B \u0432\u044B\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E\u0442\u0441\u044F
    \u0442\u0438\u0440\u043E\u043A\u0441\u0438\u043D \u0438 \u0442\u0440\u0438\u0439\u043E\u0434\u0442\u0438\u0440\u043E\u043D\u0438\u043D
    \u2014 \u0433\u043E\u0440\u043C\u043E\u043D\u044B, \u0441\u0442\u0438\u043C\u0443\u043B\u0438\u0440\u0443\u044E\u0449\u0438\u0435
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u044B \u043E\u043A\u0438\u0441\u043B\u0435\u043D\u0438\u044F
    \u0432 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u0435. \u041E\u043D\u0438
    \u0432\u043B\u0438\u044F\u044E\u0442 \u043D\u0430 \u0431\u0435\u043B\u043A\u043E\u0432\u044B\u0439,
    \u0443\u0433\u043B\u0435\u0432\u043E\u0434\u043D\u044B\u0439, \u0436\u0438\u0440\u043E\u0432\u043E\u0439
    \u0438 \u0432\u043E\u0434\u043D\u043E-\u0441\u043E\u043B\u0435\u0432\u043E\u0439
    \u043E\u0431\u043C\u0435\u043D, \u043D\u0430 \u0440\u043E\u0441\u0442 \u0438
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043D\u0446\u0438\u0440\u043E\u0432\u043A\u0443
    \u0442\u043A\u0430\u043D\u0435\u0439, \u0432 \u0442\u043E\u043C \u0447\u0438\u0441\u043B\u0435
    \u043C\u043E\u0437\u0433\u0430"
  clip: {fileID: 0}
