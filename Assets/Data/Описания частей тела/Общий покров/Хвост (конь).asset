  m_Script: {fileID: 11500000, guid: 3f00395bd4580c04eb5d722a11c9666a, type: 3}
  m_Name: "\u0425\u0432\u043E\u0441\u0442 (\u043A\u043E\u043D\u044C)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0425\u0432\u043E\u0441\u0442"
  scientificName: cauda equina
  nameClip: {fileID: 8300000, guid: a77ce546cdf791143aba2a3c3de38bb1, type: 3}
  description: "\u0425\u0432\u043E\u0441\u0442 \u043B\u043E\u0448\u0430\u0434\u0438
    \u2014 \u044D\u0442\u043E \u0447\u0430\u0441\u0442\u044C \u043F\u043E\u0437\u0432\u043E\u043D\u043E\u0447\u043D\u0438\u043A\u0430,
    \u043F\u043E\u043A\u0440\u044B\u0442\u0430\u044F \u0432\u043E\u043B\u043E\u0441\u0430\u043C\u0438.
    \u0412\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043A\u0430\u043A \u043F\u0443\u0447\u043E\u043A
    \u0434\u043B\u0438\u043D\u043D\u044B\u0445, \u043F\u0440\u043E\u0447\u043D\u044B\u0445
    \u0432\u043E\u043B\u043E\u0441, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432\u0441\u0451
    \u0432\u0440\u0435\u043C\u044F \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
    \u0432 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0438.\n\u0421\u0440\u0435\u0434\u043D\u0438\u0439
    \u0441\u043B\u043E\u0439 \u0432\u043E\u043B\u043E\u0441\u0430 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442,
    \u0431\u0443\u0434\u0443\u0442 \u0432\u043E\u043B\u043E\u0441\u043A\u0438 \u043F\u0440\u044F\u043C\u044B\u043C\u0438
    \u0438\u043B\u0438 \u0432\u044C\u044E\u0449\u0438\u043C\u0438\u0441\u044F. \u0412
    \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u0435 \u0441\u043B\u0443\u0447\u0430\u0435\u0432
    \u0432\u043E\u043B\u043E\u0441\u044B \u043F\u0440\u044F\u043C\u044B\u0435, \u043D\u043E
    \u0435\u0441\u0442\u044C \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u0438
    \u0441 \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u043E\u0439 \u0441\u0440\u0435\u0434\u043D\u0435\u0439
    \u043A\u043E\u0440\u043E\u0439 \u0432\u043E\u043B\u043E\u0441\u0430, \u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u043A\u0443\u0434\u0440\u044F\u0432\u044B\u0439 \u0431\u0430\u0448\u043A\u0438\u0440.\n\u0426\u0432\u0435\u0442
    \u0445\u0432\u043E\u0441\u0442\u0430 \u0441\u0432\u044F\u0437\u0430\u043D \u0441
    \u043E\u0431\u0449\u0438\u043C \u0446\u0432\u0435\u0442\u043E\u043C \u0448\u0435\u0440\u0441\u0442\u0438
    \u043B\u043E\u0448\u0430\u0434\u0438 \u0438, \u043A\u0430\u043A \u043F\u0440\u0430\u0432\u0438\u043B\u043E,
    \u043D\u0435 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043F\u043E\u0440\u043E\u0434\u043D\u044B\u043C
    \u043F\u0440\u0438\u0437\u043D\u0430\u043A\u043E\u043C. \u041E\u0434\u043D\u0430\u043A\u043E
    \u0443 \u043E\u043A\u0440\u0430\u0441\u043E\u0432 \u0448\u0435\u0440\u0441\u0442\u0438
    \u0441 \u0442\u043E\u0447\u0435\u0447\u043D\u043E\u0439 \u043E\u043A\u0440\u0430\u0441\u043A\u043E\u0439
    \u0445\u0432\u043E\u0441\u0442 \u2014 \u043E\u0434\u043D\u0430 \u0438\u0437 \u0430\u043D\u0430\u0442\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0447\u0430\u0441\u0442\u0435\u0439, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0438\u0440\u0443\u0435\u0442
    \u043A\u043E\u043D\u0442\u0440\u0430\u0441\u0442\u043D\u044B\u0439 \u0446\u0432\u0435\u0442.\n\u0424\u0443\u043D\u043A\u0446\u0438\u0438:\n-
    \u0417\u0430\u0449\u0438\u0442\u0430 \u043E\u0442 \u043A\u0443\u0441\u0430\u0447\u0438\u0445
    \u043D\u0430\u0441\u0435\u043A\u043E\u043C\u044B\u0445 - \u0432 \u0436\u0430\u0440\u043A\u0438\u0435
    \u0434\u043D\u0438 \u043B\u043E\u0448\u0430\u0434\u0438 \u0430\u043A\u0442\u0438\u0432\u043D\u043E
    \u0440\u0430\u0437\u043C\u0430\u0445\u0438\u0432\u0430\u044E\u0442 \u0445\u0432\u043E\u0441\u0442\u043E\u043C
    \u043A\u0430\u043A \u043C\u0443\u0445\u043E\u0431\u043E\u0439\u043A\u043E\u0439,
    \u043C\u0435\u0448\u0430\u044F \u043D\u0430\u0441\u0435\u043A\u043E\u043C\u044B\u043C
    \u043E\u0442\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0442\u044C \u044F\u0439\u0446\u0430
    \u0432 \u0438\u0445 \u043A\u043E\u0436\u0443.\n- \u0423\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435
    \u0440\u0430\u0432\u043D\u043E\u0432\u0435\u0441\u0438\u044F \u2014 \u0445\u0432\u043E\u0441\u0442
    \u043D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u043E \u0432\u043B\u0438\u044F\u0435\u0442
    \u043D\u0430 \u0431\u0430\u043B\u0430\u043D\u0441 \u0437\u0430\u0434\u043D\u0438\u0445
    \u043D\u043E\u0433 \u043B\u043E\u0448\u0430\u0434\u0438.\n- \u041E\u0431\u0449\u0435\u043D\u0438\u0435
    \u2014 \u0445\u0432\u043E\u0441\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
    \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u0434\u0430\u0447\u0438 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438
    \u043E\u0431 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u043C \u0438
    \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u043C
    \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438 \u043B\u043E\u0448\u0430\u0434\u0438,
    \u043A\u0430\u043A \u0432 \u0441\u0442\u0430\u0434\u0435, \u0442\u0430\u043A
    \u0438 \u043C\u0435\u0436\u0434\u0443 \u043B\u043E\u0448\u0430\u0434\u044C\u044E
    \u0438 \u0432\u0441\u0430\u0434\u043D\u0438\u043A\u043E\u043C. \u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
    \u0432\u044B\u0441\u043E\u043A\u043E \u043F\u043E\u0434\u043D\u044F\u0442\u044B\u0439
    \u0445\u0432\u043E\u0441\u0442 \u2014 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
    \u0432\u043E\u0437\u0431\u0443\u0436\u0434\u0435\u043D\u0438\u044F, \u0445\u043E\u0440\u043E\u0448\u0435\u0433\u043E
    \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F \u0438 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0430;
    \u0445\u0432\u043E\u0441\u0442, \u043F\u043B\u043E\u0442\u043D\u043E \u043F\u0440\u0438\u0436\u0430\u0442\u044B\u0439
    \u043A \u044F\u0433\u043E\u0434\u0438\u0446\u0430\u043C, \u0447\u0430\u0441\u0442\u043E
    \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043D\u0430 \u0434\u0438\u0441\u043A\u043E\u043C\u0444\u043E\u0440\u0442"
  clip: {fileID: 8300000, guid: 7e198de7ec7a7a644ae889e2a71fba20, type: 3}
