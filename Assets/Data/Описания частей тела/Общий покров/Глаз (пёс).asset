    \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \u0443\u043B\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C
