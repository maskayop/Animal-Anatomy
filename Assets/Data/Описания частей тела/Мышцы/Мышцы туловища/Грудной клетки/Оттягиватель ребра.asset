    \u043C\u0435\u0436\u0434\u0443 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C
    \u0440\u0435\u0431\u0440\u043E\u043C \u0438 \u043F\u043E\u043F\u0435\u0440\u0435\u0447\u043D\u044B\u043C
    \u043E\u0442\u0440\u043E\u0441\u0442\u043A\u043E\u043C \u043F\u0435\u0440\u0432\u043E\u0433\u043E
    \u043F\u043E\u044F\u0441\u043D\u0438\u0447\u043D\u043E\u0433\u043E \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u0430.
    \u041B\u0430\u0442\u0435\u0440\u0430\u043B\u044C\u043D\u043E \u043E\u043D\u0430
    \u043F\u0440\u0438\u043A\u0440\u044B\u0442\u0430 \u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u043E\u0439
