  description: "\u041D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F, \u043F\u043B\u043E\u0441\u043A\u0430\u044F
    \u043C\u044B\u0448\u0446\u0430, \u043D\u0430\u0445\u043E\u0434\u044F\u0449\u0430\u044F\u0441\u044F
