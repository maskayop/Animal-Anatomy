  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0411\u043E\u043B\u044C\u0448\u0430\u044F \u043F\u043E\u044F\u0441\u043D\u0438\u0447\u043D\u0430\u044F
    \u043C\u044B\u0448\u0446\u0430"
  scientificName: musculus psoas major
  nameClip: {fileID: 8300000, guid: 0693e8e35ff2e154d922b5e6af0d324a, type: 3}
  description: "\u0411\u0435\u0440\u0451\u0442 \u043D\u0430\u0447\u0430\u043B\u043E
    \u043D\u0430 \u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u043E\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
    \u0434\u0432\u0443\u0445 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0445
    \u0440\u0451\u0431\u0435\u0440, \u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u043F\u043E\u043F\u0435\u0440\u0435\u0447\u043D\u044B\u0445
    \u043E\u0442\u0440\u043E\u0441\u0442\u043A\u043E\u0432 \u0438 \u0442\u0435\u043B
    \u043F\u043E\u044F\u0441\u043D\u0438\u0447\u043D\u044B\u0445 \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u043E\u0432,
    \u0430 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043A\u0440\u0435\u043F\u043A\u0438\u043C \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u0438\u0435\u043C
    \u043D\u0430 \u043C\u0430\u043B\u043E\u043C \u0432\u0435\u0440\u0442\u0435\u043B\u0435
    \u0431\u0435\u0434\u0440\u0435\u043D\u043D\u043E\u0439 \u043A\u043E\u0441\u0442\u0438
    \u043C\u0435\u0436\u0434\u0443 \u043B\u0430\u0442\u0435\u0440\u0430\u043B\u044C\u043D\u043E\u0439
    \u0438 \u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u043E\u0439 \u043D\u043E\u0436\u043A\u0430\u043C\u0438
    \u043F\u043E\u0434\u0432\u0437\u0434\u043E\u0448\u043D\u043E\u0439 \u043C\u044B\u0448\u0446\u044B.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F
    \u2013 \u0441\u0433\u0438\u0431\u0430\u0435\u0442 \u043F\u043E\u044F\u0441\u043D\u0438\u0446\u0443
    \u0438 \u0442\u0430\u0437\u043E\u0431\u0435\u0434\u0440\u0435\u043D\u043D\u044B\u0439
    \u0441\u0443\u0441\u0442\u0430\u0432, \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0442
    \u0432 \u0432\u044B\u043D\u043E\u0441\u0435 \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u0438
    \u0432\u043F\u0435\u0440\u0451\u0434"
  clip: {fileID: 8300000, guid: 513796a9f19cfd642ba73f0527a738d6, type: 3}
