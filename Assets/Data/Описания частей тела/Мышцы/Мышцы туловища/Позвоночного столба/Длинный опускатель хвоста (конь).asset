  m_Script: {fileID: 11500000, guid: 3f00395bd4580c04eb5d722a11c9666a, type: 3}
  m_Name: "\u0414\u043B\u0438\u043D\u043D\u044B\u0439 \u043E\u043F\u0443\u0441\u043A\u0430\u0442\u0435\u043B\u044C
    \u0445\u0432\u043E\u0441\u0442\u0430 (\u043A\u043E\u043D\u044C)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0414\u043B\u0438\u043D\u043D\u044B\u0439 \u043E\u043F\u0443\u0441\u043A\u0430\u0442\u0435\u043B\u044C
    \u0445\u0432\u043E\u0441\u0442\u0430"
  scientificName: "musculus\_sacrococcygeus ventralis lateralis"
  description: "\u041A\u0440\u0435\u0441\u0442\u0446\u043E\u0432\u043E-\u0445\u0432\u043E\u0441\u0442\u043E\u0432\u0430\u044F
    \u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u0430\u044F \u043B\u0430\u0442\u0435\u0440\u0430\u043B\u044C\u043D\u0430\u044F
    \u043C\u044B\u0448\u0446\u0430 (musculus sacrocaudalis ventralis lateralis).
    \u041E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u043A \u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u043C\u0443
    \u043C\u044B\u0448\u0435\u0447\u043D\u043E\u043C\u0443 \u0442\u044F\u0436\u0443.\n\u041D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u043F\u043E\u043F\u0435\u0440\u0435\u0447\u043D\u044B\u0445
    \u043E\u0442\u0440\u043E\u0441\u0442\u043A\u043E\u0432 \u043A\u0440\u0435\u0441\u0442\u0446\u043E\u0432\u044B\u0445
    \u0438 \u043F\u0435\u0440\u0432\u044B\u0445 4\u20135 \u0445\u0432\u043E\u0441\u0442\u043E\u0432\u044B\u0445
    \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u043E\u0432. \u041E\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
    \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u044F 4\u20135 \u0441\u0435\u0433\u043C\u0435\u043D\u0442\u043E\u0432,
    \u043D\u0430 \u043F\u043E\u043F\u0435\u0440\u0435\u0447\u043D\u044B\u0445 \u043E\u0442\u0440\u043E\u0441\u0442\u043A\u0430\u0445
    \u0445\u0432\u043E\u0441\u0442\u043E\u0432\u044B\u0445 \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u043E\u0432.
    \u041F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u043F\u043E \u043B\u0430\u0442\u0435\u0440\u043E\u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u043C\u0443
    \u043A\u0440\u0430\u044E \u0445\u0432\u043E\u0441\u0442\u0430.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F
    \u2014 \u043F\u0440\u0438 \u0441\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u0438\u0438
    \u043C\u044B\u0448\u0446\u0430 \u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442
    \u0445\u0432\u043E\u0441\u0442, \u043F\u0440\u0438 \u044D\u0442\u043E\u043C,
    \u0441\u043E\u043A\u0440\u0430\u0449\u0430\u044F\u0441\u044C \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
    \u043D\u0430 \u043F\u0440\u0430\u0432\u043E\u0439 \u0438\u043B\u0438 \u043B\u0435\u0432\u043E\u0439
    \u0441\u0442\u043E\u0440\u043E\u043D\u0435, \u043E\u0442\u0432\u043E\u0434\u0438\u0442
    \u0445\u0432\u043E\u0441\u0442 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
    \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0445 \u0432 \u044D\u0442\u043E\u0442
    \u043C\u043E\u043C\u0435\u043D\u0442 \u043C\u044B\u0448\u0446, \u0430 \u0441\u043E\u043A\u0440\u0430\u0449\u0430\u044F\u0441\u044C
    \u043F\u043E\u043E\u0447\u0435\u0440\u0451\u0434\u043D\u043E, \u0432\u0440\u0430\u0449\u0430\u0435\u0442
    \u0445\u0432\u043E\u0441\u0442"
  clip: {fileID: 8300000, guid: b2abbd87bc72df94d8df4a9561414cff, type: 3}
