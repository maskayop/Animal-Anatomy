  m_Name: "\u041A\u043B\u044B\u043A\u043E\u0432\u0430\u044F \u043C\u044B\u0448\u0446\u0430
    (\u043F\u0451\u0441)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u041A\u043B\u044B\u043A\u043E\u0432\u0430\u044F \u043C\u044B\u0448\u0446\u0430"
  scientificName: musculus caninus
  nameClip: {fileID: 8300000, guid: 7d813c39123b63e4baa7b5a5ba50858d, type: 3}
  description: "\u041D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u043D\u0430
    \u0431\u043E\u043A\u043E\u0432\u043E\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
    \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u0447\u0435\u043B\u044E\u0441\u0442\u0438
    \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438 \u043F\u043E\u0434\u0433\u043B\u0430\u0437\u043D\u0438\u0447\u043D\u043E\u0433\u043E
    \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u044F.\n\u041C\u044B\u0448\u0446\u0430
    \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E
    \u043E\u0442 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044F
    \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u0433\u0443\u0431\u044B \u0438 \u043F\u0440\u0438\u043A\u0440\u044B\u0442\u0430
    \u043D\u043E\u0441\u043E\u0433\u0443\u0431\u043D\u044B\u043C \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u0435\u043C.
    \u0417\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u0432 \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u0433\u0443\u0431\u0435.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F
    \u2013 \u043E\u0442\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442 \u0443\u0433\u043E\u043B
    \u0440\u0442\u0430 \u043D\u0430\u0437\u0430\u0434 \u0438 \u0432\u0432\u0435\u0440\u0445,
    \u043E\u0431\u043D\u0430\u0436\u0430\u044F \u043A\u043B\u044B\u043A"
  clip: {fileID: 0}
