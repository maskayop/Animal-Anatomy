    \u0433\u043B\u0430\u0437\u0430 \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438
    \u0432\u0435\u0440\u0445\u043D\u0435\u0433\u043E \u0432\u0435\u043A\u0430.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F
    \u2013 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0432\u0435\u0440\u0445\u043D\u0435\u0435
