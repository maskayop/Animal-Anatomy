  m_Name: "\u0421\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C
    \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u0433\u0443\u0431\u044B (\u043A\u043E\u043D\u044C)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0421\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439
    \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C \u0432\u0435\u0440\u0445\u043D\u0435\u0439
    \u0433\u0443\u0431\u044B"
  scientificName: musculus proprius levator labii superior
  description: "\u041D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u043E\u0442
    \u043E\u0431\u043B\u0430\u0441\u0442\u0438 \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F
    \u0441\u043B\u0451\u0437\u043D\u043E\u0439, \u0441\u043A\u0443\u043B\u043E\u0432\u043E\u0439
    \u0438 \u0432\u0435\u0440\u0445\u043D\u0435\u0447\u0435\u043B\u044E\u0441\u0442\u043D\u043E\u0439
    \u043A\u043E\u0441\u0442\u0435\u0439 \u0443 \u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0443\u0433\u043B\u0430 \u0433\u043B\u0430\u0437\u0430. \u041F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
    \u0432 \u043E\u043A\u0440\u0443\u0433\u043B\u043E\u0435 \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u0438\u0435,
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043A
    \u0432\u0435\u0440\u0445\u0443\u0448\u043A\u0435 \u043D\u043E\u0441\u0430, \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
    \u043C\u0435\u0436\u0434\u0443 \u043D\u043E\u0437\u0434\u0440\u044F\u043C\u0438.
    \u0423\u043F\u043B\u043E\u0449\u0430\u0435\u0442\u0441\u044F \u0438, \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u044F\u0441\u044C
    \u0441 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u043E\u043B\u043E\u0436\u043D\u043E\u0439
    \u043E\u0434\u043D\u043E\u0438\u043C\u0451\u043D\u043D\u043E\u0439 \u043C\u044B\u0448\u0446\u0435\u0439,
    \u0432\u043F\u043B\u0435\u0442\u0430\u0435\u0442\u0441\u044F \u0432 \u043A\u0440\u0443\u0433\u043E\u0432\u0443\u044E
    \u043C\u044B\u0448\u0446\u0443 \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u0433\u0443\u0431\u044B.\r\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F
    - \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0432\u0435\u0440\u0445\u043D\u044E\u044E
    \u0433\u0443\u0431\u0443 \u0432 \u0441\u0430\u0433\u0438\u0442\u0442\u0430\u043B\u044C\u043D\u043E\u0439
    \u043F\u043B\u043E\u0441\u043A\u043E\u0441\u0442\u0438"
