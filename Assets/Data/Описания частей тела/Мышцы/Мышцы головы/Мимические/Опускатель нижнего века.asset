  russianName: "\u041E\u043F\u0443\u0441\u043A\u0430\u0442\u0435\u043B\u044C \u043D\u0438\u0436\u043D\u0435\u0433\u043E
    \u0432\u0435\u043A\u0430"
  scientificName: musculus depressor palpebrae inferioris
  nameClip: {fileID: 8300000, guid: 9c840c6f09caf3f42b4b3aa6dd44a10e, type: 3}
  description: "\u042F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0447\u0430\u0441\u0442\u044C\u044E
    \u0449\u0451\u0447\u043D\u043E\u0439 \u043C\u044B\u0448\u0446\u044B (musculus
    malaris). \u041E\u043D\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
    \u043E\u0442 \u043D\u0438\u0436\u043D\u0435\u0433\u043E \u0432\u0435\u043A\u0430
    \u0438 \u0442\u043E\u043D\u043A\u0438\u043C \u043C\u044B\u0448\u0435\u0447\u043D\u044B\u043C
    \u043F\u043B\u0430\u0441\u0442\u043E\u043C \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0440\u043E\u0441\u0442\u0440\u043E\u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E,
    \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u044F\u0441\u044C \u043D\u0430
    \u0443\u0440\u043E\u0432\u043D\u0435 \u043B\u0438\u0446\u0435\u0432\u043E\u0433\u043E
    \u0433\u0440\u0435\u0431\u043D\u044F \u0432 \u0449\u0451\u0447\u043D\u043E\u0439
    \u0444\u0430\u0441\u0446\u0438\u0438.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F
    \u2013 \u043E\u0442\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442 \u043D\u0438\u0436\u043D\u0435\u0435
    \u0432\u0435\u043A\u043E"
  clip: {fileID: 8300000, guid: b1545b38fe10f6445a22e9f7b564fea4, type: 3}
