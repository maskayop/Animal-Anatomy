  m_Name: "\u041F\u043E\u0440\u0442\u043D\u044F\u0436\u043D\u0430\u044F \u043C\u044B\u0448\u0446\u0430"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u041F\u043E\u0440\u0442\u043D\u044F\u0436\u043D\u0430\u044F \u043C\u044B\u0448\u0446\u0430"
  scientificName: musculus sartorius
  description: "\u0414\u043B\u0438\u043D\u043D\u0430\u044F, \u043B\u0435\u043D\u0442\u043E\u0432\u0438\u0434\u043D\u043E\u0439
    \u0444\u043E\u0440\u043C\u044B, \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u043E\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
    \u0431\u0435\u0434\u0440\u0430. \u041D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
    \u043E\u0442 \u043F\u043E\u0434\u0432\u0437\u0434\u043E\u0448\u043D\u043E\u0439
    \u0444\u0430\u0441\u0446\u0438\u0438 \u0438 \u0434\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u0438\u044F \u043C\u0430\u043B\u043E\u0439
    \u043F\u043E\u044F\u0441\u043D\u0438\u0447\u043D\u043E\u0439 \u043C\u044B\u0448\u0446\u044B,
    \u0430 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u043A\u043E\u043B\u0435\u043D\u043D\u043E\u0439 \u0447\u0430\u0448\u043A\u0435
    \u0438 \u0447\u0435\u0440\u0435\u0437 \u0444\u0430\u0441\u0446\u0438\u044E \u0433\u043E\u043B\u0435\u043D\u0438
    \u2013 \u043D\u0430 \u0433\u0440\u0435\u0431\u043D\u0435 \u0431\u043E\u043B\u044C\u0448\u0435\u0431\u0435\u0440\u0446\u043E\u0432\u043E\u0439
    \u043A\u043E\u0441\u0442\u0438 \u0438 \u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u043E\u0439
    \u0441\u0432\u044F\u0437\u043A\u0435 \u043A\u043E\u043B\u0435\u043D\u043D\u043E\u0433\u043E
    \u0441\u0443\u0441\u0442\u0430\u0432\u0430.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F
    \u2013 \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0442 \u0432 \u0441\u0433\u0438\u0431\u0430\u043D\u0438\u0438
    \u0442\u0430\u0437\u043E\u0431\u0435\u0434\u0440\u0435\u043D\u043D\u043E\u0433\u043E
    \u0438 \u0440\u0430\u0437\u0433\u0438\u0431\u0430\u043D\u0438\u0438 \u043A\u043E\u043B\u0435\u043D\u043D\u043E\u0433\u043E
    \u0441\u0443\u0441\u0442\u0430\u0432\u043E\u0432"
