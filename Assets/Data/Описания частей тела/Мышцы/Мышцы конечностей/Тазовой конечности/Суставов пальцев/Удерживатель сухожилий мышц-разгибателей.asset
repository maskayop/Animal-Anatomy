  m_Name: "\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u0435\u043B\u044C
    \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u0438\u0439 \u043C\u044B\u0448\u0446-\u0440\u0430\u0437\u0433\u0438\u0431\u0430\u0442\u0435\u043B\u0435\u0439"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u0435\u043B\u044C
    \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u0438\u0439 \u043C\u044B\u0448\u0446-\u0440\u0430\u0437\u0433\u0438\u0431\u0430\u0442\u0435\u043B\u0435\u0439"
  scientificName: retinaculum musculorum extensorum manus
  nameClip: {fileID: 8300000, guid: 49ca7d01d1ef42149a7732d74fe20ffb, type: 3}
  description: "\u041F\u0440\u043E\u0447\u043D\u0430\u044F \u0432\u043E\u043B\u043E\u043A\u043D\u0438\u0441\u0442\u0430\u044F
    \u043B\u0435\u043D\u0442\u0430, \u043F\u0440\u043E\u0445\u043E\u0434\u044F\u0449\u0430\u044F
    \u043A\u043E\u0441\u043E \u0432\u043D\u0438\u0437 \u0438 \u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u043E
    \u043F\u043E\u043F\u0435\u0440\u0451\u043A \u0442\u044B\u043B\u044C\u043D\u043E\u0439
    \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u044F.
    \u0421\u043E\u0441\u0442\u043E\u0438\u0442 \u0438\u0437 \u0447\u0430\u0441\u0442\u0438
    \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0439 \u0444\u0430\u0441\u0446\u0438\u0438
    \u0437\u0430\u0434\u043D\u0435\u0439 \u0447\u0430\u0441\u0442\u0438 \u043F\u0440\u0435\u0434\u043F\u043B\u0435\u0447\u044C\u044F,
    \u0443\u0441\u0438\u043B\u0435\u043D\u043D\u043E\u0439 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C
    \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043F\u043E\u043F\u0435\u0440\u0435\u0447\u043D\u044B\u0445
    \u0432\u043E\u043B\u043E\u043A\u043E\u043D.\n\u0420\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D
    \u043D\u0430 \u0442\u044B\u043B\u044C\u043D\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u0435
    \u043F\u0440\u0435\u0434\u043F\u043B\u0435\u0447\u044C\u044F, \u0447\u0443\u0442\u044C
    \u043F\u0440\u043E\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0435\u0435
    \u043A\u0438\u0441\u0442\u0438. \u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0441\u044F
    \u043B\u0430\u0434\u043E\u043D\u043D\u043E\u0439 \u0437\u0430\u043F\u044F\u0441\u0442\u043D\u043E\u0439
    \u0441\u0432\u044F\u0437\u043A\u043E\u0439, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043D\u0430 \u043F\u0435\u0440\u0435\u0434\u043D\u0435\u0439
    \u0441\u0442\u043E\u0440\u043E\u043D\u0435 \u043F\u0440\u0435\u0434\u043F\u043B\u0435\u0447\u044C\u044F.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F
    - \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u0438\u044F
    \u043C\u044B\u0448\u0446-\u0440\u0430\u0437\u0433\u0438\u0431\u0430\u0442\u0435\u043B\u0435\u0439
    \u043D\u0430 \u043C\u0435\u0441\u0442\u0435"
