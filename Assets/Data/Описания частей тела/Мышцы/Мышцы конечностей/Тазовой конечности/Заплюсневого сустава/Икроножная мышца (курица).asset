  m_Name: "\u0418\u043A\u0440\u043E\u043D\u043E\u0436\u043D\u0430\u044F \u043C\u044B\u0448\u0446\u0430
    (\u043A\u0443\u0440\u0438\u0446\u0430)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0418\u043A\u0440\u043E\u043D\u043E\u0436\u043D\u0430\u044F \u043C\u044B\u0448\u0446\u0430"
  scientificName: musculus gastrocnemius
  nameClip: {fileID: 8300000, guid: bb79557ef1318e44d8b3ac163e8321b9, type: 3}
  description: "\u0418\u043A\u0440\u043E\u043D\u043E\u0436\u043D\u0430\u044F \u043C\u044B\u0448\u0446\u0430
    \u0438\u043C\u0435\u0435\u0442 \u0442\u0440\u0438 \u0447\u0430\u0441\u0442\u0438:
    \u043B\u0430\u0442\u0435\u0440\u0430\u043B\u044C\u043D\u0443\u044E, \u043F\u0440\u043E\u043C\u0435\u0436\u0443\u0442\u043E\u0447\u043D\u0443\u044E
    \u0438 \u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u0443\u044E. \u041B\u0430\u0442\u0435\u0440\u0430\u043B\u044C\u043D\u0430\u044F
    \u0438 \u043F\u0440\u043E\u043C\u0435\u0436\u0443\u0442\u043E\u0447\u043D\u0430\u044F
    \u0447\u0430\u0441\u0442\u0438 \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442\u0441\u044F
    \u0432 \u0434\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0439 \u043E\u0431\u043B\u0430\u0441\u0442\u0438
    \u0431\u0435\u0434\u0440\u0435\u043D\u043D\u043E\u0439 \u043A\u043E\u0441\u0442\u0438,
    \u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u0430\u044F - \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438
    \u043A\u043E\u043B\u0435\u043D\u043D\u043E\u0439 \u0447\u0430\u0448\u043A\u0438
    \u0438 \u0435\u0451 \u0441\u0432\u044F\u0437\u043E\u0447\u043D\u043E\u0433\u043E
    \u0430\u043F\u043F\u0430\u0440\u0430\u0442\u0430. \u041E\u0431\u0449\u0435\u0435
    \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u0438\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
    \u043F\u043E\u0437\u0430\u0434\u0438 \u043C\u0435\u0436\u043F\u0440\u0435\u0434\u043F\u043B\u044E\u0441\u043D\u0435\u0432\u043E\u0433\u043E
    \u0441\u0443\u0441\u0442\u0430\u0432\u0430 \u0447\u0435\u0440\u0435\u0437 \u0431\u043E\u043B\u044C\u0448\u0435\u0431\u0435\u0440\u0446\u043E\u0432\u044B\u0439
    \u0445\u0440\u044F\u0449 \u0438 \u043F\u0440\u0438\u043A\u0440\u0435\u043F\u043B\u044F\u0435\u0442\u0441\u044F
    \u043A \u043F\u043E\u0434\u043E\u0448\u0432\u0435\u043D\u043D\u043E\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
    \u0446\u0435\u0432\u043A\u0438 \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438
    \u0433\u0438\u043F\u043E\u0442\u0430\u0440\u0437\u0443\u0441\u0430.\r\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F
    - \u0440\u0430\u0437\u0433\u0438\u0431\u0430\u0435\u0442 \u043C\u0435\u0436\u043F\u0440\u0435\u0434\u043F\u043B\u044E\u0441\u043D\u0435\u0432\u043E\u0439
    \u0441\u0443\u0441\u0442\u0430\u0432; \u0447\u0430\u0441\u0442\u0438, \u043F\u0435\u0440\u0435\u0441\u0435\u043A\u0430\u044E\u0449\u0438\u0435
    \u043A\u043E\u043B\u0435\u043D\u043D\u044B\u0439 \u0441\u0443\u0441\u0442\u0430\u0432,
    \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u044E\u0442 \u0432 \u0435\u0433\u043E
    \u0441\u0433\u0438\u0431\u0430\u043D\u0438\u0438"
  clip: {fileID: 0}
