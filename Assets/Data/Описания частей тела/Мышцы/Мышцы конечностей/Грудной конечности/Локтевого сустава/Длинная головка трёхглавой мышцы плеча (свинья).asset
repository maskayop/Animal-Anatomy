  m_Script: {fileID: 11500000, guid: 3f00395bd4580c04eb5d722a11c9666a, type: 3}
  m_Name: "\u0414\u043B\u0438\u043D\u043D\u0430\u044F \u0433\u043E\u043B\u043E\u0432\u043A\u0430
    \u0442\u0440\u0451\u0445\u0433\u043B\u0430\u0432\u043E\u0439 \u043C\u044B\u0448\u0446\u044B
    \u043F\u043B\u0435\u0447\u0430 (\u0441\u0432\u0438\u043D\u044C\u044F)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0414\u043B\u0438\u043D\u043D\u0430\u044F \u0433\u043E\u043B\u043E\u0432\u043A\u0430
    \u0442\u0440\u0451\u0445\u0433\u043B\u0430\u0432\u043E\u0439 \u043C\u044B\u0448\u0446\u044B
    \u043F\u043B\u0435\u0447\u0430"
  scientificName: musculus triceps brachii caput longum
  nameClip: {fileID: 8300000, guid: ceb50f57d87a7c7468ebf66088962c65, type: 3}
  description: "\u0422\u0440\u0451\u0445\u0433\u043B\u0430\u0432\u0430\u044F \u043C\u044B\u0448\u0446\u0430
    \u043F\u043B\u0435\u0447\u0430 (\u0442\u0440\u0438\u0446\u0435\u043F\u0441) -
    musculus triceps brachii - \u043C\u043E\u0449\u043D\u0430\u044F, \u0434\u0438\u043D\u0430\u043C\u043E\u0441\u0442\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F \u043C\u044B\u0448\u0446\u0430.
    \u041E\u043D\u0430 \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u0435\u0442 \u0432\u0441\u0451
    \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u043E\u0435 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E,
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u043D\u043E\u0435 \u043B\u043E\u043F\u0430\u0442\u043A\u043E\u0439,
    \u043F\u043B\u0435\u0447\u0435\u0432\u043E\u0439 \u043A\u043E\u0441\u0442\u044C\u044E
    \u0438 \u043B\u043E\u043A\u0442\u0435\u0432\u044B\u043C \u0431\u0443\u0433\u0440\u043E\u043C.
    \u0412 \u043D\u0435\u0439 \u0440\u0430\u0437\u043B\u0438\u0447\u0430\u044E\u0442
    \u0447\u0435\u0442\u044B\u0440\u0435 \u0433\u043E\u043B\u043E\u0432\u043A\u0438:
    \u0434\u043B\u0438\u043D\u043D\u0430\u044F, \u043B\u0430\u0442\u0435\u0440\u0430\u043B\u044C\u043D\u0430\u044F,
    \u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u0430\u044F \u0438 \u0434\u043E\u0431\u0430\u0432\u043E\u0447\u043D\u0430\u044F.
    \u0414\u043E\u0431\u0430\u0432\u043E\u0447\u043D\u0430\u044F \u0433\u043E\u043B\u043E\u0432\u043A\u0430
    \u0438\u043C\u0435\u0435\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E
    \u0443 \u0445\u0438\u0449\u043D\u044B\u0445 \u0438 \u0441\u0432\u0438\u043D\u044C\u0438.\n\u0414\u043B\u0438\u043D\u043D\u0430\u044F
    \u0433\u043E\u043B\u043E\u0432\u043A\u0430 \u043F\u0435\u0440\u0438\u0441\u0442\u0430\u044F
    \u0438 \u0441\u0430\u043C\u0430\u044F \u043C\u0430\u0441\u0441\u0438\u0432\u043D\u0430\u044F.
    \u0420\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442\u0441\u044F
    \u0432 \u0433\u043B\u0443\u0431\u0438\u043D\u0435 \u043C\u0435\u0436\u0434\u0443
    \u0433\u043E\u043B\u043E\u0432\u043A\u0430\u043C\u0438 \u0442\u0440\u0451\u0445\u0433\u043B\u0430\u0432\u043E\u0439
    \u043C\u044B\u0448\u0446\u044B; \u0431\u0435\u0440\u0451\u0442 \u043D\u0430\u0447\u0430\u043B\u043E
    \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u043C, \u0443\u0442\u043E\u043B\u0449\u0451\u043D\u043D\u043E\u0439
    \u0444\u043E\u0440\u043C\u044B, \u043C\u044B\u0448\u0435\u0447\u043D\u044B\u043C
    \u0431\u0440\u044E\u0448\u043A\u043E\u043C \u043D\u0430 \u0448\u0435\u0439\u043A\u0435
    \u043F\u043B\u0435\u0447\u0435\u0432\u043E\u0439 \u043A\u043E\u0441\u0442\u0438,
    \u0430 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u043E\u0439
    \u0433\u043E\u043B\u043E\u0432\u043A\u043E\u0439 \u043D\u0430 \u043B\u043E\u043A\u0442\u0435\u0432\u043E\u043C
    \u0431\u0443\u0433\u0440\u0435.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F \u2013
    \u0440\u0430\u0437\u0433\u0438\u0431\u0430\u0435\u0442 \u043B\u043E\u043A\u0442\u0435\u0432\u043E\u0439
    \u0438 \u0441\u0433\u0438\u0431\u0430\u0435\u0442 \u043F\u043B\u0435\u0447\u0435\u0432\u043E\u0439
    \u0441\u0443\u0441\u0442\u0430\u0432\u044B"
  clip: {fileID: 8300000, guid: 4779dbb1399cc754fa73c272faa309ed, type: 3}
