  m_Script: {fileID: 11500000, guid: 3f00395bd4580c04eb5d722a11c9666a, type: 3}
  m_Name: "\u0414\u0435\u043B\u044C\u0442\u043E\u0432\u0438\u0434\u043D\u0430\u044F
    \u043C\u044B\u0448\u0446\u0430 (\u043A\u043E\u0440\u043E\u0432\u0430)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0414\u0435\u043B\u044C\u0442\u043E\u0432\u0438\u0434\u043D\u0430\u044F
    \u043C\u044B\u0448\u0446\u0430"
  scientificName: musculus deltoideus
  nameClip: {fileID: 8300000, guid: 0cf6f0b8d1fc5bb46bf10f5e38af77ea, type: 3}
  description: "\u0421\u043B\u043E\u0436\u043D\u0430\u044F, \u043F\u0435\u0440\u0438\u0441\u0442\u0430\u044F,
    \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u043B\u0430\u0442\u0435\u0440\u0430\u043B\u044C\u043D\u043E\u0439
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u043B\u043E\u043F\u0430\u0442\u043A\u0438
    \u0438 \u043F\u043B\u0435\u0447\u0435\u0432\u043E\u0433\u043E \u0441\u0443\u0441\u0442\u0430\u0432\u0430,
    \u0434\u0435\u043B\u0438\u0442\u0441\u044F \u043D\u0430 \u043B\u043E\u043F\u0430\u0442\u043E\u0447\u043D\u0443\u044E,
    \u0430\u043A\u0440\u043E\u043C\u0438\u0430\u043B\u044C\u043D\u0443\u044E \u0447\u0430\u0441\u0442\u0438.\n\u041B\u043E\u043F\u0430\u0442\u043E\u0447\u043D\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C \u2013 pars scapularis \u2013 \u0431\u0435\u0440\u0451\u0442
    \u043D\u0430\u0447\u0430\u043B\u043E \u0448\u0438\u0440\u043E\u043A\u0438\u043C
    \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u0438\u0435\u043C \u043E\u0442 \u043E\u0441\u0442\u0438
    \u043B\u043E\u043F\u0430\u0442\u043A\u0438 \u0438 \u0431\u043E\u043B\u044C\u0448\u0435\u0439
    \u0447\u0430\u0441\u0442\u0438 \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u0442\u0440\u0435\u0442\u0438
    \u0437\u0430\u043E\u0441\u0442\u043D\u043E\u0439 \u043C\u044B\u0448\u0446\u044B.\n\u0410\u043A\u0440\u043E\u043C\u0438\u0430\u043B\u044C\u043D\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C \u2013 pars acromialis \u2013 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
    \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u043C \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u0438\u0435\u043C
    \u043E\u0442 \u0430\u043A\u0440\u043E\u043C\u0438\u043E\u043D\u0430.\n\u041A\u043B\u044E\u0447\u0438\u0447\u043D\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C \u2013 pars clavicularis \u2013 \u0432 \u0441\u0432\u044F\u0437\u0438
    \u0441 \u0440\u0435\u0434\u0443\u043A\u0446\u0438\u0435\u0439 \u043A\u043B\u044E\u0447\u0438\u0446\u044B
    \u0443 \u0434\u043E\u043C\u0430\u0448\u043D\u0438\u0445 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445
    \u0432\u043E\u0448\u043B\u0430 \u0432 \u0441\u043E\u0441\u0442\u0430\u0432 \u043F\u043B\u0435\u0447\u0435\u0433\u043E\u043B\u043E\u0432\u043D\u043E\u0439
    \u043C\u044B\u0448\u0446\u044B \u043A\u0430\u043A \u0435\u0451 \u043A\u043B\u044E\u0447\u0438\u0447\u043D\u043E\u043F\u043B\u0435\u0447\u0435\u0432\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C.\n\u0414\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
    \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u0438\u044F \u043B\u043E\u043F\u0430\u0442\u043E\u0447\u043D\u043E\u0439
    \u0438 \u0430\u043A\u0440\u043E\u043C\u0438\u0430\u043B\u044C\u043D\u043E\u0439
    \u0447\u0430\u0441\u0442\u0435\u0439, \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0432\u0448\u0438\u0441\u044C
    \u0432\u043C\u0435\u0441\u0442\u0435, \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F
    \u043D\u0430 \u0434\u0435\u043B\u044C\u0442\u043E\u0432\u0438\u0434\u043D\u043E\u0439
    \u0448\u0435\u0440\u043E\u0445\u043E\u0432\u0430\u0442\u043E\u0441\u0442\u0438
    \u043F\u043B\u0435\u0447\u0435\u0432\u043E\u0439 \u043A\u043E\u0441\u0442\u0438,
    \u0438\u043C\u0435\u044F \u043F\u043E\u0434 \u0441\u043E\u0431\u043E\u0439 \u043F\u043E\u0434\u0441\u0443\u0445\u043E\u0436\u0438\u043B\u044C\u043D\u0443\u044E
    \u0431\u0443\u0440\u0441\u0443. \u041F\u043E \u0441\u0432\u043E\u0435\u043C\u0443
    \u0445\u043E\u0434\u0443 \u0434\u0435\u043B\u044C\u0442\u043E\u0432\u0438\u0434\u043D\u0430\u044F
    \u043C\u044B\u0448\u0446\u0430 \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u0435\u0442
    \u0437\u0430\u043E\u0441\u0442\u043D\u0443\u044E, \u043C\u0430\u043B\u0443\u044E
    \u043A\u0440\u0443\u0433\u043B\u0443\u044E \u0438 \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E
    \u0442\u0440\u0451\u0445\u0433\u043B\u0430\u0432\u0443\u044E \u043C\u044B\u0448\u0446\u0443
    \u043F\u043B\u0435\u0447\u0430.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F \u2013
    \u0441\u0433\u0438\u0431\u0430\u0435\u0442 \u0438 \u0441\u0443\u043F\u0438\u043D\u0438\u0440\u0443\u0435\u0442
    \u043F\u043B\u0435\u0447\u0435\u0432\u043E\u0439 \u0441\u0443\u0441\u0442\u0430\u0432"
  clip: {fileID: 8300000, guid: a6fd52926ff05624f9457395c23472c2, type: 3}
