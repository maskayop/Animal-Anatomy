  m_Name: "\u0414\u0435\u043B\u044C\u0442\u043E\u0432\u0438\u0434\u043D\u0430\u044F
    \u043C\u044B\u0448\u0446\u0430 (\u043A\u0443\u0440\u0438\u0446\u0430)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u0414\u0435\u043B\u044C\u0442\u043E\u0432\u0438\u0434\u043D\u0430\u044F
    \u043C\u044B\u0448\u0446\u0430"
  scientificName: musculus deltoideus
  nameClip: {fileID: 8300000, guid: 0cf6f0b8d1fc5bb46bf10f5e38af77ea, type: 3}
  description: "\u0412 \u0434\u0435\u043B\u044C\u0442\u043E\u0432\u0438\u0434\u043D\u043E\u0439
    \u043C\u044B\u0448\u0446\u0435 \u0440\u0430\u0437\u043B\u0438\u0447\u0430\u044E\u0442
    \u0431\u043E\u043B\u044C\u0448\u0443\u044E, \u043C\u0430\u043B\u0443\u044E \u0438
    \u043F\u0440\u043E\u043F\u0430\u0442\u0430\u0433\u0438\u0430\u043B\u044C\u043D\u0443\u044E
    \u0447\u0430\u0441\u0442\u0438 (pars major, pars minor et pars propatagialis).\r\n-
    \u0411\u043E\u043B\u044C\u0448\u0430\u044F \u0447\u0430\u0441\u0442\u044C \u0431\u0435\u0440\u0451\u0442
    \u043D\u0430\u0447\u0430\u043B\u043E \u043E\u0442 \u0430\u043A\u0440\u043E\u043C\u0438\u043E\u043D\u0430
    \u0438 \u0448\u0435\u0439\u043A\u0438 \u043B\u043E\u043F\u0430\u0442\u043A\u0438.\r\n-
    \u041C\u0430\u043B\u0430\u044F \u0447\u0430\u0441\u0442\u044C \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u043A\u043E\u0440\u0430\u043A\u043E\u0438\u0434\u043D\u043E\u0439
    \u043A\u043E\u0441\u0442\u0438 \u0438 \u0430\u043A\u0440\u043E\u043C\u0438\u043E\u043D\u0435.\r\n\u0411\u043E\u043B\u044C\u0448\u0430\u044F
    \u0438 \u043C\u0430\u043B\u0430\u044F \u0447\u0430\u0441\u0442\u0438 \u043F\u0440\u0438\u043A\u0440\u0435\u043F\u043B\u044F\u044E\u0442\u0441\u044F
    \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438 \u0434\u0435\u043B\u044C\u0442\u043E\u043F\u0435\u043A\u0442\u043E\u0440\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0433\u0440\u0435\u0431\u043D\u044F \u043F\u043B\u0435\u0447\u0435\u0432\u043E\u0439
    \u043A\u043E\u0441\u0442\u0438.\r\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F:\r\n\u0411\u043E\u043B\u044C\u0448\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
    \u0438 \u0441\u0443\u043F\u0438\u043D\u0438\u0440\u0443\u0435\u0442 \u043A\u0440\u044B\u043B\u043E,
    \u043C\u0430\u043B\u0430\u044F - \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
    \u0435\u0433\u043E; \u043F\u0440\u043E\u043F\u0430\u0442\u0430\u0433\u0438\u0430\u043B\u044C\u043D\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C \u043D\u0430\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442
    \u043F\u0435\u0440\u0435\u0434\u043D\u044E\u044E \u043A\u043E\u0436\u043D\u0443\u044E
    \u0441\u043A\u043B\u0430\u0434\u043A\u0443 \u043A\u0440\u044B\u043B\u0430"
