  m_Name: "\u041C\u0435\u0436\u043A\u043E\u0441\u0442\u043D\u044B\u0435 \u043C\u044B\u0448\u0446\u044B
    (\u043A\u043E\u0442)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u041C\u0435\u0436\u043A\u043E\u0441\u0442\u043D\u044B\u0435 \u043C\u044B\u0448\u0446\u044B"
  scientificName: musculi interossei
  description: "\u041E\u043D\u0438 \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E
    \u043F\u0440\u0438\u043A\u0440\u0435\u043F\u043B\u044F\u044E\u0442\u0441\u044F
    \u043A II\u2013V \u043F\u044F\u0441\u0442\u043D\u044B\u043C \u043A\u043E\u0441\u0442\u044F\u043C.\n\u041C\u044B\u0448\u0446\u044B
    \u0443 \u043A\u043E\u0448\u043A\u0438 \u0441\u0433\u0438\u0431\u0430\u044E\u0442
    \u043E\u043F\u043E\u0440\u043D\u044B\u0435 \u043F\u0430\u043B\u044C\u0446\u044B
    \u0432 \u043F\u044F\u0441\u0442\u043D\u043E-\u0444\u0430\u043B\u0430\u043D\u0433\u043E\u0432\u044B\u0445
    \u0441\u0443\u0441\u0442\u0430\u0432\u0430\u0445. \u0422\u0430\u043A\u0436\u0435
    \u043E\u043D\u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u044E\u0442 \u0433\u043B\u0430\u0432\u043D\u0443\u044E
    \u0444\u0443\u043D\u043A\u0446\u0438\u044E \u2014 \u043E\u0442\u0432\u0435\u0434\u0435\u043D\u0438\u0435
    \u0438 \u043F\u0440\u0438\u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u043F\u0430\u043B\u044C\u0446\u0435\u0432
    \u043A \u0441\u0440\u0435\u0434\u043D\u0435\u0439 \u043B\u0438\u043D\u0438\u0438.
    \u041F\u0440\u0438 \u044D\u0442\u043E\u043C \u043A\u0430\u0436\u0434\u0430\u044F
    \u0444\u0430\u043B\u0430\u043D\u0433\u0430 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
    \u043F\u0430\u043B\u044C\u0446\u0430 \u0438\u043C\u0435\u0435\u0442 \u043E\u0434\u043D\u0443
    \u0438\u043B\u0438 \u0434\u0430\u0436\u0435 \u0434\u0432\u0435 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0445
    \u043C\u044B\u0448\u0446\u044B, \u043F\u0440\u0438\u0432\u043E\u0434\u044F\u0449\u0438\u0435
    \u0435\u0451 \u0432 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435"
  clip: {fileID: 0}
