  russianName: "\u042F\u0439\u0446\u0435\u0432\u043E\u0434 (\u044F\u0439\u0446\u0435\u043F\u0440\u043E\u0432\u043E\u0434)"
  scientificName: oviductus
  nameClip: {fileID: 8300000, guid: 55e02f4ad2b75cd4eac094a42a6cf384, type: 3}
  description: "\u0422\u0440\u0443\u0431\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0439
    \u043E\u0440\u0433\u0430\u043D \u043F\u043E\u043B\u043E\u0432\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u044B
    \u0441\u0430\u043C\u043A\u0438 \u043A\u0443\u0440\u0438\u0446\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0441\u043B\u0443\u0436\u0438\u0442 \u0434\u043B\u044F \u0432\u044B\u0432\u0435\u0434\u0435\u043D\u0438\u044F
    \u0437\u0440\u0435\u043B\u044B\u0445 \u044F\u0438\u0446 \u0438\u043B\u0438 \u044F\u0439\u0446\u0435\u043A\u043B\u0435\u0442\u043E\u043A.
    \u0423 \u043F\u0442\u0438\u0446, \u0432 \u043E\u0442\u043B\u0438\u0447\u0438\u0435
    \u043E\u0442 \u043C\u043D\u043E\u0433\u0438\u0445 \u0434\u0440\u0443\u0433\u0438\u0445
    \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445, \u043E\u0431\u044B\u0447\u043D\u043E
    \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E
    \u043B\u0435\u0432\u044B\u0439 \u044F\u0439\u0446\u0435\u0432\u043E\u0434, \u0430
    \u043F\u0440\u0430\u0432\u044B\u0439 \u0440\u0435\u0434\u0443\u0446\u0438\u0440\u043E\u0432\u0430\u043D\n\u042F\u0439\u0446\u0435\u0432\u043E\u0434
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u043E\u0431\u043E\u0439
    \u0441\u0438\u043B\u044C\u043D\u043E \u0438\u0437\u043E\u0433\u043D\u0443\u0442\u0443\u044E
    \u0442\u0440\u0443\u0431\u043A\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u043F\u0440\u043E\u0441\u0442\u0438\u0440\u0430\u0435\u0442\u0441\u044F \u043E\u0442
    \u044F\u0438\u0447\u043D\u0438\u043A\u0430 \u0434\u043E \u043A\u043B\u043E\u0430\u043A\u0438.
    \u041E\u043D \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D \u0432
    \u043B\u0435\u0432\u043E\u0439 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0435
    \u0431\u0440\u044E\u0448\u043D\u043E\u0439 \u043F\u043E\u043B\u043E\u0441\u0442\u0438,
    \u0437\u0430\u043D\u0438\u043C\u0430\u044F \u0435\u0451 \u043A\u0430\u0443\u0434\u043E\u0434\u043E\u0440\u0441\u0430\u043B\u044C\u043D\u0443\u044E
    \u0447\u0430\u0441\u0442\u044C, \u0438 \u0441\u043E\u043F\u0440\u0438\u043A\u0430\u0441\u0430\u0435\u0442\u0441\u044F
    \u0441 \u043B\u0435\u0432\u043E\u0439 \u043F\u043E\u0447\u043A\u043E\u0439, \u0441\u0435\u043B\u0435\u0437\u0451\u043D\u043A\u043E\u0439
    \u0438 \u043A\u0438\u0448\u0435\u0447\u043D\u0438\u043A\u043E\u043C. \u041E\u0440\u0433\u0430\u043D
    \u043F\u043E\u0434\u0432\u0435\u0448\u0435\u043D \u043D\u0430 \u0448\u0438\u0440\u043E\u043A\u0438\u0445
    \u0441\u0432\u044F\u0437\u043A\u0430\u0445 (\u0431\u0440\u044B\u0436\u0435\u0439\u043A\u0430\u0445),
    \u043C\u0435\u0436\u0434\u0443 \u043B\u0438\u0441\u0442\u043A\u0430\u043C\u0438
    \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043F\u0440\u043E\u0445\u043E\u0434\u044F\u0442
    \u043A\u0440\u043E\u0432\u0435\u043D\u043E\u0441\u043D\u044B\u0435 \u0441\u043E\u0441\u0443\u0434\u044B
    \u0438 \u043D\u0435\u0440\u0432\u044B.\n\u041E\u0431\u0449\u0430\u044F \u0434\u043B\u0438\u043D\u0430
    \u044F\u0439\u0446\u0435\u0432\u043E\u0434\u0430 \u0443 \u043A\u0443\u0440\u0438\u0446\u044B
    \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u043A\u043E\u043B\u043E
    319\u2013350 \u043C\u043C. \u041E\u043D \u0441\u043E\u0441\u0442\u043E\u0438\u0442
    \u0438\u0437 \u043F\u044F\u0442\u0438 \u0430\u043D\u0430\u0442\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u0438
    \u0438 \u0444\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E
    \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445 \u043E\u0442\u0434\u0435\u043B\u043E\u0432:\n-
    \u0412\u043E\u0440\u043E\u043D\u043A\u0430 (infundibulum). \u042D\u0442\u043E
    \u043F\u0435\u0440\u0435\u0434\u043D\u044F\u044F \u0447\u0430\u0441\u0442\u044C,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043D\u0435\u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u043E
    \u043F\u0440\u0438\u043C\u044B\u043A\u0430\u0435\u0442 \u043A \u044F\u0438\u0447\u043D\u0438\u043A\u0443.
    \u0415\u0451 \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u043D\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C \u0441 \u0431\u0430\u0445\u0440\u043E\u043C\u043A\u0430\u043C\u0438
    \u0437\u0430\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0435\u0442 \u044F\u0439\u0446\u0435\u043A\u043B\u0435\u0442\u043A\u0443
    \u043F\u043E\u0441\u043B\u0435 \u043E\u0432\u0443\u043B\u044F\u0446\u0438\u0438.
    \u0417\u0434\u0435\u0441\u044C \u0436\u0435 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
    \u043E\u043F\u043B\u043E\u0434\u043E\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u0435.\n-
    \u0411\u0435\u043B\u043A\u043E\u0432\u044B\u0439 \u043E\u0442\u0434\u0435\u043B
    (\u043C\u0430\u0433\u043D\u0443\u043C). \u0421\u0430\u043C\u0430\u044F \u0434\u043B\u0438\u043D\u043D\u0430\u044F
    \u0438 \u0438\u0437\u0432\u0438\u0442\u0430\u044F \u0447\u0430\u0441\u0442\u044C
    \u044F\u0439\u0446\u0435\u0432\u043E\u0434\u0430. \u0417\u0434\u0435\u0441\u044C
    \u0437\u0430 \u0441\u0447\u0451\u0442 \u0441\u0435\u043A\u0440\u0435\u0446\u0438\u0438
    \u0442\u0440\u0443\u0431\u0447\u0430\u0442\u044B\u0445 \u0436\u0435\u043B\u0451\u0437
    \u0441\u043B\u0438\u0437\u0438\u0441\u0442\u043E\u0439 \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0438
    \u0444\u043E\u0440\u043C\u0438\u0440\u0443\u0435\u0442\u0441\u044F \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439
    \u043E\u0431\u044A\u0451\u043C \u0431\u0435\u043B\u043A\u0430 \u044F\u0439\u0446\u0430
    (\u0430\u043B\u044C\u0431\u0443\u043C\u0438\u043D). \u042F\u0439\u0446\u0435\u043A\u043B\u0435\u0442\u043A\u0430
    \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u044D\u0442\u043E\u0442 \u043E\u0442\u0434\u0435\u043B
    \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E \u0437\u0430 3 \u0447\u0430\u0441\u0430.\n-
    \u041F\u0435\u0440\u0435\u0448\u0435\u0435\u043A (isthmus). \u0412 \u044D\u0442\u043E\u043C
    \u043E\u0442\u0434\u0435\u043B\u0435 \u043E\u0431\u0440\u0430\u0437\u0443\u044E\u0442\u0441\u044F
    \u043F\u043E\u0434\u0441\u043A\u043E\u0440\u043B\u0443\u043F\u043E\u0432\u044B\u0435
    (\u0431\u0435\u043B\u043A\u043E\u0432\u044B\u0435) \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0438
    \u044F\u0439\u0446\u0430.\n- \u041C\u0430\u0442\u043A\u0430 (uterus). \u041C\u0435\u0448\u043A\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0439
    \u043E\u0442\u0434\u0435\u043B, \u0433\u0434\u0435 \u044F\u0439\u0446\u043E \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 16\u201319 \u0447\u0430\u0441\u043E\u0432 \u0438 \u043F\u043E\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u0438\u0437\u0432\u0435\u0441\u0442\u043A\u043E\u0432\u043E\u0439 \u0441\u043A\u043E\u0440\u043B\u0443\u043F\u043E\u0439.
    \u042D\u0442\u043E\u0442 \u043F\u0440\u043E\u0446\u0435\u0441\u0441 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
    \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
    \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u043A\u0430\u043B\u044C\u0446\u0438\u044F,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u043E\u0441\u0442\u0443\u043F\u0430\u0435\u0442
    \u0432 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C \u043A\u0443\u0440\u0438\u0446\u044B
    \u0441 \u043A\u043E\u0440\u043C\u043E\u043C.\n- \u0412\u043B\u0430\u0433\u0430\u043B\u0438\u0449\u0435
    (vagina). \u041A\u043E\u043D\u0435\u0447\u043D\u044B\u0439 \u043E\u0442\u0434\u0435\u043B,
    \u043C\u044B\u0448\u0435\u0447\u043D\u0430\u044F \u0442\u0440\u0443\u0431\u043A\u0430,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u0432 \u043A\u043B\u043E\u0430\u043A\u0443. \u041F\u0440\u0438 \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0438
    \u044F\u0439\u0446\u0430 \u0435\u0451 \u0441\u0442\u0435\u043D\u043A\u0438 \u0432\u044B\u0434\u0435\u043B\u044F\u044E\u0442
    \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u0446\u0438\u0434\u043D\u0443\u044E
    \u043F\u043B\u0451\u043D\u043A\u0443, \u0437\u0430\u0449\u0438\u0449\u0430\u044E\u0449\u0443\u044E
    \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435.\n\u042F\u0439\u0446\u0435\u0432\u043E\u0434
    \u2014 \u044D\u0442\u043E \u0441\u043B\u043E\u0436\u043D\u044B\u0439 \u0438 \u0434\u0438\u043D\u0430\u043C\u0438\u0447\u043D\u044B\u0439
    \u043E\u0440\u0433\u0430\u043D, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
    \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435
    \u044F\u0439\u0446\u0435\u043A\u043B\u0435\u0442\u043A\u0438 \u0432 \u043F\u043E\u043B\u043D\u043E\u0446\u0435\u043D\u043D\u043E\u0435
    \u044F\u0439\u0446\u043E. \u041F\u043E \u043C\u0435\u0440\u0435 \u043F\u0440\u043E\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
    \u043F\u043E \u043E\u0442\u0434\u0435\u043B\u0430\u043C \u044F\u0439\u0446\u0435\u043A\u043B\u0435\u0442\u043A\u0430
    \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E
    \u043F\u043E\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u043C\u0438
    \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0430\u043C\u0438: \u0431\u0435\u043B\u043A\u043E\u043C,
    \u043F\u043E\u0434\u0441\u043A\u043E\u0440\u043B\u0443\u043F\u043E\u0432\u044B\u043C\u0438
    \u043C\u0435\u043C\u0431\u0440\u0430\u043D\u0430\u043C\u0438 \u0438 \u0441\u043A\u043E\u0440\u043B\u0443\u043F\u043E\u0439.
    \u0414\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u044F\u0439\u0446\u0430 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u0441\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u0438\u0435\u043C \u043C\u044B\u0448\u0446
    \u0441\u0442\u0435\u043D\u043E\u043A \u0438 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435\u043C
    \u0440\u0435\u0441\u043D\u0438\u0447\u0435\u043A \u043C\u0435\u0440\u0446\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
    \u044D\u043F\u0438\u0442\u0435\u043B\u0438\u044F. \u0412\u0435\u0441\u044C \u043F\u0440\u043E\u0446\u0435\u0441\u0441
    \u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044F \u0438
    \u0432\u044B\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u044F\u0439\u0446\u0430
    \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442 \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E
    23\u201324 \u0447\u0430\u0441\u0430.\n\u0421\u043B\u0438\u0437\u0438\u0441\u0442\u0430\u044F
    \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0430 \u044F\u0439\u0446\u0435\u0432\u043E\u0434\u0430
    \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442 \u043C\u043D\u043E\u0433\u043E\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u044B\u0435
    \u0441\u043A\u043B\u0430\u0434\u043A\u0438, \u0447\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u0435\u0451
    \u043F\u043B\u043E\u0449\u0430\u0434\u044C \u0434\u043B\u044F \u0441\u0435\u043A\u0440\u0435\u0446\u0438\u0438
    \u0438 \u0432\u0441\u0430\u0441\u044B\u0432\u0430\u043D\u0438\u044F. \u041C\u044B\u0448\u0435\u0447\u043D\u0430\u044F
    \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0430 \u0441\u043E\u0441\u0442\u043E\u0438\u0442
    \u0438\u0437 \u043F\u0440\u043E\u0434\u043E\u043B\u044C\u043D\u044B\u0445 \u0438
    \u0446\u0438\u0440\u043A\u0443\u043B\u044F\u0440\u043D\u044B\u0445 \u0432\u043E\u043B\u043E\u043A\u043E\u043D,
    \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u0445
    \u043F\u0435\u0440\u0438\u0441\u0442\u0430\u043B\u044C\u0442\u0438\u043A\u0443"
