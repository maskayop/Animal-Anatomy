  m_Name: "\u042F\u0438\u0447\u043D\u0438\u043A\u0438 (\u043A\u0443\u0440\u0438\u0446\u0430)"
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.Data_Info
  russianName: "\u042F\u0438\u0447\u043D\u0438\u043A\u0438"
  scientificName: ovarium
  nameClip: {fileID: 8300000, guid: f7eaf854c7f3f1f4facf941ec566e416, type: 3}
  description: "\u041A\u043B\u044E\u0447\u0435\u0432\u043E\u0439 \u043E\u0440\u0433\u0430\u043D
    \u0436\u0435\u043D\u0441\u043A\u043E\u0439 \u0440\u0435\u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0438\u0432\u043D\u043E\u0439
    \u0441\u0438\u0441\u0442\u0435\u043C\u044B, \u0433\u0434\u0435 \u0444\u043E\u0440\u043C\u0438\u0440\u0443\u044E\u0442\u0441\u044F
    \u044F\u0439\u0446\u0435\u043A\u043B\u0435\u0442\u043A\u0438 (\u043E\u043E\u0446\u0438\u0442\u044B)
    \u0438 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442 \u0438\u0445
    \u0441\u043E\u0437\u0440\u0435\u0432\u0430\u043D\u0438\u0435.\n\u0423 \u043A\u0443\u0440
    \u0432 \u044D\u043C\u0431\u0440\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u043C
    \u043F\u0435\u0440\u0438\u043E\u0434\u0435 \u0437\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F
    \u043F\u0430\u0440\u043D\u044B\u0435 (\u043F\u0440\u0430\u0432\u044B\u0439 \u0438
    \u043B\u0435\u0432\u044B\u0439) \u044F\u0438\u0447\u043D\u0438\u043A\u0438. \u041E\u0434\u043D\u0430\u043A\u043E
    \u0443 \u0432\u0437\u0440\u043E\u0441\u043B\u043E\u0439 \u043F\u0442\u0438\u0446\u044B
    \u0444\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0438\u0440\u0443\u0435\u0442
    \u043F\u043E\u0447\u0442\u0438 \u0432\u0441\u0435\u0433\u0434\u0430 \u0442\u043E\u043B\u044C\u043A\u043E
    \u043B\u0435\u0432\u044B\u0439 \u044F\u0438\u0447\u043D\u0438\u043A, \u0430 \u043F\u0440\u0430\u0432\u044B\u0439
    \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E \u0440\u0435\u0434\u0443\u0446\u0438\u0440\u0443\u0435\u0442\u0441\u044F
    (\u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442\u0441\u044F \u0432 \u0440\u0430\u0437\u043C\u0435\u0440\u0430\u0445).
    \u041B\u0435\u0432\u044B\u0439 \u044F\u0438\u0447\u043D\u0438\u043A \u0438\u043C\u0435\u0435\u0442
    \u0444\u043E\u0440\u043C\u0443 \u043F\u0440\u043E\u0434\u043E\u043B\u0433\u043E\u0432\u0430\u0442\u043E\u0439
    \u0447\u0435\u0442\u044B\u0440\u0451\u0445\u0443\u0433\u043E\u043B\u044C\u043D\u043E\u0439
    \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u043A\u0438 \u0438 \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D
    \u0432 \u043F\u043E\u044F\u0441\u043D\u0438\u0447\u043D\u043E\u0439 \u043E\u0431\u043B\u0430\u0441\u0442\u0438
    \u0431\u0440\u044E\u0448\u043D\u043E\u0439 \u043F\u043E\u043B\u043E\u0441\u0442\u0438
    \u043F\u0435\u0440\u0435\u0434 \u043B\u0435\u0432\u043E\u0439 \u043F\u043E\u0447\u043A\u043E\u0439.
    \u041E\u043D \u043F\u0440\u0438\u043A\u0440\u0435\u043F\u043B\u0451\u043D \u043A
    \u0434\u043E\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
    \u0431\u0440\u044E\u0448\u043D\u043E\u0439 \u043F\u043E\u043B\u043E\u0441\u0442\u0438
    \u0438 \u043A\u0440\u0443\u043F\u043D\u044B\u043C \u043A\u0440\u043E\u0432\u0435\u043D\u043E\u0441\u043D\u044B\u043C
    \u0441\u043E\u0441\u0443\u0434\u0430\u043C \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
    \u0431\u0440\u044E\u0448\u043D\u043E\u0439 \u0441\u043A\u043B\u0430\u0434\u043A\u0438.
    \u0414\u0440\u0443\u0433\u043E\u0439 \u0441\u043A\u043B\u0430\u0434\u043A\u043E\u0439
    \u044F\u0438\u0447\u043D\u0438\u043A \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0435\u0442\u0441\u044F
    \u0441 \u044F\u0439\u0446\u0435\u0432\u043E\u0434\u043E\u043C. \u0421\u043D\u0430\u0440\u0443\u0436\u0438
    \u043E\u0440\u0433\u0430\u043D \u043F\u043E\u043A\u0440\u044B\u0442 \u043E\u0434\u043D\u043E\u0441\u043B\u043E\u0439\u043D\u044B\u043C
    \u043A\u0443\u0431\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u044D\u043F\u0438\u0442\u0435\u043B\u0438\u0435\u043C,
    \u043F\u043E\u0434 \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
    \u0442\u043E\u043D\u043A\u0430\u044F \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0442\u043A\u0430\u043D\u043D\u0430\u044F
    \u0431\u0435\u043B\u043E\u0447\u043D\u0430\u044F \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u0430.\n\u0412\u043D\u0443\u0442\u0440\u0438
    \u044F\u0438\u0447\u043D\u0438\u043A \u0447\u0451\u0442\u043A\u043E \u0434\u0435\u043B\u0438\u0442\u0441\u044F
    \u043D\u0430 \u0434\u0432\u0435 \u0437\u043E\u043D\u044B:\n- \u041A\u043E\u0440\u043A\u043E\u0432\u0430\u044F
    \u0437\u043E\u043D\u0430 \u2014 \u0437\u0434\u0435\u0441\u044C \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u044E\u0442\u0441\u044F
    \u0436\u0435\u043D\u0441\u043A\u0438\u0435 \u043F\u043E\u043B\u043E\u0432\u044B\u0435
    \u043A\u043B\u0435\u0442\u043A\u0438 (\u043E\u043E\u0446\u0438\u0442\u044B).\n-
    \u041C\u043E\u0437\u0433\u043E\u0432\u0430\u044F \u0437\u043E\u043D\u0430 \u2014
    \u0431\u043E\u0433\u0430\u0442\u0430 \u043A\u0440\u043E\u0432\u0435\u043D\u043E\u0441\u043D\u044B\u043C\u0438
    \u0441\u043E\u0441\u0443\u0434\u0430\u043C\u0438 \u0438 \u043D\u0435\u0440\u0432\u043D\u044B\u043C\u0438
    \u0432\u043E\u043B\u043E\u043A\u043D\u0430\u043C\u0438, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
    \u0435\u0451 \u0447\u0430\u0441\u0442\u043E \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442
    \u0441\u043E\u0441\u0443\u0434\u0438\u0441\u0442\u043E\u0439.\n\u0417\u0430\u043A\u043B\u0430\u0434\u043A\u0430
    \u0433\u043E\u043D\u0430\u0434 \u0443 \u043A\u0443\u0440\u0438\u043D\u044B\u0445
    \u044D\u043C\u0431\u0440\u0438\u043E\u043D\u043E\u0432 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
    \u043D\u0430 4-\u0435 \u0441\u0443\u0442\u043A\u0438 \u0438\u043D\u043A\u0443\u0431\u0430\u0446\u0438\u0438.
    \u041A 8-\u043C \u0441\u0443\u0442\u043A\u0430\u043C \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
    \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043D\u0446\u0438\u0440\u043E\u0432\u043A\u0430,
    \u0430 \u043A 19-\u043C \u0441\u0443\u0442\u043A\u0430\u043C \u0447\u0430\u0441\u0442\u044C
    \u043E\u043E\u0433\u043E\u043D\u0438\u0439 (\u043F\u0440\u0435\u0434\u0448\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A\u043E\u0432
    \u043E\u043E\u0446\u0438\u0442\u043E\u0432) \u0434\u0438\u0444\u0444\u0435\u0440\u0435\u043D\u0446\u0438\u0440\u0443\u0435\u0442\u0441\u044F
    \u0432 \u043E\u043E\u0446\u0438\u0442\u044B, \u0438 \u043D\u0430 \u0433\u0440\u0430\u043D\u0438\u0446\u0435
    \u043A\u043E\u0440\u043A\u043E\u0432\u043E\u0433\u043E \u0438 \u043C\u043E\u0437\u0433\u043E\u0432\u043E\u0433\u043E
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442
    \u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u0442\u044C\u0441\u044F
    \u0444\u043E\u043B\u043B\u0438\u043A\u0443\u043B\u044B. \u041A \u043C\u043E\u043C\u0435\u043D\u0442\u0443
    \u0432\u044B\u043B\u0443\u043F\u043B\u0435\u043D\u0438\u044F \u0444\u043E\u043B\u043B\u0438\u043A\u0443\u043B\u044F\u0440\u043D\u044B\u0435
    \u0441\u0442\u0430\u0434\u0438\u0438 \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F
    \u043F\u0440\u0435\u043E\u0431\u043B\u0430\u0434\u0430\u044E\u0449\u0438\u043C\u0438,
    \u0430 \u043E\u043E\u0433\u043E\u043D\u0438\u0438 \u0438\u0441\u0447\u0435\u0437\u0430\u044E\u0442.\n\u0423
    \u0441\u0443\u0442\u043E\u0447\u043D\u044B\u0445 \u0446\u044B\u043F\u043B\u044F\u0442
    \u043A\u043E\u0440\u043A\u043E\u0432\u043E\u0435 \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u043E
    \u0443\u0436\u0435 \u043D\u0430\u0441\u044B\u0449\u0435\u043D\u043E \u043E\u043E\u0446\u0438\u0442\u0430\u043C\u0438,
    \u043E\u043A\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u043C\u0438 \u0444\u043E\u043B\u043B\u0438\u043A\u0443\u043B\u044F\u0440\u043D\u044B\u043C
    \u044D\u043F\u0438\u0442\u0435\u043B\u0438\u0435\u043C, \u0430 \u043C\u043E\u0437\u0433\u043E\u0432\u043E\u0435
    \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u043E \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043E
    \u0440\u044B\u0445\u043B\u043E\u0439 \u0432\u043E\u043B\u043E\u043A\u043D\u0438\u0441\u0442\u043E\u0439
    \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u0442\u043A\u0430\u043D\u044C\u044E \u0441 \u0440\u0430\u0432\u043D\u043E\u043C\u0435\u0440\u043D\u043E
    \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u044B\u043C\u0438
    \u0441\u043E\u0441\u0443\u0434\u0430\u043C\u0438 \u0438 \u043D\u0435\u0440\u0432\u043D\u044B\u043C\u0438
    \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u044F\u043C\u0438. \u041A 120-\u0441\u0443\u0442\u043E\u0447\u043D\u043E\u043C\u0443
    \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0443 \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
    \u044F\u0438\u0447\u043D\u0438\u043A\u0430 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
    \u0431\u043B\u0438\u0437\u043A\u0438\u043C \u043A \u0434\u0435\u0444\u0438\u043D\u0438\u0442\u0438\u0432\u043D\u043E\u043C\u0443
    (\u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u043C\u0443).
    \u041F\u043E\u043B\u043E\u0432\u043E\u0435 \u0441\u043E\u0437\u0440\u0435\u0432\u0430\u043D\u0438\u0435,
    \u0441\u043E\u043F\u0440\u043E\u0432\u043E\u0436\u0434\u0430\u044E\u0449\u0435\u0435\u0441\u044F
    \u043E\u0432\u0443\u043B\u044F\u0446\u0438\u0435\u0439, \u043D\u0430\u0441\u0442\u0443\u043F\u0430\u0435\u0442
    \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E \u043A 150-\u0441\u0443\u0442\u043E\u0447\u043D\u043E\u043C\u0443
    \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0443, \u0438 \u0442\u043E\u0433\u0434\u0430
    \u044F\u0438\u0447\u043D\u0438\u043A \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u0442\u0430\u0435\u0442
    \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u0443\u044E \u0433\u0440\u043E\u0437\u0434\u0435\u0432\u0438\u0434\u043D\u0443\u044E
    \u0444\u043E\u0440\u043C\u0443 \u0438\u0437-\u0437\u0430 \u0431\u043E\u043B\u044C\u0448\u043E\u0433\u043E
    \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u0444\u043E\u043B\u043B\u0438\u043A\u0443\u043B\u043E\u0432
    \u0440\u0430\u0437\u043D\u043E\u0439 \u0441\u0442\u0435\u043F\u0435\u043D\u0438
    \u0437\u0440\u0435\u043B\u043E\u0441\u0442\u0438.\n\u0412 \u044F\u0438\u0447\u043D\u0438\u043A\u0435
    \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044E\u0442
    \u0444\u043E\u043B\u043B\u0438\u043A\u0443\u043B\u044B \u043D\u0430 \u0440\u0430\u0437\u043D\u044B\u0445
    \u0441\u0442\u0430\u0434\u0438\u044F\u0445 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F:\n-
    \u041F\u0440\u0438\u043C\u043E\u0440\u0434\u0438\u0430\u043B\u044C\u043D\u044B\u0435
    \u2014 \u0441\u0430\u043C\u044B\u0435 \u0440\u0430\u043D\u043D\u0438\u0435, \u043C\u0435\u043B\u043A\u0438\u0435,
    \u0441 \u043D\u0435\u0437\u0440\u0435\u043B\u044B\u043C\u0438 \u043E\u043E\u0446\u0438\u0442\u0430\u043C\u0438.\n-
    \u0424\u043E\u043B\u043B\u0438\u043A\u0443\u043B\u044B \u0432 \u0441\u0442\u0430\u0434\u0438\u0438
    \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E\u0433\u043E \u0438 \u0431\u044B\u0441\u0442\u0440\u043E\u0433\u043E
    \u0440\u043E\u0441\u0442\u0430 \u2014 \u043E\u043E\u0446\u0438\u0442\u044B \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F
    \u0437\u0430 \u0441\u0447\u0451\u0442 \u043D\u0430\u043A\u043E\u043F\u043B\u0435\u043D\u0438\u044F
    \u0436\u0435\u043B\u0442\u043A\u0430.\n- \u0421\u043E\u0437\u0440\u0435\u0432\u0430\u044E\u0449\u0438\u0435
    \u2014 \u0433\u043E\u0442\u043E\u0432\u044B\u0435 \u043A \u043E\u0432\u0443\u043B\u044F\u0446\u0438\u0438.\n-
    \u0410\u0442\u0440\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u2014
    \u0442\u0435, \u0447\u0442\u043E \u043F\u0440\u0435\u043A\u0440\u0430\u0442\u0438\u043B\u0438
    \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0438 \u043F\u043E\u0434\u0432\u0435\u0440\u0433\u043B\u0438\u0441\u044C
    \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u043C\u0443 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044E
    (\u0430\u0442\u0440\u0435\u0437\u0438\u044F).\n\u041F\u043E \u043C\u0435\u0440\u0435
    \u043D\u0430\u043A\u043E\u043F\u043B\u0435\u043D\u0438\u044F \u0436\u0435\u043B\u0442\u043A\u0430
    \u0444\u043E\u043B\u043B\u0438\u043A\u0443\u043B\u044B \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044E\u0442\u0441\u044F
    \u043A \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u044F\u0438\u0447\u043D\u0438\u043A\u0430
    \u0438 \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u044E\u0442 \u043D\u0430\u0440\u0443\u0436\u0443,
    \u043E\u0441\u0442\u0430\u0432\u0430\u044F\u0441\u044C \u0441\u043E\u0435\u0434\u0438\u043D\u0451\u043D\u043D\u044B\u043C\u0438
    \u0441 \u043E\u0440\u0433\u0430\u043D\u043E\u043C \u0442\u043E\u043B\u044C\u043A\u043E
    \u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E\u043C \xAB\u043D\u043E\u0436\u043A\u0438\xBB
    \u2014 \u044D\u0442\u043E \u043E\u0432\u0430\u0440\u0438\u0430\u043B\u044C\u043D\u044B\u0439
    \u0444\u043E\u043B\u043B\u0438\u043A\u0443\u043B.\n\u0423 \u0440\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u043E
    \u043D\u0435\u0441\u0443\u0449\u0435\u0439\u0441\u044F \u043A\u0443\u0440\u0438\u0446\u044B
    \u0432 \u0434\u0435\u043D\u044C \u0441\u043E\u0437\u0440\u0435\u0432\u0430\u0435\u0442
    \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E \u043E\u0434\u0438\u043D \u0444\u043E\u043B\u043B\u0438\u043A\u0443\u043B.
    \u0415\u0441\u043B\u0438 \u0432 \u044F\u0439\u0446\u0435\u0432\u043E\u0434\u0435
    \u0435\u0441\u0442\u044C \u044F\u0439\u0446\u043E, \u043D\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
    \u044F\u0438\u0447\u043D\u0438\u043A\u0430 \u043C\u043E\u0436\u043D\u043E \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u0442\u044C
    2\u20133 \u043A\u0440\u0443\u043F\u043D\u044B\u0445 \u0436\u0451\u043B\u0442\u044B\u0445
    \u0444\u043E\u043B\u043B\u0438\u043A\u0443\u043B\u0430 (\u0434\u0438\u0430\u043C\u0435\u0442\u0440\u043E\u043C
    \u0432 \u0441\u0440\u0435\u0434\u043D\u0435\u043C 27\u201332 \u043C\u043C). \u0415\u0441\u043B\u0438
    \u044F\u0439\u0446\u0430 \u043D\u0435\u0442 \u2014 \u0432\u0438\u0434\u043D\u044B
    \u0431\u043E\u043B\u0435\u0435 \u043C\u0435\u043B\u043A\u0438\u0435 (20\u201325
    \u043C\u043C) \u0444\u043E\u043B\u043B\u0438\u043A\u0443\u043B\u044B \u043C\u043E\u043B\u043E\u0447\u043D\u043E-\u0436\u0451\u043B\u0442\u043E\u0433\u043E
    \u0446\u0432\u0435\u0442\u0430. \u0421 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u043E\u043C
    \u0443 \u043D\u0435\u0441\u0443\u0448\u043A\u0438 \u043E\u0431\u044A\u0451\u043C
    \u0444\u043E\u043B\u043B\u0438\u043A\u0443\u043B\u0430 \u043A \u043C\u043E\u043C\u0435\u043D\u0442\u0443
    \u043E\u0432\u0443\u043B\u044F\u0446\u0438\u0438 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
    \u043D\u043E \u043E\u0431\u0449\u0435\u0435 \u0447\u0438\u0441\u043B\u043E \u0440\u0430\u0441\u0442\u0443\u0449\u0438\u0445
    \u0444\u043E\u043B\u043B\u0438\u043A\u0443\u043B\u043E\u0432 \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E
    \u0441\u043D\u0438\u0436\u0430\u0435\u0442\u0441\u044F, \u0430 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u043E\u0442\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u043C\u043E\u0433\u043E
    \u0432 \u043E\u043E\u0446\u0438\u0442 \u0436\u0435\u043B\u0442\u043A\u0430 \u2014
    \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0430\u0435\u0442.\n\u0421 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u043E\u043C
    \u0444\u0443\u043D\u043A\u0446\u0438\u044F \u044F\u0438\u0447\u043D\u0438\u043A\u0430
    \u043E\u0441\u043B\u0430\u0431\u0435\u0432\u0430\u0435\u0442: \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442\u0441\u044F
    \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0444\u043E\u043B\u043B\u0438\u043A\u0443\u043B\u043E\u0432,
    \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0430\u0442\u0440\u0435\u0437\u0438\u044F,
    \u0441\u043D\u0438\u0436\u0430\u0435\u0442\u0441\u044F \u043E\u0432\u0443\u043B\u044F\u0442\u043E\u0440\u043D\u0430\u044F
    \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C. \u042D\u0442\u0438
    \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E
    \u0432\u043B\u0438\u044F\u044E\u0442 \u043D\u0430 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0438\u0432\u043D\u043E\u0435
    \u0434\u043E\u043B\u0433\u043E\u043B\u0435\u0442\u0438\u0435 \u043F\u0442\u0438\u0446\u044B"
