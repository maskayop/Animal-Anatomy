  partName: "\u0414\u0432\u043E\u0439\u043D\u0438\u0447\u043D\u0430\u044F \u043C\u044B\u0448\u0446\u0430"
  partScientificName: musculus gemelli
  partDescription: "\u041D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F, \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0447\u0430\u0442\u043E\u0439
    \u0444\u043E\u0440\u043C\u044B, \u0431\u0435\u0440\u0451\u0442 \u043D\u0430\u0447\u0430\u043B\u043E
    \u043F\u043E \u043A\u0440\u0430\u044E \u043C\u0430\u043B\u043E\u0439 \u0441\u0435\u0434\u0430\u043B\u0438\u0449\u043D\u043E\u0439
    \u0432\u044B\u0440\u0435\u0437\u043A\u0438 \u0438 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u0432 \u0432\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u044F\u043C\u043A\u0435
    \u043C\u0435\u0436\u0434\u0443 \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u0438\u044F\u043C\u0438
    \u043E\u0431\u0435\u0438\u0445 \u0437\u0430\u043F\u0438\u0440\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u043C\u044B\u0448\u0446.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F \u2013
    \u0441\u0443\u043F\u0438\u043D\u0438\u0440\u0443\u044E\u0442 \u0431\u0435\u0434\u0440\u043E"
