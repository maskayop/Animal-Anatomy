  - {fileID: 6996231969811704782}
  - {fileID: 7751974175841685438}
  cameraDistanceLimitsMultiplier: 1
  info: {fileID: 0}
  sagittalType: 0
  partName: "\u0421\u0440\u0435\u0434\u043D\u044F\u044F \u044F\u0433\u043E\u0434\u0438\u0447\u043D\u0430\u044F
    \u043C\u044B\u0448\u0446\u0430"
  partScientificName: musculus gluteus medius
  partDescription: "\u0418\u0437 \u0432\u0441\u0435\u0445 \u044F\u0433\u043E\u0434\u0438\u0447\u043D\u044B\u0445
    \u043C\u044B\u0448\u0446 \u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435 \u043C\u0430\u0441\u0441\u0438\u0432\u043D\u0430\u044F.
    \u041E\u043D\u0430 \u0431\u0435\u0440\u0451\u0442 \u043D\u0430\u0447\u0430\u043B\u043E
    \u043E\u0442 \u0432\u0441\u0435\u0439 \u044F\u0433\u043E\u0434\u0438\u0447\u043D\u043E\u0439
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u043A\u0440\u044B\u043B\u0430
    \u043F\u043E\u0434\u0432\u0437\u0434\u043E\u0448\u043D\u043E\u0439 \u043A\u043E\u0441\u0442\u0438
    \u0438 \u043E\u0442 \u0434\u043E\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0439
    \u043A\u0440\u0435\u0441\u0442\u0446\u043E\u0432\u043E\u043F\u043E\u0434\u0432\u0437\u0434\u043E\u0448\u043D\u043E\u0439
    \u0441\u0432\u044F\u0437\u043A\u0438. \u0415\u0451 \u043D\u0430\u0447\u0430\u043B\u043E
    \u043F\u0440\u043E\u0441\u0442\u0438\u0440\u0430\u0435\u0442\u0441\u044F \u043D\u0430
    \u043F\u043E\u044F\u0441\u043D\u0438\u0447\u043D\u0443\u044E \u0447\u0430\u0441\u0442\u044C
    \u0434\u043B\u0438\u043D\u043D\u0435\u0439\u0448\u0435\u0439 \u043C\u044B\u0448\u0446\u044B
    \u0441\u043F\u0438\u043D\u044B. \u0421 \u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043A\u0440\u0430\u044F \u043F\u0440\u0438\u043A\u0440\u044B\u0442\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u043D\u043E\u0439
    \u044F\u0433\u043E\u0434\u0438\u0447\u043D\u043E\u0439 \u043C\u044B\u0448\u0446\u0435\u0439.
    \u0421\u0432\u043E\u0438\u043C \u0434\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C
    \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u0438\u0435\u043C \u043E\u043D\u0430
    \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u0431\u043E\u043B\u044C\u0448\u043E\u043C \u0432\u0435\u0440\u0442\u0435\u043B\u0435.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F
    \u2013 \u0440\u0430\u0437\u0433\u0438\u0431\u0430\u0435\u0442 \u0442\u0430\u0437\u043E\u0431\u0435\u0434\u0440\u0435\u043D\u043D\u044B\u0439
    \u0441\u0443\u0441\u0442\u0430\u0432"
  partListButton: {fileID: 0}
  bodyPartGroup: {fileID: 0}
