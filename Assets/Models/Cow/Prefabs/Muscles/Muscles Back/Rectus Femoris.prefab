  sagittalType: 0
  partName: "\u041F\u0440\u044F\u043C\u0430\u044F \u043C\u044B\u0448\u0446\u0430
    \u0431\u0435\u0434\u0440\u0430"
  partScientificName: musculus rectus femoris
  partDescription: "\u0421\u0430\u043C\u0430\u044F \u043C\u043E\u0449\u043D\u0430\u044F
    \u0438\u0437 \u0432\u0441\u0435\u0445 \u0447\u0435\u0442\u044B\u0440\u0451\u0445
    \u0433\u043E\u043B\u043E\u0432\u043E\u043A. \u041E\u043D\u0430 \u0431\u0435\u0440\u0451\u0442
    \u043D\u0430\u0447\u0430\u043B\u043E \u043E\u0442 \u0442\u0435\u043B\u0430 \u043F\u043E\u0434\u0432\u0437\u0434\u043E\u0448\u043D\u043E\u0439
    \u043A\u043E\u0441\u0442\u0438 \u0432 \u0443\u0433\u043B\u0443\u0431\u043B\u0435\u043D\u0438\u044F\u0445
    \u043D\u0430\u0434 \u043F\u0435\u0440\u0435\u0434\u043D\u0438\u043C \u043A\u0440\u0430\u0435\u043C
    \u0432\u0435\u0440\u0442\u043B\u0443\u0436\u043D\u043E\u0439 \u0432\u043F\u0430\u0434\u0438\u043D\u044B.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F
    \u2013 \u0440\u0430\u0437\u0433\u0438\u0431\u0430\u0435\u0442 \u043A\u043E\u043B\u0435\u043D\u043D\u044B\u0439
    \u0438 \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u0441\u0433\u0438\u0431\u0430\u0442\u044C
    \u0442\u0430\u0437\u043E\u0431\u0435\u0434\u0440\u0435\u043D\u043D\u044B\u0439
    \u0441\u0443\u0441\u0442\u0430\u0432"
  partListButton: {fileID: 0}
  bodyPartGroup: {fileID: 0}
