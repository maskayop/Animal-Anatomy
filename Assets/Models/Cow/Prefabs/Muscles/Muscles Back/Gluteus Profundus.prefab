  cameraDistanceLimitsMultiplier: 1
  info: {fileID: 0}
  sagittalType: 0
  partName: "\u0413\u043B\u0443\u0431\u043E\u043A\u0430\u044F \u044F\u0433\u043E\u0434\u0438\u0447\u043D\u0430\u044F
    \u043C\u044B\u0448\u0446\u0430"
  partScientificName: musculus gluteus profundus
  partDescription: "\u041B\u0435\u0436\u0438\u0442 \u043F\u043E\u0434 \u0441\u0440\u0435\u0434\u043D\u0435\u0439
    \u044F\u0433\u043E\u0434\u0438\u0447\u043D\u043E\u0439 \u043C\u044B\u0448\u0446\u0435\u0439.
    \u041E\u043D\u0430 \u0431\u0435\u0440\u0451\u0442 \u043D\u0430\u0447\u0430\u043B\u043E
    \u043D\u0430 \u043B\u0430\u0442\u0435\u0440\u0430\u043B\u044C\u043D\u043E\u0439
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u0441\u0435\u0434\u0430\u043B\u0438\u0449\u043D\u043E\u0439
    \u043E\u0441\u0442\u0438 \u0438 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u0431\u043E\u043B\u044C\u0448\u043E\u043C \u0432\u0435\u0440\u0442\u0435\u043B\u0435,
    \u0438\u043C\u0435\u044F \u043F\u043E\u0434 \u0441\u043E\u0431\u043E\u0439 \u0431\u0443\u0440\u0441\u0443
    (b. trochanterica m. glutei profundi).\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F
    \u2013 \u0430\u0431\u0434\u0443\u043A\u0442\u043E\u0440 \u0442\u0430\u0437\u043E\u0431\u0435\u0434\u0440\u0435\u043D\u043D\u043E\u0433\u043E
    \u0441\u0443\u0441\u0442\u0430\u0432\u0430"
