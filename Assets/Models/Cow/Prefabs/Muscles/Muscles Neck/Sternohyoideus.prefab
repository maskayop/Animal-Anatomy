  partName: "\u0413\u0440\u0443\u0434\u0438\u043D\u043D\u043E-\u043F\u043E\u0434\u044A\u044F\u0437\u044B\u0447\u043D\u0430\u044F
    \u043C\u044B\u0448\u0446\u0430"
  partScientificName: musculus sternohyoideus
  partDescription: "\u0414\u043B\u0438\u043D\u043D\u0430\u044F, \u043B\u0435\u043D\u0442\u043E\u0432\u0438\u0434\u043D\u0430\u044F,
    \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u043E\u0442 \u0440\u0443\u043A\u043E\u044F\u0442\u043A\u0438
    \u0433\u0440\u0443\u0434\u0438\u043D\u044B \u0432\u043C\u0435\u0441\u0442\u0435
    \u0441 \u043E\u0434\u043D\u043E\u0438\u043C\u0451\u043D\u043D\u043E\u0439 \u043C\u044B\u0448\u0446\u0435\u0439
    \u0434\u0440\u0443\u0433\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B,
    \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u0441 \u043D\u0435\u0439 \u043F\u043E
    \u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
    \u0448\u0435\u0438 \u0438 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u0442\u0435\u043B\u0435 \u043F\u043E\u0434\u044A\u044F\u0437\u044B\u0447\u043D\u043E\u0439
    \u043A\u043E\u0441\u0442\u0438.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F \u2013
    \u043E\u0442\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442 \u043F\u043E\u0434\u044A\u044F\u0437\u044B\u0447\u043D\u0443\u044E
    \u043A\u043E\u0441\u0442\u044C \u043D\u0430\u0437\u0430\u0434"
