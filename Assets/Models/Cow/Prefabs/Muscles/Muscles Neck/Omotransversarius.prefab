  systemType: 1
  meshRenderers:
  - {fileID: 1382461662400395252}
  - {fileID: 8459387153459572853}
  cameraDistanceLimitsMultiplier: 1
  info: {fileID: 0}
  partName: "\u041F\u043B\u0435\u0447\u0435\u0430\u0442\u043B\u0430\u043D\u0442\u043D\u0430\u044F
    \u043C\u044B\u0448\u0446\u0430"
  partScientificName: musculus omotransversarius
  partDescription: "\u0421\u043B\u0430\u0431\u043E \u0440\u0430\u0437\u0432\u0438\u0442\u0430
    \u0443 \u0436\u0432\u0430\u0447\u043D\u044B\u0445, \u0438\u043C\u0435\u0435\u0442
    \u043F\u043B\u043E\u0441\u043A\u0443\u044E, \u043B\u0435\u043D\u0442\u043E\u0432\u0438\u0434\u043D\u0443\u044E
    \u0444\u043E\u0440\u043C\u0443 \u0438 \u043D\u0430 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C
    \u043F\u0440\u043E\u0442\u044F\u0436\u0435\u043D\u0438\u0438 \u043F\u0440\u0438\u043A\u0440\u044B\u0442\u0430
    \u043F\u043B\u0435\u0447\u0435\u0433\u043E\u043B\u043E\u0432\u043D\u043E\u0439
    \u043C\u044B\u0448\u0446\u0435\u0439. \u0421\u0432\u043E\u0438\u043C \u0434\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C
    \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u0438\u0435\u043C \u043E\u043D\u0430
    \u043A\u0440\u0435\u043F\u0438\u0442\u0441\u044F \u043D\u0430 \u0430\u043A\u0440\u043E\u043C\u0438\u043E\u043D\u0435,
    \u0430 \u043F\u0440\u043E\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u043C
    \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u043A\u0440\u044B\u043B\u0435 \u0430\u0442\u043B\u0430\u043D\u0442\u0430.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F
    \u2013 \u043F\u0440\u0438 \u043E\u0434\u043D\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0435\u043C
    \u0441\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u0438\u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u0441\u0442\u0432\u0443\u0435\u0442
    \u0431\u043E\u043A\u043E\u0432\u043E\u043C\u0443 \u0438\u0437\u0433\u0438\u0431\u0443
    \u0448\u0435\u0438 \u0438 \u0432\u044B\u043D\u043E\u0441\u0443 \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u0438
    \u0432\u043F\u0435\u0440\u0451\u0434, \u0430 \u043F\u0440\u0438 \u0434\u0432\u0443\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0435\u043C
    \u2013 \u043E\u043F\u0443\u0441\u043A\u0430\u043D\u0438\u044E \u0433\u043E\u043B\u043E\u0432\u044B"
  partListButton: {fileID: 0}
  bodyPartGroup: {fileID: 0}
