  m_Script: {fileID: 11500000, guid: 27d7729a6b4a3fd4a8c08838916fac4f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.BodyPartInfo
  systemType: 1
  meshRenderers:
  - {fileID: 4670977828133822269}
  - {fileID: 8780113908326961018}
  cameraDistanceLimitsMultiplier: 1
  info: {fileID: 0}
  sagittalType: 0
  partName: "\u0422\u0440\u0430\u043F\u0435\u0446\u0438\u0435\u0432\u0438\u0434\u043D\u0430\u044F
    \u043C\u044B\u0448\u0446\u0430"
  partScientificName: musculus trapezius
  partDescription: "\u0420\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442\u0441\u044F
    \u043D\u0435\u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u043E
    \u043F\u043E\u0434 \u043A\u043E\u0436\u0435\u0439 \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438
    \u0448\u0435\u0438 \u0438 \u0445\u043E\u043B\u043A\u0438. \u041E\u043D\u0430
    \u0442\u043E\u043D\u043A\u0430\u044F, \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0447\u0430\u0442\u0430\u044F
    \u0438 \u0438\u043C\u0435\u0435\u0442 \u0444\u043E\u0440\u043C\u0443 \u0440\u0430\u0437\u043D\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0435\u0433\u043E
    \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u0438\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0441\u0432\u043E\u0438\u043C \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0435\u043C
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D \u043A \u0434\u043E\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0439
    \u0441\u0440\u0435\u0434\u0438\u043D\u043D\u043E\u0439 \u043B\u0438\u043D\u0438\u0438,
    \u0430 \u0432\u0435\u0440\u0448\u0438\u043D\u043E\u0439 \u2013 \u043A \u043E\u0441\u0442\u0438
    \u043B\u043E\u043F\u0430\u0442\u043A\u0438. \u0412 \u043C\u044B\u0448\u0446\u0435
    \u0440\u0430\u0437\u043B\u0438\u0447\u0430\u044E\u0442 \u0448\u0435\u0439\u043D\u0443\u044E
    \u0438 \u0433\u0440\u0443\u0434\u043D\u0443\u044E \u0447\u0430\u0441\u0442\u0438.\n\u0428\u0435\u0439\u043D\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C \u2013 pars cervicalis \u2013 \u0441\u0432\u043E\u0438\u043C
    \u0448\u0438\u0440\u043E\u043A\u0438\u043C \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u044C\u043D\u044B\u043C
    \u043A\u0440\u0430\u0435\u043C \u0431\u0435\u0440\u0451\u0442 \u043D\u0430\u0447\u0430\u043B\u043E
    \u043E\u0442 \u043A\u0430\u043D\u0430\u0442\u0438\u043A\u0430 \u0432\u044B\u0439\u043D\u043E\u0439
    \u0441\u0432\u044F\u0437\u043A\u0438 \u0438 \u043E\u0442 \u0443\u0440\u043E\u0432\u043D\u044F
    2-\u0433\u043E \u0448\u0435\u0439\u043D\u043E\u0433\u043E \u0438 \u0434\u043E
    3-\u0433\u043E \u0433\u0440\u0443\u0434\u043D\u043E\u0433\u043E \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u0430.
    \u041C\u044B\u0448\u0435\u0447\u043D\u044B\u0435 \u043F\u0443\u0447\u043A\u0438,
    \u043A\u043E\u043D\u0432\u0435\u0440\u0433\u0438\u0440\u0443\u044F \u0432\u0435\u043D\u0442\u0440\u043E\u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u043E,
    \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F
    \u0432\u0434\u043E\u043B\u044C \u0432\u0441\u0435\u0433\u043E \u043A\u0440\u0430\u043D\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043A\u0440\u0430\u044F \u043E\u0441\u0442\u0438 \u043B\u043E\u043F\u0430\u0442\u043A\u0438.\n\u0413\u0440\u0443\u0434\u043D\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C \u2013 pars thoracica \u2013 \u0431\u043E\u043B\u0435\u0435
    \u043C\u044F\u0441\u0438\u0441\u0442\u0430, \u043A\u043E\u0440\u043E\u0447\u0435
    \u0438 \u0443\u0436\u0435 \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0435\u0439.
    \u041E\u043D\u0430 \u043F\u0440\u0438\u043A\u0440\u0435\u043F\u043B\u044F\u0435\u0442\u0441\u044F
    \u043D\u0430 \u043D\u0430\u0434\u043E\u0441\u0442\u0438\u0441\u0442\u043E\u0439
    \u0441\u0432\u044F\u0437\u043A\u0435 \u0432 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u0445
    \u043E\u0442 3-\u0433\u043E \u0434\u043E 10-\u0433\u043E \u0433\u0440\u0443\u0434\u043D\u044B\u0445
    \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u043E\u0432.\n\u041C\u044B\u0448\u0435\u0447\u043D\u044B\u0435
    \u043F\u0443\u0447\u043A\u0438, \u043A\u043E\u043D\u0432\u0435\u0440\u0433\u0438\u0440\u0443\u044F
    \u0432 \u0432\u0435\u043D\u0442\u0440\u043E\u043A\u0440\u0430\u043D\u0438\u0430\u043B\u044C\u043D\u043E\u043C
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438, \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F
    \u043D\u0430 \u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u043E\u043C \u043A\u0440\u0430\u0435
    \u0434\u043E\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0439 \u0442\u0440\u0435\u0442\u0438
    \u043E\u0441\u0442\u0438 \u043B\u043E\u043F\u0430\u0442\u043A\u0438.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F
    \u2013 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442
    \u0443\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435 \u043B\u043E\u043F\u0430\u0442\u043A\u0438
    \u043D\u0430 \u0442\u0443\u043B\u043E\u0432\u0438\u0449\u0435. \u041F\u0440\u0438
    \u043E\u0434\u043D\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0435\u043C
    \u0441\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u0438\u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u0441\u0442\u0432\u0443\u0435\u0442
    \u0438\u0437\u0433\u0438\u0431\u0430\u043C \u0448\u0435\u0438 \u0438 \u0432\u044B\u043D\u043E\u0441\u0443
    \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u0438 \u0432\u043F\u0435\u0440\u0451\u0434;
    \u043F\u0440\u0438 \u0434\u0432\u0443\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0435\u043C
    \u0441\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u0438\u0438 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0435\u0442
    \u043E\u043F\u0443\u0441\u043A\u0430\u043D\u0438\u0435 \u0442\u0443\u043B\u043E\u0432\u0438\u0449\u0430
    \u043C\u0435\u0436\u0434\u0443 \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u044F\u043C\u0438"
