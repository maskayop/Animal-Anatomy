  info: {fileID: 11400000, guid: 7730a0421e9b9994ba8209ad3df06385, type: 2}
  partName: "\u041F\u043B\u0435\u0447\u0435\u043F\u043E\u0434\u044A\u044F\u0437\u044B\u0447\u043D\u0430\u044F
    \u043C\u044B\u0448\u0446\u0430"
  partScientificName: musculus omohyoideus
  partDescription: "\u041B\u0435\u043D\u0442\u043E\u0432\u0438\u0434\u043D\u043E\u0439
    \u0444\u043E\u0440\u043C\u044B. \u041D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
    \u043E\u0442 \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0439 \u0444\u0430\u0441\u0446\u0438\u0438
    \u0448\u0435\u0438 \u043D\u0430 \u0443\u0440\u043E\u0432\u043D\u0435 3-\u0433\u043E
    (5-\u0433\u043E) \u0448\u0435\u0439\u043D\u043E\u0433\u043E \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u0430
    \u0438 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u0442\u0435\u043B\u0435 \u043F\u043E\u0434\u044A\u044F\u0437\u044B\u0447\u043D\u043E\u0439
    \u043A\u043E\u0441\u0442\u0438.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F \u2013
    \u043E\u0442\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442 \u043F\u043E\u0434\u044A\u044F\u0437\u044B\u0447\u043D\u0443\u044E
    \u043A\u043E\u0441\u0442\u044C \u043D\u0430\u0437\u0430\u0434"
  partListButton: {fileID: 0}
  bodyPartGroup: {fileID: 0}
