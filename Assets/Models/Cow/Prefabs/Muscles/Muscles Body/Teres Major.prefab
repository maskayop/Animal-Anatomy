  cameraDistanceLimitsMultiplier: 1
  info: {fileID: 0}
  sagittalType: 0
  partName: "\u0411\u043E\u043B\u044C\u0448\u0430\u044F \u043A\u0440\u0443\u0433\u043B\u0430\u044F
    \u043C\u044B\u0448\u0446\u0430"
  partScientificName: musculus teres major
  partDescription: "\u0412\u044B\u0442\u044F\u043D\u0443\u0442\u043E\u0439, \u0440\u044B\u0431\u043E\u0432\u0438\u0434\u043D\u043E\u0439
    \u0444\u043E\u0440\u043C\u044B, \u043E\u0434\u043D\u043E\u043F\u0435\u0440\u0438\u0441\u0442\u043E\u0433\u043E
    \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F. \u041E\u043D\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
    \u043E\u0442 \u043F\u0440\u043E\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0439
    \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u044B \u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043A\u0440\u0430\u044F \u043B\u043E\u043F\u0430\u0442\u043A\u0438, \u0433\u0434\u0435
    \u0442\u0435\u0441\u043D\u043E \u0441\u0440\u0430\u0441\u0442\u0430\u0435\u0442\u0441\u044F
    \u0441 \u043F\u043E\u0434\u043B\u043E\u043F\u0430\u0442\u043E\u0447\u043D\u043E\u0439
    \u043C\u044B\u0448\u0446\u0435\u0439, \u0430 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043A\u0440\u0443\u0433\u043B\u043E\u0439
    \u0448\u0435\u0440\u043E\u0445\u043E\u0432\u0430\u0442\u043E\u0441\u0442\u0438
    \u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u043E\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
    \u043F\u043B\u0435\u0447\u0435\u0432\u043E\u0439 \u043A\u043E\u0441\u0442\u0438
    \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u0438\u0435\u043C
    \u0448\u0438\u0440\u043E\u0447\u0430\u0439\u0448\u0435\u0439 \u043C\u044B\u0448\u0446\u044B
    \u0441\u043F\u0438\u043D\u044B.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F \u2013
    \u0441\u0433\u0438\u0431\u0430\u0435\u0442 \u0438 \u043F\u0440\u043E\u043D\u0438\u0440\u0443\u0435\u0442
    \u043F\u043B\u0435\u0447\u0435\u0432\u043E\u0439 \u0441\u0443\u0441\u0442\u0430\u0432"
  partListButton: {fileID: 0}
  bodyPartGroup: {fileID: 0}
