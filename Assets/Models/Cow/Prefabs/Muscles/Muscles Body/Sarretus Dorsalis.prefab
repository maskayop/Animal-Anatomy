  cameraDistanceLimitsMultiplier: 1
  info: {fileID: 11400000, guid: 0259e20257a56b04c834ec80dfaf9ad2, type: 2}
  partName: "\u041A\u0440\u0430\u043D\u0438\u0430\u043B\u044C\u043D\u0430\u044F \u0434\u043E\u0440\u0441\u0430\u043B\u044C\u043D\u0430\u044F
    \u0437\u0443\u0431\u0447\u0430\u0442\u0430\u044F \u043C\u044B\u0448\u0446\u0430"
  partScientificName: musculus serratus dorsalis cranialis
  partDescription: "\u0422\u043E\u043D\u043A\u0430\u044F, \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0447\u0430\u0442\u0430\u044F,
    \u0448\u0438\u0440\u043E\u043A\u0430\u044F \u043C\u044B\u0448\u0446\u0430. \u041E\u043D\u0430
    \u0431\u0435\u0440\u0451\u0442 \u043D\u0430\u0447\u0430\u043B\u043E \u0442\u043E\u043D\u043A\u0438\u043C
    \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u044C\u043D\u044B\u043C \u0430\u043F\u043E\u043D\u0435\u0432\u0440\u043E\u0437\u043E\u043C
    \u043E\u0442 \u043D\u0430\u0434\u043E\u0441\u0442\u0438\u0441\u0442\u043E\u0439
    \u0441\u0432\u044F\u0437\u043A\u0438 \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438
    \u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435 \u0432\u044B\u0441\u043E\u043A\u0438\u0445
    \u043E\u0441\u0442\u0438\u0441\u0442\u044B\u0445 \u043E\u0442\u0440\u043E\u0441\u0442\u043A\u043E\u0432
    \u043F\u0435\u0440\u0435\u0434\u043D\u0438\u0445 \u0433\u0440\u0443\u0434\u043D\u044B\u0445
    \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u043E\u0432 \u0438, \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u044F\u0441\u044C
    \u043A\u0430\u0443\u0434\u043E\u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E,
    \u0437\u0430\u043A\u0440\u0435\u043F\u043B\u044F\u0435\u0442\u0441\u044F \u043C\u044B\u0448\u0435\u0447\u043D\u044B\u043C\u0438
    \u0437\u0443\u0431\u0446\u0430\u043C\u0438 \u043D\u0430 \u043A\u0440\u0430\u043D\u0438\u0430\u043B\u044C\u043D\u044B\u0445
    \u043A\u0440\u0430\u044F\u0445 \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u0442\u0440\u0435\u0442\u0438
    \u0440\u0451\u0431\u0435\u0440 \u0432 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u0445
    \u0441 5-\u0433\u043E \u043F\u043E 8 (9)-\u0435"
  partListButton: {fileID: 0}
  bodyPartGroup: {fileID: 0}
