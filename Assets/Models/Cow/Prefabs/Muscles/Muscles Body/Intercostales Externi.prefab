  cameraDistanceLimitsMultiplier: 1
  info: {fileID: 11400000, guid: 1ca9300f86951ae48bbc0ff3bdacec2e, type: 2}
  partName: "\u041D\u0430\u0440\u0443\u0436\u043D\u044B\u0435 \u043C\u0435\u0436\u0440\u0451\u0431\u0435\u0440\u043D\u044B\u0435
    \u043C\u044B\u0448\u0446\u044B"
  partScientificName: musculi intercostales externi
  partDescription: "\u0420\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u044E\u0442\u0441\u044F
    \u0432 \u043C\u0435\u0436\u0440\u0451\u0431\u0435\u0440\u043D\u044B\u0445 \u043F\u0440\u043E\u043C\u0435\u0436\u0443\u0442\u043A\u0430\u0445
    \u043F\u043E\u0434 \u0437\u0443\u0431\u0447\u0430\u0442\u044B\u043C\u0438, \u0448\u0438\u0440\u043E\u0447\u0430\u0439\u0448\u0435\u0439
    \u0438 \u043D\u0430\u0440\u0443\u0436\u043D\u043E\u0439 \u043A\u043E\u0441\u043E\u0439
    \u043C\u044B\u0448\u0446\u0435\u0439 \u0436\u0438\u0432\u043E\u0442\u0430. \u041E\u043D\u0438
    \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442\u0441\u044F \u043C\u044B\u0448\u0435\u0447\u043D\u044B\u043C\u0438
    \u043F\u0443\u0447\u043A\u0430\u043C\u0438 \u043E\u0442 \u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u044B\u0445
    \u043A\u0440\u0430\u0451\u0432 \u0440\u0451\u0431\u0435\u0440, \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0442\u0441\u044F
    \u0432\u0435\u043D\u0442\u0440\u043E\u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u043E
    \u0438 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F
    \u043D\u0430 \u043A\u0440\u0430\u043D\u0438\u0430\u043B\u044C\u043D\u044B\u0445
    \u043A\u0440\u0430\u044F\u0445 \u0441\u0437\u0430\u0434\u0438 \u043B\u0435\u0436\u0430\u0449\u0438\u0445
    \u0440\u0451\u0431\u0435\u0440. \u041C\u0435\u0436\u0434\u0443 \u0440\u0451\u0431\u0435\u0440\u043D\u044B\u043C\u0438
    \u0445\u0440\u044F\u0449\u0430\u043C\u0438 \u0438\u0445 \u043D\u0435\u0442"
  partListButton: {fileID: 0}
  bodyPartGroup: {fileID: 0}
