  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 27d7729a6b4a3fd4a8c08838916fac4f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.BodyPartInfo
  systemType: 1
  meshRenderers:
  - {fileID: 8214054548801450657}
  - {fileID: 3166002631534663320}
  cameraDistanceLimitsMultiplier: 1
  info: {fileID: 11400000, guid: b2da8d962708306488fa2ce686984198, type: 2}
  partName: "\u0412\u044B\u0439\u043D\u0430\u044F \u0441\u0432\u044F\u0437\u043A\u0430"
  partScientificName: ligamentum supraspinale
  partDescription: "\u041F\u0430\u0440\u043D\u0430\u044F, \u043F\u043E\u0434\u0440\u0430\u0437\u0434\u0435\u043B\u044F\u0435\u0442\u0441\u044F
    \u043D\u0430 \u043A\u0430\u043D\u0430\u0442\u0438\u043A \u0438 \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u043A\u0443.\n\u041A\u0430\u043D\u0430\u0442\u0438\u043A
    \u0432\u044B\u0439\u043D\u043E\u0439 \u0441\u0432\u044F\u0437\u043A\u0438 \u2013
    funi\u0441ulus nuche \u2013 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    \u0441\u043E\u0431\u043E\u0439 \u043F\u0430\u0440\u043D\u044B\u0439 \u044D\u043B\u0430\u0441\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0442\u044F\u0436, \u0431\u0435\u0440\u0443\u0449\u0438\u0439 \u043D\u0430\u0447\u0430\u043B\u043E
    \u043E\u0442 \u0432\u0435\u0440\u0448\u0438\u043D\u044B \u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435
    \u0432\u044B\u0441\u043E\u043A\u043E\u0433\u043E \u043E\u0441\u0442\u0438\u0441\u0442\u043E\u0433\u043E
    \u043E\u0442\u0440\u043E\u0441\u0442\u043A\u0430 \u043E\u0434\u043D\u043E\u0433\u043E
    \u0438\u0437 \u043F\u0435\u0440\u0432\u044B\u0445 \u0433\u0440\u0443\u0434\u043D\u044B\u0445
    \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u043E\u0432, \u0430 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u0447\u0435\u0448\u0443\u0435 \u0437\u0430\u0442\u044B\u043B\u043E\u0447\u043D\u043E\u0439
    \u043A\u043E\u0441\u0442\u0438.\n\u0423 \u0436\u0432\u0430\u0447\u043D\u044B\u0445
    \u043A\u0430\u043D\u0430\u0442\u0438\u043A \u0432 \u0432\u0438\u0434\u0435 \u0434\u0432\u0443\u0445
    \u0442\u044F\u0436\u0435\u0439 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
    \u043E\u0442 \u043D\u0430\u0440\u0443\u0436\u043D\u043E\u0433\u043E \u0437\u0430\u0442\u044B\u043B\u043E\u0447\u043D\u043E\u0433\u043E
    \u043F\u0440\u0435\u0434\u0431\u0443\u0433\u043E\u0440\u044C\u044F \u0438 \u0432
    \u043E\u0431\u043B\u0430\u0441\u0442\u0438 \u0445\u043E\u043B\u043A\u0438, \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u0440\u0430\u0441\u0448\u0438\u0440\u044F\u044F\u0441\u044C \u0438 \u0443\u0442\u043E\u043B\u0449\u0430\u044F\u0441\u044C,
    \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u0432\u0434\u043E\u043B\u044C
    \u043F\u0435\u0440\u0432\u044B\u0445 \u0433\u0440\u0443\u0434\u043D\u044B\u0445
    \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u043E\u0432, \u0430 \u0437\u0430\u0442\u0435\u043C,
    \u0441\u0443\u0436\u0438\u0432\u0430\u044F\u0441\u044C \u0438 \u0441\u0431\u043B\u0438\u0436\u0430\u044F\u0441\u044C,
    \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0445
    \u0433\u0440\u0443\u0434\u043D\u044B\u0445 \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u043E\u0432
    \u0442\u044F\u0436\u0438 \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u044E\u0442\u0441\u044F
    \u043C\u0435\u0436\u0434\u0443 \u0441\u043E\u0431\u043E\u0439 \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u044E\u0442\u0441\u044F
    \u043A\u0430\u043A \u0438\u0441\u0442\u0438\u043D\u043D\u0430\u044F \u043D\u0430\u0434\u043E\u0441\u0442\u0438\u0441\u0442\u0430\u044F
    \u0441\u0432\u044F\u0437\u043A\u0430.\n\u041F\u043B\u0430\u0441\u0442\u0438\u043D\u043A\u0430
    \u0432\u044B\u0439\u043D\u043E\u0439 \u0441\u0432\u044F\u0437\u043A\u0438 \u2013
    lamina nuchae \u2013 \u043F\u0430\u0440\u043D\u0430\u044F, \u0431\u0435\u0440\u0451\u0442
    \u043D\u0430\u0447\u0430\u043B\u043E \u0448\u0438\u0440\u043E\u043A\u0438\u043C\u0438
    \u0437\u0443\u0431\u0446\u0430\u043C\u0438 \u043E\u0442 \u043E\u0441\u0442\u0438\u0441\u0442\u044B\u0445
    \u043E\u0442\u0440\u043E\u0441\u0442\u043A\u043E\u0432 \u0432\u0441\u0435\u0445
    \u0448\u0435\u0439\u043D\u044B\u0445 (\u043A\u0440\u043E\u043C\u0435 \u043F\u0435\u0440\u0432\u043E\u0433\u043E)
    \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u043E\u0432. \u041E\u0442 \u043F\u0435\u0440\u0432\u044B\u0445
    \u043F\u044F\u0442\u0438 \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u043E\u0432
    \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0447\u0430\u0442\u0430\u044F \u0447\u0430\u0441\u0442\u044C
    \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u043A\u0430\u043D\u0430\u0442\u0438\u043A\u0435 \u0432\u044B\u0439\u043D\u043E\u0439
    \u0441\u0432\u044F\u0437\u043A\u0438, \u0430 \u043E\u0442 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0445
    \u0434\u0432\u0443\u0445-\u0442\u0440\u0451\u0445 \u2013 \u043D\u0430 \u043E\u0441\u0442\u0438\u0441\u0442\u044B\u0445
    \u043E\u0442\u0440\u043E\u0441\u0442\u043A\u0430\u0445 1-\u0433\u043E \u0433\u0440\u0443\u0434\u043D\u044B\u0445
    \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u043E\u0432"
  partListButton: {fileID: 0}
  bodyPartGroup: {fileID: 0}
