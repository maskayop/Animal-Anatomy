  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.BodyPartInfo
  systemType: 1
  meshRenderers:
  - {fileID: 662362035194632363}
  - {fileID: 6679156554643449379}
  cameraDistanceLimitsMultiplier: 1
  info: {fileID: 0}
  sagittalType: 0
  partName: "\u041C\u0430\u043B\u0430\u044F \u043A\u0440\u0443\u0433\u043B\u0430\u044F
    \u043C\u044B\u0448\u0446\u0430"
  partScientificName: musculus teres minor
  partDescription: "\u0414\u0432\u0443\u043F\u0435\u0440\u0438\u0441\u0442\u0430\u044F,
    \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043A\u0430\u0443\u0434\u043E\u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u043E
    \u043E\u0442 \u0437\u0430\u043E\u0441\u0442\u043D\u043E\u0439 \u043C\u044B\u0448\u0446\u044B
    \u0438 \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E \u043F\u0440\u0438\u043A\u0440\u044B\u0442\u0430
    \u0435\u044E. \u041E\u043D\u0430 \u0431\u0435\u0440\u0451\u0442 \u043D\u0430\u0447\u0430\u043B\u043E
    \u043E\u0442 \u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043A\u0440\u0430\u044F \u043D\u0438\u0436\u043D\u0435\u0439 \u0442\u0440\u0435\u0442\u0438
    \u043B\u043E\u043F\u0430\u0442\u043A\u0438 \u0438 \u043D\u0430 \u043F\u0440\u043E\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u043C
    \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u0438\u0438 \u0442\u0440\u0451\u0445\u0433\u043B\u0430\u0432\u043E\u0439
    \u043C\u044B\u0448\u0446\u044B \u043F\u043B\u0435\u0447\u0430, \u0430 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u043C \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u0438\u0435\u043C
    \u043C\u0435\u0436\u0434\u0443 \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u0438\u044F\u043C\u0438
    \u0434\u0435\u043B\u044C\u0442\u043E\u0432\u0438\u0434\u043D\u043E\u0439 \u0438
    \u0437\u0430\u043E\u0441\u0442\u043D\u043E\u0439 \u043C\u044B\u0448\u0446 \u0432\u043F\u0435\u0440\u0435\u0434\u0438
    \u043E\u0442 \u043B\u0438\u043D\u0438\u0438 \u0442\u0440\u0451\u0445\u0433\u043B\u0430\u0432\u043E\u0439
    \u043C\u044B\u0448\u0446\u044B \u043F\u043B\u0435\u0447\u0430. \u041F\u043E\u0434
    \u0435\u0451 \u0434\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u0438\u0435\u043C
    \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043F\u043E\u0434\u0441\u0443\u0445\u043E\u0436\u0438\u043B\u044C\u043D\u0430\u044F
    \u0431\u0443\u0440\u0441\u0430 (b. subtendinea m. teretis minoris).\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F
    \u2013 \u0441\u0433\u0438\u0431\u0430\u0435\u0442 \u043F\u043B\u0435\u0447\u0435\u0432\u043E\u0439
    \u0441\u0443\u0441\u0442\u0430\u0432"
  partListButton: {fileID: 0}
  bodyPartGroup: {fileID: 0}
