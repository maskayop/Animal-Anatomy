  cameraDistanceLimitsMultiplier: 1
  info: {fileID: 0}
  sagittalType: 0
  partName: "\u0420\u043E\u043C\u0431\u043E\u0432\u0438\u0434\u043D\u0430\u044F \u043C\u044B\u0448\u0446\u0430
    \u0448\u0435\u0438"
  partScientificName: musculus rhomboideus cervicis
  partDescription: "\u0420\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430\u0434 \u043F\u043B\u0430\u0441\u0442\u044B\u0440\u0435\u0432\u0438\u0434\u043D\u043E\u0439
    \u043C\u044B\u0448\u0446\u0435\u0439. \u041E\u043D\u0430 \u0431\u0435\u0440\u0451\u0442
    \u043D\u0430\u0447\u0430\u043B\u043E \u0443 \u0432\u0441\u0435\u0445 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445
    \u043E\u0442 \u043A\u0430\u043D\u0430\u0442\u0438\u043A\u0430 \u0432\u044B\u0439\u043D\u043E\u0439
    \u0441\u0432\u044F\u0437\u043A\u0438 \u043D\u0430 \u043F\u0440\u043E\u0442\u044F\u0436\u0435\u043D\u0438\u0438
    \u043E\u0442 2 \u2013 3-\u0433\u043E \u0448\u0435\u0439\u043D\u043E\u0433\u043E
    \u0434\u043E 2 \u2013 3-\u0433\u043E \u0433\u0440\u0443\u0434\u043D\u043E\u0433\u043E
    \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u0430 \u0438 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u043E\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
    \u043A\u0440\u0430\u043D\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0443\u0433\u043B\u0430
    \u043B\u043E\u043F\u0430\u0442\u043E\u0447\u043D\u043E\u0433\u043E \u0445\u0440\u044F\u0449\u0430.
    \u041F\u043E \u0441\u0432\u043E\u0435\u043C\u0443 \u0445\u043E\u0434\u0443 \u043C\u044B\u0448\u0435\u0447\u043D\u044B\u0435
    \u043F\u0443\u0447\u043A\u0438 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u044E\u0442
    \u043A\u0430\u0443\u0434\u043E\u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0435
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0438 \u043F\u043E\u0447\u0442\u0438
    \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u044C\u043D\u043E\u0435
    \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435"
