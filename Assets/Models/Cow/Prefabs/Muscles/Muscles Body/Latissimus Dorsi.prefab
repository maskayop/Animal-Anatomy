  m_Script: {fileID: 11500000, guid: 27d7729a6b4a3fd4a8c08838916fac4f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.BodyPartInfo
  systemType: 1
  meshRenderers:
  - {fileID: 8391681018418244710}
  - {fileID: 449350728629512363}
  cameraDistanceLimitsMultiplier: 1
  info: {fileID: 0}
  sagittalType: 0
  partName: "\u0428\u0438\u0440\u043E\u0447\u0430\u0439\u0448\u0430\u044F \u043C\u044B\u0448\u0446\u0430
    \u0441\u043F\u0438\u043D\u044B"
  partScientificName: musculus latissimus dorsi
  partDescription: "\u0428\u0438\u0440\u043E\u043A\u0430\u044F, \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u043E\u0439
    \u0444\u043E\u0440\u043C\u044B, \u0441\u0432\u043E\u0438\u043C \u0448\u0438\u0440\u043E\u043A\u0438\u043C
    \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0435\u043C \u0431\u0435\u0440\u0451\u0442
    \u043D\u0430\u0447\u0430\u043B\u043E \u043E\u0442 \u0433\u0440\u0443\u0434\u0438\u043D\u043E\u043F\u043E\u044F\u0441\u043D\u0438\u0447\u043D\u043E\u0439
    \u0444\u0430\u0441\u0446\u0438\u0438 \u0432 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u0445
    \u043E\u0442 5-\u0433\u043E \u0433\u0440\u0443\u0434\u043D\u043E\u0433\u043E
    \u0438 \u0434\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E
    \u043F\u043E\u044F\u0441\u043D\u0438\u0447\u043D\u043E\u0433\u043E \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u0430.
    \u0418\u043C\u0435\u0435\u0442\u0441\u044F \u0435\u0449\u0451 \u043F\u0440\u0438\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435
    \u0438 \u043D\u0430 \u0434\u0432\u0443\u0445 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0445
    \u0440\u0451\u0431\u0440\u0430\u0445.\n\u041A\u0430\u0443\u0434\u043E\u0434\u043E\u0440\u0441\u0430\u043B\u044C\u043D\u043E
    \u043C\u044B\u0448\u0446\u0430 \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E
    \u043F\u0440\u0438\u043A\u0440\u044B\u0442\u0430 \u043A\u043E\u0436\u043D\u043E\u0439
    \u043C\u044B\u0448\u0446\u0435\u0439 \u0442\u0443\u043B\u043E\u0432\u0438\u0449\u0430,
    \u0430 \u0434\u043E\u0440\u0441\u043E\u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E
    \u2013 \u0433\u0440\u0443\u0434\u043D\u043E\u0439 \u0447\u0430\u0441\u0442\u044C\u044E
    \u0442\u0440\u0430\u043F\u0435\u0446\u0438\u0435\u0432\u0438\u0434\u043D\u043E\u0439
    \u043C\u044B\u0448\u0446\u044B. \u041F\u0435\u0440\u0435\u043A\u0438\u0434\u044B\u0432\u0430\u044F\u0441\u044C
    \u0447\u0435\u0440\u0435\u0437 \u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u044B\u0439
    \u043A\u0440\u0430\u0439 \u043B\u043E\u043F\u0430\u0442\u043E\u0447\u043D\u043E\u0433\u043E
    \u0445\u0440\u044F\u0449\u0430, \u0448\u0438\u0440\u043E\u0447\u0430\u0439\u0448\u0430\u044F
    \u043C\u044B\u0448\u0446\u0430 \u0441\u043F\u0438\u043D\u044B, \u0441\u0443\u0436\u0438\u0432\u0430\u044F\u0441\u044C
    \u0432 \u043A\u0440\u0430\u043D\u0438\u043E\u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u043C
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438, \u0437\u0430\u0445\u043E\u0434\u0438\u0442
    \u043F\u043E\u0434 \u043B\u043E\u043F\u0430\u0442\u043A\u0443, \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0435\u0442\u0441\u044F
    \u0441 \u043A\u0430\u0443\u0434\u043E\u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u043C
    \u043A\u0440\u0430\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043A\u0440\u0443\u0433\u043B\u043E\u0439
    \u043C\u044B\u0448\u0446\u044B \u0438 \u0435\u0451 \u0434\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C
    \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u0438\u0435\u043C, \u0430 \u0437\u0430\u0442\u0435\u043C
    \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043A\u0440\u0443\u0433\u043B\u043E\u0439
    \u0448\u0435\u0440\u043E\u0445\u043E\u0432\u0430\u0442\u043E\u0441\u0442\u0438
    \u043F\u043B\u0435\u0447\u0435\u0432\u043E\u0439 \u043A\u043E\u0441\u0442\u0438.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F
    \u2013 \u043E\u0442\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0439
    \u043E\u0442\u0434\u0435\u043B \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u0438
    \u043D\u0430\u0437\u0430\u0434, \u0430 \u043F\u0440\u0438 \u043E\u043F\u043E\u0440\u043D\u043E\u0439
    \u043F\u043E\u0437\u0438\u0446\u0438\u0438 \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u0435\u0439
    \u043F\u043E\u0434\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442 \u0442\u0435\u043B\u043E
    \u0432\u043F\u0435\u0440\u0451\u0434"
  partListButton: {fileID: 0}
  bodyPartGroup: {fileID: 0}
