  - {fileID: 3281578000882993717}
  - {fileID: 7013037610161643743}
  - {fileID: 7845661294885010479}
  cameraDistanceLimitsMultiplier: 1
  info: {fileID: 0}
  sagittalType: 0
  partName: "\u0413\u043B\u0443\u0431\u043E\u043A\u0430\u044F (\u0432\u043E\u0441\u0445\u043E\u0434\u044F\u0449\u0430\u044F)
    \u0433\u0440\u0443\u0434\u043D\u0430\u044F \u043C\u044B\u0448\u0446\u0430"
  partScientificName: musculus pectoralis profundus (ascendens)
  partDescription: "\u041D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
    \u043E\u0442 \u0442\u0435\u043B\u0430 \u0433\u0440\u0443\u0434\u0438\u043D\u044B,
    \u0431\u0440\u044E\u0448\u043D\u043E\u0439 \u0444\u0430\u0441\u0446\u0438\u0438
    \u0438 \u0445\u0440\u044F\u0449\u0435\u0439 \u0438\u0441\u0442\u0438\u043D\u043D\u044B\u0445
    \u0440\u0451\u0431\u0435\u0440, \u0430 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u0431\u043E\u043B\u044C\u0448\u043E\u043C \u0438 \u043C\u0430\u043B\u043E\u043C
    \u0431\u0443\u0433\u043E\u0440\u043A\u0430\u0445 \u043F\u043B\u0435\u0447\u0435\u0432\u043E\u0439
    \u043A\u043E\u0441\u0442\u0438, \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E
    \u043D\u0430 \u0444\u0438\u0431\u0440\u043E\u0437\u043D\u043E\u043C \u0432\u043B\u0430\u0433\u0430\u043B\u0438\u0449\u0435
    \u043F\u0440\u043E\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u0438\u044F \u0434\u0432\u0443\u0433\u043B\u0430\u0432\u043E\u0439
    \u043C\u044B\u0448\u0446\u044B \u043F\u043B\u0435\u0447\u0430.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F
    \u2013 \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u043D\u044B\u043C
    \u0433\u0440\u0443\u0434\u043D\u044B\u043C \u043C\u044B\u0448\u0446\u0430\u043C"
  partListButton: {fileID: 0}
  bodyPartGroup: {fileID: 0}
