  sagittalType: 0
  partName: "\u0412\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u0430\u044F \u0437\u0443\u0431\u0447\u0430\u0442\u0430\u044F
    \u043C\u044B\u0448\u0446\u0430 \u0433\u0440\u0443\u0434\u0438"
  partScientificName: musculus serratus ventralis thoracis
  partDescription: "\u0411\u0435\u0440\u0451\u0442 \u043D\u0430\u0447\u0430\u043B\u043E
    \u043C\u044B\u0448\u0435\u0447\u043D\u044B\u043C\u0438 \u0437\u0443\u0431\u0446\u0430\u043C\u0438
    \u043D\u0430 \u043B\u0430\u0442\u0435\u0440\u0430\u043B\u044C\u043D\u043E\u0439
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u043F\u0435\u0440\u0432\u044B\u0445
    \u0434\u0435\u0432\u044F\u0442\u0438 \u0440\u0451\u0431\u0435\u0440 \u0438 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u043E\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
    \u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0443\u0433\u043B\u0430
    \u043B\u043E\u043F\u0430\u0442\u043A\u0438. \u041C\u0435\u0436\u0434\u0443 \u0437\u0443\u0431\u0446\u0430\u043C\u0438
    \u043D\u0430 \u0440\u0451\u0431\u0435\u0440\u043D\u043E\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
    \u0432\u043A\u043B\u0438\u043D\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u0437\u0443\u0431\u0446\u044B
    \u043D\u0430\u0440\u0443\u0436\u043D\u043E\u0439 \u043A\u043E\u0441\u043E\u0439
    \u043C\u044B\u0448\u0446\u044B \u0436\u0438\u0432\u043E\u0442\u0430. \u0421\u0432\u0435\u0440\u0445\u0443
    \u043C\u044B\u0448\u0446\u0430 \u043F\u043B\u043E\u0442\u043D\u043E \u0441\u0440\u0430\u0441\u0442\u0430\u0435\u0442\u0441\u044F
    \u0441 \u0437\u0443\u0431\u0447\u0430\u0442\u043E\u0439 \u0444\u0430\u0441\u0446\u0438\u0435\u0439.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F
    \u2013 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442
    \u0442\u0443\u043B\u043E\u0432\u0438\u0449\u0435 \u043C\u0435\u0436\u0434\u0443
    \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u044F\u043C\u0438"
