  cameraDistanceLimitsMultiplier: 1
  info: {fileID: 0}
  sagittalType: 0
  partName: "\u041F\u043E\u043F\u0435\u0440\u0435\u0447\u043D\u0430\u044F \u0433\u0440\u0443\u0434\u043D\u0430\u044F
    \u043C\u044B\u0448\u0446\u0430"
  partScientificName: musculus pectoralis transversus
  partDescription: "\u041D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
    \u043E\u0442 \u0442\u0435\u043B\u0430 \u0433\u0440\u0443\u0434\u0438\u043D\u044B
    \u0432 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u0445 \u043E\u0442 1-\u0433\u043E
    \u0434\u043E 6-\u0433\u043E \u0440\u0451\u0431\u0435\u0440\u043D\u043E\u0433\u043E
    \u0445\u0440\u044F\u0449\u0430 \u0438 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043D\u0438\u0436\u0435 \u043B\u043E\u043A\u0442\u0435\u0432\u043E\u0433\u043E
    \u0441\u0443\u0441\u0442\u0430\u0432\u0430 \u043D\u0430 \u0444\u0430\u0441\u0446\u0438\u0438
    \u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u043E\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
    \u043F\u0440\u0435\u0434\u043F\u043B\u0435\u0447\u044C\u044F.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F
    \u2013 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0430\u0434\u0434\u0443\u043A\u0442\u043E\u0440\u043E\u043C
    \u0433\u0440\u0443\u0434\u043D\u043E\u0439 \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u0438,
    \u0441\u043F\u043E\u0441\u043E\u0431\u0441\u0442\u0432\u0443\u0435\u0442 \u0432\u044B\u043D\u043E\u0441\u0443
    \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u0438 \u0432\u043F\u0435\u0440\u0451\u0434,
    \u0430 \u043F\u0440\u0438 \u043E\u043F\u043E\u0440\u043D\u043E\u0439 \u043F\u043E\u0437\u0438\u0446\u0438\u0438
    \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u0438 \u043F\u043E\u0434\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442
    \u0442\u0435\u043B\u043E \u0432\u043F\u0435\u0440\u0451\u0434"
  partListButton: {fileID: 0}
  bodyPartGroup: {fileID: 0}
