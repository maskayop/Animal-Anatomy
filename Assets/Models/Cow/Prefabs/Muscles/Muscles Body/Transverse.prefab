  systemType: 1
  meshRenderers:
  - {fileID: 5273812298503429703}
  - {fileID: 618831830021345811}
  cameraDistanceLimitsMultiplier: 1
  info: {fileID: 0}
  sagittalType: 0
  partName: "\u041D\u0438\u0441\u0445\u043E\u0434\u044F\u0449\u0430\u044F \u0433\u0440\u0443\u0434\u043D\u0430\u044F
    \u043C\u044B\u0448\u0446\u0430"
  partScientificName: musculus pectoralis descendens
  partDescription: "\u041C\u043E\u0449\u043D\u0430\u044F, \u0431\u0435\u0440\u0451\u0442
    \u043D\u0430\u0447\u0430\u043B\u043E \u043D\u0430 \u0440\u0443\u043A\u043E\u044F\u0442\u043A\u0435
    \u0433\u0440\u0443\u0434\u0438\u043D\u044B \u0438 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u0433\u0440\u0435\u0431\u043D\u0435 \u0431\u043E\u043B\u044C\u0448\u043E\u0433\u043E
    \u0431\u0443\u0433\u0440\u0430 \u043F\u043B\u0435\u0447\u0435\u0432\u043E\u0439
    \u043A\u043E\u0441\u0442\u0438. \u0421\u043E\u043F\u0440\u0438\u043A\u0430\u0441\u0430\u044F\u0441\u044C
    \u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u043E \u0441 \u043E\u0434\u043D\u043E\u0438\u043C\u0451\u043D\u043D\u043E\u0439
    \u043C\u044B\u0448\u0446\u0435\u0439 \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u043E\u043B\u043E\u0436\u043D\u043E\u0439
    \u0441\u0442\u043E\u0440\u043E\u043D\u044B, \u043E\u043D\u0430 \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0442
    \u0432 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0438 \u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439
    \u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u043E\u0439 \u043B\u0438\u043D\u0438\u0438
    (linea mediana ventralis).\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F \u2013
    \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0430\u0434\u0434\u0443\u043A\u0442\u043E\u0440\u043E\u043C
    \u0433\u0440\u0443\u0434\u043D\u043E\u0439 \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u0438,
    \u0441\u043F\u043E\u0441\u043E\u0431\u0441\u0442\u0432\u0443\u0435\u0442 \u0432\u044B\u043D\u043E\u0441\u0443
    \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u0438 \u0432\u043F\u0435\u0440\u0451\u0434,
    \u0430 \u043F\u0440\u0438 \u043E\u043F\u043E\u0440\u043D\u043E\u0439 \u043F\u043E\u0437\u0438\u0446\u0438\u0438
    \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u0438 \u043F\u043E\u0434\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442
    \u0442\u0435\u043B\u043E \u0432\u043F\u0435\u0440\u0451\u0434"
  partListButton: {fileID: 0}
  bodyPartGroup: {fileID: 0}
