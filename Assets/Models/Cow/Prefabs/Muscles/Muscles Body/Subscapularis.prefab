  systemType: 1
  meshRenderers:
  - {fileID: 5091522943457298747}
  - {fileID: 3868103489733958556}
  cameraDistanceLimitsMultiplier: 1
  info: {fileID: 0}
  sagittalType: 0
  partName: "\u041F\u043E\u0434\u043B\u043E\u043F\u0430\u0442\u043E\u0447\u043D\u0430\u044F
    \u043C\u044B\u0448\u0446\u0430"
  partScientificName: musculus subscapularis
  partDescription: "\u041C\u043D\u043E\u0433\u043E\u043F\u0435\u0440\u0438\u0441\u0442\u0430\u044F,
    \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u0435\u0442 \u0432\u0441\u044E \u043F\u043E\u0434\u043B\u043E\u043F\u0430\u0442\u043E\u0447\u043D\u0443\u044E
    \u044F\u043C\u043A\u0443 \u0438 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u043E\u043C \u043C\u044B\u0448\u0435\u0447\u043D\u043E\u043C
    \u0431\u0443\u0433\u0440\u0435 \u043F\u043B\u0435\u0447\u0435\u0432\u043E\u0439
    \u043A\u043E\u0441\u0442\u0438, \u0438\u043C\u0435\u044F \u043F\u043E\u0434 \u0441\u043E\u0431\u043E\u0439
    \u043F\u043E\u0434\u0441\u0443\u0445\u043E\u0436\u0438\u043B\u044C\u043D\u0443\u044E
    \u0431\u0443\u0440\u0441\u0443 (b. subtendinea m. subscapularis). \u0421\u043F\u0435\u0440\u0435\u0434\u0438
    \u043C\u044B\u0448\u0446\u0430 \u0433\u0440\u0430\u043D\u0438\u0447\u0438\u0442
    \u0441 \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u043D\u043E\u0439, \u0430 \u0441\u0437\u0430\u0434\u0438
    \u2013 \u0441 \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043A\u0440\u0443\u0433\u043B\u043E\u0439
    \u043C\u044B\u0448\u0446\u0430\u043C\u0438.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F
    \u2013 \u0430\u0434\u0434\u0443\u043A\u0442\u043E\u0440 \u043F\u043B\u0435\u0447\u0435\u0432\u043E\u0433\u043E
    \u0441\u0443\u0441\u0442\u0430\u0432\u0430; \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u0442
    \u0440\u043E\u043B\u044C \u0435\u0433\u043E \u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u043E\u0439
    \u0441\u0432\u044F\u0437\u043A\u0438"
  partListButton: {fileID: 0}
  bodyPartGroup: {fileID: 0}
