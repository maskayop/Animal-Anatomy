  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.BodyPartInfo
  systemType: 1
  meshRenderers:
  - {fileID: 7167147344781279812}
  - {fileID: 380851457344908727}
  - {fileID: 2821783429601372491}
  cameraDistanceLimitsMultiplier: 1
  info: {fileID: 0}
  partName: "\u041A\u043E\u0440\u0430\u043A\u043E\u0438\u0434\u043D\u043E-\u043F\u043B\u0435\u0447\u0435\u0432\u0430\u044F
    \u043C\u044B\u0448\u0446\u0430"
  partScientificName: musculus coracobrachialis
  partDescription: "\u0423\u0437\u043A\u0438\u043C, \u0434\u043B\u0438\u043D\u043D\u044B\u043C
    \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u0438\u0435\u043C \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
    \u043E\u0442 \u043A\u043E\u0440\u0430\u043A\u043E\u0438\u0434\u043D\u043E\u0433\u043E
    \u043E\u0442\u0440\u043E\u0441\u0442\u043A\u0430 \u043B\u043E\u043F\u0430\u0442\u043A\u0438,
    \u043F\u0435\u0440\u0435\u0441\u0435\u043A\u0430\u0435\u0442 \u0434\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435
    \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u0438\u0435 \u043F\u043E\u0434\u043B\u043E\u043F\u0430\u0442\u043E\u0447\u043D\u043E\u0439
    \u043C\u044B\u0448\u0446\u044B \u0438, \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044F
    \u0432 \u043C\u044B\u0448\u0435\u0447\u043D\u043E\u0435 \u0431\u0440\u044E\u0448\u043A\u043E
    \u0434\u0432\u0443\u043F\u0435\u0440\u0438\u0441\u0442\u043E\u0433\u043E \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F,
    \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u043A\u0440\u0430\u043D\u0438\u043E\u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u043E\u0439
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u0432\u0435\u0440\u0445\u043D\u0435\u0439
    \u0442\u0440\u0435\u0442\u0438 \u043F\u043B\u0435\u0447\u0435\u0432\u043E\u0439
    \u043A\u043E\u0441\u0442\u0438. \u041F\u043E\u0434 \u043F\u0440\u043E\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u043C
    \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u0438\u0435\u043C \u0438\u043C\u0435\u0435\u0442\u0441\u044F
    \u043F\u043E\u0434\u0441\u0443\u0445\u043E\u0436\u0438\u043B\u044C\u043D\u0430\u044F
    \u0431\u0443\u0440\u0441\u0430 (b. subtendinea m. coracobrachialis). \u0423 \u043A\u043E\u043F\u044B\u0442\u043D\u044B\u0445
    \u043C\u044B\u0448\u0435\u0447\u043D\u043E\u0435 \u0431\u0440\u044E\u0448\u043A\u043E
    \u0438\u043C\u0435\u0435\u0442 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u0440\u0430\u0437\u043C\u0435\u0440\u044B \u0438 \u0441\u0432\u043E\u0438\u043C
    \u0434\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C \u043A\u0440\u0430\u0435\u043C
    \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0435\u0442 \u043D\u0438\u0436\u043D\u0435\u0439
    \u0442\u0440\u0435\u0442\u0438 \u043F\u043B\u0435\u0447\u0435\u0432\u043E\u0439
    \u043A\u043E\u0441\u0442\u0438.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F \u2013
    \u0430\u0434\u0434\u0443\u043A\u0442\u043E\u0440 \u0438 \u043F\u0440\u043E\u043D\u0430\u0442\u043E\u0440
    \u043F\u043B\u0435\u0447\u0435\u0432\u043E\u0433\u043E \u0441\u0443\u0441\u0442\u0430\u0432\u0430"
  partListButton: {fileID: 0}
  bodyPartGroup: {fileID: 0}
