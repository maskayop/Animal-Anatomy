  - {fileID: 2970396300849296925}
  - {fileID: 9189854801507009530}
  cameraDistanceLimitsMultiplier: 1
  partName: "\u041A\u0440\u0443\u0433\u043E\u0432\u0430\u044F \u043C\u044B\u0448\u0446\u0430
    \u0440\u0442\u0430 (\u043A\u0440\u0430\u0435\u0432\u0430\u044F)"
  partScientificName: musculus orbicularis oris (pars marginalis)
  partDescription: "\u0421\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    \u043E\u0441\u043D\u043E\u0432\u0443 \u0433\u0443\u0431 \u0438, \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u044F\u0441\u044C
    \u043C\u0435\u0436\u0434\u0443 \u0441\u043B\u0438\u0437\u0438\u0441\u0442\u043E\u0439
    \u043E\u0431\u043E\u043B\u043E\u0447\u043A\u043E\u0439 \u0438 \u043A\u043E\u0436\u0435\u0439
    \u0433\u0443\u0431. \u0412 \u0443\u0433\u043B\u0430\u0445 \u0440\u0442\u0430
    \u043A\u0440\u0443\u0433\u043E\u0432\u0430\u044F \u043C\u044B\u0448\u0446\u0430
    \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442 \u0432 \u0449\u0451\u0447\u043D\u0443\u044E
    \u043C\u044B\u0448\u0446\u0443. \u0412 \u043A\u0440\u0443\u0433\u043E\u0432\u0443\u044E
    \u043C\u044B\u0448\u0446\u0443 \u0440\u0442\u0430 \u0432\u043F\u043B\u0435\u0442\u0430\u044E\u0442\u0441\u044F
    \u043C\u044B\u0448\u0435\u0447\u043D\u044B\u0435 \u043F\u0443\u0447\u043A\u0438
    \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u0435\u0439 \u0438
    \u043E\u043F\u0443\u0441\u043A\u0430\u0442\u0435\u043B\u0435\u0439 \u0433\u0443\u0431.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F
    \u2013 \u0441\u0436\u0438\u043C\u0430\u0442\u0435\u043B\u044C \u0433\u0443\u0431"
