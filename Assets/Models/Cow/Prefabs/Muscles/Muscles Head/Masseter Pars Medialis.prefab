  m_Script: {fileID: 11500000, guid: 27d7729a6b4a3fd4a8c08838916fac4f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.BodyPartInfo
  systemType: 1
  meshRenderers:
  - {fileID: 1817066643049395248}
  - {fileID: 1043628114594812062}
  - {fileID: 7357461886748558837}
  cameraDistanceLimitsMultiplier: 0.45
  partName: "\u0411\u043E\u043B\u044C\u0448\u0430\u044F \u0436\u0435\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F
    \u043C\u044B\u0448\u0446\u0430 (\u0433\u043B\u0443\u0431\u043E\u043A\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C)"
  partScientificName: musculus masseter (pars profundus)
  partDescription: "\u041F\u043E \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044E
    \u043C\u043D\u043E\u0433\u043E\u043F\u0435\u0440\u0438\u0441\u0442\u0430\u044F,
    \u043E\u0447\u0435\u043D\u044C \u043C\u043E\u0449\u043D\u0430\u044F, \u043B\u0435\u0436\u0438\u0442
    \u043D\u0430 \u043B\u0430\u0442\u0435\u0440\u0430\u043B\u044C\u043D\u043E\u0439
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u0432\u0435\u0442\u0432\u0438
    \u043D\u0438\u0436\u043D\u0435\u0439 \u0447\u0435\u043B\u044E\u0441\u0442\u0438,
    \u0441\u0432\u0435\u0440\u0445\u0443 \u043F\u0440\u0438\u043A\u0440\u044B\u0442\u0430
    \u0444\u0430\u0441\u0446\u0438\u0435\u0439 \u0438 \u043A\u043E\u0436\u043D\u043E\u0439
    \u043C\u044B\u0448\u0446\u0435\u0439 \u043B\u0438\u0446\u0430.\n\u0411\u0435\u0440\u0451\u0442
    \u043D\u0430\u0447\u0430\u043B\u043E \u043E\u0442 \u0441\u043A\u0443\u043B\u043E\u0432\u043E\u0439
    \u0434\u0443\u0433\u0438. \u041C\u044B\u0448\u0435\u0447\u043D\u044B\u0435 \u043F\u0443\u0447\u043A\u0438
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u043D\u043E\u0439
    \u0447\u0430\u0441\u0442\u0438 \u0438\u043C\u0435\u044E\u0442 \u043A\u0430\u0443\u0434\u043E\u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0435,
    \u0430 \u0443 \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0439 \u2013 \u0434\u043E\u0440\u0441\u043E\u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0435
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435. \u041E\u0431\u0435
    \u0447\u0430\u0441\u0442\u0438, \u0441\u0440\u0430\u0441\u0442\u0430\u044F\u0441\u044C
    \u043C\u0435\u0436\u0434\u0443 \u0441\u043E\u0431\u043E\u0439, \u0437\u0430\u043A\u0440\u0435\u043F\u043B\u044F\u044E\u0442\u0441\u044F
    \u0432 \u0436\u0435\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u044F\u043C\u043A\u0435
    \u0432\u0435\u0442\u0432\u0438 \u043D\u0438\u0436\u043D\u0435\u0439 \u0447\u0435\u043B\u044E\u0441\u0442\u0438"
