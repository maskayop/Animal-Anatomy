  cameraDistanceLimitsMultiplier: 0.45
  info: {fileID: 11400000, guid: 21e77122b85967e4a82b0ea82de2c247, type: 2}
  partName: "\u041D\u043E\u0441\u043E\u0433\u0443\u0431\u043D\u044B\u0439 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C
    (\u0433\u043B\u0443\u0431\u043E\u043A\u0430\u044F \u0447\u0430\u0441\u0442\u044C)"
  partScientificName: musculus levator nasolabialis
  partDescription: "\u041F\u043B\u0430\u0441\u0442\u0438\u043D\u0447\u0430\u0442\u043E\u0439
    \u0444\u043E\u0440\u043C\u044B \u043C\u044B\u0448\u0446\u0430, \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u044E\u0449\u0430\u044F\u0441\u044F
    \u043D\u0435\u043F\u043E\u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u043E
    \u043F\u043E\u0434 \u043A\u043E\u0436\u0435\u0439 \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438
    \u0431\u043E\u043A\u043E\u0432\u043E\u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
    \u043D\u043E\u0441\u0430 \u0438 \u043E\u0431\u0440\u0430\u0437\u0443\u044E\u0449\u0430\u044F
    \u0441 \u043D\u0430\u0440\u0443\u0436\u043D\u043E\u0439 \u0449\u0451\u0447\u043D\u043E\u0439
    \u043C\u044B\u0448\u0446\u0435\u0439 \u0435\u0434\u0438\u043D\u044B\u0439 \u043C\u044B\u0448\u0435\u0447\u043D\u044B\u0439
    \u043F\u043B\u0430\u0441\u0442.\n\u0411\u0435\u0440\u0451\u0442 \u043D\u0430\u0447\u0430\u043B\u043E
    \u043E\u0442 \u043A\u043E\u0436\u043D\u043E\u0439 \u043C\u044B\u0448\u0446\u044B
    \u043B\u0431\u0430 \u0438 \u043D\u043E\u0441\u0430, \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u043A\u0440\u044B\u043B\u0435 \u043D\u043E\u0441\u0430"
  partListButton: {fileID: 0}
  bodyPartGroup: {fileID: 0}
