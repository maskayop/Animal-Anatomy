  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.BodyPartInfo
  systemType: 1
  meshRenderers:
  - {fileID: 1690498498718211829}
  - {fileID: 2481507931205276200}
  - {fileID: 5801960448190193070}
  cameraDistanceLimitsMultiplier: 0.45
  partName: "\u041D\u0430\u0440\u0443\u0436\u043D\u0430\u044F \u0449\u0451\u0447\u043D\u0430\u044F
    \u043C\u044B\u0448\u0446\u0430"
  partScientificName: musculus malaris
  partDescription: "\u0422\u043E\u043D\u043A\u0430\u044F, \u043F\u043B\u043E\u0441\u043A\u0430\u044F,
    \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u043E\u0439 \u0444\u043E\u0440\u043C\u044B.
    \u0411\u0435\u0440\u0451\u0442 \u0441\u0432\u043E\u0451 \u043D\u0430\u0447\u0430\u043B\u043E
    \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u043D\u043E\u0441\u043E\u0433\u0443\u0431\u043D\u044B\u043C
    \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u0435\u043C \u043E\u0442
    \u043B\u043E\u0431\u043D\u043E\u0439 \u043C\u044B\u0448\u0446\u044B \u0438 \u0442\u0435\u0441\u043D\u043E
    \u0441\u0440\u0430\u0441\u0442\u0430\u0435\u0442\u0441\u044F \u0441 \u043E\u043F\u0443\u0441\u043A\u0430\u0442\u0435\u043B\u0435\u043C
    \u043D\u0438\u0436\u043D\u0435\u0433\u043E \u0432\u0435\u043A\u0430, \u0430 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u0432 \u043C\u044B\u0448\u0446\u0430\u0445 \u0449\u0435\u043A\u0438. \u0420\u0435\u0437\u043A\u043E
    \u043E\u0447\u0435\u0440\u0447\u0435\u043D\u0430 \u0438 \u043E\u0442\u0434\u0435\u043B\u0435\u043D\u0430
    \u043E\u0442 \u043D\u043E\u0441\u043E\u0433\u0443\u0431\u043D\u043E\u0433\u043E
    \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044F.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F
    \u2013 \u0442\u044F\u043D\u0435\u0442 \u0449\u0451\u043A\u0443 \u043A\u0430\u0443\u0434\u043E\u0434\u043E\u0440\u0441\u0430\u043B\u044C\u043D\u043E
    \u0438 \u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442 \u043D\u0438\u0436\u043D\u0435\u0435
    \u0432\u0435\u043A\u043E"
  partListButton: {fileID: 0}
  bodyPartGroup: {fileID: 0}
