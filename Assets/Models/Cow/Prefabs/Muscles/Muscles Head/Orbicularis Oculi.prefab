  m_Script: {fileID: 11500000, guid: 27d7729a6b4a3fd4a8c08838916fac4f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.BodyPartInfo
  systemType: 1
  meshRenderers:
  - {fileID: 4475991397944078643}
  - {fileID: 1783578279665416432}
  - {fileID: 8369511190000162527}
  cameraDistanceLimitsMultiplier: 0.45
  partName: "\u041A\u0440\u0443\u0433\u043E\u0432\u0430\u044F \u043C\u044B\u0448\u0446\u0430
    \u0433\u043B\u0430\u0437\u0430 "
  partScientificName: 'musculus orbicularis oculi '
  partDescription: "\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430
    \u043A\u0440\u0443\u0433\u043E\u0432\u044B\u043C\u0438 \u043F\u0443\u0447\u043A\u0430\u043C\u0438
    \u043C\u044B\u0448\u0435\u0447\u043D\u044B\u0445 \u0432\u043E\u043B\u043E\u043A\u043E\u043D
    \u0432\u043E\u043A\u0440\u0443\u0433 \u0433\u043B\u0430\u0437\u043D\u043E\u0439
    \u0449\u0435\u043B\u0438. \u0412 \u043D\u0435\u0439 \u0440\u0430\u0437\u043B\u0438\u0447\u0430\u044E\u0442
    \u0432\u0435\u043A\u043E\u0432\u0443\u044E \u0447\u0430\u0441\u0442\u044C (pars
    palpebralis), \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0449\u0443\u044E
    \u043E\u0441\u043D\u043E\u0432\u0443 \u0432\u0435\u043A, \u0438 \u0433\u043B\u0430\u0437\u043D\u0438\u0447\u043D\u0443\u044E
    (pars orbicularis), \u043F\u0440\u043E\u0445\u043E\u0434\u044F\u0449\u0443\u044E
    \u043F\u043E \u043A\u0440\u0430\u044E \u0433\u043B\u0430\u0437\u043D\u0438\u0446\u044B
    \u0438 \u043E\u0442\u0434\u0430\u044E\u0449\u0443\u044E \u043C\u044B\u0448\u0435\u0447\u043D\u044B\u0435
    \u043F\u0443\u0447\u043A\u0438 \u0432 \u0441\u0442\u0435\u043D\u043A\u0443 \u0441\u043B\u0451\u0437\u043D\u043E\u0433\u043E
    \u043C\u0435\u0448\u043A\u0430.\n\u0421\u0443\u0436\u0438\u0432\u0430\u0435\u0442
    \u0433\u043B\u0430\u0437\u043D\u0443\u044E \u0449\u0435\u043B\u044C, \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
    \u043A\u043E\u043C\u043F\u0440\u0435\u0441\u0441\u0438\u043E\u043D\u043D\u043E\u0435
    \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043D\u0430
    \u0441\u043B\u0451\u0437\u043D\u044B\u0435 \u0436\u0435\u043B\u0435\u0437\u044B,
    \u0441\u043F\u043E\u0441\u043E\u0431\u0441\u0442\u0432\u0443\u044F \u0440\u0430\u0441\u0448\u0438\u0440\u0435\u043D\u0438\u044E
    \u0441\u043B\u0451\u0437\u043D\u043E\u0433\u043E \u043C\u0435\u0448\u043A\u0430
    \u0438 \u0432\u0441\u0430\u0441\u044B\u0432\u0430\u043D\u0438\u044E \u0441\u043B\u0451\u0437\u043D\u043E\u0439
    \u0436\u0438\u0434\u043A\u043E\u0441\u0442\u0438 \u0447\u0435\u0440\u0435\u0437
    \u0441\u043B\u0451\u0437\u043D\u044B\u0435 \u043A\u0430\u043D\u0430\u043B\u044C\u0446\u044B"
  partListButton: {fileID: 0}
  bodyPartGroup: {fileID: 0}
