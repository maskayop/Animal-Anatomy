  partName: "\u0421\u043A\u0443\u043B\u043E\u0432\u0430\u044F \u043C\u044B\u0448\u0446\u0430"
  partScientificName: musculus zygomaticus
  partDescription: "\u0422\u043E\u043D\u043A\u0430\u044F, \u043B\u0435\u043D\u0442\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u0430\u044F,
