    \u0444\u0430\u0441\u0446\u0438\u0438, \u0430 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u0432 \u043A\u0440\u0443\u0433\u043E\u0432\u043E\u0439 \u043C\u044B\u0448\u0446\u0435
    \u0440\u0442\u0430.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F \u2013 \u043E\u0442\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442
    \u0443\u0433\u043E\u043B \u0440\u0442\u0430 \u043D\u0430\u0437\u0430\u0434 \u0438
    \u0432\u0432\u0435\u0440\u0445"
