  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 27d7729a6b4a3fd4a8c08838916fac4f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.BodyPartInfo
  systemType: 1
  meshRenderers:
  - {fileID: 1219700367902348251}
  - {fileID: 938269554196259751}
  - {fileID: 5018830811326986971}
  cameraDistanceLimitsMultiplier: 0.4
  partName: "\u0429\u0451\u0447\u043D\u0430\u044F \u043C\u044B\u0448\u0446\u0430"
  partScientificName: musculus buccinator
  partDescription: "\u0417\u0430\u043B\u043E\u0436\u0435\u043D\u0430 \u0432 \u0442\u043E\u043B\u0449\u0435
    \u0449\u0435\u043A\u0438 \u0438 \u0441\u043E\u0441\u0442\u043E\u0438\u0442 \u0438\u0437
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u043D\u043E\u0439
    \u0438 \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0439 \u0447\u0430\u0441\u0442\u0435\u0439.\n\u041F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u043D\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C (m. buccalis) - \u043F\u0435\u0440\u0438\u0441\u0442\u0430\u044F
    \u043C\u044B\u0448\u0446\u0430, \u0443 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
    \u043F\u043E\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
    \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u044C\u043D\u0430\u044F \u043F\u043E\u043B\u043E\u0441\u043A\u0430.
    \u041E\u0442 \u044D\u0442\u043E\u0439 \u043F\u043E\u043B\u043E\u0441\u043A\u0438
    \u043C\u044B\u0448\u0435\u0447\u043D\u044B\u0435 \u043F\u0443\u0447\u043A\u0438
    \u0442\u044F\u043D\u0443\u0442\u0441\u044F \u0432\u0432\u0435\u0440\u0445 \u0438
    \u0432\u043F\u0435\u0440\u0451\u0434 \u0434\u043E \u0432\u0435\u0440\u0445\u043D\u0435\u0439
    \u0447\u0435\u043B\u044E\u0441\u0442\u0438, \u0430 \u0432 \u043D\u0438\u0436\u043D\u0435\u0439
    \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0435 \u043E\u043D\u0438 \u0438\u0434\u0443\u0442
    \u0432\u043D\u0438\u0437 \u0438 \u0432\u043F\u0435\u0440\u0451\u0434 \u0434\u043E
    \u043D\u0438\u0436\u043D\u0435\u0439 \u0447\u0435\u043B\u044E\u0441\u0442\u0438.\n\u0413\u043B\u0443\u0431\u043E\u043A\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C (m.molaris) - \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F
    \u043E\u0442 \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u0438 \u043D\u0438\u0436\u043D\u0435\u0439
    \u0447\u0435\u043B\u044E\u0441\u0442\u0438. \u041E\u0431\u0435 \u0447\u0430\u0441\u0442\u0438
    \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u044E\u0442\u0441\u044F \u0432\u043C\u0435\u0441\u0442\u0435
    \u0438 \u043E\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F
    \u0432 \u043E\u0431\u043B\u0430\u0441\u0442\u0438 \u0443\u0433\u043B\u0430 \u0440\u0442\u0430.\n\u041F\u0440\u0438
    \u043F\u0435\u0440\u0435\u0436\u0451\u0432\u044B\u0432\u0430\u043D\u0438\u0438
    \u043A\u043E\u0440\u043C\u0430 \u0441\u043F\u043E\u0441\u043E\u0431\u0441\u0442\u0432\u0443\u0435\u0442
    \u0435\u0433\u043E \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u044F\u043C
    \u043D\u0430 \u043A\u043E\u0440\u0435\u043D\u043D\u044B\u0435 \u0437\u0443\u0431\u044B,
    \u043F\u0440\u0438\u0436\u0438\u043C\u0430\u044E\u0442 \u0449\u0451\u043A\u0443
    \u043A \u0437\u0443\u0431\u0430\u043C."
