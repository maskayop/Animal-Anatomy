  cameraDistanceLimitsMultiplier: 0.45
  partName: "\u041E\u043F\u0443\u0441\u043A\u0430\u0442\u0435\u043B\u044C \u043D\u0438\u0436\u043D\u0435\u0439
    \u0433\u0443\u0431\u044B"
  partScientificName: musculus depressor labii inferioris
  partDescription: "\u041F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u0432\u0434\u043E\u043B\u044C
    \u0437\u0443\u0431\u043D\u043E\u0433\u043E \u043A\u0440\u0430\u044F \u043D\u0438\u0436\u043D\u0435\u0439
    \u0447\u0435\u043B\u044E\u0441\u0442\u0438. \u0415\u0433\u043E \u043D\u0430\u0447\u0430\u043B\u043E
    \u0441\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0441 \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0439
    \u0447\u0430\u0441\u0442\u044C\u044E \u0449\u0451\u0447\u043D\u043E\u0439 \u043C\u044B\u0448\u0446\u044B.
    \u041D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u043E\u0442 \u0449\u0451\u0447\u043D\u043E\u0439
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u043D\u0438\u0436\u043D\u0435\u0439
    \u0447\u0435\u043B\u044E\u0441\u0442\u0438. \u0417\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043C\u044B\u0448\u0446\u0430 \u0432 \u043E\u0441\u043D\u043E\u0432\u0435 \u043D\u0438\u0436\u043D\u0435\u0439
    \u0433\u0443\u0431\u044B.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F \u2013
    \u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442 \u043D\u0438\u0436\u043D\u044E\u044E
    \u0433\u0443\u0431\u0443"
