  info: {fileID: 11400000, guid: 019ffd7c935e59a4fb87a225e869bd7f, type: 2}
  sagittalType: 1
  partName: "\u0413\u0440\u0443\u0434\u0438\u043D\u043E\u043D\u0438\u0436\u043D\u0435\u0447\u0435\u043B\u044E\u0441\u0442\u043D\u0430\u044F
    (\u0433\u0440\u0443\u0434\u0438\u043D\u043E\u0433\u043E\u043B\u043E\u0432\u043D\u0430\u044F)
    \u043C\u044B\u0448\u0446\u0430 (\u043B\u0435\u0432\u0430\u044F)"
  partScientificName: musculus sternomandibularis (sternocephalicus) (sinister)
  partDescription: "\u0418\u043C\u0435\u0435\u0442 \u043B\u0435\u043D\u0442\u043E\u0432\u0438\u0434\u043D\u0443\u044E
    \u0444\u043E\u0440\u043C\u0443, \u0431\u0435\u0440\u0451\u0442 \u043D\u0430\u0447\u0430\u043B\u043E
    \u043E\u0442 \u0440\u0443\u043A\u043E\u044F\u0442\u043A\u0438 \u0433\u0440\u0443\u0434\u0438\u043D\u044B,
    \u0430 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u043E \u0443 \u0440\u0430\u0437\u043D\u044B\u0445
    \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445.\n\u0424\u0443\u043D\u043A\u0446\u0438\u044F
    \u2013 \u043F\u0440\u0438 \u043E\u0434\u043D\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0435\u043C
    \u0441\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u0438\u0438 \u0441\u0433\u0438\u0431\u0430\u0435\u0442
    \u0448\u0435\u044E, \u043F\u0440\u0438 \u0434\u0432\u0443\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0435\u043C
    \u0441\u043F\u043E\u0441\u043E\u0431\u0441\u0442\u0432\u0443\u0435\u0442 \u043E\u043F\u0443\u0441\u043A\u0430\u043D\u0438\u044E
    \u0448\u0435\u0438, \u0432\u044B\u0442\u044F\u0433\u0438\u0432\u0430\u043D\u0438\u044E
    \u0433\u043E\u043B\u043E\u0432\u044B"
  partListButton: {fileID: 0}
  bodyPartGroup: {fileID: 0}
