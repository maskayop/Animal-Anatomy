  m_Script: {fileID: 11500000, guid: 27d7729a6b4a3fd4a8c08838916fac4f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.BodyPartInfo
  systemType: 9
  meshRenderers:
  - {fileID: 36125357392639149}
  - {fileID: 8072390571665161312}
  partName: "\u0413\u043B\u0430\u0437 (\u043F\u0440\u0430\u0432\u044B\u0439)"
  partDescription: "\u0413\u043B\u0430\u0437\u043D\u044B\u0435 \u044F\u0431\u043B\u043E\u043A\u0438
    \u2014 \u044D\u0442\u043E \u043F\u0430\u0440\u043D\u044B\u0435 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0442
    \r\n\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E \u043E\u0440\u0438\u0435\u043D\u0442\u0430\u0446\u0438\u044E
    \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \u0443\u043B\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C
    \r\n\u0438\u0437\u043B\u0443\u0447\u0430\u0435\u043C\u044B\u0439 \u0438\u043B\u0438
    \u043E\u0442\u0440\u0430\u0436\u0430\u0435\u043C\u044B\u0439 \u0441\u0432\u0435\u0442
    \u043E\u0442 \u043E\u0431\u044A\u0435\u043A\u0442\u043E\u0432 \u0432\u043D\u0435\u0448\u043D\u0435\u0433\u043E
    \u043C\u0438\u0440\u0430 \u0438 \r\n\u0432\u043E\u0441\u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0442\u044C
    \u0438\u0445. \u0426\u0432\u0435\u0442\u043D\u043E\u0435 \u0437\u0440\u0435\u043D\u0438\u0435
    \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0435\u043D\u043D\u043E \u043B\u043E\u0448\u0430\u0434\u044F\u043C,
    \u043A\u0440\u0443\u043F\u043D\u043E\u043C\u0443 \u0440\u043E\u0433\u0430\u0442\u043E\u043C\u0443
    \r\n\u0441\u043A\u043E\u0442\u0443."
