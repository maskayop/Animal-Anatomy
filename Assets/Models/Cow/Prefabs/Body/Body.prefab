  partDescription: "\u0428\u043A\u0443\u0440\u0430 \u2014 \u043D\u0430\u0440\u0443\u0436\u043D\u044B\u0439
    \u043F\u043E\u043A\u0440\u043E\u0432 \u0442\u0435\u043B\u0430 \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0433\u043E,
    \u043E\u043D\u0430 \u0441\u043B\u0443\u0436\u0438\u0442 \u0437\u0430\u0449\u0438\u0442\u043E\u0439
    \u0435\u0433\u043E \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043C\u0430 \u043E\u0442
    \u0432\u043D\u0435\u0448\u043D\u0438\u0445 \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439
    \u0438 \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
    \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0442 \u0432 \u0440\u0435\u0433\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0438
    \u043E\u0431\u043C\u0435\u043D\u0430 \u0432\u0435\u0449\u0435\u0441\u0442\u0432,
    \u0442\u0435\u043F\u043B\u0430, \u0430 \u0442\u0430\u043A\u0436\u0435 \u0432
    \u0432\u043E\u0441\u043F\u0440\u0438\u044F\u0442\u0438\u0438 \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445
    \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043D\u0438\u0439 \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0435\u0439
