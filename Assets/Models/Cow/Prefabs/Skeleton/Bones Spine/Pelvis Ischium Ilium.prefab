  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 27d7729a6b4a3fd4a8c08838916fac4f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.BodyPartInfo
  systemType: 0
  meshRenderers:
  - {fileID: 2711424511884268057}
  - {fileID: 1700200531633070233}
  - {fileID: 6393013275657754127}
  cameraDistanceLimitsMultiplier: 0.6
  info: {fileID: 11400000, guid: 5e04034bb783d8347847b07258b6eb83, type: 2}
  sagittalType: 0
  suffix: {fileID: 0}
  partName: "\u0421\u0435\u0434\u0430\u043B\u0438\u0449\u043D\u0430\u044F \u043A\u043E\u0441\u0442\u044C"
  partScientificName: os ischii
  partDescription: "\u0421\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    \u043E\u0441\u043D\u043E\u0432\u0443 \u043A\u043E\u0441\u0442\u043D\u043E\u0433\u043E
    \u043E\u0441\u0442\u043E\u0432\u0430 \u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043E\u0442\u0434\u0435\u043B\u0430 \u0442\u0430\u0437\u043E\u0432\u043E\u0439
    \u043F\u043E\u043B\u043E\u0441\u0442\u0438. \u041E\u043D\u0430 \u0441\u043E\u0441\u0442\u043E\u0438\u0442
    \u0438\u0437 \u0442\u0435\u043B\u0430, \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u044B
    \u0438 \u0432\u0435\u0442\u0432\u0438, \u043E\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u044E\u0449\u0438\u0445
    \u0437\u0430\u043F\u0435\u0440\u0442\u043E\u0435 \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435
    \u0441 \u0431\u043E\u043A\u043E\u0432 \u0438 \u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u043E\u0439
    \u0441\u0442\u043E\u0440\u043E\u043D\u044B. \u041E\u0431\u0435 \u0442\u0430\u0437\u043E\u0432\u044B\u0435
    \u043A\u043E\u0441\u0442\u0438, \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u044F\u0441\u044C
    \u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E \u043C\u0435\u0436\u0434\u0443
    \u0441\u043E\u0431\u043E\u0439, \u0430 \u0434\u043E\u0440\u0441\u0430\u043B\u044C\u043D\u043E
    \u0441 \u043A\u0440\u0435\u0441\u0442\u0446\u043E\u0432\u043E\u0439 \u043A\u043E\u0441\u0442\u044C\u044E,
    \u043E\u0431\u0440\u0430\u0437\u0443\u044E\u0442 \u0442\u0430\u0437\u043E\u0432\u0443\u044E
    \u043F\u043E\u043B\u043E\u0441\u0442\u044C (cavum pelvis). \u0422\u0430\u0437\u043E\u0432\u0430\u044F
    \u043F\u043E\u043B\u043E\u0441\u0442\u044C \u0438\u043C\u0435\u0435\u0442 \u043A\u043E\u043D\u0443\u0441\u043E\u0432\u0438\u0434\u043D\u0443\u044E
    \u0444\u043E\u0440\u043C\u0443 \u0441 \u0432\u0435\u0440\u0448\u0438\u043D\u043E\u0439,
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u0439 \u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u043E.
    \u0411\u043E\u043A\u043E\u0432\u044B\u0435 \u0441\u0442\u0435\u043D\u043A\u0438
    \u0442\u0430\u0437\u0430 \u043E\u0431\u0440\u0430\u0437\u0443\u044E\u0442 \u043F\u043E\u0434\u0432\u0437\u0434\u043E\u0448\u043D\u044B\u0435
    \u0438 \u0441\u0435\u0434\u0430\u043B\u0438\u0449\u043D\u044B\u0435 \u043A\u043E\u0441\u0442\u0438,
    \u0441\u0432\u043E\u0434 \u0442\u0430\u0437\u0430 \u2013 \u043A\u0440\u0435\u0441\u0442\u0446\u043E\u0432\u044B\u0435
    \u0438 \u043F\u0435\u0440\u0432\u044B\u0435 \u0445\u0432\u043E\u0441\u0442\u043E\u0432\u044B\u0435
    \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u0438, \u0430 \u0434\u043D\u043E \u0442\u0430\u0437\u0430,
    \u0438\u043B\u0438 \u043F\u043E\u0434\u043E\u0448\u0432\u0443 \u043A\u043E\u0441\u0442\u043D\u043E\u0433\u043E
    \u0442\u0430\u0437\u0430 (solum pelvis osseum), \u2013 \u043B\u043E\u043D\u043D\u044B\u0435
    \u043A\u043E\u0441\u0442\u0438 \u0438 \u0432\u0435\u0442\u0432\u044C \u0441\u0435\u0434\u0430\u043B\u0438\u0449\u043D\u043E\u0439
    \u043A\u043E\u0441\u0442\u0438"
  partListButton: {fileID: 0}
  bodyPartGroup: {fileID: 0}
