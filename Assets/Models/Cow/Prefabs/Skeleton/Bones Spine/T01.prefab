  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.BodyPartInfo
  systemType: 0
  meshRenderers:
  - {fileID: 1241953138982212746}
  - {fileID: 5759611095476319594}
  - {fileID: 7089208891516401768}
  cameraDistanceLimitsMultiplier: 0.4
  info: {fileID: 11400000, guid: 20ae03a16002c664b9a7c9e5bdd1831c, type: 2}
  sagittalType: 0
  suffix: {fileID: 11400000, guid: 941f99bbbc15ed84b9a2d3661ce9d789, type: 2}
  partName: "\u041F\u0435\u0440\u0432\u044B\u0439 (1) \u0433\u0440\u0443\u0434\u043D\u043E\u0439
    \u043F\u043E\u0437\u0432\u043E\u043D\u043E\u043A"
  partScientificName: vertebrae thoracicae
  partDescription: "\u0423\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0442 \u0432
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0438 \u0433\u0440\u0443\u0434\u043D\u043E\u0439
    \u043A\u043B\u0435\u0442\u043A\u0438. \u0421\u043E\u0441\u0442\u043E\u0438\u0442
    \u0438\u0437 \u0442\u0435\u043B\u0430, \u0434\u0443\u0433\u0438 \u0438 \u043E\u0442\u0440\u043E\u0441\u0442\u043A\u043E\u0432.
    \u0422\u0435\u043B\u043E \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u0430 (corpus
    vertebrae) \u2013 \u044D\u0442\u043E \u0441\u0430\u043C\u0430\u044F \u043C\u0430\u0441\u0441\u0438\u0432\u043D\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u0430.
    \u041A\u0440\u0430\u043D\u0438\u0430\u043B\u044C\u043D\u044B\u0439 \u043A\u043E\u043D\u0435\u0446
    \u0442\u0435\u043B\u0430 \u0432\u044B\u043F\u0443\u043A\u043B\u044B\u0439 \u2013
    \u044D\u0442\u043E \u0433\u043E\u043B\u043E\u0432\u043A\u0430 \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u0430
    (caput vertebrae), \u0430 \u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u044B\u0439
    \u043A\u043E\u043D\u0435\u0446 \u0442\u0435\u043B\u0430 \u0432\u043E\u0433\u043D\u0443\u0442\u044B\u0439
    \u2013 \u044D\u0442\u043E \u044F\u043C\u043A\u0430 \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u0430
    (fossa vertebrae). \u041F\u043E \u0431\u043E\u043A\u0430\u043C \u0442\u0435\u043B\u0430
    \u0438\u043C\u0435\u044E\u0442\u0441\u044F \u0441\u0443\u0441\u0442\u0430\u0432\u043D\u044B\u0435
    \u0440\u0451\u0431\u0435\u0440\u043D\u044B\u0435 \u044F\u043C\u043A\u0438, \u043E\u043D\u0438
    \u0441\u043B\u0443\u0436\u0430\u0442 \u0434\u043B\u044F \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F
    \u0441 \u0433\u043E\u043B\u043E\u0432\u043A\u043E\u0439 \u0440\u0435\u0431\u0440\u0430.
    \u0411\u044B\u0432\u0430\u044E\u0442 \u043A\u0440\u0430\u043D\u0438\u0430\u043B\u044C\u043D\u044B\u0435
    \u0440\u0451\u0431\u0435\u0440\u043D\u044B\u0435 \u044F\u043C\u043A\u0438 \u0438
    \u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u044B\u0435 (fossa costalis
    cranialis et caudalis)"
  partListButton: {fileID: 0}
  bodyPartGroup: {fileID: 0}
