  - {fileID: 1848917638953245449}
  - {fileID: 8887610958841476699}
  cameraDistanceLimitsMultiplier: 0.3
  partName: "\u0412\u0442\u043E\u0440\u043E\u0439 (2) \u043F\u043E\u044F\u0441\u043D\u0438\u0447\u043D\u044B\u0439
    \u043F\u043E\u0437\u0432\u043E\u043D\u043E\u043A"
  partScientificName: vertebrae lumbales
  partDescription: "\u0425\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0437\u0443\u0435\u0442\u0441\u044F
    \u043F\u0440\u0438\u0437\u043D\u0430\u043A\u0430\u043C\u0438, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u043C\u0438
    \u0431\u043E\u043B\u044C\u0448\u0443\u044E \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C
    \u0438 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E
    \u043F\u043E\u0434\u0432\u0438\u0436\u043D\u043E\u0441\u0442\u044C. \u041E\u0442\u043B\u0438\u0447\u0430\u0435\u0442\u0441\u044F
    \u0431\u043E\u043B\u0435\u0435 \u043C\u043E\u0449\u043D\u044B\u043C \u0442\u0435\u043B\u043E\u043C
    \u0441\u043E \u0441\u043B\u0430\u0431\u043E \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u043D\u043E\u0439
    \u0433\u043E\u043B\u043E\u0432\u043A\u043E\u0439 \u0438 \u044F\u043C\u043A\u0430\u043C\u0438.
    \u041E\u0441\u0442\u0438\u0441\u0442\u044B\u0435 \u043E\u0442\u0440\u043E\u0441\u0442\u043A\u0438
    \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0447\u0430\u0442\u044B\u0435, \u043F\u043E\u0447\u0442\u0438
    \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u043E\u0439 \u0432\u044B\u0441\u043E\u0442\u044B
    \u0438 \u0448\u0438\u0440\u0438\u043D\u044B. \u041F\u043E\u043F\u0435\u0440\u0435\u0447\u043D\u044B\u0435
    \u043E\u0442\u0440\u043E\u0441\u0442\u043A\u0438 \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0447\u0430\u0442\u044B\u0435
    \u0438 \u0448\u0438\u0440\u043E\u043A\u0438\u0435"
