  systemType: 0
  meshRenderers:
  - {fileID: 3021581154391134996}
  - {fileID: 1587372613216440131}
  - {fileID: 1557661529062271518}
  cameraDistanceLimitsMultiplier: 0.6
  info: {fileID: 11400000, guid: 4a5fd061f6a41a5449cf6e92ddbc3f4d, type: 2}
  sagittalType: 0
  partName: "\u0413\u0440\u0443\u0434\u043D\u0430\u044F \u043A\u043E\u0441\u0442\u044C
    (\u0433\u0440\u0443\u0434\u0438\u043D\u0430)"
  partScientificName: sternum
  partDescription: "\u041E\u0431\u0440\u0430\u0437\u0443\u0435\u0442 \u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u0443\u044E
    \u0441\u0442\u0435\u043D\u043A\u0443 \u0433\u0440\u0443\u0434\u043D\u043E\u0439
    \u043A\u043B\u0435\u0442\u043A\u0438. \u041D\u0430 \u043D\u0435\u0439 \u0435\u0441\u0442\u044C
    \u0442\u0435\u043B\u043E (corpus sterni), \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
    \u043F\u043E \u0431\u043E\u043A\u0430\u043C \u043D\u0430\u0445\u043E\u0434\u044F\u0442\u0441\u044F
    \u0440\u0451\u0431\u0435\u0440\u043D\u044B\u0435 \u0432\u044B\u0440\u0435\u0437\u043A\u0438
    \u0434\u043B\u044F \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F
    \u0441 \u0440\u0451\u0431\u0440\u0430\u043C\u0438 \u2013 incisura costalis. \u0421\u043F\u0435\u0440\u0435\u0434\u0438
    \u0433\u0440\u0443\u0434\u0438\u043D\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
    \u0440\u0443\u043A\u043E\u044F\u0442\u043A\u0430 (manubrium sterni), \u0430 \u043D\u0430
    \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u043E\u043B\u043E\u0436\u043D\u043E\u043C
    \u043A\u043E\u043D\u0446\u0435 \u2013 \u043C\u0435\u0447\u0435\u0432\u0438\u0434\u043D\u044B\u0439
    \u043E\u0442\u0440\u043E\u0441\u0442\u043E\u043A (processus xiphoideus) \u0441
    \u043C\u0435\u0447\u0435\u0432\u0438\u0434\u043D\u044B\u043C \u0445\u0440\u044F\u0449\u043E\u043C
    (cartilag\u043E xiphoidea)"
  partListButton: {fileID: 0}
  bodyPartGroup: {fileID: 0}
