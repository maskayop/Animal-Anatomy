  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.BodyPartInfo
  systemType: 0
  meshRenderers: []
  cameraDistanceLimitsMultiplier: 1
  partName: "\u0440\u0451\u0431\u0435\u0440\u043D\u044B\u0439 \u0445\u0440\u044F\u0449
    (\u0440\u0451\u0431\u0435\u0440\u043D\u0430\u044F \u0434\u0443\u0433\u0430)"
  partDescription: "cartilago costalis \u2013 \u0441\u0443\u0441\u0442\u0430\u0432\u043D\u043E\u0439
    \u0444\u0430\u0441\u0435\u0442\u043A\u043E\u0439 \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0435\u0442\u0441\u044F
    \u0441 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0435\u0439
    \u0441\u0443\u0441\u0442\u0430\u0432\u043D\u043E\u0439 \u044F\u043C\u043A\u043E\u0439
    \u0433\u0440\u0443\u0434\u0438\u043D\u044B. \n\ncartilago costalis \u2013 \u043A
    \u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u043C\u0443 \u043A\u043E\u043D\u0446\u0443
    \u0438\u0441\u0442\u043E\u043D\u0447\u0430\u0435\u0442\u0441\u044F \u0438, \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044F\u0441\u044C
    \u043E\u0434\u0438\u043D \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u0439, \u0432\u043C\u0435\u0441\u0442\u0435
    \u0441 \u0442\u0435\u043B\u043E\u043C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E
    \u0440\u0435\u0431\u0440\u0430 \u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442
    \u0440\u0451\u0431\u0435\u0440\u043D\u0443\u044E \u0434\u0443\u0433\u0443 (arcus
    costalis) \u0441 \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u043D\u044B\u043C
    \u043D\u0430 \u043D\u0435\u0439 \u0443\u0433\u043B\u043E\u043C (angulus arcuum
    costalium)."
