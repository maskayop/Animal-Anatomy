  - {fileID: 2482415575982858244}
  - {fileID: 5579829570990745913}
  - {fileID: 8520486288534179064}
  cameraDistanceLimitsMultiplier: 0.6
  info: {fileID: 0}
  sagittalType: 2
  partName: "\u0420\u0451\u0431\u0435\u0440\u043D\u0430\u044F \u0434\u0443\u0433\u0430
    (\u043F\u0440\u0430\u0432\u0430\u044F)"
  partScientificName: cartilago costalis (dexter)
  partDescription: "\u041A \u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u043C\u0443
    \u043A\u043E\u043D\u0446\u0443 \u0438\u0441\u0442\u043E\u043D\u0447\u0430\u0435\u0442\u0441\u044F,
    \u0438 \u0440\u0451\u0431\u0435\u0440\u043D\u044B\u0435 \u0445\u0440\u044F\u0449\u0438
    \u043B\u043E\u0436\u043D\u044B\u0445 \u0440\u0451\u0431\u0435\u0440, \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044F\u0441\u044C
    \u043E\u0434\u0438\u043D \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u0439, \u0432\u043C\u0435\u0441\u0442\u0435
    \u0441 \u0442\u0435\u043B\u043E\u043C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E
    \u0440\u0435\u0431\u0440\u0430 \u043E\u0431\u0440\u0430\u0437\u0443\u044E\u0442
    \u0440\u0451\u0431\u0435\u0440\u043D\u0443\u044E \u0434\u0443\u0433\u0443 (arcus
    costalis) \u0441 \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u043D\u044B\u043C
    \u043D\u0430 \u043D\u0435\u0439 \u0443\u0433\u043B\u043E\u043C (angulus arcuum
    costalium)"
  partListButton: {fileID: 0}
  bodyPartGroup: {fileID: 0}
