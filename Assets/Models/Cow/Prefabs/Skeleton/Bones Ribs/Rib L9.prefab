  m_Script: {fileID: 11500000, guid: 27d7729a6b4a3fd4a8c08838916fac4f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.BodyPartInfo
  systemType: 0
  meshRenderers:
  - {fileID: 8398714855448695366}
  - {fileID: 1573732022628142420}
  - {fileID: 1469352869196810244}
  cameraDistanceLimitsMultiplier: 0.58
  partName: "\u0414\u0435\u0432\u044F\u0442\u0430\u044F (9) \u0440\u0451\u0431\u0435\u0440\u043D\u0430\u044F
    \u043A\u043E\u0441\u0442\u044C (\u043B\u0435\u0432\u0430\u044F)"
  partDescription: "os costale \u2013 \u043B\u043E\u0436\u043D\u0430\u044F (\u0430\u0441\u0442\u0435\u0440\u043D\u0430\u043B\u044C\u043D\u0430\u044F)
    - \u0441\u043Estae spuriae, synchondroses asternales - \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0442
    \u0432 \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0438 \u0431\u043E\u043A\u043E\u0432\u043E\u0439
    \u0441\u0442\u0435\u043D\u043A\u0438 \u0433\u0440\u0443\u0434\u043D\u043E\u0439
    \u043A\u043B\u0435\u0442\u043A\u0438 \u0438 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F
    \u043A \u0434\u043B\u0438\u043D\u043D\u044B\u043C \u0438\u0437\u043E\u0433\u043D\u0443\u0442\u044B\u043C
    \u043F\u043B\u043E\u0441\u043A\u0438\u043C \u043A\u043E\u0441\u0442\u044F\u043C.
    \u0421\u0432\u043E\u0438\u043C\u0438 \u0434\u043E\u0440\u0441\u0430\u043B\u044C\u043D\u044B\u043C\u0438
    \u043A\u043E\u043D\u0446\u0430\u043C\u0438 \u0440\u0451\u0431\u0440\u0430 \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u044F\u044E\u0442\u0441\u044F
    \u043A \u0433\u0440\u0443\u0434\u043D\u044B\u043C \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u0430\u043C,
    \u0430 \u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u043C\u0438,
    \u043D\u0435 \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u044F \u0433\u0440\u0443\u0434\u0438\u043D\u044B,
    \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F
    \u043D\u0430 \u0440\u0451\u0431\u0435\u0440\u043D\u043E\u0439 \u0434\u0443\u0433\u0435
    (arcus costalis). \u0412\u0434\u043E\u043B\u044C \u043A\u0430\u0443\u0434\u043E\u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043A\u0440\u0430\u044F \u043A\u043E\u0441\u0442\u043D\u043E\u0433\u043E \u0440\u0435\u0431\u0440\u0430
    \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u0436\u0435\u043B\u043E\u0431
    (sulcus costae), \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u044E\u0442\u0441\u044F
    \u043C\u0435\u0436\u0440\u0451\u0431\u0435\u0440\u043D\u044B\u0435 \u0441\u043E\u0441\u0443\u0434\u044B
    \u0438 \u043D\u0435\u0440\u0432\u044B. \u041D\u0438\u0436\u043D\u0438\u0439 \u043A\u043E\u043D\u0435\u0446
    \u0440\u0435\u0431\u0440\u0430 \u0448\u0435\u0440\u043E\u0445\u043E\u0432\u0430\u0442
    \u0438 \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0435\u0442\u0441\u044F \u0441
    \u0440\u0451\u0431\u0435\u0440\u043D\u044B\u043C \u0445\u0440\u044F\u0449\u043E\u043C."
