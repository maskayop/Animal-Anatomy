  - {fileID: 22884078794119085}
  - {fileID: 9087967460274075642}
  cameraDistanceLimitsMultiplier: 0.4
  partName: "\u0427\u0435\u0442\u0432\u0451\u0440\u0442\u044B\u0439 (4) \u0448\u0435\u0439\u043D\u044B\u0439
    \u043F\u043E\u0437\u0432\u043E\u043D\u043E\u043A "
  partScientificName: "vert\u0435brae cervicales"
  partDescription: "\u041E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u043A
    \u0442\u0438\u043F\u0438\u0447\u043D\u044B\u043C. \u0415\u0433\u043E \u043F\u043E\u043F\u0435\u0440\u0435\u0447\u043D\u044B\u0435
    \u043E\u0442\u0440\u043E\u0441\u0442\u043A\u0438 \u0441\u0440\u0430\u0441\u0442\u0430\u044E\u0442\u0441\u044F
    \u0441 \u0440\u0443\u0434\u0438\u043C\u0435\u043D\u0442\u0430\u043C\u0438 \u0440\u0451\u0431\u0435\u0440
    (processus costalis), \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0438\u043C\u0435\u044E\u0442
    \u043A\u0440\u0430\u043D\u0438\u043E\u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0435
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435. \u041C\u0435\u0436\u0434\u0443
    \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0435\u043C \u043F\u043E\u043F\u0435\u0440\u0435\u0447\u043D\u043E\u0433\u043E
    \u043E\u0442\u0440\u043E\u0441\u0442\u043A\u0430 \u0438 \u0442\u0435\u043B\u043E\u043C
    \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u0430 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
    \u043F\u043E\u043F\u0435\u0440\u0435\u0447\u043D\u043E\u0435 \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435
    (foramen transversarium)"
