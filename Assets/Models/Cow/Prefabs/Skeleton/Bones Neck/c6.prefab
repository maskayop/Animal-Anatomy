  partName: "\u0428\u0435\u0441\u0442\u043E\u0439 (6) \u0448\u0435\u0439\u043D\u044B\u0439
    \u043F\u043E\u0437\u0432\u043E\u043D\u043E\u043A "
  partDescription: "vert\u0435brae cervicales - \u043D\u0430 \u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u043F\u043E\u043F\u0435\u0440\u0435\u0447\u043D\u043E\u0433\u043E
    \u043E\u0442\u0440\u043E\u0441\u0442\u043A\u0430 \u0438\u043C\u0435\u0435\u0442
    \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u0443\u044E \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u043A\u0443
    (lamina ventralis). \u0415\u0433\u043E \u043F\u043E\u043F\u0435\u0440\u0435\u0447\u043D\u043E\u0435
    \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u043F\u0440\u0435\u0432\u043E\u0441\u0445\u043E\u0434\u0438\u0442 \u043F\u043E
    \u0441\u0432\u043E\u0438\u043C \u0440\u0430\u0437\u043C\u0435\u0440\u0430\u043C
    \u0442\u0430\u043A\u043E\u0432\u043E\u0439 \u0432\u0441\u0435\u0445 \u0434\u0440\u0443\u0433\u0438\u0445
    \u0448\u0435\u0439\u043D\u044B\u0445 \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u043E\u0432."
