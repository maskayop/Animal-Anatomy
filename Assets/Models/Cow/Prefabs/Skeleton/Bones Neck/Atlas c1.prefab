  systemType: 0
  meshRenderers:
  - {fileID: 5706685653252885050}
  - {fileID: 2664787223103721584}
  - {fileID: 2149910462039061825}
  cameraDistanceLimitsMultiplier: 0.4
  partName: "\u041F\u0435\u0440\u0432\u044B\u0439 (1) \u0448\u0435\u0439\u043D\u044B\u0439
    \u043F\u043E\u0437\u0432\u043E\u043D\u043E\u043A (\u0430\u0442\u043B\u0430\u043D\u0442)"
  partScientificName: atlas
  partDescription: "\u0421\u0430\u043C\u044B\u0439 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
    \u0448\u0435\u0439\u043D\u044B\u0439 \u043F\u043E\u0437\u0432\u043E\u043D\u043E\u043A,
    \u0438\u043C\u0435\u0435\u0442 \u0432\u0438\u0434 \u043A\u043E\u043B\u044C\u0446\u0430,
    \u0447\u0442\u043E \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442
    \u0431\u043E\u043B\u044C\u0448\u0443\u044E \u043F\u043E\u0434\u0432\u0438\u0436\u043D\u043E\u0441\u0442\u044C
    \u0433\u043E\u043B\u043E\u0432\u044B, \u0441\u043E\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E
    \u0438\u0437 \u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439
    \u0438 \u0434\u043E\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0439 \u0434\u0443\u0433\u0438.
    \u041D\u0430 \u043A\u0440\u0430\u043D\u0438\u0430\u043B\u044C\u043D\u043E\u043C
    \u043A\u0440\u0430\u0435 \u0438\u043C\u0435\u0435\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E
    \u043E\u0434\u043D\u0430 \u0441\u0443\u0441\u0442\u0430\u0432\u043D\u0430\u044F
    \u044F\u043C\u043A\u0430 \u0434\u043B\u044F \u0441\u043E\u0447\u043B\u0435\u043D\u0435\u043D\u0438\u044F
    \u0441 \u043C\u044B\u0449\u0435\u043B\u043A\u043E\u043C \u0430\u0442\u043B\u0430\u043D\u0442\u0430"
