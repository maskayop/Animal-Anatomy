  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.BodyPartInfo
  systemType: 0
  meshRenderers:
  - {fileID: 7438335643344369644}
  - {fileID: 168565272355739437}
  - {fileID: 2699516746668691026}
  cameraDistanceLimitsMultiplier: 0.4
  partName: "\u0421\u0435\u0434\u044C\u043C\u043E\u0439 \u0448\u0435\u0439\u043D\u044B\u0439
    \u043F\u043E\u0437\u0432\u043E\u043D\u043E\u043A "
  partDescription: "\u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442
    \u043F\u043E \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044E \u0438 \u0444\u043E\u0440\u043C\u0435
    \u043F\u0435\u0440\u0432\u044B\u0439 \u0433\u0440\u0443\u0434\u043D\u043E\u0439.
    \u041E\u043D \u0438\u043C\u0435\u0435\u0442 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439
    \u043F\u043E\u043F\u0435\u0440\u0435\u0447\u043D\u044B\u0439 \u043E\u0442\u0440\u043E\u0441\u0442\u043E\u043A;
    \u043F\u043E\u043F\u0435\u0440\u0435\u0447\u043D\u043E\u0435 \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u0435
    \u0438 \u0440\u0451\u0431\u0435\u0440\u043D\u044B\u0439 \u043E\u0442\u0440\u043E\u0441\u0442\u043E\u043A
    \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044E\u0442. \u041D\u0430
    \u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u043E\u043C \u043A\u0440\u0430\u0435
    \u0442\u0435\u043B\u0430 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
    \u043F\u0430\u0440\u043D\u0430\u044F \u044F\u043C\u043A\u0430 \u0434\u043B\u044F
    \u0441\u043E\u0447\u043B\u0435\u043D\u0435\u043D\u0438\u044F \u0441 \u0433\u043E\u043B\u043E\u0432\u043A\u043E\u0439
    \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0440\u0435\u0431\u0440\u0430."
