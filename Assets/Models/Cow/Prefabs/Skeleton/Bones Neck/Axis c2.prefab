  meshRenderers:
  - {fileID: 187482656072994950}
  - {fileID: 269233185273873139}
  - {fileID: 6038318367597080655}
  cameraDistanceLimitsMultiplier: 0.4
  partName: "\u0412\u0442\u043E\u0440\u043E\u0439 \u0448\u0435\u0439\u043D\u044B\u0439
    \u043F\u043E\u0437\u0432\u043E\u043D\u043E\u043A (\u044D\u043F\u0438\u0441\u0442\u0440\u043E\u0444\u0435\u0439
    \u0438\u043B\u0438 \u0430\u043A\u0441\u0438\u0441)"
  partDescription: "(\u043E\u0441\u0435\u0432\u043E\u0439) \u2013 axis \u2013 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0437\u0443\u0435\u0442\u0441\u044F
    \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C\u0438
    \u0440\u0430\u0437\u043C\u0435\u0440\u0430\u043C\u0438 \u0442\u0435\u043B\u0430,
    \u043D\u0430\u043B\u0438\u0447\u0438\u0435\u043C \u043D\u0430 \u043F\u0435\u0440\u0435\u0434\u043D\u0435\u043C
    \u043A\u043E\u043D\u0446\u0435 \u0437\u0443\u0431\u043E\u0432\u0438\u0434\u043D\u043E\u0433\u043E
    \u043E\u0442\u0440\u043E\u0441\u0442\u043A\u0430, \u0438\u043B\u0438 \u0437\u0443\u0431\u0430
    (dens) \u0441 \u0434\u043E\u0440\u0441\u0430\u043B\u044C\u043D\u043E\u0439 \u0438
    \u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439 \u0441\u0443\u0441\u0442\u0430\u0432\u043D\u044B\u043C\u0438
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044F\u043C\u0438
    (facies articulares dorsalis et ventralis)."
