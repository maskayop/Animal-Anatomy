  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.BodyPartInfo
  systemType: 0
  meshRenderers:
  - {fileID: 2338359103158632422}
  - {fileID: 3614213320586442033}
  - {fileID: 2138333525189312691}
  cameraDistanceLimitsMultiplier: 0.25
  partName: "\u041A\u043E\u043B\u0435\u043D\u043D\u0430\u044F \u0447\u0430\u0448\u0435\u0447\u043A\u0430
    (\u043F\u0440\u0430\u0432\u0430\u044F)"
  partScientificName: patella
  partDescription: "\u0421\u0435\u0441\u0430\u043C\u043E\u0432\u0438\u0434\u043D\u0430\u044F
    \u043A\u043E\u0441\u0442\u044C \u043A\u043B\u0438\u043D\u043E\u0432\u0438\u0434\u043D\u043E\u0439
    \u0444\u043E\u0440\u043C\u044B, \u0432\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u0439
    \u0432 \u0441\u0443\u0445\u043E\u0436\u0438\u043B\u0438\u0435 \u0447\u0435\u0442\u044B\u0440\u0451\u0445\u0433\u043B\u0430\u0432\u043E\u0439
    \u043C\u044B\u0448\u0446\u044B \u0431\u0435\u0434\u0440\u0430. \u041D\u0430 \u043D\u0435\u0439
    \u0440\u0430\u0437\u043B\u0438\u0447\u0430\u044E\u0442 \u043F\u0440\u043E\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u0435 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0435
    - basis patelle, \u0434\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u043E \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u0443\u044E
    \u0432\u0435\u0440\u0448\u0438\u043D\u0443 - apex \u0438 \u0441\u0443\u0441\u0442\u0430\u0432\u043D\u0443\u044E
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C - facies articularis
    \u0434\u043B\u044F \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F
    \u0441 \u0431\u043B\u043E\u043A\u043E\u043C \u0431\u0435\u0434\u0440\u0435\u043D\u043D\u043E\u0439
    \u043A\u043E\u0441\u0442\u0438"
