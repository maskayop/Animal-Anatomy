  systemType: 0
  meshRenderers:
  - {fileID: 5409701029181481289}
  - {fileID: 3002980862368273672}
  - {fileID: 4890349258753303500}
  cameraDistanceLimitsMultiplier: 0.4
  info: {fileID: 11400000, guid: 5f3a7bd94b2566245a3d85521c9e77a5, type: 2}
  sagittalType: 2
  suffix: {fileID: 0}
  partName: "\u041F\u043B\u044E\u0441\u043D\u0430 (\u043F\u0440\u0430\u0432\u0430\u044F)"
  partScientificName: metatarsus (dexter)
  partDescription: "\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430
    \u043F\u043B\u044E\u0441\u043D\u0435\u0432\u044B\u043C\u0438 \u043A\u043E\u0441\u0442\u044F\u043C\u0438
    (ossa metatarsalia), \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u043E
    \u0441\u0432\u043E\u0435\u043C\u0443 \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044E
    \u0441\u0445\u043E\u0434\u043D\u044B \u0441 \u043F\u044F\u0441\u0442\u043D\u044B\u043C\u0438
    \u043A\u043E\u0441\u0442\u044F\u043C\u0438 \u0433\u0440\u0443\u0434\u043D\u043E\u0439
    \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u0438. \u0423 \u041A\u0420\u0421
    \u0441\u0438\u043B\u044C\u043D\u043E \u0440\u0430\u0437\u0432\u0438\u0442\u044B
    \u0438 \u0441\u043B\u0438\u043B\u0438\u0441\u044C \u0432 \u043E\u0434\u043D\u0443
    \u0431\u043E\u043B\u044C\u0448\u0443\u044E \u043A\u043E\u0441\u0442\u044C \u0442\u0440\u0435\u0442\u044C\u044F
    \u0438 \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u0430\u044F \u043F\u043B\u044E\u0441\u043D\u0435\u0432\u044B\u0435
    \u043A\u043E\u0441\u0442\u0438, \u0432\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435
    \u0447\u0435\u0433\u043E \u044D\u0442\u043E \u043C\u0430\u0441\u0441\u0438\u0432\u043D\u044B\u0439
    \u043B\u0443\u0447 \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u043A\u043E\u0441\u0442\u044C\u044E
    \u0431\u0435\u0433\u0443\u043D\u043E\u0432. \u041D\u0430 \u043F\u043B\u044E\u0441\u0435
    \u044D\u0442\u0430 \u043A\u043E\u0441\u0442\u044C \u043E\u043A\u0440\u0443\u0433\u043B\u0451\u043D\u043D\u0435\u0435
    \u0438 \u0434\u043B\u0438\u043D\u043D\u0435\u0435, \u0447\u0435\u043C \u043D\u0430
    \u043F\u044F\u0441\u0442\u0438. \u041F\u0435\u0440\u0432\u0430\u044F \u0438 \u043F\u044F\u0442\u0430\u044F
    \u043F\u043B\u044E\u0441\u043D\u0435\u0432\u044B\u0435 \u043A\u043E\u0441\u0442\u0438
    \u0438\u0441\u0447\u0435\u0437\u043B\u0438, \u0432\u0442\u043E\u0440\u0430\u044F
    \u043F\u043B\u044E\u0441\u043D\u0435\u0432\u0430\u044F \u043A\u043E\u0441\u0442\u044C
    \u0440\u0443\u0434\u0438\u043C\u0435\u043D\u0442\u0430\u0440\u043D\u0430"
  partListButton: {fileID: 0}
  bodyPartGroup: {fileID: 0}
