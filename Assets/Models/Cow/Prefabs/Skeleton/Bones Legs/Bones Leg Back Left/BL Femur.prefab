  partName: "\u0411\u0435\u0434\u0440\u0435\u043D\u043D\u0430\u044F \u043A\u043E\u0441\u0442\u044C
    (\u043B\u0435\u0432\u0430\u044F)"
  partScientificName: os femoris
  partDescription: "\u0422\u0440\u0443\u0431\u0447\u0430\u0442\u0430\u044F \u043A\u043E\u0441\u0442\u044C,
    \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u0430\u044F
    \u043A\u043E\u0441\u043E \u043E\u0442 \u0442\u0430\u0437\u0430 \u0432\u043D\u0438\u0437
    \u0438 \u0432\u043F\u0435\u0440\u0451\u0434. \u041D\u0430 \u043F\u0440\u043E\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u043C
    \u043A\u043E\u043D\u0446\u0435 \u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u043E
    \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u0433\u043E\u043B\u043E\u0432\u043A\u0430
    \u0431\u0435\u0434\u0440\u0435\u043D\u043D\u043E\u0439 \u043A\u043E\u0441\u0442\u0438
    - caput femoris"
