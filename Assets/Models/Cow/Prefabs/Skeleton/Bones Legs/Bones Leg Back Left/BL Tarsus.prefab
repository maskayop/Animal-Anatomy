  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.BodyPartInfo
  systemType: 0
  meshRenderers: []
  cameraDistanceLimitsMultiplier: 0.25
  partName: "\u0417\u0430\u043F\u043B\u044E\u0441\u043D\u0430"
  partDescription: "tarsus \u2013 \u0441\u043E\u0441\u0442\u043E\u0438\u0442 \u0438\u0437
    \u0442\u0440\u0451\u0445 \u0440\u044F\u0434\u043E\u0432 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0445
    \u043A\u043E\u0441\u0442\u0435\u0439 (ossa tarsi). \u0412 \u043F\u0440\u043E\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u043C
    \u0440\u044F\u0434\u0443 \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u044E\u0442\u0441\u044F
    \u0434\u0432\u0435 (\u0442\u0430\u0440\u0430\u043D\u043D\u0430\u044F \u0438 \u043F\u044F\u0442\u043E\u0447\u043D\u0430\u044F),
    \u0432 \u0441\u0440\u0435\u0434\u043D\u0435\u043C \u043E\u0434\u043D\u0430 (\u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u0430\u044F)
    \u0438 \u0432 \u0434\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u043C \u0434\u0432\u0435
    \u2013 \u0447\u0435\u0442\u044B\u0440\u0435 (\u043F\u0435\u0440\u0432\u0430\u044F,
    \u0432\u0442\u043E\u0440\u0430\u044F, \u0442\u0440\u0435\u0442\u044C\u044F \u0438
    \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u0430\u044F) \u0437\u0430\u043F\u043B\u044E\u0441\u043D\u0435\u0432\u044B\u0435
    \u043A\u043E\u0441\u0442\u0438."
