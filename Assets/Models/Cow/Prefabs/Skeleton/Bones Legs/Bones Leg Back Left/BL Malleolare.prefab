  info: {fileID: 0}
  sagittalType: 1
  partName: "\u041B\u043E\u0434\u044B\u0436\u043A\u043E\u0432\u0430\u044F \u043A\u043E\u0441\u0442\u044C
    (\u043B\u0435\u0432\u0430\u044F)"
  partScientificName: os malleolare (sinister)
  partDescription: "\u0418\u043C\u0435\u0435\u0442 \u0432\u0438\u0434 \u0447\u0435\u0442\u044B\u0440\u0435\u0445\u0443\u0433\u043E\u043B\u044C\u043D\u043E\u0439
    \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u043A\u0438. \u041D\u0430 \u0435\u0451
    \u043F\u0440\u043E\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u043C
    \u043A\u0440\u0430\u0435 \u0438\u043C\u0435\u0435\u0442\u0441\u044F \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439
    \u043A\u043B\u044E\u0432\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u0439
    \u043E\u0442\u0440\u043E\u0441\u0442\u043E\u043A \u0438 \u0434\u0432\u0435 \u0441\u0443\u0441\u0442\u0430\u0432\u043D\u044B\u0435
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u0434\u043B\u044F
    \u0441\u043E\u0447\u043B\u0435\u043D\u0435\u043D\u0438\u044F \u0441 \u0431\u043E\u043B\u044C\u0448\u0435\u0431\u0435\u0440\u0446\u043E\u0432\u043E\u0439
    \u043A\u043E\u0441\u0442\u044C\u044E. \u041D\u0430 \u0434\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u043C
    \u043A\u0440\u0430\u0435 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
    \u0435\u0449\u0435 \u043E\u0434\u043D\u0430 \u0441\u0443\u0441\u0442\u0430\u0432\u043D\u0430\u044F
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C \u0434\u043B\u044F
    \u0441\u043E\u0447\u043B\u0435\u043D\u0435\u043D\u0438\u044F \u0441 \u043F\u044F\u0442\u043E\u0447\u043D\u043E\u0439
    \u043A\u043E\u0441\u0442\u044C\u044E \u0437\u0430\u043F\u043B\u044E\u0441\u043D\u044B"
