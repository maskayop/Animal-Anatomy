  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 27d7729a6b4a3fd4a8c08838916fac4f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.BodyPartInfo
  systemType: 0
  meshRenderers:
  - {fileID: 981838167471178830}
  - {fileID: 4740996187512075967}
  - {fileID: 542414015740548631}
  cameraDistanceLimitsMultiplier: 0.45
  partName: "\u041A\u043E\u0441\u0442\u0438 \u043F\u0440\u0435\u0434\u043F\u043B\u0435\u0447\u044C\u044F
    (\u043B\u0435\u0432\u044B\u0435)"
  partScientificName: ossa antebrachii
  partDescription: "\u041A \u043D\u0438\u043C \u043E\u0442\u043D\u043E\u0441\u044F\u0442\u0441\u044F
    \u043B\u0443\u0447\u0435\u0432\u0430\u044F \u043A\u043E\u0441\u0442\u044C (radius)
    \u0438 \u043B\u043E\u043A\u0442\u0435\u0432\u0430\u044F \u043A\u043E\u0441\u0442\u044C
    (ulna). \u041B\u043E\u043A\u0442\u0435\u0432\u0430\u044F \u043A\u043E\u0441\u0442\u044C
    \u043F\u0440\u0438\u043A\u0440\u0435\u043F\u043B\u044F\u0435\u0442\u0441\u044F
    \u043A \u043B\u0443\u0447\u0435\u0432\u043E\u0439 \u0441 \u043A\u0430\u0443\u0434\u043E-\u043B\u0430\u0442\u0435\u0440\u0430\u043B\u044C\u043D\u043E\u0439
    \u0441\u0442\u043E\u0440\u043E\u043D\u044B.\n\u041B\u0443\u0447\u0435\u0432\u0430\u044F
    \u043A\u043E\u0441\u0442\u044C \u2013 radius \u2013 \u0442\u0438\u043F\u0438\u0447\u043D\u0430\u044F
    \u0434\u043B\u0438\u043D\u043D\u0430\u044F \u0442\u0440\u0443\u0431\u0447\u0430\u0442\u0430\u044F
    \u043A\u043E\u0441\u0442\u044C. \u041E\u043D\u0430 \u0438\u043C\u0435\u0435\u0442
    \u0442\u0435\u043B\u043E \u0438 \u0434\u0432\u0430 \u043A\u043E\u043D\u0446\u0430.\n\u041B\u043E\u043A\u0442\u0435\u0432\u0430\u044F
    \u043A\u043E\u0441\u0442\u044C \u2013 ulna \u2013 \u0432 \u0434\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0439
    \u0442\u0440\u0435\u0442\u0438 \u043F\u043E\u0434\u0432\u0435\u0440\u0433\u043B\u0430\u0441\u044C
    \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u0440\u0435\u0434\u0443\u043A\u0446\u0438\u0438.\n\u0423
    \u043A\u043E\u0440\u043E\u0432\u044B \u044D\u0442\u0438 \u043A\u043E\u0441\u0442\u0438
    \u0441\u0440\u0430\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u043E
    \u043A\u043E\u0441\u0442\u043D\u043E\u0439 \u0442\u043A\u0430\u043D\u044C\u044E,
    \u043C\u0435\u0436\u0434\u0443 \u043D\u0438\u043C\u0438 \u0435\u0441\u0442\u044C
    \u0434\u0432\u0430 \u043C\u0435\u0436\u043A\u043E\u0441\u0442\u043D\u044B\u0445
    \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430: \u043F\u0440\u043E\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0435
    \u0438 \u0434\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435. \u041B\u043E\u043A\u0442\u0435\u0432\u0430\u044F
    \u043A\u043E\u0441\u0442\u044C \u0440\u0430\u0437\u0432\u0438\u0442\u0430 \u043C\u0435\u043D\u044C\u0448\u0435
    \u043B\u0443\u0447\u0435\u0432\u043E\u0439 \u0438 \u0434\u043E\u0445\u043E\u0434\u0438\u0442
    \u0434\u043E \u0435\u0451 \u0434\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043A\u043E\u043D\u0446\u0430"
