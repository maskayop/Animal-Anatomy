  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.BodyPartInfo
  systemType: 0
  meshRenderers:
  - {fileID: 5356919655615222766}
  - {fileID: 396558638207427551}
  - {fileID: 8986954710768279388}
  cameraDistanceLimitsMultiplier: 0.55
  partName: "\u041B\u043E\u043F\u0430\u0442\u043A\u0430 (\u043B\u0435\u0432\u0430\u044F)"
  partScientificName: scapula
  partDescription: "\u041F\u043B\u0430\u0441\u0442\u0438\u043D\u0447\u0430\u0442\u0430\u044F,
    \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u043E\u0439 \u0444\u043E\u0440\u043C\u044B
    \u043A\u043E\u0441\u0442\u044C, \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043D\u0430
    \u0442\u0443\u043B\u043E\u0432\u0438\u0449\u0435 \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442\u0441\u044F
    \u043A\u043E\u0441\u043E \u0442\u0430\u043A, \u0447\u0442\u043E \u0435\u0451
    \u0434\u043E\u0440\u0441\u0430\u043B\u044C\u043D\u044B\u0439 \u043A\u0440\u0430\u0439
    \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D \u0434\u043E\u0440\u0441\u043E\u043A\u0430\u0443\u0434\u0430\u043B\u044C\u043D\u043E,
    \u0430 \u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0439 \u0443\u0433\u043E\u043B
    \u2013 \u043A\u0440\u0430\u043D\u0438\u043E\u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E.
    \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0435\u0442
    \u0434\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0439 \u0442\u0440\u0435\u0442\u0438
    \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0440\u0435\u0431\u0440\u0430"
