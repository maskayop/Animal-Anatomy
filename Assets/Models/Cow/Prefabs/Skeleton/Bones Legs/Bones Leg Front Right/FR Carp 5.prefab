  systemType: 0
  meshRenderers:
  - {fileID: 1299833251123019123}
  - {fileID: 6514678742930639604}
  cameraDistanceLimitsMultiplier: 0.25
  info: {fileID: 11400000, guid: 671b12206f552434cb50240e5ea6d3b2, type: 2}
  sagittalType: 2
  suffix: {fileID: 0}
  partName: "\u0421\u0440\u043E\u0441\u0448\u0438\u0435\u0441\u044F \u0432\u0442\u043E\u0440\u0430\u044F
    \u0438 \u0442\u0440\u0435\u0442\u044C\u044F \u043A\u043E\u0441\u0442\u044C \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u044F
    (\u043F\u0440\u0430\u0432\u044B\u0435)"
  partScientificName: os carpi secundum et tertium (dexter)
  partDescription: "\u0417\u0430\u043F\u044F\u0441\u0442\u044C\u0435 - carpus - \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0435
    \u043B\u0430\u043F\u044B, \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043E
    \u0434\u0432\u0443\u043C\u044F \u0440\u044F\u0434\u0430\u043C\u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0445
    \u043A\u043E\u0441\u0442\u0435\u0439 (ossa carpi), \u0441\u0447\u0451\u0442 \u043A\u043E\u0442\u043E\u0440\u044B\u0445
    \u0432\u0435\u0434\u0451\u0442\u0441\u044F \u0441 \u043C\u0435\u0434\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043A\u0440\u0430\u044F. \u041A\u043E\u0441\u0442\u0438 \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u044F
    \u0441\u0438\u043B\u044C\u043D\u043E \u0440\u0435\u0434\u0443\u0446\u0438\u0440\u043E\u0432\u0430\u043D\u044B,
    \u0442\u0430\u043A \u043A\u0430\u043A \u043D\u0435 \u043D\u0435\u0441\u0443\u0442
    \u0430\u043C\u043E\u0440\u0442\u0438\u0437\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0439
    \u0444\u0443\u043D\u043A\u0446\u0438\u0438"
  partListButton: {fileID: 0}
  bodyPartGroup: {fileID: 0}
