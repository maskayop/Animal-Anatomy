  partName: "\u0421\u0440\u043E\u0441\u0448\u0438\u0435\u0441\u044F \u0442\u0440\u0435\u0442\u044C\u044F
    \u0438 \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u0430\u044F \u043F\u044F\u0441\u0442\u043D\u044B\u0435
