  m_EditorClassIdentifier: Assembly-CSharp::AnimalAnatomy.BodyPartInfo
  systemType: 0
  meshRenderers:
  - {fileID: 3542061096423345856}
  - {fileID: 3316735448733467260}
  - {fileID: 1999926529467843251}
  cameraDistanceLimitsMultiplier: 0.25
  info: {fileID: 11400000, guid: 1d50b272f7e4b5143895becf4094cd79, type: 2}
  sagittalType: 0
  suffix: {fileID: 11400000, guid: 98d7624a944fd0c498e1918b629cf1b4, type: 2}
  partName: "\u041F\u044F\u0442\u044B\u0439 (5) \u0445\u0432\u043E\u0441\u0442\u043E\u0432\u043E\u0439
    \u043F\u043E\u0437\u0432\u043E\u043D\u043E\u043A"
  partScientificName: vertebrae caudales
  partDescription: "\u0421\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
    \u043E\u0441\u043D\u043E\u0432\u0443 \u0445\u0432\u043E\u0441\u0442\u043E\u0432\u043E\u0433\u043E
    \u043E\u0442\u0434\u0435\u043B\u0430, \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u044E\u0449\u0435\u0433\u043E
    \u0437\u0430\u0449\u0438\u0442\u043D\u0443\u044E \u0444\u0443\u043D\u043A\u0446\u0438\u044E
    \u0438 \u0440\u043E\u043B\u044C \u0441\u0432\u043E\u0435\u043E\u0431\u0440\u0430\u0437\u043D\u043E\u0433\u043E
    \u0440\u0443\u043B\u044F \u043F\u0440\u0438 \u0431\u044B\u0441\u0442\u0440\u044B\u0445
    \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F\u0445.
    \u0423 \u043A\u0440\u0443\u043F\u043D\u043E\u0433\u043E \u0440\u043E\u0433\u0430\u0442\u043E\u0433\u043E
    \u0441\u043A\u043E\u0442\u0430 \u0445\u0432\u043E\u0441\u0442 \u0434\u043B\u0438\u043D\u043D\u044B\u0439
    \u0437\u0430 \u0441\u0447\u0451\u0442 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
    \u0434\u043B\u0438\u043D\u044B \u0442\u0435\u043B \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u043E\u0432.
    \u0421\u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442\u0441\u044F \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0435
    \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B \u043F\u043E\u0437\u0432\u043E\u043D\u043A\u0430,
    \u0440\u0443\u0434\u0438\u043C\u0435\u043D\u0442\u044B \u043F\u043E\u0437\u0432\u043E\u043D\u043E\u0447\u043D\u044B\u0445
    \u0434\u0443\u0433 \u0445\u043E\u0440\u043E\u0448\u043E \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u044B.
    \u0418\u0437 \u0441\u0443\u0441\u0442\u0430\u0432\u043D\u044B\u0445 \u043E\u0442\u0440\u043E\u0441\u0442\u043A\u043E\u0432
    \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0441\u044C \u043B\u0438\u0448\u044C
    \u043A\u0440\u0430\u043D\u0438\u0430\u043B\u044C\u043D\u044B\u0435, \u0430 \u043F\u043E\u043F\u0435\u0440\u0435\u0447\u043D\u044B\u0435
    \u043F\u0440\u0438\u043D\u044F\u043B\u0438 \u0444\u043E\u0440\u043C\u0443 \u0448\u0438\u0440\u043E\u043A\u0438\u0445
    \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u043E\u043A, \u0437\u0430\u0433\u043D\u0443\u0442\u044B\u0445
    \u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E. \u041D\u0430 \u043A\u0440\u0430\u043D\u0438\u0430\u043B\u044C\u043D\u044B\u0445
    \u043A\u043E\u043D\u0446\u0430\u0445 \u0432\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439
    \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438 \u0438\u043C\u0435\u044E\u0442\u0441\u044F
    \u0433\u0435\u043C\u0430\u043B\u044C\u043D\u044B\u0435 \u043E\u0442\u0440\u043E\u0441\u0442\u043A\u0438
    (processus hemales) \u0438 \u0438\u043D\u043E\u0433\u0434\u0430 \u043C\u043E\u0433\u0443\u0442
    \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u044B\u0432\u0430\u0442\u044C \u0433\u0435\u043C\u0430\u043B\u044C\u043D\u044B\u0435
    \u0434\u0443\u0433\u0438 (arcus hemales)"
  partListButton: {fileID: 0}
  bodyPartGroup: {fileID: 0}
